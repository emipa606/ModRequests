<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  
    <!--============================== Chair ==============================-->
	
	  <ThingDef ParentName="CPFurnitureBase">
    <defName>RetroArmchair</defName>
    <label>Retro armchair</label>
    <graphicData>
      <texPath>Things/Furniture/SofaChair</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,3)</drawSize>
      <shadowData>
        <volume>(0.6, 0.6, 0.6)</volume>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <WorkToBuild>7500</WorkToBuild>
      <Mass>15</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>2</Beauty>
      <Comfort>1.0</Comfort>
    </statBases>
	<thingCategories>
		<li>BuildingsFurniture</li>
	</thingCategories>
    <description>A highly comfortable armchair that was banned from making jokes, however it sure feels cozy to sit on.</description>
    <socialPropernessMatters>true</socialPropernessMatters>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
	<colorPerStuff>
      <li>
        <stuff>Cloth</stuff>
        <color>(68,70,74)</color>
      </li>
    </colorPerStuff>
    <costStuffCount>110</costStuffCount>
    <pathCost>30</pathCost>
    <fillPercent>0.40</fillPercent>
	<defaultPlacingRot>South</defaultPlacingRot>
	<designationCategory>Furniture</designationCategory>
    <building>
      <isSittable>true</isSittable>
    </building>
  </ThingDef>
          <!--============================== Table ==============================-->
  
      <ThingDef ParentName="TableBase">
    <defName>RetroSmallTable</defName>
    <label>Retro table (small)</label>
    <graphicData>
      <texPath>Things/Furniture/SmallTable</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
	<rotatable>false</rotatable>
	<minifiedDef>MinifiedThing</minifiedDef>
    <statBases>
      <MaxHitPoints>45</MaxHitPoints>
      <WorkToBuild>380</WorkToBuild>
      <Mass>2.5</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>2</Beauty>
    </statBases>
	<stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <size>(1,1)</size>
    <designationCategory>Furniture</designationCategory>
    <costStuffCount>15</costStuffCount>
  </ThingDef>
  
        <!--============================== Retro Console ==============================-->
  
    <ThingDef ParentName="CPBuildingBase">
    <defName>RimtendoESConsole</defName>
    <label>Rimtendo Console</label>
    <description>Plays a selection of classic games on the totally non-copyright console "Rimtendo Entertainment System". Retro TV included.</description>
    <graphicData>
      <texPath>Things/Furniture/RESTube</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shadowData>
        <volume>(0.7, 0.6, 0.7)</volume>
        <offset>(0,0,-0.15)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <rotatable>true</rotatable>
    <minifiedDef>MinifiedThing</minifiedDef>
    <socialPropernessMatters>true</socialPropernessMatters>
    <fillPercent>0.40</fillPercent>
    <statBases>
      <WorkToBuild>6000</WorkToBuild>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>28</Mass>
      <Flammability>1.0</Flammability>
      <MarketValue>700</MarketValue>
      <JoyGainFactor>1.1</JoyGainFactor>
    </statBases>
	<thingCategories>
		<li>BuildingsJoy</li>
	</thingCategories>
    <costList>
      <Steel>100</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <pathCost>70</pathCost>
    <passability>PassThroughOnly</passability>
    <defaultPlacingRot>South</defaultPlacingRot>
    <building>
      <joyKind>Gaming_Video</joyKind>
      <spawnedConceptLearnOpportunity>TVForSickPeople</spawnedConceptLearnOpportunity>
      <boughtConceptLearnOpportunity>TVForSickPeople</boughtConceptLearnOpportunity>
      <watchBuildingStandDistanceRange>
        <min>2</min>
        <max>4</max>
      </watchBuildingStandDistanceRange>
	  <watchBuildingStandRectWidth>5</watchBuildingStandRectWidth>
    </building>
    <placeWorkers>
      <li>PlaceWorker_WatchArea</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
    </comps>
    <tradeTags>
      <li>Television</li>
    </tradeTags>
    <constructEffect>ConstructMetal</constructEffect>
    <designationCategory>Joy</designationCategory>
    <researchPrerequisites><li>TubeTelevision</li></researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
  </ThingDef>
  
      <!--============================== RockemSockem ==============================-->

  
    <ThingDef ParentName="CPFurnitureBase">
    <defName>RockemSockemTable</defName>
    <label>Rock'em Sock'em</label>
    <description>The ancient game of two robots beating each other to death against their will for your entertainment.
	
No wonder Mechanoids hate us.</description>
    <graphicData>
      <texPath>Things/Furniture/RockemSockem</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shadowData>
        <volume>(0.3, 0.6, 0.3)</volume>
      </shadowData>
      <damageData>
        <rect>(0.09375,0.296875,0.796875,0.703125)</rect>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <socialPropernessMatters>true</socialPropernessMatters>
    <fillPercent>0.40</fillPercent>
	<thingCategories>
		<li>BuildingsJoy</li>
	</thingCategories>
    <building>
      <joyKind>Gaming_Dexterity</joyKind>
    </building>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>10000</WorkToBuild>
      <Mass>5</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>7</Beauty>
      <JoyGainFactor>1.5</JoyGainFactor>
    </statBases>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>80</costStuffCount>
    <pathCost>70</pathCost>
    <passability>PassThroughOnly</passability>
	    <designationCategory>Joy</designationCategory>
  </ThingDef>
  
        <!--============================== DND ==============================-->

  
    <ThingDef ParentName="CPFurnitureBase">
    <defName>DNRandiesTable</defName>
    <label>Dungeons and Randies</label>
    <description>The ancient tabletop role-playing game. Toxic fallouts and plagues for everybody!</description>
    <graphicData>
