<!-- ========== BAR M1918 ========== -->
<ThingDef ParentName="BaseHumanMakeableGun">
    <defName>BA_Gun_Autorifle</defName>
    <label>Autorifle</label>
    <description>A gas-operated light machine rifle favored for walking fire assaults, its heavy caliber and slower rate of fire make it deadly and accurate.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/Autorifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.25</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <weaponClasses>
      <li>RangedHeavy</li>
    </weaponClasses>
    <recipeMaker>
      <researchPrerequisite>AntiqueGuns</researchPrerequisite>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
    </recipeMaker>
    <thingSetMakerTags><li>RewardStandardQualitySuper</li></thingSetMakerTags>
    <statBases>
      <WorkToMake>34000</WorkToMake>
      <Mass>7</Mass>
      <AccuracyTouch>0.25</AccuracyTouch>
      <AccuracyShort>0.55</AccuracyShort>
      <AccuracyMedium>0.65</AccuracyMedium>
      <AccuracyLong>0.40</AccuracyLong>
      <RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
    </statBases>
    <costList>
      <Steel>70</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_Autorifle</defaultProjectile>
        <warmupTime>1.5</warmupTime>
        <range>36.9</range>
        <ticksBetweenBurstShots>5</ticksBetweenBurstShots>
        <burstShotCount>3</burstShotCount>
        <soundCast>Shot_Minigun</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <weaponTags>
    </weaponTags>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2.5</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
