<?xml version="1.0" encoding="utf-8"?>

<Defs>
	<ThingDef Name="GFShieldMakeableBase" Abstract="True">	
		<thingClass>Apparel</thingClass>
		<category>Item</category>
		<selectable>True</selectable>
		<pathCost>10</pathCost>
		<useHitPoints>True</useHitPoints>
		<techLevel>Industrial</techLevel>	
		<graphicData>
			<onGroundRandomRotateAngle>35</onGroundRandomRotateAngle>
		</graphicData>
		<drawGUIOverlay>true</drawGUIOverlay>
		<statBases>
			<Flammability>0</Flammability>
			<DeteriorationRate>1</DeteriorationRate>
		</statBases>
		<altitudeLayer>Item</altitudeLayer>
		<alwaysHaulable>True</alwaysHaulable>
		<tickerType>Never</tickerType>
        <smeltable>true</smeltable>
		<comps>
			<li Class="CompProperties_Forbiddable" />
			<li>
				<compClass>CompColorable</compClass>
			</li>
			<li>
				<compClass>CompQuality</compClass>
			</li>
		</comps>
		
 </ThingDef>  

<ThingDef Name="GF_Shield" ParentName="GFShieldMakeableBase" Abstract="True">
   <recipeMaker>
	  <researchPrerequisite>ShieldBelt</researchPrerequisite>	     
	  <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Machining</soundWorking>
      <unfinishedThingDef>UnfinishedBelt</unfinishedThingDef>
	  <recipeUsers>
			<li>TableMachining</li>
	  </recipeUsers>
	    <defaultIngredientFilter>
			<categories>
			  <li>Root</li>
			</categories>
		  </defaultIngredientFilter>
    </recipeMaker>
	
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
				<li>FullHead</li>
				<li>Feet</li>			
			</bodyPartGroups>
		</apparel>
			
   
  </ThingDef>  


 <ThingDef ParentName="GF_Shield"> 
    <defName>GF_Sat8_shield</defName>
    <label>SAT8 Shield</label>
    <description>SAT8's Shield</description>
    <graphicData>
      <texPath>Things/Apparel/sat8shield</texPath> 
      <graphicClass>Graphic_Single</graphicClass>
	  	<shaderType>CutoutComplex</shaderType>
    </graphicData>
    <apparel> 
      <wornGraphicPath>Things/Apparel/sat8shield</wornGraphicPath>
	  <hatRenderedFrontOfFace>true</hatRenderedFrontOfFace>
      <layers>
        <li>Belt</li>
      </layers>
    </apparel>
	<costStuffCount>100</costStuffCount>
	<costList>
		<ComponentIndustrial>10</ComponentIndustrial>
	</costList>
	   <stuffCategories>
		<li>Metallic</li>
	   </stuffCategories>
    <thingCategories>
      <li>GF_Apparel_Shields</li>
    </thingCategories>
		<statBases>
		  <WorkToMake>20000</WorkToMake>
		  <Mass>11</Mass>	
		  <MaxHitPoints>500</MaxHitPoints>
		  <DeteriorationRate>1</DeteriorationRate>
		  <ArmorRating_Blunt>3.00</ArmorRating_Blunt>
		  <ArmorRating_Sharp>5.50</ArmorRating_Sharp>
		</statBases>
    <equippedStatOffsets> 
            <PainShockThreshold>0.25</PainShockThreshold>
			<MoveSpeed>-1</MoveSpeed>
    </equippedStatOffsets>
    <generateAllowChance>0</generateAllowChance>
	<generateCommonality>0</generateCommonality>
	<tradeability>Sellable</tradeability>
	<useHitPoints>True</useHitPoints>
	<smeltable>True</smeltable>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>RGBA(1,1,1,1)</only>
        </li>
      </options>
    </colorGenerator>
  </ThingDef>

	

