<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- ============================== CLEAN =============================
       Sweeping filth: keep the broom symbol & dust, add low sweeping
       grit kicked along the floor.
  -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/EffecterDef[defName="Clean"]/children</xpath>
    <value>
      <children>
        <!-- sweeping dust cloud (denser + a touch bigger for a proper sweep haze) -->
        <li>
          <subEffecterClass>SubEffecter_SprayerContinuous</subEffecterClass>
          <fleckDef>DustPuffThick</fleckDef>
          <spawnLocType>RandomCellOnTarget</spawnLocType>
          <ticksBetweenMotes>10</ticksBetweenMotes>
          <scale>0.70~1.05</scale>
          <angle>0~360</angle>
          <rotationRate>-15~25</rotationRate>
          <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
          <speed>0.1~0.35</speed>
          <positionRadius>0.5</positionRadius>
        </li>
        <!-- grit swept along the ground (more, more often) -->
        <li>
          <subEffecterClass>SubEffecter_SprayerContinuous</subEffecterClass>
          <fleckDef>DirtBits</fleckDef>
          <spawnLocType>RandomCellOnTarget</spawnLocType>
          <ticksBetweenMotes>14</ticksBetweenMotes>
          <burstCount>2~4</burstCount>
          <scale>0.28~0.45</scale>
          <positionRadius>0.45</positionRadius>
          <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
          <angle>0~360</angle>
          <speed>2.5~4.5</speed>
        </li>
      </children>
    </value>
  </Operation>

  <!-- ============================ CLEAR SNOW ==========================
       Shoveling snow: keep the symbol, much heavier snow spray plus a
       soft white powder haze.
  -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/EffecterDef[defName="ClearSnow"]/children</xpath>
    <value>
      <children>
        <!-- thrown snow (kept, denser) -->
        <li>
          <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
          <fleckDef>SnowBits</fleckDef>
          <spawnLocType>RandomCellOnTarget</spawnLocType>
          <chancePerTick>0.1</chancePerTick>
          <burstCount>6~9</burstCount>
          <scale>0.35~0.49</scale>
          <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
          <angle>-30~30</angle>
          <speed>5~7</speed>
        </li>
        <!-- soft powder haze (white-tinted dust) -->
        <li>
          <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
          <fleckDef>DustPuffThick</fleckDef>
          <spawnLocType>RandomCellOnTarget</spawnLocType>
          <chancePerTick>0.06</chancePerTick>
          <scale>0.63~1.05</scale>
          <color>(244, 248, 255)</color>
          <rotationRate>-20~20</rotationRate>
          <speed>0.3~0.9</speed>
          <positionRadius>0.4</positionRadius>
        </li>
      </children>
    </value>
  </Operation>

</Patch>
