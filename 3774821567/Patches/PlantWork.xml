<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- ============================ HARVEST TREE ========================
       Felling/chopping trees: the flying debris (wood chips + leaves) is now
       emitted by the animated AXE on each strike (hit-synced), so the effecter
       no longer sprays debris continuously. Children left empty on purpose.
  -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/EffecterDef[defName="Harvest_Tree"]/children</xpath>
    <value>
      <children />
    </value>
  </Operation>

  <!-- =========================== HARVEST PLANT ========================
       Harvesting/cutting crops & bushes: leaf clippings are now thrown by the
       SICKLE on each sweep hit (hit-synced). Keep only the soft disturbed-soil
       grit at ground level as ambiance.
  -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/EffecterDef[defName="Harvest_Plant"]/children</xpath>
    <value>
      <children>
        <!-- disturbed soil grit (ground ambiance, not thrown debris) -->
        <li>
          <subEffecterClass>SubEffecter_SprayerContinuous</subEffecterClass>
          <fleckDef>DirtBits</fleckDef>
          <spawnLocType>RandomCellOnTarget</spawnLocType>
          <ticksBetweenMotes>18</ticksBetweenMotes>
          <scale>0.35~0.49</scale>
          <angle>0~360</angle>
          <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
          <speed>2~4</speed>
        </li>
      </children>
    </value>
  </Operation>

  <!-- ============================== SOW ===============================
       Sowing seeds: seed grains are now thrown by the TROWEL on each dig hit.
       Keep only the soft tilled-soil puff as ground ambiance.
  -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/EffecterDef[defName="Sow"]/children</xpath>
    <value>
      <children>
        <!-- soft tilled-soil puff (kept) -->
        <li>
          <subEffecterClass>SubEffecter_SprayerContinuous</subEffecterClass>
          <fleckDef>DustPuffThick</fleckDef>
          <spawnLocType>RandomCellOnTarget</spawnLocType>
          <ticksBetweenMotes>20</ticksBetweenMotes>
          <scale>0.7~1.05</scale>
          <color>(150, 116, 80)</color>
          <angle>0~360</angle>
          <rotationRate>-15~25</rotationRate>
          <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
          <speed>0.1~0.3</speed>
          <positionRadius>0.5</positionRadius>
        </li>
        <!-- seed grains are now scattered by the TROWEL on each dig hit (hit-synced) -->
      </children>
    </value>
  </Operation>

</Patch>
