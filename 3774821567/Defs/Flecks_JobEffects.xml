  <!-- Fire-extinguisher foam clump: solid near-white BUBBLE blobs (custom foam sprite, not the wispy
       Smoke mote) that dump onto the flames and smother them. High opacity + a longer solid hold so
       the foam reads as a thick wet clump piling up, then slowly fades. -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>JE_ExtinguisherCloud</defName>
    <graphicData>
      <texPath>Things/JobEffects/Effects/Foam</texPath>
      <color>(255, 255, 255, 115)</color>
      <drawSize>0.6</drawSize>
      <!-- TransparentPostLight = Fire's own render pass. A plain Transparent fleck draws in an
           EARLIER queue than the flames, so altitude can't put it on top; matching Fire's shader
           puts the foam in the same pass where the higher MetaOverlays altitude finally wins. -->
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <!-- MetaOverlays is the topmost altitude layer (above Fire's PawnState); combined with the
         post-light shader above, the foam draws ON TOP of the flames. -->
    <altitudeLayer>MetaOverlays</altitudeLayer>
    <fadeInTime>0.04</fadeInTime>
    <solidTime>0.7</solidTime>
    <!-- Fade twice as slow as before (was 0.85). -->
    <fadeOutTime>1.7</fadeOutTime>
    <!-- Start a bit smaller (drawSize 0.6) and expand outward as the foam piles/spreads. -->
    <growthRate>0.9</growthRate>
    <speedPerTime>-5</speedPerTime>
  </FleckDef>

  <!-- Fire-extinguisher ember gust: a glowing ember knocked loose and flung across the tile when the
