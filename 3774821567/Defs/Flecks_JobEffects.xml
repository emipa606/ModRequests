<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ============================================================= -->
  <!--  Job Effects — custom particle flecks                         -->
  <!--  All inherit Core's FleckBase_Thrown (FleckSystemThrown) so   -->
  <!--  they support angle/speed/rotationRate/arch.                  -->
  <!--                                                               -->
  <!--  SIZE CONVENTION: chunky thrown debris (wood chips, stone     -->
  <!--  shards, soil clods, leaves, meat/blood/bone, wool, oil) OMIT -->
  <!--  <drawSize>, so they all share the same 1.0 base and the      -->
  <!--  per-tool <impactBitScale> alone sets on-screen size. Do NOT  -->
  <!--  add <drawSize>0.5</drawSize> back to these — that halves them -->
  <!--  vs. the rest. Fine specks (seed, paint, salt, sweat, pin,    -->
  <!--  gene wisp, thread) and smoke/icon/spark flecks keep their    -->
  <!--  own drawSize on purpose.                                     -->
  <!-- ============================================================= -->

  <!-- Sharp wood splinter — chopping trees, woodworking, wood construction.
       Three random chip shapes (plank / twig / curled shaving): the fleck system
       seeds GetGraphicData() from a stable per-fleck hash, so each chip picks one
       at random and a single strike throws a mix. Parent is FleckBase_RandomGraphic_Thrown
       (NOT FleckBase_Thrown) — the latter inherits a <graphicData> that GetGraphicData
       returns first, which would silently shadow <randomGraphics>. -->
  <FleckDef ParentName="FleckBase_RandomGraphic_Thrown">
    <defName>JE_WoodChip</defName>
    <randomGraphics>
      <li>
        <graphicClass>Graphic_Fleck</graphicClass>
        <texPath>Things/Mote/JobEffects/WoodChip1</texPath>
        <shaderType>Transparent</shaderType>
      </li>
      <li>
        <graphicClass>Graphic_Fleck</graphicClass>
        <texPath>Things/Mote/JobEffects/WoodChip2</texPath>
        <shaderType>Transparent</shaderType>
      </li>
      <li>
        <graphicClass>Graphic_Fleck</graphicClass>
        <texPath>Things/Mote/JobEffects/WoodChip3</texPath>
        <shaderType>Transparent</shaderType>
      </li>
    </randomGraphics>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.03</fadeInTime>
    <solidTime>0.35</solidTime>
    <fadeOutTime>0.3</fadeOutTime>
    <archHeight>0.18~0.45</archHeight>
    <archDuration>0.55</archDuration>
    <speedPerTime>-22</speedPerTime>
  </FleckDef>

  <!-- Three angular grey rock shapes — mining, stonecutting, sculpting. Each shard picks one at
       random (the fleck system seeds GetGraphicData() from a stable per-fleck hash), so a single
       strike throws a mix; arcs and falls. Parent is FleckBase_RandomGraphic_Thrown (NOT
       FleckBase_Thrown) — the latter inherits a <graphicData> that GetGraphicData returns first,
       which would silently shadow <randomGraphics>. The meat/soil/bone flecks below still point at
       the single StoneShard sprite via their own <graphicData> (tinted), so they're unaffected. -->
  <FleckDef ParentName="FleckBase_RandomGraphic_Thrown">
    <defName>JE_StoneShard</defName>
    <randomGraphics>
      <li>
        <graphicClass>Graphic_Fleck</graphicClass>
        <texPath>Things/Mote/JobEffects/StoneShard</texPath>
        <shaderType>Transparent</shaderType>
      </li>
      <li>
        <graphicClass>Graphic_Fleck</graphicClass>
        <texPath>Things/Mote/JobEffects/Stone1</texPath>
        <shaderType>Transparent</shaderType>
      </li>
      <li>
        <graphicClass>Graphic_Fleck</graphicClass>
        <texPath>Things/Mote/JobEffects/Stone2</texPath>
        <shaderType>Transparent</shaderType>
      </li>
    </randomGraphics>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.02</fadeInTime>
    <solidTime>0.45</solidTime>
    <fadeOutTime>0.2</fadeOutTime>
    <archHeight>0.25~0.6</archHeight>
    <archDuration>0.6</archDuration>
    <speedPerTime>-14</speedPerTime>
  </FleckDef>

