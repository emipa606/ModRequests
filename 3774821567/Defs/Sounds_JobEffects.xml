<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- A small, non-invasive chisel tick for stone smoothing / sculpting / stonecutting.
       Reuses Core's real pick-on-stone clips, but pitched up and dropped to a low volume so it
       reads as a delicate chisel tap rather than a heavy mining swing. clipFolderPath resolves
       against Core's Sounds/ — no audio file is shipped with this mod. -->
  <SoundDef>
    <defName>JE_ChiselTick</defName>
    <context>MapOnly</context>
    <maxSimultaneous>3</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Interact/Work/Mine/PickHit</clipFolderPath>
          </li>
        </grains>
        <volumeRange>6~9</volumeRange>
        <pitchRange>1.45~1.75</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- One-shot extinguisher hiss for each spray pulse. Reuses Core's small-hiss clip (the steam-
       vent hiss) but as a non-sustained one-shot, low volume, so each discharge puff gets a short
       "pssht". Overlapping pulses (maxSimultaneous 3) read as a continuous spray. clipPath resolves
       against Core's Sounds/ — no audio file is shipped with this mod. -->
  <SoundDef>
    <defName>JE_ExtinguisherHiss</defName>
    <context>MapOnly</context>
    <maxSimultaneous>3</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Misc/Hiss/HissSmall</clipPath>
          </li>
        </grains>
        <volumeRange>10~14</volumeRange>
        <pitchRange>1.1~1.35</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Per-sweep sickle cut: a quick blade swish (Core's throw-whoosh clips, pitched up and
       quiet so it reads as a small hand blade, not a hurled grenade) layered with a short,
       pitched-up snip of Core's harvest rustle clips — the stalks parting on the cut. The
       vanilla Harvest_Standard sustainer keeps rustling underneath; this is just the
       hit-synced accent. clip paths resolve against Core's Sounds/ — no audio file is
       shipped with this mod. -->
  <SoundDef>
    <defName>JE_SickleSwish</defName>
    <context>MapOnly</context>
    <maxSimultaneous>3</maxSimultaneous>
    <subSounds>
      <!-- blade whoosh -->
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Misc/Swish1</clipFolderPath>
          </li>
        </grains>
        <volumeRange>14~18</volumeRange>
        <pitchRange>1.15~1.4</pitchRange>
      </li>
      <!-- stalks parting (snippy, pitched-up harvest rustle) -->
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Interact/Work/Grow</clipFolderPath>
          </li>
        </grains>
        <volumeRange>7~10</volumeRange>
        <pitchRange>1.35~1.6</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Per-stroke broom swish: Core's actual sweeping clips as hit-synced one-shots, so each
       visual stroke is audible over the faint vanilla Interact_CleanFilth sustainer. -->
  <SoundDef>
    <defName>JE_BroomSwish</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Interact/Work/Clean/Cleaning_Sweeping</clipFolderPath>
          </li>
        </grains>
        <volumeRange>10~13</volumeRange>
        <pitchRange>0.95~1.1</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Auger bit-chatter: PickHit clips pitched way up and very quiet — a fast "bit biting
       rock" tick per stab (6/s; maxSimultaneous caps stacking) over the Interact_Drill
       grind loop that already plays at the deep drill. -->
  <SoundDef>
    <defName>JE_AugerChatter</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Interact/Work/Mine/PickHit</clipFolderPath>
          </li>
        </grains>
        <volumeRange>4~6</volumeRange>
        <pitchRange>1.8~2.05</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Bonesaw rasp: Core's HAND-saw woodworking clips pitched up = a smaller, finer surgical
       blade. Saw style strikes ~8/s; maxSimultaneous 2 lets overlap read as continuous sawing. -->
  <SoundDef>
    <defName>JE_BonesawRasp</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Interact/Work/Construct/Wood/Wood_Saw_Hand</clipFolderPath>
          </li>
        </grains>
        <volumeRange>8~11</volumeRange>
        <pitchRange>1.25~1.5</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Cleaver block-thunk: the vanilla butcher squelch already plays per chop (and the blade
       is synced to land on it); this adds the missing low "chock" of the edge burying into
       the chopping block at the same instant. MeleeHit_Wood pitched down. -->
  <SoundDef>
    <defName>JE_CleaverThunk</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Impact/MeleeHit_Wood</clipFolderPath>
          </li>
        </grains>
        <volumeRange>8~10</volumeRange>
        <pitchRange>0.8~0.95</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Shovel scoop: Core's dirt-digging clips, one per dig stroke (grave digging / filling). -->
  <SoundDef>
    <defName>JE_ShovelScoop</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Interact/Work/Construct/Dig</clipFolderPath>
          </li>
        </grains>
        <volumeRange>9~12</volumeRange>
        <pitchRange>0.95~1.1</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Trowel scoop: same dirt clips pitched up and quieter — a small hand tool turning a
       trowelful of soil per sowing dig (the dirt sustainer keeps playing underneath). -->
  <SoundDef>
    <defName>JE_TrowelScoop</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Interact/Work/Construct/Dig</clipFolderPath>
          </li>
        </grains>
        <volumeRange>7~9</volumeRange>
        <pitchRange>1.2~1.4</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Machining chisel tink: sharp-metal impact clips pitched up, quiet — a fine "tink" of
       the cold chisel on a metal workpiece (the stone ChiselTick would read wrong here). -->
  <SoundDef>
    <defName>JE_MetalTink</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Impact/MeleeHit_Metal_Sharp</clipFolderPath>
          </li>
        </grains>
        <volumeRange>5~7</volumeRange>
        <pitchRange>1.4~1.7</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Smith anvil ting: blunt-metal impact clips pitched up = hammer ringing on the anvil,
       synced to each strike (kept clear of the vanilla smithing sustainer's own cadence). -->
  <SoundDef>
    <defName>JE_AnvilTing</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Impact/MeleeHit_Metal_Blunt</clipFolderPath>
          </li>
        </grains>
        <volumeRange>8~11</volumeRange>
        <pitchRange>1.25~1.5</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Crowbar pry: Core's wood-rummage clatter per yank — boards creaking loose. Material-
       agnostic enough at low volume to cover all deconstruction. -->
  <SoundDef>
    <defName>JE_CrowbarPry</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Interact/Work/Construct/Wood/Rummage_Wood</clipFolderPath>
          </li>
        </grains>
        <volumeRange>8~11</volumeRange>
        <pitchRange>0.9~1.05</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Mortar shell clunk: blunt-metal impact pitched down — the shell seating in the tube,
       one per load motion. -->
  <SoundDef>
    <defName>JE_ShellClunk</defName>
    <context>MapOnly</context>
    <maxSimultaneous>1</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Impact/MeleeHit_Metal_Blunt</clipFolderPath>
          </li>
        </grains>
        <volumeRange>9~12</volumeRange>
        <pitchRange>0.75~0.9</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Axe chop: a meaty wood bite on each felling/harvest swing. Core's wood melee-impact
       clips pitched DOWN so it reads as a heavy axe biting a trunk, not a light tap. -->
  <SoundDef>
    <defName>JE_AxeChop</defName>
    <context>MapOnly</context>
    <maxSimultaneous>3</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Impact/MeleeHit_Wood</clipFolderPath>
          </li>
        </grains>
        <volumeRange>13~17</volumeRange>
        <pitchRange>0.78~0.95</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Shear snip: a quick metallic scissor snip per squeeze. Sharp-metal melee impact pitched
       way up and quiet — a small hand blade, not a sword clash. -->
  <SoundDef>
    <defName>JE_ShearSnip</defName>
    <context>MapOnly</context>
    <maxSimultaneous>3</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Impact/MeleeHit_Metal_Sharp</clipFolderPath>
          </li>
        </grains>
        <volumeRange>5~7</volumeRange>
        <pitchRange>1.55~1.85</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

  <!-- Tool foley: a short handle clatter as a colonist pulls a tool from the belt to start work
       and stows it when done. Reuses Core's wood-rummage clatter, pitched up and quiet. Played
       from C# (ToolAnimator.PlayFoley) on the pickup/stow edges, not per strike. -->
  <SoundDef>
    <defName>JE_ToolFoley</defName>
    <context>MapOnly</context>
    <maxSimultaneous>3</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Folder">
            <clipFolderPath>Interact/Work/Construct/Wood/Rummage_Wood</clipFolderPath>
          </li>
        </grains>
        <volumeRange>7~10</volumeRange>
        <pitchRange>1.1~1.35</pitchRange>
      </li>
    </subSounds>
  </SoundDef>

</Defs>
