<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>Quadra Turbo-R V-Tech</name>
  <author>Artemiish</author>
  <packageId>Artemiish.Vtech</packageId>
  <supportedVersions>
	<li>1.5</li>
  </supportedVersions>
  <description>
