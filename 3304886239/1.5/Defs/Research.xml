<?xml version="1.0" encoding="utf-8" ?>

<Defs>
	<ResearchProjectDef>
		<defName>Artemiish_Vtech</defName>
		<label>Turbo-R</label>
		<description>Reproduce the beloved Turbo-R V-Tech produced by Quadra.</description>
		<baseCost>4000</baseCost>
		<techLevel>Industrial</techLevel>
		<prerequisites>
			<li>VVE_ComplexVehicles</li>
		</prerequisites>
		<researchViewX>4.00</researchViewX>
		<researchViewY>2.00</researchViewY>
		<tab>Vehicles</tab>
		<generalRules>
			<rulesStrings>
				<li>subject->cyberpunk engineering</li>
				<li>subject_story->studied blueprints and learned how to craft more advanced vehicles</li>
				<li>subject_gerund->creating power and speed</li>
			</rulesStrings>
		</generalRules>
	</ResearchProjectDef>
	
	<ThingDef ParentName="NonDeconstructibleAncientBuildingBase">
		<defName>Artemiish_VtechWreck</defName>
		<label>Turbo-R wreck</label>
		<description>A wrecked Turbo-R. It's almost completely looted, but can still be restored.</description>
		<rotatable>false</rotatable>
		<graphicData>
			<texPath>ArtemiishThings/Structures/VTechWreck</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(5,3)</drawSize>
		</graphicData>
		<size>(4,2)</size>
		<fillPercent>0.5</fillPercent>
		<castEdgeShadows>false</castEdgeShadows>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<statBases>
			<MaxHitPoints>600</MaxHitPoints>
			<Flammability>0</Flammability>
		</statBases>
		<killedLeavings>
			<ChunkSlagSteel>2</ChunkSlagSteel>
			<VVE_CarExhaust>2</VVE_CarExhaust>
			<VVE_CarWheel>3</VVE_CarWheel>
		</killedLeavings>
		<comps>
			<li Class="VanillaVehiclesExpanded.CompProperties_VehicleWreck">
				<vehicleDef>Artemiish_Vtech</vehicleDef>
				<!--<researchDef>Artemiish_Vtech</researchDef>-->
				<spawnRotation>West</spawnRotation>
			</li>
		</comps>
	</ThingDef>
</Defs>