<?xml version="1.0" encoding="utf-8" ?>

<Defs>
	<Vehicles.UpgradeTreeDef>
		<defName>Artemiish_Vtech_UpgradeTree</defName>
		 
		<nodes>
			<li>
				<key>ReinforcedArmor</key>
				<label>Reinforced Armor</label>
				<description>Swap the windshield to Crystaldome and armor-up the body. The result is a considerably sturdier car at the cost of added weight.</description>
				
				<icon>ArtemiishThings/UI/ArmorUpgrade</icon>
				
				<work>4000</work>
				
				<gridCoordinate>(6, 7)</gridCoordinate>
				<drawSize>(80, 80)</drawSize>
				
				<upgrades>
					<li Class = "Vehicles.StatUpgrade">
						<stats>
							<li>
								<def>ArmorRating_Blunt</def>
								<value>0.20</value>
							</li>
							<li>
								<def>ArmorRating_Sharp</def>
								<value>0.20</value>
							</li>
						</stats>
						<vehicleStats>
							<li>
								<def>AccelerationRate</def>
								<value>-0.01</value>
							</li>
							<li>
								<def>Mass</def>
								<value>30</value>
							</li>
						</vehicleStats>
					</li>
				</upgrades>
				
				<ingredients>
					<Steel>50</Steel>
					<Plasteel>60</Plasteel>
					<ComponentSpacer>1</ComponentSpacer>
					<VVE_CarWiring>1</VVE_CarWiring>
				</ingredients>
				
				<graphicOverlays>
					<li>
						<graphicData>
							<texPath>ArtemiishThings/Vehicles/Upgrades/VtechArmor</texPath>
							<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
							<drawSize>(3,5)</drawSize>
							<layer>1</layer>
							<shaderType>CutoutComplexPattern</shaderType>
						</graphicData>
					</li>
				</graphicOverlays>
			</li>
			
			<li>
				<key>OffRoadTires</key>
				<label>Off Road Tires</label>
				<description>Swap to off road tires, treaded and larger these should improve off road performance.</description>
				
				<icon>ArtemiishThings/UI/WheelsUpgrade</icon>
				
				<work>2000</work>
				
				<gridCoordinate>(12, 7)</gridCoordinate>
				<drawSize>(80, 80)</drawSize>
				
				<disableIfUpgradeNodeEnabled>ChainedTires</disableIfUpgradeNodeEnabled>

				<upgrades>
					<li Class = "Vehicles.StatUpgrade">
						<statCategories>
							<li>
								<def>OffRoadMultiplier</def>
								<value>-0.25</value>
								<type>Add</type>
							</li>
							<li>
								<def>WinterCostMultiplier</def>
								<value>-2.0</value>
								<type>Add</type>
							</li>
							<li>
								<def>WorldSpeedMultiplier</def>
								<value>0.1</value>
								<type>Add</type>
							</li>
						</statCategories>
					</li>
				</upgrades>
				
				<ingredients>
					<VVE_CarWheel>4</VVE_CarWheel>
					<Steel>40</Steel>
					<Chemfuel>40</Chemfuel>
				</ingredients>
				
				<graphicOverlays>
					<li>
						<graphicData>
							<texPath>ArtemiishThings/Vehicles/Upgrades/VtechOffroadWheels</texPath>
							<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
							<drawSize>(3,5)</drawSize>
							<layer>1</layer>
							<shaderType>Cutout</shaderType>
						</graphicData>
					</li>
				</graphicOverlays>
			</li>
			
			<li>
				<key>Spoiler</key>
				<label>Spoiler</label>
				<description>Install a spoiler to go faster. Flame decals not included.</description>
				
				<icon>ArtemiishThings/UI/SpoilerUpgrade</icon>
				
				<work>1200</work>
				
				<gridCoordinate>(18, 7)</gridCoordinate>
				<drawSize>(80, 80)</drawSize>
				
				<upgrades>
					<li Class = "Vehicles.StatUpgrade">
						<vehicleStats>
							<li>
								<def>MoveSpeed</def>
								<value>1</value>
							</li>
						</vehicleStats>
					</li>
				</upgrades>
				
				<ingredients>
					<Steel>60</Steel>
				</ingredients>
				
				<graphicOverlays>
					<li>
						<graphicData>
							<texPath>ArtemiishThings/Vehicles/Upgrades/VtechSpoiler</texPath>
							<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
							<drawSize>(3,5)</drawSize>
							<layer>2</layer>
							<shaderType>CutoutComplexPattern</shaderType>
						</graphicData>
					</li>
				</graphicOverlays>
			</li>
			
			<li>
				<key>Engine</key>
				<label>Engine</label>
				<description>Replace the engine and many other parts to improve fuel efficiency and increase speed.</description>
				
				<icon>ArtemiishThings/UI/EngineUpgrade</icon>
				
				<work>1200</work>
				
				<gridCoordinate>(24, 7)</gridCoordinate>
				<drawSize>(80, 80)</drawSize>
				
				<upgrades>
					<li Class = "Vehicles.StatUpgrade">
						<vehicleStats>
							<li>
								<def>MoveSpeed</def>
								<value>2.0</value>
							</li>
						</vehicleStats>
					</li>
					<li Class = "Vehicles.StatUpgrade">
						<vehicleStats>
							<li>
								<def>AccelerationRate</def>
								<value>0.005</value>
							</li>
						</vehicleStats>
					</li>
					<li Class = "Vehicles.StatUpgrade">
						<statCategories>
							<li>
								<def>FuelConsumptionRate</def>
								<value>-10</value>
							</li>
						</statCategories>
					</li>
				</upgrades>
				
				<ingredients>
					<ComponentSpacer>1</ComponentSpacer>
					<VVE_EngineBlock>1</VVE_EngineBlock>
					<VVE_CarTransmission>1</VVE_CarTransmission>
					<VVE_CarExhaust>4</VVE_CarExhaust>
				</ingredients>
				
				<graphicOverlays>
					<li>
						<graphicData>
							<texPath>ArtemiishThings/Vehicles/Upgrades/VtechEngine</texPath>
							<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
							<drawSize>(3,5)</drawSize>
							<layer>1</layer>
							<shaderType>CutoutComplexPattern</shaderType>
						</graphicData>
					</li>
				</graphicOverlays>
			</li>
			
			<li>
				<key>FuelCapacity</key>
				<label>Fuel Capacity</label>
				<description>Slightly increase the size of the fuel tank.</description>
				
				<icon>ArtemiishThings/UI/TankUpgrade</icon>
				
				<work>800</work>
				
				<gridCoordinate>(30, 7)</gridCoordinate>
				<drawSize>(80, 80)</drawSize>
				
				<upgrades>
					<li Class = "Vehicles.StatUpgrade">
						<statCategories>
							<li>
								<def>FuelCapacity</def>
								<value>20</value>
							</li>
						</statCategories>
					</li>
				</upgrades>
				
				<ingredients>
					<Steel>20</Steel>
				</ingredients>
			</li>
			
			<li>
				<key>MiniTurret1</key>
				<label>Mini Turret left mount</label>
				<description>Install a turret at the front of the vehicle. Requires steel to refurbish.</description>
				
				<icon>ArtemiishThings/UI/GunUpgrade</icon>
				
				<work>7800</work>
				
				<gridCoordinate>(6, 15)</gridCoordinate>
				<drawSize>(80, 80)</drawSize>
				
				<disableIfUpgradeNodeEnabled>Missiles1</disableIfUpgradeNodeEnabled>
				
				<upgrades>
					<li Class = "Vehicles.TurretUpgrade">
						<turrets>
							<li>
								<turretDef>Artemiish_VtechMachineGun</turretDef>
								
								<renderProperties>
									<north>(-0.85, 1.4)</north>
									<south>(0.93, -0.8)</south>
									<east>(1.3, 1)</east>
								</renderProperties>
								<drawLayer>3</drawLayer>

								<gizmoLabel>Left Turret</gizmoLabel>
								
								<angleRestricted/>
								<aimPieOffset>(0, -0.25)</aimPieOffset>
								
								<key>leftTurret</key>
							</li>
						</turrets>
					</li>
				</upgrades>

				<ingredients>
					<Steel>100</Steel>
					<ComponentSpacer>2</ComponentSpacer>
				</ingredients>

			</li>
			
			<li>
				<key>Missiles1</key>
				<label>Swarm Missiles left mount</label>
				<description>Install a turret at the front of the vehicle. Requires steel to refurbish.</description>
				
				<icon>ArtemiishThings/UI/MissileUpgrade</icon>
				
				<work>7800</work>
				
				<gridCoordinate>(12, 15)</gridCoordinate>
				<drawSize>(80, 80)</drawSize>
				
				<disableIfUpgradeNodeEnabled>MiniTurret1</disableIfUpgradeNodeEnabled>
				
				<upgrades>
					<li Class = "Vehicles.TurretUpgrade">
						<turrets>
							<li>
								<turretDef>Artemiish_VtechMissile</turretDef>
								
								<renderProperties>
									<north>(-0.85, 1.4)</north>
									<south>(0.93, -0.8)</south>
									<east>(1.3, 1)</east>
								</renderProperties>
								<drawLayer>3</drawLayer>

								<gizmoLabel>Left Turret</gizmoLabel>
								
								<angleRestricted/>
								<aimPieOffset>(0, -0.25)</aimPieOffset>
								
								<key>leftTurret</key>
							</li>
						</turrets>
					</li>
				</upgrades>

				<ingredients>
					<Steel>100</Steel>
					<ComponentSpacer>2</ComponentSpacer>
				</ingredients>

			</li>
		
			<li>
				<key>MiniTurret2</key>
				<label>Mini Turret right mount</label>
				<description>Install a turret at the front of the vehicle. Requires steel to refurbish.</description>
				
				<icon>ArtemiishThings/UI/GunUpgrade</icon>
				
				<work>7800</work>
				
				<gridCoordinate>(24, 15)</gridCoordinate>
				<drawSize>(80, 80)</drawSize>
				
				<disableIfUpgradeNodeEnabled>Missiles2</disableIfUpgradeNodeEnabled>
				
				<upgrades>
					<li Class = "Vehicles.TurretUpgrade">
						<turrets>
							<li>
								<turretDef>Artemiish_VtechMachineGun</turretDef>
								
								<renderProperties>
									<north>(0.9, 1.4)</north>
									<south>(-1, -0.8)</south>
									<east>(1.3, -0.5)</east>
								</renderProperties>
								<drawLayer>3</drawLayer>

								<gizmoLabel>Right Turret</gizmoLabel>
								
								<angleRestricted/>
								<aimPieOffset>(0, -0.25)</aimPieOffset>
								
								<key>rifhtTurret</key>
							</li>
						</turrets>
					</li>
				</upgrades>

				<ingredients>
					<Steel>100</Steel>
					<ComponentSpacer>2</ComponentSpacer>
				</ingredients>

			</li>
			
			<li>
				<key>Missiles2</key>
				<label>Swarm Missiles right mount</label>
				<description>Install a turret at the front of the vehicle. Requires steel to refurbish.</description>
				
				<icon>ArtemiishThings/UI/MissileUpgrade</icon>
				
				<work>7800</work>
				
				<gridCoordinate>(30, 15)</gridCoordinate>
				<drawSize>(80, 80)</drawSize>
				
				<disableIfUpgradeNodeEnabled>MiniTurret2</disableIfUpgradeNodeEnabled>
				
				<upgrades>
					<li Class = "Vehicles.TurretUpgrade">
						<turrets>
							<li>
								<turretDef>Artemiish_VtechMissile</turretDef>
								
								<renderProperties>
									<north>(0.9, 1.4)</north>
									<south>(-1, -0.8)</south>
									<east>(1.3, -0.5)</east>
								</renderProperties>
								<drawLayer>3</drawLayer>

								<gizmoLabel>Right Turret</gizmoLabel>
								
								<angleRestricted/>
								<aimPieOffset>(0, -0.25)</aimPieOffset>
								
								<key>rightTurret</key>
							</li>
						</turrets>
					</li>
				</upgrades>

				<ingredients>
					<Steel>100</Steel>
					<ComponentSpacer>2</ComponentSpacer>
				</ingredients>

			</li>
			
		</nodes>
	</Vehicles.UpgradeTreeDef>
</Defs>
