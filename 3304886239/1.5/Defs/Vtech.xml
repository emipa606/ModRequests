<?xml version="1.0" encoding="utf-8" ?>

<Defs>
	<Vehicles.VehicleBuildDef ParentName="VehicleBaseBuildable">
		<defName>Artemiish_Vtech_Blueprint</defName>
		<label>Turbo-R</label>
		<description>A beloved muscle car produced by Quadra. Made for cities, it will struggle on hills, snow or winter tiles.\n\n&lt;color=#bb8f04&gt;Crew:&lt;/color&gt; Driver x1, Passenger x1\n&lt;color=#bb8f04&gt;Fuel type:&lt;/color&gt; Chemfuel</description>
		
		<graphicData>
			<texPath>ArtemiishThings/Vehicles/VTech</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3, 5)</drawSize>
		</graphicData>
		
		<statBases>
			<MaxHitPoints>250</MaxHitPoints>
			<WorkToBuild>18500</WorkToBuild>
			<Flammability>0.5</Flammability>
		</statBases>
		
		<researchPrerequisites>
			<li>Artemiish_Vtech</li>
		</researchPrerequisites>
		
		<size>(2, 4)</size>
		
		<costList>
			<VVE_EngineBlock>1</VVE_EngineBlock>
			<VVE_CarAlternator>2</VVE_CarAlternator>
			<VVE_CarExhaust>4</VVE_CarExhaust>
			<VVE_CarSuspension>4</VVE_CarSuspension>
			<VVE_CarWheel>4</VVE_CarWheel>
			<Steel>300</Steel>
			<ComponentIndustrial>10</ComponentIndustrial>
			<Silver>300</Silver>
			<VVE_CarTransmission>2</VVE_CarTransmission>
			<VVE_CarRadiator>2</VVE_CarRadiator>
			<VVE_CarWiring>1</VVE_CarWiring>
			<VVE_CarBattery>1</VVE_CarBattery>
		</costList>
		
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		
		<thingToSpawn>Artemiish_Vtech</thingToSpawn>
	</Vehicles.VehicleBuildDef>
	
	<Vehicles.VehicleDef ParentName="VehiclePawn_Mechanical">
		<defName>Artemiish_Vtech</defName>
		<label>Turbo-R</label>
		<description>A beloved muscle car produced by Quadra. Made for cities, it will struggle on hills, snow or winter tiles.\n\n&lt;color=#bb8f04&gt;Crew:&lt;/color&gt; Driver x1, Passenger x1\n&lt;color=#bb8f04&gt;Fuel type:&lt;/color&gt; Chemfuel</description>
		
		<graphicData>
			<texPath>ArtemiishThings/Vehicles/VTech</texPath>
			<graphicClass>Vehicles.Graphic_Vehicle</graphicClass>
			<shaderType>CutoutComplexPattern</shaderType>
			<drawSize>(3, 5)</drawSize>
			<color>(50, 50, 55)</color>
		</graphicData>
		
		<fillPercent>0.8</fillPercent>
		
		<buildDef>Artemiish_Vtech_Blueprint</buildDef>
		
		<size>(2, 4)</size>
		
		<vehicleMovementPermissions>DriverNeeded</vehicleMovementPermissions>
		<vehicleCategory>Transport</vehicleCategory>
		<techLevel>Industrial</techLevel>
		<vehicleType>Land</vehicleType>
		
		<statBases>
			<ArmorRating_Blunt>0.28</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.50</ArmorRating_Sharp>
			<ArmorRating_Heat>1.3</ArmorRating_Heat>
			<MarketValue>3500</MarketValue>
			<Flammability>0.5</Flammability>
		</statBases>
		
		<vehicleStats>
			<Mass>260</Mass>
			<MoveSpeed>16</MoveSpeed>
			<CargoCapacity>280</CargoCapacity>
			<RepairRate>0.4</RepairRate>
			<AccelerationRate>0.22</AccelerationRate>
		</vehicleStats>
		
		<soundSustainersOnEvent>
			<li>
				<start>IgnitionOn</start>
				<stop>IgnitionOff</stop>
				<value>VVE_VehicleEngineMuscleCar</value>
			</li>
		</soundSustainersOnEvent>
		
		<properties>
			<offRoadMultiplier>1.6</offRoadMultiplier>
			<winterSpeedMultiplier>2.8</winterSpeedMultiplier>
			
			<customRoadCosts AssignDefaults = "0.25"/>
			
			<roles>
				<li>
					<key>driver</key>
					<label>Driver</label>
					<slots>1</slots>
					<slotsToOperate>1</slotsToOperate>
					
					<handlingTypes>
						<li>Movement</li>
					</handlingTypes>
					
					<hitbox>
						<cells>
							<li>(0, 1)</li>
						</cells>
					</hitbox>
				</li>
				<li>
					<key>passenger</key>
					<label>Passenger</label>
					<slots>1</slots>
					
					<hitbox>
						<cells>
							<li>(1, 1)</li>
						</cells>
					</hitbox>
				</li>
			</roles>
		</properties>
		
		<components>
			<li>
				<key>Engine</key>
				<label>Engine</label>
				<health>85</health>
				<priorityStatEfficiency>true</priorityStatEfficiency>
				<depth>Internal</depth>
				
				<reactors>
					<li Class = "Vehicles.Reactor_Explosive">
						<indicator>VF_Explosive</indicator>
						<chance>0.25</chance>
						<maxHealth>0.2</maxHealth>
						<radius>3</radius>
						<damageDef>Flame</damageDef>
					</li>
				</reactors>
				
				<categories>
					<li>MoveSpeed</li>
				</categories>
			</li>
			<li>
				<key>FrontLeftWheel</key>
