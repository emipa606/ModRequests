<?xml version="1.0" encoding="utf-8"?>

<Defs>
	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>Artemiish_VtechMachineGun</defName>
		<label>machine gun turret</label>
		<description>A small turret with six rotating barrels produced by Militech.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>GunShotA</shotSound>
		
		<projectile>Bullet_MiniTurret</projectile>
		<reloadTimer>8</reloadTimer>
		<warmUpTimer>2</warmUpTimer>
		
		<chargePerAmmoCount>0.25</chargePerAmmoCount>
		
		<magazineCapacity>75</magazineCapacity>
		<genericAmmo>true</genericAmmo>
		
		<hitFlags>IntendedTarget</hitFlags>
		
		<autoSnapTargeting>false</autoSnapTargeting>
		<rotationSpeed>2</rotationSpeed>
		
		<maxRange>28.9</maxRange>
		
		<recoil>
			<distanceTotal>0.15</distanceTotal>
			<distancePerTick>0.05</distancePerTick>
			<speedMultiplierPostRecoil>0.1</speedMultiplierPostRecoil>
		</recoil>
		
		<fireModes>
			<li>
				<shotsPerBurst>1</shotsPerBurst>
				<ticksBetweenShots>2</ticksBetweenShots>
				<ticksBetweenBursts>2</ticksBetweenBursts>
				<burstsTillWarmup>32</burstsTillWarmup>
				<label>Full Auto</label>
				<texPath>UI/Gizmos/FireRate_Auto</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>ArtemiishThings/Vehicles/Upgrades/MachineGun</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(1.2, 1.2)</drawSize>
		</graphicData>
		
		<ammunition>
			<thingDefs>
				<li>Steel</li>
			</thingDefs>
		</ammunition>
	</Vehicles.VehicleTurretDef>
	
	<Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
		<defName>Artemiish_VtechMissile</defName>
		<label>Swarm missile turret</label>
		<description>A small launcher capable of firing a barrage of missiles.</description>
		
		<turretType>Rotatable</turretType>
		<shotSound>RocketswarmLauncher_Fire</shotSound>
		<reloadSound>Artillery_ShellLoaded</reloadSound>
		
		<projectile>Artemiish_VtechMissileProj</projectile>
		<reloadTimer>12.2</reloadTimer>
		<warmUpTimer>3.6</warmUpTimer>
		<chargePerAmmoCount>10</chargePerAmmoCount>
		
		<magazineCapacity>16</magazineCapacity>
		<genericAmmo>true</genericAmmo>
		
		<hitFlags>IntendedTarget</hitFlags>
		
		<autoSnapTargeting>false</autoSnapTargeting>
		<rotationSpeed>1</rotationSpeed>
		
		<projectileOffset>0.1</projectileOffset>
		
		<minRange>20.9</minRange>
		
		<cooldown>
			<heatPerShot>5</heatPerShot>
			<dissipationRate>0.01667</dissipationRate>
		</cooldown>
		
		<fireModes>
			<li>
				<shotsPerBurst>12</shotsPerBurst>
				<ticksBetweenShots>8</ticksBetweenShots>
				<ticksBetweenBursts>240</ticksBetweenBursts>
				<spreadRadius>10</spreadRadius>
				<label>Burst</label>
				<texPath>UI/Gizmos/FireRate_Burst</texPath>
			</li>
		</fireModes>

		<graphicData>
			<texPath>ArtemiishThings/Vehicles/Upgrades/SwarmMissile</texPath>
			<graphicClass>Vehicles.Graphic_Turret</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(1.2, 1.2)</drawSize>
		</graphicData>
		
		<ammunition>
			<thingDefs>
				<li>Chemfuel</li>
			</thingDefs>
		</ammunition>
		
	</Vehicles.VehicleTurretDef>
	
	<ThingDef ParentName="BaseBullet">
		<defName>Artemiish_VtechMissileProj</defName>
		<label>small missile</label>
		<thingClass>VanillaVehiclesExpanded.Rocket_Scytheman</thingClass>
		<graphicData>
			<texPath>Things/Projectile/Rocket_Swarm</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.8</drawSize>
		</graphicData>
		<projectile>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>10</damageAmountBase>
			<flyOverhead>true</flyOverhead>
			<speed>28</speed>
			<arcHeightFactor>35</arcHeightFactor>
			<explosionRadius>2</explosionRadius>
			<soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
			<soundExplode>Explosion_Rocket</soundExplode>
			<soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
			<soundAmbient>MortarRound_Ambient</soundAmbient>
		</projectile>
		<drawOffscreen>true</drawOffscreen>
	</ThingDef>
	
</Defs>