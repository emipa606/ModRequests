<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>Malnutrition</defName>
    <label>malnutrition</label>
    <description>Abnormally low body fat and weight, typically caused by lack of food. Malnutrition is always very unpleasant, but its initial effects are mild. Without food, though, a malnourished creature will waste away, losing muscle mass and capacities. Malnutrition ends with death.
\nUpon re-feeding malnutrition naturally recovers over time. Malnourished creatures have larger appetites than normal.</description>
    <initialSeverity>0.2</initialSeverity>
    <lethalSeverity>-1</lethalSeverity>
    <maxSeverity>3</maxSeverity>
    <scenarioCanAdd>true</scenarioCanAdd>
    <stages>
      <li>
        <label>trivial</label>
        <socialFightChanceFactor>1.5</socialFightChanceFactor>
        <hungerRateFactorOffset>0.1</hungerRateFactorOffset>
        <capMods>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
        <statFactors>
			<ResearchSpeed>0.8</ResearchSpeed>
			<MiningSpeed>0.8</MiningSpeed>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.5</minSeverity>
        <label>minor</label>
        <socialFightChanceFactor>2</socialFightChanceFactor>
        <hungerRateFactorOffset>0.2</hungerRateFactorOffset>
		<restFallFactor>1.5</restFallFactor>
        <capMods>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>-0.2</offset>
          </li>
          <li>
            <capacity>Talking</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
        <statFactors>
			<ResearchSpeed>0.6</ResearchSpeed>
			<MiningSpeed>0.6</MiningSpeed>
        </statFactors>
        <statOffsets>
			<PainShockThreshold>-0.10</PainShockThreshold>
        </statOffsets>
      </li>
      <li>
        <minSeverity>1.0</minSeverity>
        <label>moderate</label>
        <socialFightChanceFactor>2.5</socialFightChanceFactor>
        <hungerRateFactorOffset>0.3</hungerRateFactorOffset>
		<restFallFactor>2.0</restFallFactor>
        <capMods>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>-0.3</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.2</offset>
          </li>
          <li>
            <capacity>Talking</capacity>
            <offset>-0.3</offset>
          </li>
        </capMods>
        <statFactors>
			<ResearchSpeed>0.45</ResearchSpeed>
			<MiningSpeed>0.45</MiningSpeed>
        </statFactors>
        <statOffsets>
			<PainShockThreshold>-0.20</PainShockThreshold>
        </statOffsets>
      </li>
      <li>
        <minSeverity>2.0</minSeverity>
        <label>severe</label>
        <socialFightChanceFactor>3</socialFightChanceFactor>
        <hungerRateFactorOffset>0.4</hungerRateFactorOffset>
        <restFallFactor>4.0</restFallFactor>
        <capMods>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>-0.4</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.4</offset>
          </li>
          <li>
            <capacity>Talking</capacity>
            <offset>-0.4</offset>
          </li>
        </capMods>
        <statFactors>
			<ResearchSpeed>0.3</ResearchSpeed>
			<MiningSpeed>0.3</MiningSpeed>
        </statFactors>
        <statOffsets>
			<PainShockThreshold>-0.30</PainShockThreshold>
        </statOffsets>
      </li>
      <li>
        <minSeverity>3.0</minSeverity>
        <label>extreme</label>
        <lifeThreatening>true</lifeThreatening>
        <socialFightChanceFactor>3.5</socialFightChanceFactor>
        <hungerRateFactorOffset>0.5</hungerRateFactorOffset>
        <restFallFactor>6.0</restFallFactor>
        <deathMtbDays>3</deathMtbDays>
        <capMods>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>-0.6</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.6</offset>
          </li>
          <li>
            <capacity>Talking</capacity>
            <offset>-0.5</offset>
          </li>
        </capMods>
        <statFactors>
			<ResearchSpeed>0.15</ResearchSpeed>
			<MiningSpeed>0.15</MiningSpeed>
        </statFactors>
        <statOffsets>
			<PainShockThreshold>-0.50</PainShockThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
