<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <AbilityCategoryDef>
    <defName>MDII_Ability</defName>
    <displayOrder>1000</displayOrder>
  </AbilityCategoryDef>

  <AbilityDef>
    <defName>MDII_AbilityChargeBlaster</defName>
    <label>Aiming shot</label>
    <description>A charge blaster in the arm provides precision fire. Although only one shot is fired, it almost always hits the target.</description>
    <iconPath>Things/Abilities/MDII_AbilityGunA</iconPath>
    <category>MDII_Ability</category>
    <displayOrder>200</displayOrder>
    <aiCanUse>true</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0.5</warmupTime>
      <range>35.9</range>
        <soundCast>Shot_ChargeBlaster</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
        <defaultCooldownTime>0.6</defaultCooldownTime>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>MDII_ChargeBullet</projectileDef>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>MDII_AbilitySmoke</defName>
    <label>Smoke grenade</label>
    <description>It fires a built-in smoke grenade.</description>
    <iconPath>Things/Abilities/MDII_AbilitySmoke</iconPath>
    <cooldownTicksRange>90</cooldownTicksRange>
    <category>MDII_Ability</category>
    <displayOrder>200</displayOrder>
    <aiCanUse>false</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0.25</warmupTime>
      <range>16.1</range>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <soundCast>ThrowGrenade</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
        <defaultCooldownTime>1</defaultCooldownTime>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>Bullet_SmokeLauncher</projectileDef>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>MDII_AbilityBlaster</defName>
    <label>Charge shot</label>
    <description>The arm charge blaster is fired at maximum power. It is not used voluntarily due to the dangerous attack with the blast.</description>
    <iconPath>Things/Abilities/MDII_AbilityGunB</iconPath>
    <cooldownTicksRange>480</cooldownTicksRange>
    <category>MDII_Ability</category>
    <displayOrder>200</displayOrder>
    <aiCanUse>false</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>3</warmupTime>
      <range>36.9</range>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <ai_AvoidFriendlyFireRadius>4</ai_AvoidFriendlyFireRadius>
        <soundAiming>OrbitalTargeter_Aiming</soundAiming>
        <soundCast>Shot_ChargeBlaster</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
        <defaultCooldownTime>1.5</defaultCooldownTime>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>MDII_BlasterBullet</projectileDef>
      </li>
    </comps>
  </AbilityDef>

  <ThingDef ParentName="BaseBullet">
    <defName>MDII_BlasterBullet</defName>
    <label>Overcharge blaster shot</label>
    <graphicData>
      <texPath>Things/Projectile/Charge_Small</texPath>
      <drawSize>2.6</drawSize>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <thingClass>Projectile_Explosive</thingClass>
    <projectile>
      <damageDef>Thump</damageDef>
      <explosionRadius>3.5</explosionRadius>
      <damageAmountBase>80</damageAmountBase>
      <armorPenetrationBase>1.5</armorPenetrationBase>
      <stoppingPower>5</stoppingPower>
      <screenShakeFactor>5</screenShakeFactor>
      <speed>200</speed>
    </projectile>
  </ThingDef>

  <AbilityDef>
    <defName>MDII_AbilityRocket</defName>
    <label>HEDP Rocket</label>
    <description>Fires dual-purpose High Explosive rocket that are effective against armored targets. Effective against densely packed enemies and lightly armored mechanoids. It is not used voluntarily due to the dangerous nature of the attack with the blast.</description>
    <iconPath>Things/Abilities/MDII_AbilityRocketA</iconPath>
    <cooldownTicksRange>280</cooldownTicksRange>
    <category>MDII_Ability</category>
    <displayOrder>200</displayOrder>
    <aiCanUse>true</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>1.5</warmupTime>
      <range>41.9</range>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <ai_AvoidFriendlyFireRadius>4</ai_AvoidFriendlyFireRadius>
        <soundCast>ThrowGrenade</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>12</muzzleFlashScale>
        <defaultCooldownTime>1.5</defaultCooldownTime>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>MDII_HEDPRocket</projectileDef>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>MDII_AbilityCluster</defName>
    <label>ClusterRocket</label>
    <description>It fires rockets that contain many bombs. It is a powerful weapon that scatters small bombs at the point of impact and detonates them in a chain reaction. Due to its nature, friendly fire has lethal consequences and is not used voluntarily.</description>
    <iconPath>Things/Abilities/MDII_AbilityRocketB</iconPath>
    <cooldownTicksRange>1200</cooldownTicksRange>
    <category>MDII_Ability</category>
    <displayOrder>200</displayOrder>
    <aiCanUse>false</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>3.5</warmupTime>
      <range>41.9</range>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <ai_AvoidFriendlyFireRadius>8</ai_AvoidFriendlyFireRadius>
        <soundCast>ThrowGrenade</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>12</muzzleFlashScale>
        <defaultCooldownTime>1.5</defaultCooldownTime>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>MDII_ClusterRocket</projectileDef>
      </li>
    </comps>
  </AbilityDef>

</Defs>