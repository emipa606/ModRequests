<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  
  <ThingDef ParentName="BaseWeapon">
    <defName>MDII_MechKnife</defName>
    <label>EI-MechKnife</label>
    <description>This is a large blade made entirely of plasteel. The blade, composed of elaborate monomolecular crystals, has extremely high penetrating power and can cut through heavy armor like a piece of paper. It is standard equipment for the MechDragon series as a melee weapon, but it is designed to be “detachable” in case of emergencies such as a functional failure of the main body, and has a handle for that purpose. However, it seems that space tribes and tribesmen who originally took notice of this function for friendly soldiers sometimes use Mechdragon as a hunting target in order to obtain a powerful weapon.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Weapon/MDII_CSW</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.6</drawSize>
      <drawOffsetNorth>(0.0, 0.0, 0.0)</drawOffsetNorth>
      <drawOffsetEast>(0.15, 0.0, 0.0)</drawOffsetEast>
      <drawOffsetSouth>(0.0, 0.0, 0.0)</drawOffsetSouth>
      <drawOffsetWest>(-0.15, 0.0, 0.0)</drawOffsetWest>
    </graphicData>
    <uiIconScale>1.4</uiIconScale>
    <equippedAngleOffset>-45</equippedAngleOffset>
    <soundInteract>Interact_Rifle</soundInteract>
    <meleeHitSound>MDII_Sword</meleeHitSound>
    <techLevel>Ultra</techLevel>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>3</Beauty>
      <MarketValue>800</MarketValue>
      <Mass>8.5</Mass>
    </statBases>
    <weaponTags Inherit="False">
      <li>None</li>
    </weaponTags>
    <weaponClasses>
      <li>MeleePiercer</li>
      <li>Ultratech</li>
    </weaponClasses>
    <smeltable>false</smeltable>
    <tradeability>Sellable</tradeability>
    <generateCommonality>1</generateCommonality>
    <generateAllowChance>1</generateAllowChance>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>16</power>
        <cooldownTime>1.0</cooldownTime>
      </li>
      <li>
        <label>blade</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>32</power>
        <cooldownTime>0.6</cooldownTime>
        <armorPenetration>1.2</armorPenetration>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>27</power>
        <cooldownTime>0.8</cooldownTime>
        <armorPenetration>1.4</armorPenetration>
      </li>
    </tools>
    <relicChance>0</relicChance>
  </ThingDef>

  <ThingDef ParentName="BaseGun">
    <defName>MDII_MechChargeBlaster</defName>
    <label>EI-ChargeBlaster</label>
    <description>It is a large charge weapon. It is equipped with a highly efficient capacitor and an advanced charging mechanism to increase the energy content of the projectile. Due to its structure, it is not capable of high-speed continuous firing, but it is rather good at continuous shooting and can counter a certain degree of numerical disadvantage. It is equipped as standard equipment in the MechDragon series, but it is designed to be “detachable” in case of emergencies such as a functional failure of the main body, and has a handle for that purpose. However, it seems that space tribes and tribesmen who have originally taken notice of this feature for friendly soldiers sometimes use Mechdragon as a hunting target in order to obtain powerful weapons.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Weapon/MDII_CMG</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.6</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <MarketValue>800</MarketValue>
      <Mass>14.6</Mass>
      <AccuracyTouch>0.52</AccuracyTouch>
      <AccuracyShort>0.68</AccuracyShort>
      <AccuracyMedium>0.82</AccuracyMedium>
      <AccuracyLong>0.75</AccuracyLong>
      <RangedWeapon_Cooldown>1</RangedWeapon_Cooldown>
    </statBases>
    <smeltable>false</smeltable>
    <tradeability>None</tradeability>
    <generateCommonality>1</generateCommonality>
    <generateAllowChance>1</generateAllowChance>
    <weaponTags Inherit="False">
      <li>None</li>
    </weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>MDII_ChargeBullet</defaultProjectile>
        <warmupTime>1.5</warmupTime>
        <range>35.9</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
        <soundCast>Shot_ChargeBlaster</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>18</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>12</power>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <relicChance>0</relicChance>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>MDII_ChargeBullet</defName>
    <label>charge blaster shot</label>
    <graphicData>
      <texPath>Things/Projectile/Charge_Small</texPath>
      <drawSize>1.6</drawSize>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>21</damageAmountBase>
      <armorPenetrationBase>0.5</armorPenetrationBase>
      <stoppingPower>5</stoppingPower>
      <speed>160</speed>
      <extraDamages>
        <li>
          <def>Bomb</def>
          <amount>6</amount>
          <armorPenetration>1</armorPenetration>
          <chance>1</chance>
        </li>
      </extraDamages>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseGun">
    <defName>MDII_MechLauncher</defName>
    <label>EIV-MissileLauncher</label>
    <description>Large missile launcher. The ammunition container is interchangeable for quick reloading. The four-round ammunition container of the standard type is loaded with M31 HEDP effective against mechanoids, but there is also an ammunition container that has the same appearance as the standard type but carries only one powerful cluster missile. It is mounted on some Mechdragons as a firepower support arm, but it is difficult to remove it for operation due to the nature of its armament. However, this is not a limitation if you are willing to compromise on its weight and poor maneuverability.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Weapon/MDII_ML</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.6</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <MarketValue>1000</MarketValue>
      <Mass>18.6</Mass>
      <RangedWeapon_Cooldown>6</RangedWeapon_Cooldown>
    </statBases>
    <smeltable>false</smeltable>
    <tradeability>None</tradeability>
    <generateCommonality>1</generateCommonality>
    <generateAllowChance>1</generateAllowChance>
    <equippedStatOffsets>
      <MoveSpeed>-0.5</MoveSpeed>
    </equippedStatOffsets>
    <weaponTags Inherit="False">
      <li>None</li>
    </weaponTags>
    <verbs>
      <li>
        <label>M31 HEDP</label>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>MDII_HEDPRocket</defaultProjectile>
        <forcedMissRadius>2</forcedMissRadius>
        <ai_AvoidFriendlyFireRadius>3</ai_AvoidFriendlyFireRadius>
        <warmupTime>3.5</warmupTime>
        <range>35.9</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>30</ticksBetweenBurstShots>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <soundCast>ThrowGrenade</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>18</muzzleFlashScale>
      </li>
      <li>
        <label>M46 Cluster</label>
        <verbClass>Verb_LaunchProjectileStatic</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>MDII_ClusterRocket</defaultProjectile>
        <forcedMissRadius>1</forcedMissRadius>
        <ai_AvoidFriendlyFireRadius>8</ai_AvoidFriendlyFireRadius>
        <warmupTime>6</warmupTime>
        <range>38.9</range>
        <onlyManualCast>true</onlyManualCast>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <soundCast>ThrowGrenade</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>21</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>18</power>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <relicChance>0</relicChance>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>MDII_HEDPRocket</defName>
    <label>M31 HEDP</label>
    <graphicData>
      <texPath>Things/Projectile/MDII_STM</texPath>
      <drawSize>1.6</drawSize>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <thingClass>Projectile_Explosive</thingClass>
    <projectile>
      <damageDef>Bomb</damageDef>
      <explosionRadius>2.5</explosionRadius>
      <damageAmountBase>45</damageAmountBase>
      <armorPenetrationBase>0.7</armorPenetrationBase>
      <stoppingPower>3</stoppingPower>
      <speed>75</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>MDII_ClusterRocket</defName>
    <label>M46 Cluster rocket</label>
    <graphicData>
      <texPath>Things/Projectile/MDII_CHM</texPath>
      <drawSize>1.8</drawSize>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <thingClass>Projectile_Explosive</thingClass>
    <projectile>
      <damageDef>CHBomb</damageDef>
      <explosionRadius>7.5</explosionRadius>
      <screenShakeFactor>-1</screenShakeFactor>
      <speed>50</speed>
      <preExplosionSpawnThingDef>MDII_ClusterBomb</preExplosionSpawnThingDef>
      <preExplosionSpawnChance>0.3</preExplosionSpawnChance>
      <flyOverhead>true</flyOverhead>
      <soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
      <soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
      <soundAmbient>MortarRound_Ambient</soundAmbient>
    </projectile>
  </ThingDef>

</Defs>
