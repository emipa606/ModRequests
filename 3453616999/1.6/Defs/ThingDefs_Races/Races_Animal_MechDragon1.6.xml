        </surpriseAttack>
      </li>
      <li>
        <label>Right arm</label>
        <capacities>
          <li>Scratch</li>
          <li>Blunt</li>
        </capacities>
        <cooldownTime>0.5</cooldownTime>
        <armorPenetration>1</armorPenetration>
