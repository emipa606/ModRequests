      <Flammability>0</Flammability>
      <MoveSpeed>6.5</MoveSpeed>
      <MeleeArmorPenetration>1.2</MeleeArmorPenetration>
      <MeleeHitChance>1.2</MeleeHitChance>
      <MeleeDodgeChance>1.2</MeleeDodgeChance>
      <MarketValue>5000</MarketValue>
