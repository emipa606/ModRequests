<Patch>

	<Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Luciferium"]/ingestible/outcomeDoers</xpath>
    <value>
      <li Class="DrugImplant.IngestionOutcomeDoer_BoostLuciImplant">
          <targetImplant>DI_LuciferiumImplant</targetImplant>
        </li>
    </value>
  </Operation>
  
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="GoJuice"]/ingestible/outcomeDoers</xpath>
    <value>
      <li Class="DrugImplant.IngestionOutcomeDoer_BoostGoJuiceImplant">
          <targetImplant>DI_GojuiceImplant</targetImplant>
		  <highDef>GoJuiceHigh</highDef>
        </li>
    </value>
  </Operation>
  
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/StatDef[defName="PainShockThreshold"]/parts</xpath>
    <match Class="PatchOperationAdd">
		<xpath>Defs/StatDef[defName="PainShockThreshold"]/parts</xpath>
		<value>
			<li Class="DrugImplant.StatPart_BeerPain" />
		</value>
	</match>
	<nomatch Class="PatchOperationAdd"> 
		<xpath>Defs/StatDef[defName="PainShockThreshold"]</xpath>
		<value>
			<parts>			
				<li Class="DrugImplant.StatPart_BeerPain" />
			</parts>
		</value>
	</nomatch>
  </Operation>

</Patch>