	<RecipeDef ParentName="SurgeryInstallImplantBase">
		<defName>InstallDI_LastWishImplant</defName>
		<label>install d-implant(Last Wish)</label>
		<description>Install a d-implant.</description>
		<descriptionHyperlinks>
			<ThingDef>DI_LastWishImplant</ThingDef>
			<HediffDef>DI_LastWishImplant</HediffDef>
		</descriptionHyperlinks>
		<jobString>Installing d-implant(Last Wish).</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>DI_LastWishImplant</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>DI_LastWishImplant</li>
			</thingDefs>
		</fixedIngredientFilter>
		<appliedOnFixedBodyParts>
			<li>Brain</li>
		</appliedOnFixedBodyParts>
		<addsHediff>DI_LastWishImplant</addsHediff>
	</RecipeDef>

</Defs>