<Patch>
	
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/HediffDef[defName="DI_LuciferiumImplant_ODMode"]/comps</xpath>
		<value>
			<li Class="HediffCompProperties_ExplodeOnDeath">
				<explosionRadius>5</explosionRadius>
				<damageDef>Bomb</damageDef>
				<damageAmount>25</damageAmount>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/HediffDef[defName="DI_LuciferiumImplant"]/comps</xpath>
		<value>
			<li Class="DrugImplantLuciferiumExpansion.HediffCompProperties_StoreScarlet">
				<fillAmount>150</fillAmount>
				<uiIcon>Things/Building/Production/LuciferiumStorageTank_north</uiIcon>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/HediffDef[defName="DI_LuciferiumImplant_ODMode"]</xpath>
		<value>
			<li Class="DrugImplant.HediffExtension_MinCapacity">
				<activeIfPresent>USH_InnerOrgansWeakening</activeIfPresent>
				<pawnCapacityMinLevels>
					<li>
						<capacity>Moving</capacity>
						<minLevel>1.5</minLevel>
					</li>
					<li>
						<capacity>Manipulation</capacity>
						<minLevel>1.5</minLevel>
					</li>
				</pawnCapacityMinLevels>
			</li>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ResearchProjectDef[defName="LuciferiumRes"]/description</xpath>
		<value>
			<description>Master the art of both creating and managing Luciferium, a drug known across the universe. Unlocks a new ability for those with the Luciferium implant.</description>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="DI_LuciferiumImplant"]/recipeMaker</xpath>
		<value>
			<researchPrerequisite>ScarlettRefining</researchPrerequisite>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="LuciferiumDrops"]</xpath>
		<value>
			<ingestible>
				<foodType>Processed</foodType>
				<preferability>NeverForNutrition</preferability>
				<baseIngestTicks>100</baseIngestTicks>
				<chairSearchRadius>0</chairSearchRadius>
				<nurseable>true</nurseable>
				<drugCategory>Medical</drugCategory>
				<ingestSound>Ingest_Pill</ingestSound>
				<ingestHoldUsesTable>false</ingestHoldUsesTable>
				<ingestCommandString>Take {0}</ingestCommandString>
				<ingestReportString>Taking {0}.</ingestReportString>
				<outcomeDoers>
					<li Class="IngestionOutcomeDoer_OffsetNeed">
						<need>DI_ScarletSludgeNeed</need>
						<offset>0.1</offset>
						<toleranceChemical>Luciferium</toleranceChemical>
					</li>
				</outcomeDoers>
			</ingestible>
			<comps>
				<li Class="CompProperties_Drug">
					<listOrder>105</listOrder>
				</li>
			</comps>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="USH_RedFlicker"]/ingestible/outcomeDoers</xpath>
		<value>
			<!-- <li Class="IngestionOutcomeDoer_OffsetNeed"> -->
			<!-- <need>DI_ScarletSludgeNeed</need> -->
			<!-- <offset>0.1</offset> -->
			<!-- <toleranceChemical>Luciferium</toleranceChemical> -->
			<!-- </li> -->
			<li Class="DrugImplantLuciferiumExpansion.IngestionOutcomeDoer_AdjustHediffSeverity">
				<hediffDef>DI_RedFlickerImplant</hediffDef>
				<severity>1.2</severity>
			</li>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="USH_ScarletEye"]/ingestible/outcomeDoers</xpath>
		<value>
			<!-- <li Class="IngestionOutcomeDoer_OffsetNeed"> -->
			<!-- <need>DI_ScarletSludgeNeed</need> -->
			<!-- <offset>0.1</offset> -->
			<!-- <toleranceChemical>Luciferium</toleranceChemical> -->
			<!-- </li> -->
			<li Class="DrugImplantLuciferiumExpansion.IngestionOutcomeDoer_AdjustHediffSeverity">
				<hediffDef>DI_ScarletEyeImplant</hediffDef>
				<severity>1.2</severity>
			</li>
		</value>
	</Operation>
