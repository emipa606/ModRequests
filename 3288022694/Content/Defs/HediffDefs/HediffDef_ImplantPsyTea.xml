<Defs>

	<ThingDef ParentName="DrugImplantThingMakeableBase">
		<defName>DI_PsychiteImplant</defName>
		<label>drug-implant (Psychite tea)</label>
		<description>A synthesizer , encoded to produce Psychite from nutrients the user eats. The user will need to eat more to sustain themselves as a consequence. The brain requires time to neurologically adapt to the constant presence of the drug, causing complications until the brain has adapted.

Once adapted, the synthesizer consistently releases small traces of Psychite directly into the brain, giving them energy and dulling pain slightly. The user gains pain tolerance and restores their Rest need by 5% every 30 seconds.</description>
		<descriptionHyperlinks>
			<RecipeDef>InstallDI_PsychiteImplant</RecipeDef>
		</descriptionHyperlinks>
		<techLevel>Spacer</techLevel>
		<graphicData>
			<texPath>Things/Item/Health/HealthItem</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.80</drawSize>
			<color>(189,169,118)</color>
		</graphicData>
		<statBases>
			<MarketValue>400</MarketValue>
		</statBases>
		<costList>
			<PsychiteTea>10</PsychiteTea>
			<DI_BaseImplantPart>1</DI_BaseImplantPart>
		</costList>
		<recipeMaker>
			<recipeUsers Inherit="False">
				<li>DrugLab</li>
			</recipeUsers>
			<researchPrerequisites>
				<li>PsychoidBrewing</li>
			</researchPrerequisites>
		</recipeMaker>
		<thingCategories>
			<li>BodyParts</li>
		</thingCategories>
	</ThingDef>
	
	<HediffDef ParentName="ImplantHediffBase">
