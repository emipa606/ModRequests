			</li>
			<li>
				<compClass>DrugImplant.HediffComp_SeverityTracker</compClass>
			</li>
			<li Class="DrugImplant.HediffCompProperties_DrugGeneTracker" MayRequire="ludeon.rimworld.biotech">
				<resistanceGeneDef>AddictionResistant_Psychite</resistanceGeneDef>
				<immuneGeneDef>AddictionImmune_Psychite</immuneGeneDef>
				<dependencyGeneDef>ChemicalDependency_Psychite</dependencyGeneDef>
			</li>
		</comps>
		<stages>
			<li>
				<minSeverity>0.01</minSeverity>
