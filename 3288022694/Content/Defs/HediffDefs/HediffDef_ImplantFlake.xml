	<RecipeDef ParentName="SurgeryInstallImplantBase">
		<defName>InstallDI_FlakeImplant</defName>
		<label>install d-implant(Flake)</label>
		<description>Install a d-implant.</description>
		<workerClass>DrugImplant.Recipe_InstallImplantCondition</workerClass>
		<descriptionHyperlinks>
