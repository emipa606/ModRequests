<Defs>	
	
	<ThingDef ParentName="DrugImplantThingMakeableBase">
		<defName>DI_AmbrosiaImplant</defName>
		<label>drug-implant (Ambrosia)</label>
		<description>A synthesizer, encoded to produce Ambrosia from waste products in the body. The brain requires time to neurologically adapt to the constant presence of the drug, causing complications until the brain has adapted.

Once adapted, the synthesizer traces the user’s spit with Ambrosia that mixes with food that they eat, which helps bring out the flavor and nutrition from food. Meals eaten by this pawn gain increased nutrition and provide a mood buff for a time.</description>
		<descriptionHyperlinks>
			<RecipeDef>InstallDI_AmbrosiaImplant</RecipeDef>
		</descriptionHyperlinks>
		<techLevel>Spacer</techLevel>
		<graphicData>
			<texPath>Things/Item/Health/HealthItem</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.80</drawSize>
			<color>(189,169,118)</color>
		</graphicData>
		<statBases>
			<MarketValue>400</MarketValue>
		</statBases>
		<costList>
			<Ambrosia>100</Ambrosia>
			<DI_BaseImplantPart>1</DI_BaseImplantPart>
		</costList>
		<recipeMaker>
			<recipeUsers Inherit="False">
				<li>DrugLab</li>
			</recipeUsers>
		</recipeMaker>
		<thingCategories>
			<li>BodyParts</li>
		</thingCategories>
	</ThingDef>
