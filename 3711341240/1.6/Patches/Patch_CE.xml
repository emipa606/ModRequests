<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>

        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[@Name="MUG_ThrowableBase"]/statBases</xpath>
          <value>
            <Bulk>0.3</Bulk>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="MUG_Proj_Fragment"]/projectile/armorPenetrationBase</xpath>
          <value>
            <armorPenetrationBase>12</armorPenetrationBase>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="MUG_Proj_C4Explosive"]/projectile/armorPenetrationBase</xpath>
          <value>
            <armorPenetrationBase>240</armorPenetrationBase>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="MUG_Proj_DataKnife"]/projectile/armorPenetrationBase</xpath>
          <value>
            <armorPenetrationBase>450</armorPenetrationBase>
          </value>
        </li>

      </operations>
    </match>
  </Operation>
</Patch>