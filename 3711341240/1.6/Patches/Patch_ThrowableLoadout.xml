<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <nomatch Class="PatchOperationSequence">
      <operations>

        <li Class="PatchOperationInsert">
          <xpath>Defs/ThinkTreeDef[defName="Humanlike"]//li[@Class="ThinkNode_Tagger"][tagToGive="TakeForInventoryStock"]</xpath>
          <order>Append</order>
          <value>
            <li Class="ThinkNode_Tagger">
              <tagToGive>TakeForInventoryStock</tagToGive>
              <subNodes>
                <li Class="More_Useful_Grenade.JobGiver_TakeThrowableLoadout">
                  <leaveJoinableLordIfIssuesJob>true</leaveJoinableLordIfIssuesJob>
                </li>
              </subNodes>
            </li>
          </value>
        </li>

        <li Class="PatchOperationInsert">
          <xpath>Defs/PawnTableDef[defName="Assign"]/columns/li[text()="DrugPolicy"]</xpath>
          <order>Append</order>
          <value>
            <li>GapTiny</li>
            <li>MUG_ThrowableLoadout</li>
          </value>
        </li>

      </operations>
    </nomatch>
  </Operation>

</Patch>