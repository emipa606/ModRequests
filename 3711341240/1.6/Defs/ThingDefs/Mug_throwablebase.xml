<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 投掷物基类 -->
  <ThingDef Name="MUG_ThrowableBase" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <drawerType>MapMeshOnly</drawerType>
    <altitudeLayer>Item</altitudeLayer>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <alwaysHaulable>true</alwaysHaulable>
    <drawGUIOverlay>true</drawGUIOverlay>
    <rotatable>false</rotatable>
    <pathCost>14</pathCost>
    <tickerType>Never</tickerType>
    <stackLimit>10</stackLimit>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <techLevel>Industrial</techLevel>
    <equipmentType>None</equipmentType>
    <orderedTakeGroup>MUG_Grenade</orderedTakeGroup>

    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Mass>0.5</Mass>
      <Flammability>0.4</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
    </statBases>

    <thingCategories>
      <li>Grenades</li>
    </thingCategories>

    <tradeTags>
      <li>MortarShell</li>
    </tradeTags>

    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="More_Useful_Grenade.CompProperties_Throwable" />
    </comps>
  </ThingDef>

  <!-- 投掷物弹体基类 -->
  <ThingDef Name="MUG_ProjectileBase" Abstract="True" ParentName="BaseGrenadeProjectile">
    <thingClass>Projectile_Explosive</thingClass>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Projectile/Grenade</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
    </graphicData>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>50</damageAmountBase>
      <explosionRadius>2.5</explosionRadius>
      <speed>20</speed>
      <arcHeightFactor>2.0</arcHeightFactor>
      <shadowSize>0.4</shadowSize>
      <soundExplode>Explosion_Bomb</soundExplode>
      <spinRate>5</spinRate>
    </projectile>
  </ThingDef>

</Defs>