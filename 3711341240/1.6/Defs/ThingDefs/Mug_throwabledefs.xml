<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <DamageDef>
    <defName>MUG_DamageC4Blast</defName>
    <label>C4 blast</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <harmsHealth>true</harmsHealth>
    <makesBlood>true</makesBlood>
    <canInterruptJobs>true</canInterruptJobs>
    <makesAnimalsFlee>true</makesAnimalsFlee>
    <buildingDamageFactor>15</buildingDamageFactor>
    <buildingDamageFactorImpassable>5</buildingDamageFactorImpassable>
    <isExplosive>true</isExplosive>
    <hasForcefulImpact>true</hasForcefulImpact>
    <hediff>Shredded</hediff>
    <hediffSkin>Shredded</hediffSkin>
    <hediffSolid>Crack</hediffSolid>
    <armorCategory>Sharp</armorCategory>
    <soundExplosion>Explosion_Bomb</soundExplosion>
    <explosionCellFleck>ExplosionFlash</explosionCellFleck>
    <explosionColorCenter>(1, 0.95, 0.8, 1)</explosionColorCenter>
    <explosionColorEdge>(1, 0.5, 0.15, 1)</explosionColorEdge>
    <explosionHeatEnergyPerCell>30</explosionHeatEnergyPerCell>
    <defaultDamage>200</defaultDamage>
    <defaultArmorPenetration>1.6</defaultArmorPenetration>
  </DamageDef>


  <!-- 破片手雷 -->
  <ThingDef ParentName="BaseGrenadeProjectile">
    <defName>MUG_Proj_FragGrenade</defName>
    <label>frag grenade</label>
    <thingClass>More_Useful_Grenade.Projectile_FragGrenade</thingClass>
    <graphicData>
      <texPath>Things/Projectile/MUG_FragGrenade_Projectile</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>0.5</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>65</damageAmountBase>
      <explosionRadius>1.5</explosionRadius>
      <speed>26</speed>
      <arcHeightFactor>2.0</arcHeightFactor>
      <shadowSize>0.4</shadowSize>
      <explosionDelay>45</explosionDelay>
      <soundExplode>Explosion_Bomb</soundExplode>
      <spinRate>5</spinRate>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>MUG_Proj_Fragment</defName>
