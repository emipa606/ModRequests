      <damageDef>Cut</damageDef>
      <damageAmountBase>6</damageAmountBase>
      <armorPenetrationBase>0.30</armorPenetrationBase>
      <speed>50</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="MUG_ThrowableBase">
    <defName>MUG_FragGrenade</defName>
    <label>frag grenade</label>
    <description>A fairly standard fragmentation grenade. Upon detonation, alongside the basic explosive shockwave, it scatters a lethal spray of sharp shrapnel in all directions, further expanding its kill zone.

The flying shrapnel makes it highly effective at clearing out unarmored or lightly armored targets, but it falls short against heavily armored foes.

"A shotgun can turn you into a sieve, and so can this."</description>
    <graphicData>
      <texPath>Things/Item/MUG_FragGrenade</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Mass>0.5</Mass>
    </statBases>
    <verbs>
      <li>
        <label>throw frag grenade</label>
        <verbClass>More_Useful_Grenade.Verb_ThrowFromInventory</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <onlyManualCast>true</onlyManualCast>
        <violent>true</violent>
        <targetable>true</targetable>
        <range>19.9</range>
        <forcedMissRadius>1.5</forcedMissRadius>
        <warmupTime>0.7</warmupTime>
        <burstShotCount>1</burstShotCount>
        <canGoWild>false</canGoWild>
        <noiseRadius>5</noiseRadius>
        <soundCast>ThrowGrenade</soundCast>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <defaultProjectile>MUG_Proj_FragGrenade</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
  </ThingDef>


