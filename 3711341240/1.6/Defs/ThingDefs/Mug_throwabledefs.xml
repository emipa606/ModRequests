  <ThingDef ParentName="MUG_ThrowableBase">
    <defName>MUG_C4Explosive</defName>
    <label>C4 explosive</label>
    <description>A specially modified block of highly volatile plastic explosive with staggering power and devastating destructive force against structures. To ensure the user's safety, its delayed fuse has been extended.

Its special adhesive casing allows it not only to stick to walls for directional breaching, but also to attach directly to mobile units if hit when thrown, detonating after a delay for extra lethal effect.

"The only connection it has to C4 is its appearance. Classics never go out of style."</description>
    <graphicData>
      <texPath>Things/Item/MUG_C4Explosive</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Mass>0.8</Mass>
    </statBases>
    <verbs>
      <li>
        <label>throw C4</label>
        <verbClass>More_Useful_Grenade.Verb_ThrowFromInventory</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <onlyManualCast>true</onlyManualCast>
        <violent>true</violent>
        <targetable>true</targetable>
        <range>18.9</range>
        <forcedMissRadius>1.0</forcedMissRadius>
        <warmupTime>0.8</warmupTime>
        <burstShotCount>1</burstShotCount>
        <canGoWild>false</canGoWild>
        <noiseRadius>5</noiseRadius>
        <soundCast>ThrowGrenade</soundCast>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <defaultProjectile>MUG_Proj_C4Explosive</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
  </ThingDef>


