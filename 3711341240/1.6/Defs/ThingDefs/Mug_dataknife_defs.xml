<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 数据飞刀 弹体 -->
  <ThingDef>
    <defName>MUG_Proj_DataKnife</defName>
    <label>data knife</label>
    <thingClass>More_Useful_Grenade.DataKnifeProjectile</thingClass>
    <category>Projectile</category>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Projectile</altitudeLayer>
    <useHitPoints>false</useHitPoints>
    <neverMultiSelect>true</neverMultiSelect>
    <graphicData>
      <texPath>Things/Projectile/MUG_DataKnife_Projectile</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>1</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Cut</damageDef>
      <damageAmountBase>30</damageAmountBase>
      <armorPenetrationBase>3.0</armorPenetrationBase>
      <speed>50</speed>
      <arcHeightFactor>0</arcHeightFactor>
      <shadowSize>0.2</shadowSize>
      <flyOverhead>false</flyOverhead>
      <spinRate>0</spinRate>
    </projectile>
  </ThingDef>


  <!-- 数据飞刀 物品 -->
  <ThingDef ParentName="MUG_ThrowableBase">
    <defName>MUG_DataKnife</defName>
    <label>data knife</label>
    <description>A cutting-edge tactical weapon with electromagnetic pulse and hacking circuits embedded within its blade. When thrown, it flies in a straight line with astonishing precision, bypassing conventional projectile interception systems to directly cripple and severely damage the target.

It can instantly overload and shatter most forms of energy shields. The powerful EMP released upon impact completely shuts down mechanoids and turrets, while the resulting interference field temporarily disrupts ability casting and cloaking effects for the target and surrounding units.

"Hah, a reality-editing tech version of a DDoS, kid."</description>
    <graphicData>
      <texPath>Things/Item/MUG_DataKnife</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Mass>0.3</Mass>
    </statBases>
    <verbs>
      <li>
        <label>throw data knife</label>
        <verbClass>More_Useful_Grenade.Verb_ThrowDataKnife</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <onlyManualCast>true</onlyManualCast>
        <violent>true</violent>
        <targetable>true</targetable>
        <range>36</range>
        <warmupTime>0.3</warmupTime>
        <burstShotCount>1</burstShotCount>
        <canGoWild>false</canGoWild>
        <noiseRadius>3</noiseRadius>
        <soundCast>ThrowGrenade</soundCast>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <defaultProjectile>MUG_Proj_DataKnife</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
  </ThingDef>


  <!-- 数据飞刀 过载伤害 -->
  <DamageDef>
    <defName>MUG_DamageOverload</defName>
    <label>data overload</label>
    <workerClass>DamageWorker</workerClass>
    <isRanged>true</isRanged>
    <harmsHealth>true</harmsHealth>
    <armorCategory>Sharp</armorCategory>
    <defaultDamage>99999</defaultDamage>
    <defaultArmorPenetration>2.0</defaultArmorPenetration>
    <canInterruptJobs>false</canInterruptJobs>
    <makesBlood>false</makesBlood>
    <makesAnimalsFlee>false</makesAnimalsFlee>
    <externalViolence>false</externalViolence>
    <isExplosive>false</isExplosive>
    <buildingDamageFactor>0</buildingDamageFactor>
    <plantDamageFactor>0</plantDamageFactor>
  </DamageDef>

</Defs>