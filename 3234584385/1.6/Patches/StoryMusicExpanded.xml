<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/SongDef[clipPath="StoryMusicExpanded/Life_and_Death_from_Pirate"]</xpath>
        <value>
            <li Class="ConfigurableMusicPlayer.MusicPlayDefExtension">
                <tenseFaction>Pirate</tenseFaction>
            </li>
        </value>
    </Operation>
<Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/SongDef[clipPath="StoryMusicExpanded/The_farthest_hometown"]</xpath>
        <value>
            <li Class="ConfigurableMusicPlayer.MusicPlayDefExtension">
                <tenseFaction>Outlander</tenseFaction>
            </li>
        </value>
    </Operation>
<Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/SongDef[clipPath="StoryMusicExpanded/mano_a_mano_with_Tribe"]</xpath>
        <value>
            <li Class="ConfigurableMusicPlayer.MusicPlayDefExtension">
                <tenseFaction>Tribe</tenseFaction>
            </li>
        </value>
    </Operation>
<Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/SongDef[clipPath="StoryMusicExpanded/Ray"]</xpath>
        <value>
            <li Class="ConfigurableMusicPlayer.MusicPlayDefExtension">
                <tenseFaction>Mechanoid</tenseFaction>
            </li>
        </value>
    </Operation>
<Operation Class="PatchOperationAddModExtension">
        <xpath>Defs/SongDef[clipPath="StoryMusicExpanded/Forced_landing"]</xpath>
        <value>
            <li Class="ConfigurableMusicPlayer.MusicPlayDefExtension">
                <isStarterSong>True</isStarterSong>
            </li>
        </value>
    </Operation>
    <!-- 处理 SongDef[clipPath="StoryMusicExpanded/Ray"] -->
    <Operation Class="PatchOperationConditional">
        <xpath>Defs/SongDef[clipPath="StoryMusicExpanded/Ray"]/commonality</xpath>
        <match Class="PatchOperationReplace">
            <xpath>Defs/SongDef[clipPath="StoryMusicExpanded/Ray"]/commonality</xpath>
            <value>
                <commonality>10.0</commonality>
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/SongDef[clipPath="StoryMusicExpanded/Ray"]</xpath>
            <value>
                <commonality>10.0</commonality>
            </value>
        </nomatch>
    </Operation>

    <!-- 处理 SongDef[clipPath="StoryMusicExpanded/mano_a_mano_with_Tribe"] -->
    <Operation Class="PatchOperationConditional">
        <xpath>Defs/SongDef[clipPath="StoryMusicExpanded/mano_a_mano_with_Tribe"]/commonality</xpath>
        <match Class="PatchOperationReplace">
            <xpath>Defs/SongDef[clipPath="StoryMusicExpanded/mano_a_mano_with_Tribe"]/commonality</xpath>
            <value>
                <commonality>10.0</commonality>
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/SongDef[clipPath="StoryMusicExpanded/mano_a_mano_with_Tribe"]</xpath>
            <value>
                <commonality>10.0</commonality>
            </value>
        </nomatch>
    </Operation>

    <!-- 假设其他两个 clipPath 也需要添加相同的标签 -->
    <Operation Class="PatchOperationConditional">
        <xpath>Defs/SongDef[clipPath="StoryMusicExpanded/Life_and_Death_from_Pirate"]/commonality</xpath>
        <match Class="PatchOperationReplace">
            <xpath>Defs/SongDef[clipPath="StoryMusicExpanded/Life_and_Death_from_Pirate"]/commonality</xpath>
            <value>
                <commonality>10.0</commonality>
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/SongDef[clipPath="StoryMusicExpanded/Life_and_Death_from_Pirate"]</xpath>
            <value>
                <commonality>10.0</commonality>
            </value>
        </nomatch>
    </Operation>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/SongDef[clipPath="StoryMusicExpanded/The_farthest_hometown"]/commonality</xpath>
        <match Class="PatchOperationReplace">
            <xpath>Defs/SongDef[clipPath="StoryMusicExpanded/The_farthest_hometown"]/commonality</xpath>
            <value>
                <commonality>10.0</commonality>
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/SongDef[clipPath="StoryMusicExpanded/The_farthest_hometown"]</xpath>
            <value>
                <commonality>10.0</commonality>
            </value>
        </nomatch>
    </Operation>
</Patch>
