<?xml version="1.0" encoding="utf-8" ?>
<Patch>
<!-- Creep Xenotypes -->

<Operation Class="PatchOperationSequence">
<operations>

<li MayRequire="Ludeon.RimWorld.Anomaly" Class="PatchOperationAdd">
	<xpath>Defs/CreepJoinerFormKindDef[defName="DarkScholar" or defName="CultEscapee"]</xpath>
	  <value>
		<xenotypeSet>
			<xenotypeChances>
				<Hussar>0.05</Hussar>
				<Dirtmole>0.05</Dirtmole>
				<Genie>0.025</Genie>
				<Neanderthal>0.025</Neanderthal>
				<Kitul>0.05</Kitul>
				<Prole>.05</Prole>
				<Nizai>.05</Nizai>
				<Gwennin>.05</Gwennin>
			</xenotypeChances>
		</xenotypeSet>
	  </value>
</li>

<li MayRequire="Ludeon.RimWorld.Anomaly" Class="PatchOperationAdd">
	<xpath>Defs/CreepJoinerFormKindDef[defName="DealMaker" or defName="TimelessOne"]</xpath>
	  <value>
		<xenotypeSet>
			<xenotypeChances>
				<Sanguophage>0.20</Sanguophage>
			</xenotypeChances>
		</xenotypeSet>
	  </value>
</li>

<li MayRequire="Ludeon.RimWorld.Anomaly" Class="PatchOperationAdd">
	<xpath>Defs/CreepJoinerFormKindDef[defName="CreepDrifter" or defName="LeatheryStranger"]</xpath>
	  <value>
		<xenotypeSet>
			<xenotypeChances>
				<Waster>0.04</Waster>
				<Hussar>0.04</Hussar>
				<Dirtmole>0.04</Dirtmole>
				<Neanderthal>0.04</Neanderthal>
				<Genie>0.04</Genie>
				<Pigskin>0.04</Pigskin>
				<Yttakin>0.04</Yttakin>
				<Impid>0.04</Impid>
				<Sanguophage>0.04</Sanguophage>
				<Nizai>.04</Nizai>
				<Kitul>.04</Kitul>
				<Gwennin>.04</Gwennin>
				<Prole>.04</Prole>
				<Artemid>.04</Artemid>
			</xenotypeChances>
		</xenotypeSet>
	  </value>
</li>

<li MayRequire="Ludeon.RimWorld.Anomaly" Class="PatchOperationAdd">
	<xpath>Defs/CreepJoinerFormKindDef[defName="Blindhealer"]</xpath>
	  <value>
		<xenotypeSet>
			<xenotypeChances>
				<Dirtmole>0.1</Dirtmole>
				<Neanderthal>0.05</Neanderthal>
				<Pigskin>0.05</Pigskin>
				<Impid>0.05</Impid>
				<Yttakin>0.05</Yttakin>
				<Kitul>0.1</Kitul>
				<Prole>0.1</Prole>
				<Gwennin>0.1</Gwennin>
			</xenotypeChances>
		</xenotypeSet>
	  </value>
</li>

<li MayRequire="Ludeon.RimWorld.Anomaly" Class="PatchOperationAdd">
	<xpath>Defs/CreepJoinerFormKindDef[defName="LoneGenius"]</xpath>
	  <value>
		<xenotypeSet>
			<xenotypeChances>
				<Waster>0.025</Waster>
				<Dirtmole>0.025</Dirtmole>
				<Genie>0.10</Genie>
				<Impid>0.025</Impid>
				<Sanguophage>0.025</Sanguophage>
				<Nizai>.05</Nizai>
				<Kitul>.025</Kitul>
				<Gwennin>.025</Gwennin>
				<Artemid>.05</Artemid>
			</xenotypeChances>
		</xenotypeSet>
	  </value>
</li>
	  
</operations>
</Operation>

</Patch>