<?xml version="1.0" encoding="utf-8" ?>
<Patch>
<Operation Class="PatchOperationSequence">
  <operations>
<li MayRequire="Ludeon.RimWorld.Ideology" Class="PatchOperationAdd">
	<xpath>Defs/FactionDef[defName="Beggars" or defName="Pilgrims"]/xenotypeSet/xenotypeChances</xpath>
	  <value>
	    <Reaper>0.025</Reaper>
	    <Artemid>.05</Artemid>
	    <Kitul>.05</Kitul>
	    <Gwennin>.05</Gwennin>
	  </value>
</li>

<li MayRequire="Ludeon.RimWorld.Royalty" Class="PatchOperationAdd">
	<xpath>Defs/FactionDef[defName="OutlanderRefugee"]/xenotypeSet/xenotypeChances</xpath>
	  <value>
	    <Reaper>0.025</Reaper>
	    <Artemid>.05</Artemid>
	    <Kitul>.05</Kitul>
	    <Gwennin>.05</Gwennin>
	    <Nizai>.05</Nizai>
	  </value>
</li>

<li MayRequire="Ludeon.RimWorld.Royalty" Class="PatchOperationAdd">
	<xpath>Defs/FactionDef[defName="Empire"]/xenotypeSet/xenotypeChances</xpath>
	  <value>
		<Nizai>0.15</Nizai>
		<Prole>0.025</Prole>
	  </value>
</li>
	  
<li MayRequire="Ludeon.RimWorld.Royalty" Class="PatchOperationAdd">
	<xpath>Defs/FactionDef[defName="Empire"]/permanentEnemyToEveryoneExcept</xpath>
	  <value>
      <li>TribeCivilCustomVaried</li>
      <li>OutlanderMulticultural</li>
      <li>OutlanderMulticulturalRough</li>
      <li>MulticulturalPirates</li>
      <li>PirateWasterMulti</li>
      <li>PirateYttakinCustom</li>
	  </value>
</li>

<li Class="PatchOperationAdd">
	<xpath>Defs/FactionDef[@Name="AncientsBase"]</xpath>
	  <value>
	    <xenotypeSet>
			<xenotypeChances>
				<Waster>0.04</Waster>
				<Hussar>0.04</Hussar>
				<Dirtmole>0.04</Dirtmole>
				<Neanderthal>0.04</Neanderthal>
				<Genie>0.04</Genie>
				<Pigskin>0.04</Pigskin>
				<Yttakin>0.04</Yttakin>
				<Impid>0.04</Impid>
				<Nizai>.04</Nizai>
				<Kitul>.04</Kitul>
				<Gwennin>.04</Gwennin>
				<Prole>.04</Prole>
				<Artemid>.04</Artemid>
				<Sanguophage>.04</Sanguophage>
			</xenotypeChances>
		</xenotypeSet>
	  </value>
    </li>
</operations>
</Operation>
</Patch>