<?xml version="1.0" encoding="utf-8" ?>
<Patch>

<!--Adds custom xenotypes from other mod to new factions-->

<Operation Class="PatchOperationSequence">
<operations>

 <li MayRequire="Ludeon.RimWorld.Anomaly" Class="PatchOperationAdd">
	<xpath>Defs/PawnKindDef[@Name="HoraxianBase"]/xenotypeSet/xenotypeChances</xpath>
	  <value>
	    <Kitul>0.05</Kitul>
	    <Prole>.05</Prole>
	    <Nizai>.05</Nizai>
	    <Gwennin>.05</Gwennin>
	  </value>
</li>

<li MayRequire="Ludeon.RimWorld.Anomaly" Class="PatchOperationAdd">
	<xpath>Defs/PawnKindDef[@Name="MutantBase"]/xenotypeSet/xenotypeChances</xpath>
	  <value>
	    <Kitul>0.025</Kitul>
	    <Prole>.025</Prole>
	    <Nizai>.025</Nizai>
	    <Gwennin>.025</Gwennin>
	    <Artemid>.025</Artemid>
	  </value>
</li>

</operations>
</Operation>

</Patch>