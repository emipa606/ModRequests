  <!-- Mech Beacon -->

    <ThingDef ParentName="BuildingBase" Name="BaseEDF_MechBeacon" Abstract="True">
    <graphicData>	
      <texPath>Things/Building/EDF_MiniBeacon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2)</drawSize>
    </graphicData>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <castEdgeShadows>False</castEdgeShadows>
    <passability>PassThroughOnly</passability>
    <blockWind>false</blockWind>
    <fillPercent>0.1</fillPercent>
    <pathCost>20</pathCost>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <repairEffect>ConstructMetal</repairEffect>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>10</WorkToBuild>
      <Mass>1</Mass>
      <Flammability>0</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <building>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <size>(1,1)</size>
    <costList></costList>
  </ThingDef>

    <ThingDef ParentName="BaseEDF_MechBeacon">
    <defName>EDF_MechBeacon_A</defName>
    <label>EDF MechBeacon</label>
    <description>A beacon to mark the descent point. After transmitting a signal, it destroys itself in a short period of time.</description>
    <comps>
      <li Class="CompProperties_Initiatable" />
      <li Class="CompProperties_PawnSpawnOnWakeup">
        <points>1500</points>
        <dropInPods>True</dropInPods>
        <pawnSpawnRadius>1</pawnSpawnRadius>
        <spawnablePawnKinds>
          <li>Mech_EDF_NixInstant_A</li>
        </spawnablePawnKinds>
        <spawnSound>OrbitalTargeter_Fire</spawnSound>
        <lordJob>LordJob_MechanoidsDefend</lordJob>
        <shouldJoinParentLord>true</shouldJoinParentLord>
      </li>
      <li Class="CompProperties_Lifespan">
        <lifespanTicks>30</lifespanTicks>
      </li>
    </comps>
  </ThingDef>

