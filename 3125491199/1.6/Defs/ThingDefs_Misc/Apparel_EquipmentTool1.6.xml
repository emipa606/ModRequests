  <!-- Mini light -->

    <ThingDef ParentName="BaseEDF_MechBeacon">
    <defName>EDF_Minilight</defName>
    <label>EDF disposable light</label>
    <description>A small light that emits light from an internal power source. Destroys itself when power is lost.</description>
    <graphicData>	
      <texPath>Things/Building/EDF_Minilight</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2)</drawSize>
    </graphicData>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>6</glowRadius>
        <glowColor>(255,117,108,0)</glowColor>
      </li>
      <li Class="CompProperties_Lifespan">
        <lifespanTicks>48000</lifespanTicks>
      </li>
