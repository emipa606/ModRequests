<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Bace -->

  <ThingDef ParentName="ApparelNoQualityBase" Name="BaseEDF_BeaconPack" Abstract="True">
    <tradeability>Sellable</tradeability>
    <graphicData>
      <texPath>Things/Apparel/Equipment/EDF_BeaconGunB</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.3</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>10000</WorkToMake>
      <Mass>2</Mass>
      <Flammability>0.2</Flammability>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <tickerType>Normal</tickerType>
    <equippedStatOffsets>
      <MoveSpeed>-0.1</MoveSpeed>
    </equippedStatOffsets>
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <scoreOffset>4</scoreOffset>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups>
        <li>Arms</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <tags Inherit="False">
        <li>EDF</li>
      </tags>
        <defaultOutfitTags Inherit="False">
          <li>EDF</li>
        </defaultOutfitTags>
    </apparel>
  </ThingDef>

  <!-- Flare Gun -->

  <ThingDef ParentName="BaseEDF_BeaconPack">
    <defName>EDF_FlareGun</defName>
    <label>Flare Gun</label>
    <description>A special gun that ejects disposable lights. Useful for searching in dark places. It is only for lighting and cannot be used like a flash bang.</description>
    <graphicData>
      <texPath>Things/Apparel/Equipment/EDF_BeaconGunA</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.3</drawSize>
    </graphicData>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_ApparelReloadable">
        <maxCharges>15</maxCharges>
        <ammoDef>Steel</ammoDef>
        <ammoCountPerCharge>3</ammoCountPerCharge>
        <baseReloadTicks>60</baseReloadTicks>
        <soundReload>Standard_Reload</soundReload>
        <hotKey>Misc4</hotKey>
        <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
      </li>
    </comps>
    <verbs>
      <li>
        <verbClass>Verb_LaunchProjectileStatic</verbClass>
        <label>deploy light</label>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Proj_EDFMinilight</defaultProjectile>
        <warmupTime>1.0</warmupTime>
        <range>12.9</range>
        <burstShotCount>1</burstShotCount>
        <onlyManualCast>True</onlyManualCast>
        <targetable>true</targetable>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
          <canTargetPawns>false</canTargetPawns>
          <canTargetBuildings>false</canTargetBuildings>
        </targetParams>
        <soundCast>ThrowGrenade</soundCast>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedPack</unfinishedThingDef>
      <researchPrerequisite>EDF_TI</researchPrerequisite>
      <skillRequirements>
        <Crafting>12</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>EDF_FabricBench</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="BaseGrenadeProjectile">
    <defName>Proj_EDFMinilight</defName>
    <label>Mini light</label>
    <thingClass>Projectile_SpawnsThing</thingClass>
    <graphicData>
      <texPath>Things/Projectile/EDF_LPB</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <projectile>
      <speed>65</speed>
      <spawnsThingDef>EDF_Minilight</spawnsThingDef>
      <tryAdjacentFreeSpaces>true</tryAdjacentFreeSpaces>
    </projectile>
  </ThingDef>

