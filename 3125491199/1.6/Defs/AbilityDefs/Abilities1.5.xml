<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <AbilityCategoryDef>
    <defName>EDF_Ability</defName>
    <displayOrder>1000</displayOrder>
  </AbilityCategoryDef>

  <AbilityDef>
    <defName>EDF_AbilityAcidA</defName>
    <label>Acid shot</label>
    <description>It attacks by spitting out powerful acid.</description>
    <iconPath>Things/Abilities/EDF_AbilityAcidA</iconPath>
    <cooldownTicksRange>480</cooldownTicksRange>
    <category>EDF_Ability</category>
    <displayOrder>200</displayOrder>
    <aiCanUse>true</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0.5</warmupTime>
      <range>11.9</range>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <ai_AvoidFriendlyFireRadius>4</ai_AvoidFriendlyFireRadius>
        <muzzleFlashScale>0</muzzleFlashScale>
        <defaultCooldownTime>3.5</defaultCooldownTime>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>EDF_AcidSpitA</projectileDef>
      </li>
    </comps>
  </AbilityDef>

  <ThingDef ParentName="BaseBullet">
    <defName>EDF_AcidSpitA</defName>
    <label>Acid</label>
    <graphicData>
      <texPath>Things/Projectile/EDF_Acid</texPath>
      <drawSize>2</drawSize>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingClass>Projectile_Explosive</thingClass>
    <projectile>
      <damageDef>EDF_Acid</damageDef>
      <explosionRadius>2.5</explosionRadius>
      <damageAmountBase>10</damageAmountBase>
      <armorPenetrationBase>0.3</armorPenetrationBase>
      <stoppingPower>1</stoppingPower>
      <screenShakeFactor>-1</screenShakeFactor>
      <speed>20</speed>
    </projectile>
  </ThingDef>

  <AbilityDef>
    <defName>EDF_AbilityAcidB</defName>
    <label>Super Acid shot</label>
    <description>It attacks by spitting out very powerful acid.</description>
    <iconPath>Things/Abilities/EDF_AbilityAcidB</iconPath>
    <cooldownTicksRange>480</cooldownTicksRange>
    <category>EDF_Ability</category>
    <displayOrder>200</displayOrder>
    <aiCanUse>true</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0.5</warmupTime>
      <range>14.9</range>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <ai_AvoidFriendlyFireRadius>4</ai_AvoidFriendlyFireRadius>
        <muzzleFlashScale>0</muzzleFlashScale>
        <defaultCooldownTime>3.5</defaultCooldownTime>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>EDF_AcidSpitB</projectileDef>
      </li>
    </comps>
  </AbilityDef>

  <ThingDef ParentName="BaseBullet">
    <defName>EDF_AcidSpitB</defName>
    <label>Super Acid</label>
    <graphicData>
      <texPath>Things/Projectile/EDF_Acid</texPath>
      <drawSize>2.5</drawSize>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingClass>Projectile_Explosive</thingClass>
    <projectile>
      <damageDef>EDF_Acid</damageDef>
      <explosionRadius>2.5</explosionRadius>
      <damageAmountBase>35</damageAmountBase>
      <armorPenetrationBase>0.5</armorPenetrationBase>
      <stoppingPower>1.5</stoppingPower>
      <screenShakeFactor>-1</screenShakeFactor>
      <speed>80</speed>
    </projectile>
  </ThingDef>

</Defs>