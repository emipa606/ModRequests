<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <FactionDef ParentName="FactionBase" >
    <defName>EDF_corps</defName>
    <label>EDF Armed forces</label>
    <description>A defense organization with its origins in the EDF, the Earth Defense Forces Organization. Armed with firearms using advanced technology, they protect people from various dangers. The dangers they face are sometimes mechanoids, assailants, or alien invaders.</description>
    <pawnSingular>EDF troop</pawnSingular>
    <pawnsPlural>EDF troops</pawnsPlural>
    <categoryTag>EDF</categoryTag>
    <settlementGenerationWeight>0.8</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <canMakeRandomly>true</canMakeRandomly>
    <canSiege>false</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>supreme commander</leaderTitle>
    <factionIconPath>Things/Icon/Icon_EDF</factionIconPath>
    <techLevel>Ultra</techLevel>
    <factionNameMaker>NamerFactionEDF</factionNameMaker>
    <settlementNameMaker>NamerSettlementEDF</settlementNameMaker>
    <apparelStuffFilter>
      <thingDefs>
        <li>Synthread</li>
        <li>Hyperweave</li>
        <li>Plasteel</li>
      </thingDefs>
    </apparelStuffFilter>
    <allowedCultures><li>Astropolitan</li></allowedCultures>
    <disallowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">Structure_Animist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Supremacist</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">HumanPrimacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">MaleSupremacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">FemaleSupremacy</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Raider</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Cannibal</li>
    </disallowedMemes>
    <structureMemeWeights>
      <Structure_Ideological MayRequire="Ludeon.RimWorld.Ideology">1</Structure_Ideological>
    </structureMemeWeights>
    <classicIdeo>true</classicIdeo>
    <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>31</configurationListOrderPriority>
    <backstoryFilters>
      <li>
        <categories>
          <li>Outlander</li>
        </categories>
        <commonality>0.95</commonality>
      </li>
      <li>
        <categories>
          <li>Offworld</li>
        </categories>
        <commonality>0.05</commonality>
      </li>
    </backstoryFilters>
    <caravanTraderKinds>
      <li>Caravan_Outlander_BulkGoods</li>
      <li>Caravan_Outlander_CombatSupplier</li>
      <li>Caravan_Outlander_Exotic</li>
      <li>Caravan_Outlander_PirateMerchant</li>
    </caravanTraderKinds>
    <visitorTraderKinds>
      <li>Visitor_Outlander_Standard</li>
    </visitorTraderKinds>
    <baseTraderKinds>
      <li>Base_Outlander_Standard</li>
    </baseTraderKinds>
    <allowedArrivalTemperatureRange>-40~45</allowedArrivalTemperatureRange>
    <raidLootMaker>OutlanderRaidLootMaker</raidLootMaker>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(500, 100)</li>
        <li>(1000, 500)</li>
        <li>(2000, 1000)</li>
        <li>(2001, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <!-- Normal mixed Unit  -->
      <li>
        <kindDef>Combat</kindDef>
        <commonality>60</commonality>
        <options>
          <EDF_III_Soldier>10</EDF_III_Soldier>
          <EDF_III_Officer>5</EDF_III_Officer>
          <EDF_III_Titania>5</EDF_III_Titania>
          <EDF_III_Storm>1</EDF_III_Storm>
          <EDF_III_Omega>1</EDF_III_Omega>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>60</commonality>
        <options>
          <EDF_IV_Ranger>10</EDF_IV_Ranger>
          <EDF_IV_Sniper>5</EDF_IV_Sniper>
          <EDF_IV_Rocket>5</EDF_IV_Rocket>
          <EDF_IV_Officer>5</EDF_IV_Officer>
          <EDF_IV_Storm>5</EDF_IV_Storm>
          <EDF_IV_Omega>1</EDF_IV_Omega>
          <EDF_IV_Air>1</EDF_IV_Air>
          <EDF_IV_Airstrike>1</EDF_IV_Airstrike>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>60</commonality>
        <options>
          <EDF_V_Ranger>10</EDF_V_Ranger>
          <EDF_V_Sniper>5</EDF_V_Sniper>
          <EDF_V_Rocket>5</EDF_V_Rocket>
          <EDF_V_Officer>5</EDF_V_Officer>
          <EDF_V_Storm>5</EDF_V_Storm>
          <EDF_V_Air>1</EDF_V_Air>
          <EDF_V_Airstrike>1</EDF_V_Airstrike>
        </options>
      </li>
      <!-- Mech Operations Unit  -->
      <li>
        <kindDef>Combat</kindDef>
        <commonality>30</commonality>
        <options>
          <Mech_Vegalta_A>10</Mech_Vegalta_A>
          <EDF_IV_Air>1</EDF_IV_Air>
          <EDF_IV_Airstrike>3</EDF_IV_Airstrike>
          <EDF_IV_Storm>1</EDF_IV_Storm>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>30</commonality>
        <options>
          <Mech_EDF_Nix_A>10</Mech_EDF_Nix_A>
          <Mech_EDF_Nix_B>10</Mech_EDF_Nix_B>
          <EDF_V_Air>1</EDF_V_Air>
          <EDF_V_Airstrike>3</EDF_V_Airstrike>
          <EDF_V_Storm>1</EDF_V_Storm>
        </options>
      </li>
      <!-- Underground Sweeper Unit  -->
      <li>
        <kindDef>Combat</kindDef>
        <commonality>10</commonality>
        <options>
          <EDF_IV_Flamer>5</EDF_IV_Flamer>
          <EDF_IV_Rocket>1</EDF_IV_Rocket>
          <EDF_IV_Storm>1</EDF_IV_Storm>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>10</commonality>
        <options>
          <EDF_V_Flamer>5</EDF_V_Flamer>
          <EDF_V_Rocket>1</EDF_V_Rocket>
          <EDF_V_Storm>1</EDF_V_Storm>
        </options>
      </li>
      <!-- Sniper Unit  -->
      <li>
        <kindDef>Combat</kindDef>
        <commonality>30</commonality>
        <options>
          <EDF_IV_Ranger>5</EDF_IV_Ranger>
          <EDF_IV_Sniper>10</EDF_IV_Sniper>
          <EDF_IV_Storm>1</EDF_IV_Storm>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>30</commonality>
        <options>
          <EDF_V_Ranger>5</EDF_V_Ranger>
          <EDF_V_Sniper>10</EDF_V_Sniper>
          <EDF_V_Storm>1</EDF_V_Storm>
        </options>
      </li>
      <!-- Omega Team  -->
      <li>
        <kindDef>Combat</kindDef>
        <commonality>20</commonality>
        <options>
          <EDF_III_Omega>10</EDF_III_Omega>
          <EDF_III_Titania>3</EDF_III_Titania>
          <EDF_III_Storm>2</EDF_III_Storm>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>20</commonality>
        <options>
          <EDF_IV_Omega>10</EDF_IV_Omega>
          <EDF_IV_Storm>3</EDF_IV_Storm>
        </options>
      </li>
      <!-- Extreme powerful Unit  -->
      <li>
        <kindDef>Combat</kindDef>
        <commonality>10</commonality>
        <options>
          <EDF_IV_RangerINF>10</EDF_IV_RangerINF>
          <EDF_IV_SniperINF>5</EDF_IV_SniperINF>
          <EDF_IV_Omega>3</EDF_IV_Omega>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>10</commonality>
        <options>
          <EDF_V_RangerINF>10</EDF_V_RangerINF>
          <EDF_V_SniperINF>5</EDF_V_SniperINF>
          <EDF_V_StormINF>1</EDF_V_StormINF>
          <Mech_BargaTypeB>1</Mech_BargaTypeB>
        </options>
      </li>
      <!-- Peaceful Unit  -->
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <EDF_III_Soldier>10</EDF_III_Soldier>
          <EDF_III_Titania>3</EDF_III_Titania>
          <EDF_III_Officer>1</EDF_III_Officer>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <EDF_IV_Ranger>10</EDF_IV_Ranger>
          <EDF_V_Ranger>10</EDF_V_Ranger>
          <EDF_IV_Officer>1</EDF_IV_Officer>
          <EDF_V_Officer>1</EDF_V_Officer>
        </options>
      </li>
      <!-- Traders -->
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <EDF_Civil_Trader>1</EDF_Civil_Trader>
        </traders>
        <carriers>
          <Muffalo>6</Muffalo>
        </carriers>
        <guards>
          <EDF_IV_Ranger>10</EDF_IV_Ranger>
          <EDF_V_Ranger>10</EDF_V_Ranger>
          <EDF_IV_Sniper>5</EDF_IV_Sniper>
          <EDF_V_Sniper>5</EDF_V_Sniper>
          <EDF_IV_Rocket>5</EDF_IV_Rocket>
          <EDF_V_Rocket>5</EDF_V_Rocket>
          <EDF_IV_Officer>5</EDF_IV_Officer>
          <EDF_V_Officer>5</EDF_V_Officer>
          <EDF_IV_Air>1</EDF_IV_Air>
          <EDF_V_Air>1</EDF_V_Air>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <EDF_IV_RangerINF>10</EDF_IV_RangerINF>
          <EDF_IV_SniperINF>5</EDF_IV_SniperINF>
          <EDF_V_RangerINF>10</EDF_V_RangerINF>
          <EDF_V_SniperINF>5</EDF_V_SniperINF>
          <EDF_V_StormINF>1</EDF_V_StormINF>
          <EDF_V_AirstrikeINF>1</EDF_V_AirstrikeINF>
        </options>
      </li>
    </pawnGroupMakers>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
  </FactionDef>



  <FactionDef ParentName="FactionBase">
    <defName>EDF_Ravager</defName>
    <label>Ravager</label>
    <description>An invading civilization with advanced technology. Although it appears to be a small number of reconnaissance units deployed on this planet, it still possesses a force that should not be underestimated.</description>
    <pawnSingular>Ravager</pawnSingular>
    <pawnsPlural>Ravagers</pawnsPlural>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <factionNameMaker>NamerFactionRavager</factionNameMaker>
    <factionIconPath>Things/Icon/Icon_Ravager</factionIconPath>
    <canStageAttacks>false</canStageAttacks>
    <arrivalLayerWhitelist>
      <li>Surface</li>
    </arrivalLayerWhitelist>
    <colorSpectrum>
      <li>(0.78, 0.79, 0.71)</li>
    </colorSpectrum>
    <raidCommonalityFromPointsCurve>
      <points>
        <li>(300,  0)</li>
        <li>(700,  1)</li>
        <li>(1400, 1.8)</li>
        <li>(2800, 2.2)</li>
        <li>(4000, 2.6)</li>
      </points>
    </raidCommonalityFromPointsCurve>
    <raidLootMaker>MechanoidRaidLootMaker</raidLootMaker>
    <raidLootValueFromPointsCurve>
      <points>
        <li>(35,     8)</li>
        <li>(100,   60)</li>
        <li>(1000, 250)</li>
        <li>(2000, 400)</li>
        <li>(4000, 500)</li>
      </points>
    </raidLootValueFromPointsCurve>
    <humanlikeFaction>false</humanlikeFaction>
    <hidden>true</hidden>
    <autoFlee>false</autoFlee>
    <canUseAvoidGrid>false</canUseAvoidGrid>
    <techLevel>Ultra</techLevel>
    <earliestRaidDays>45</earliestRaidDays>
    <permanentEnemy>true</permanentEnemy>
    <hostileToFactionlessHumanlikes>true</hostileToFactionlessHumanlikes>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(400,200)</li>
        <li>(900,300)</li>
        <li>(100000,10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>40</commonality>
        <options>
          <Mech_HectorA_MG>10</Mech_HectorA_MG>
          <EDF_AntA>15</EDF_AntA>
          <EDF_AntB>15</EDF_AntB>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>40</commonality>
        <options>
          <Mech_HectorA_MG>10</Mech_HectorA_MG>
          <EDF_AntA>15</EDF_AntA>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>40</commonality>
        <options>
          <Mech_HectorA_MG>10</Mech_HectorA_MG>
          <EDF_AntB>15</EDF_AntB>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>20</commonality>
        <options>
          <Mech_HectorA_MG>10</Mech_HectorA_MG>
          <EDF_AntC>30</EDF_AntC>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>10</commonality>
        <options>
          <Mech_HectorA_MG>10</Mech_HectorA_MG>
          <EDF_AntD>15</EDF_AntD>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>60</commonality>
        <options>
          <Mech_HectorA_MG>10</Mech_HectorA_MG>
          <Mech_HectorA_GL>1</Mech_HectorA_GL>
          <Mech_HectorA_PL>1</Mech_HectorA_PL>
          <EDF_AntA>5</EDF_AntA>
          <EDF_AntB>5</EDF_AntB>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>10</commonality>
        <options>
          <Mech_HectorB_MG>10</Mech_HectorB_MG>
          <Mech_HectorB_PL>1</Mech_HectorB_PL>
          <EDF_AntD>5</EDF_AntD>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>80</commonality>
        <options>
          <Mech_HectorA_MG>10</Mech_HectorA_MG>
          <Mech_HectorA_GL>1</Mech_HectorA_GL>
          <Mech_HectorA_PL>1</Mech_HectorA_PL>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>20</commonality>
        <options>
          <Mech_HectorB_MG>10</Mech_HectorB_MG>
          <Mech_HectorB_PL>1</Mech_HectorB_PL>
        </options>
      </li>
    </pawnGroupMakers>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <allowedArrivalTemperatureRange>-100~200</allowedArrivalTemperatureRange>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>900</configurationListOrderPriority>
    <dropPodActive>ActiveDropPodMechanoid</dropPodActive>
    <dropPodIncoming>DropPodIncomingMechanoidRapid</dropPodIncoming>
  </FactionDef>

</Defs>