  <ThingDef ParentName="BuildingBase">
    <defName>EDF_Power_PowerCell</defName>
    <label>Plasma Core PowerCell</label>
    <description>This is a simple generator using a plasma core. It continues to supply power until it overheats. The limiter of the plasma core is removed on the premise that it cannot be reused, and although it provides a large amount of power, it also generates heat at the same time. A large radiator is installed as a countermeasure, but the device eventually destroys itself, which is the real limit of the specification. The heat generated is not a problem when used outdoors, but when used indoors, care must be taken not to overheat the room.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Power/EDF_PowerCell</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.1,1.1)</drawSize>
      <shadowData>
        <volume>(1,1,1)</volume>
        <offset>(0,0,0)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.9</fillPercent>
    <pathCost>50</pathCost>
    <rotatable>false</rotatable>
    <blockWind>true</blockWind>
    <statBases>
      <MaxHitPoints>75</MaxHitPoints>
      <WorkToBuild>50</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <tickerType>Normal</tickerType>
    <canOverlapZones>false</canOverlapZones>
    <size>(1,1)</size>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <costList>
      <Steel>10</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlant</compClass>
        <basePowerConsumption>-1500</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
        <soundAmbientProducingPower>ChemfuelFiredGenerator_Ambience</soundAmbientProducingPower>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>3</glowRadius>
        <glowColor>(217,112,33,0)</glowColor>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>21</heatPerSecond>
      </li>
      <li Class="CompProperties_Stunnable">
        <useLargeEMPEffecter>true</useLargeEMPEffecter>
        <affectedDamageDefs>
          <li>EMP</li>
        </affectedDamageDefs>
      </li>
      <li Class="CompProperties_Lifespan">
        <lifespanTicks>3000</lifespanTicks>
      </li>
    </comps>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
  </ThingDef>

</Defs>