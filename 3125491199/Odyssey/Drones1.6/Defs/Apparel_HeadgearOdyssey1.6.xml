<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="ApparelNoQualityBase">
        <defName>EDF_EVEOptions</defName>
        <label>EDF EVE Shield</label>
        <description>Auxiliary equipment for extra-vehicular activities based on deflector technology. It deploys a special pressure-resistant field to enable activities in an oxygen-free, low-pressure environment in orbit. Because it is heavily protected, even an EMP attack will not stop its function, but it is physically fragile, so care must be taken during combat.</description>
        <tradeability>Sellable</tradeability>
        <graphicData>
        <texPath>Things/Apparel/Equipment/EDF_EVEPack</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>0.9</drawSize>
      </graphicData>
      <costList>
        <ComponentIndustrial>15</ComponentIndustrial>
        <Plasteel>20</Plasteel>
      </costList>
      <statBases>
        <WorkToMake>15000</WorkToMake>
        <MaxHitPoints>10</MaxHitPoints>
        <Mass>0.3</Mass>
        <Flammability>0</Flammability>
        <Insulation_Cold>75</Insulation_Cold>
        <Insulation_Heat>50</Insulation_Heat>
        <EquipDelay>1</EquipDelay>
      </statBases>
      <equippedStatOffsets>
        <VacuumResistance>1</VacuumResistance>
      </equippedStatOffsets>
      <thingCategories Inherit="False">
        <li>ApparelUtility</li>
      </thingCategories>
      <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
        <bodyPartGroups>
          <li>Neck</li>
        </bodyPartGroups>
        <renderSkipFlags>
          <li>None</li>
        </renderSkipFlags>
        <layers>
          <li>Belt</li>
        </layers>
        <tags Inherit="False">
          <li>EDF</li>
        </tags>
        <defaultOutfitTags Inherit="False">
          <li>EDF</li>
        </defaultOutfitTags>
        <useDeflectMetalEffect>true</useDeflectMetalEffect>
      </apparel>
      <recipeMaker>
          <unfinishedThingDef>UnfinishedBelt</unfinishedThingDef>
          <researchPrerequisite>EDF_TIV</researchPrerequisite>
        <skillRequirements>
          <Crafting>12</Crafting>
        </skillRequirements>
        <recipeUsers Inherit="False">
          <li>EDF_FabricBench</li>
        </recipeUsers>
      </recipeMaker>
    </ThingDef>

</Defs>