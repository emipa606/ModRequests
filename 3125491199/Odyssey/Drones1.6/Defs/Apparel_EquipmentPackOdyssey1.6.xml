<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ================================== Non Numberring ====================================-->

  <!-- ================================== DronePack ====================================-->

  <ThingDef ParentName="ApparelNoQualityBase">
    <defName>EDF_RobotBombPack</defName>
    <label>RobotBomb Kit</label>
    <description>Self-destructing drone packs operated by the EDF's Air Raider unit. Capable of deploying self-destructing self-destructing drones.</description>
    <tradeability>Sellable</tradeability>
    <graphicData>
      <texPath>Things/Pawn/EDF_Patroller/EDF_Patroller_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.2</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>12000</WorkToMake>
      <Mass>10</Mass>
      <Flammability>0.2</Flammability>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>10</ComponentIndustrial>
    </costList>
    <tickerType>Normal</tickerType>
    <equippedStatOffsets>
      <MoveSpeed>-0.1</MoveSpeed>
    </equippedStatOffsets>
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_ApparelReloadable">
        <maxCharges>3</maxCharges>
        <ammoDef>Steel</ammoDef>
        <ammoCountPerCharge>15</ammoCountPerCharge>
        <baseReloadTicks>60</baseReloadTicks>
        <soundReload>Standard_Reload</soundReload>
        <hotKey>Misc4</hotKey>
        <chargeNoun>Turret</chargeNoun>
        <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
      </li>
    </comps>
    <verbs>
      <li>
        <verbClass>Verb_LaunchProjectileStatic</verbClass>
        <label>deploy Robot Bomb</label>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>EDF_Grenade_RobotBomb</defaultProjectile>
        <warmupTime>1.0</warmupTime>
        <range>7.9</range>
        <burstShotCount>1</burstShotCount>
        <onlyManualCast>True</onlyManualCast>
        <targetable>true</targetable>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
          <canTargetPawns>false</canTargetPawns>
          <canTargetBuildings>false</canTargetBuildings>
        </targetParams>
        <soundCast>ThrowGrenade</soundCast>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
        <canGoWild>false</canGoWild>
      </li>
    </verbs>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <scoreOffset>4</scoreOffset>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups>
        <li>Torso</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <tags Inherit="False">
        <li>EDF</li>
      </tags>
        <defaultOutfitTags Inherit="False">
          <li>EDF</li>
        </defaultOutfitTags>
    </apparel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedPack</unfinishedThingDef>
      <researchPrerequisite>EDF_TIII</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>EDF_FabricBench</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="BaseGrenadeProjectile">
    <defName>EDF_Grenade_RobotBomb</defName>
    <label>Robot Bomb</label> 
    <thingClass>Projectile_SpawnsPawnZeroAge</thingClass>
    <graphicData>
      <texPath>Things/Pawn/EDF_Patroller/EDF_Patroller_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <speed>41</speed>
      <spawnsPawnKind>Mech_Patroller_C</spawnsPawnKind>
      <tryAdjacentFreeSpaces>true</tryAdjacentFreeSpaces>
    </projectile>
  </ThingDef>

</Defs>