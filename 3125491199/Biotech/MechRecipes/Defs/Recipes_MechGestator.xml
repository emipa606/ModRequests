    <description>Resurrect a friendly mechanoid of the Light weight class. So long as the mechanoid's body is not completely destroyed, it can be resurrected.</description>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Corpses</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
