<Defs>

  <ThingDef ParentName="BaseInsect">
    <defName>EDF_AntA</defName>
    <label>GiantAnt</label>
    <description>The giant creature that has engaged EDF most frequently. They have a tough shell, strong jaws, and attack with powerful acid. Commonly known as black ants.</description>
    <statBases>
      <MoveSpeed>4.6</MoveSpeed>
      <ComfyTemperatureMin>-40</ComfyTemperatureMin>
      <MarketValue>500</MarketValue>
      <LeatherAmount>0</LeatherAmount>
      <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
      <ArmorRating_Heat>0.15</ArmorRating_Heat>
      <ToxicResistance>1</ToxicResistance>
      <PsychicSensitivity>0.5</PsychicSensitivity>
    </statBases>
    <uiIconScale>0.8</uiIconScale>
    <tools>
      <li>
        <label>head claw</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>21</power>
        <cooldownTime>2.6</cooldownTime>
        <linkedBodyPartsGroup>HeadClaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>14</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <body>BeetleLikeWithClaw</body>
      <predator>true</predator>
      <baseHungerRate>0.35</baseHungerRate>
      <baseBodySize>3.5</baseBodySize>
      <baseHealthScale>3</baseHealthScale>
      <meatLabel>insect meat</meatLabel>
      <lifeExpectancy>6</lifeExpectancy>
      <wildness>0.3</wildness>
      <trainability>Advanced</trainability>
      <lifeStageAges>
        <li>
          <def>EusocialInsectAdult</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_BigInsect_Pain</soundWounded>
          <soundDeath>Pawn_BigInsect_Death</soundDeath>
          <soundCall>Pawn_BigInsect_Call</soundCall>
          <soundAngry>Pawn_BigInsect_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>None</li>
    </tradeTags>
  </ThingDef>

