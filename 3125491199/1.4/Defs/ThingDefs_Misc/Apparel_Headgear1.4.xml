<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="ArmorHelmetMakeableBase">
        <defName>EDF_VI_Goggles</defName>
        <label>EDF ballistic goggles</label>
        <description>Combat goggles issued to EDF general soldiers.Bulletproof and impact resistant, it protects the eyes well.</description>
        <tradeability>Sellable</tradeability>
        <graphicData>
        <texPath>Things/Apparel/Helmet/EDF_VI_Goggles/EDF_VI_Goggles</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>0.9</drawSize>
      </graphicData>
      <costList>
        <ComponentIndustrial>3</ComponentIndustrial>
        <Plasteel>10</Plasteel>
        <Steel>10</Steel>
      </costList>
      <statBases>
        <WorkToMake>8000</WorkToMake>
        <MaxHitPoints>120</MaxHitPoints>
        <Mass>0.6</Mass>
        <Flammability>0.4</Flammability>
        <ArmorRating_Sharp>0.8</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.7</ArmorRating_Blunt>
        <ArmorRating_Heat>0.7</ArmorRating_Heat>
        <Insulation_Cold>4</Insulation_Cold>
        <Insulation_Heat>2</Insulation_Heat>
        <EquipDelay>0.8</EquipDelay>
      </statBases>
      <thingCategories Inherit="False">
        <li>ArmorHeadgear</li>
      </thingCategories>
      <apparel>
        <bodyPartGroups>
          <li>Eyes</li>
        </bodyPartGroups>
        <wornGraphicPath>Things/Apparel/Helmet/EDF_VI_Goggles/EDF_VI_Goggles</wornGraphicPath>
        <hatRenderedFrontOfFace>true</hatRenderedFrontOfFace>
        <layers>
          <li>EyeCover</li>
        </layers>
        <tags Inherit="False">
          <li>EDF</li>
        </tags>
        <defaultOutfitTags Inherit="False">
          <li>EDF</li>
        </defaultOutfitTags>
        <useDeflectMetalEffect>true</useDeflectMetalEffect>
      </apparel>
      <recipeMaker>
          <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
          <researchPrerequisite>EDF_ArmorII</researchPrerequisite>
        <skillRequirements>
          <Crafting>8</Crafting>
        </skillRequirements>
        <recipeUsers Inherit="False">
          <li>EDF_FabricBench</li>
        </recipeUsers>
      </recipeMaker>
    </ThingDef>

