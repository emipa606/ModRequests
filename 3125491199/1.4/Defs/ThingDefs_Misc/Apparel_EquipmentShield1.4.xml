<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ================================== EDF4 ====================================-->

  <ThingDef ParentName="ApparelNoQualityBase">
    <defName>EDF_IV_DefrectShield</defName>
    <label>Defrection Shield</label>
    <description>A large mechanical shield equipped with a "deflector" physical reversal device. It reduces any impact the wearer is subjected to and provides protection against more severe attacks.</description>
    <tradeability>Sellable</tradeability>
    <graphicData>
      <texPath>Things/Apparel/Equipment/EDF_ShieldAI/EDF_ShieldAI</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <statBases>
      <WorkToMake>18000</WorkToMake>
      <MaxHitPoints>250</MaxHitPoints>
      <Mass>18</Mass>
      <Flammability>0.1</Flammability>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>15</ComponentIndustrial>
    </costList>
    <tickerType>Normal</tickerType>
    <equippedStatOffsets>
      <MoveSpeed>-0.2</MoveSpeed>
      <IncomingDamageFactor>-0.35</IncomingDamageFactor>
    </equippedStatOffsets>
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <apparel>
      <countsAsClothingForNudity>true</countsAsClothingForNudity>
      <scoreOffset>4</scoreOffset>
      <wornGraphicPath>Things/Apparel/Equipment/EDF_ShieldAI/EDF_ShieldAI</wornGraphicPath>
      <useWornGraphicMask>false</useWornGraphicMask>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups>
        <li>Torso</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <tags Inherit="False">
        <li>EDF</li>
      </tags>
        <defaultOutfitTags Inherit="False">
          <li>EDF</li>
        </defaultOutfitTags>
        <useDeflectMetalEffect>true</useDeflectMetalEffect>
    </apparel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedPack</unfinishedThingDef>
      <researchPrerequisite>EDF_ArmorIII</researchPrerequisite>
      <skillRequirements>
        <Crafting>12</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>EDF_FabricBench</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>

