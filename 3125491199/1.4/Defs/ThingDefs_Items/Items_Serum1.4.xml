<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="MechSerumBase">
    <defName>EDF_SerumHealer</defName>
    <label>ReverserXS</label>
    <description>Medical nanomachine serum manufactured and deployed by EDF. It not only treats injuries but also restores missing body parts and even organs. Medical nanomachines are extremely difficult to produce and only one dose is enclosed.</description>
    <tradeability>Sellable</tradeability>
    <graphicData>
      <texPath>Things/Item/EDF_SerumA</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>1.1</drawSize>
    </graphicData>
    <stackLimit>10</stackLimit>
    <statBases>
      <MarketValue>300</MarketValue>
    </statBases>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Use {0_label}</useLabel>
        <useDuration>600</useDuration>
      </li>
      <li Class="CompProperties_UseEffect">
        <compClass>CompUseEffect_FixWorstHealthCondition</compClass>
      </li>
      <li Class="CompProperties_UseEffectPlaySound">
        <soundOnUsed>MechSerumUsed</soundOnUsed>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf" />
    </comps>
  </ThingDef>

  <RecipeDef>
    <defName>AdministerEDFSerumHealer</defName>
    <label>administer ReverserXS</label>
    <description>Administer a ReverserXS.</description>
    <workerClass>Recipe_AdministerUsableItem</workerClass>
    <jobString>Administering ReverserXS.</jobString>
    <targetsBodyPart>false</targetsBodyPart>
    <anesthetize>false</anesthetize>
    <workAmount>600</workAmount>
    <dontShowIfAnyIngredientMissing>true</dontShowIfAnyIngredientMissing>
    <surgeryOutcomeEffect IsNull="True"/>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>EDF_SerumHealer</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>EDF_SerumHealer</li>
      </thingDefs>
    </fixedIngredientFilter>
  </RecipeDef>


  <ThingDef ParentName="MechSerumBase">
    <defName>EDF_SerumResurrector</defName>
    <label>ReverserXR</label>
    <description>A resuscitative nanomachine serum that EDF has perfected as the ultimate goal of its medical nanomachine research. When administered to a dead person, the serum repairs the appropriate parts of the body within a few seconds and revives him or her. However, it is not perfectly reliable and can induce psychosis or damage to the nerves. In addition, the revived person needs to rest for a while, so the original development goal of "quick return of fallen soldiers to the battle line" has not been achieved.</description>
    <tradeability>Sellable</tradeability>
    <graphicData>
      <texPath>Things/Item/EDF_SerumB</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>1.1</drawSize>
    </graphicData>
    <stackLimit>10</stackLimit>
    <statBases>
      <MarketValue>900</MarketValue>
    </statBases>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Use {0_label}</useLabel>
        <useDuration>0</useDuration>
        <warmupMote>Mote_ResurrectAbility</warmupMote>
      </li>
      <li Class="CompProperties_Targetable">
        <compClass>CompTargetable_SingleCorpse</compClass>
        <fleshCorpsesOnly>true</fleshCorpsesOnly>
        <nonDessicatedCorpsesOnly>true</nonDessicatedCorpsesOnly>
      </li>
      <li Class="CompProperties_TargetEffectResurrect">
        <moteDef>Mote_ResurrectFlash</moteDef>
      </li>
    </comps>
  </ThingDef>

</Defs>