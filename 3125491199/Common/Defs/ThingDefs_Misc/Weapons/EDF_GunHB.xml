  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>EDF_IV_FGI</defName>
    <label>FG7Hand Gatling</label>
    <description>A portable Gatling gun developed for fencer units. It is extremely heavy and has a large amount of recoil when fired, but it is capable of creating an overwhelming barrage of bullets.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Weapon/HB/EDF_FGI</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.6</drawSize>
      <drawOffsetNorth>(0.0, 0.0, 0.0)</drawOffsetNorth>
      <drawOffsetEast>(0.15, 0.0, 0.0)</drawOffsetEast>
      <drawOffsetSouth>(0.0, 0.0, 0.0)</drawOffsetSouth>
      <drawOffsetWest>(-0.15, 0.0, 0.0)</drawOffsetWest>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <WorkToMake>48000</WorkToMake>
      <Mass>25</Mass>
      <AccuracyTouch>0.52</AccuracyTouch>
      <AccuracyShort>0.58</AccuracyShort>
      <AccuracyMedium>0.51</AccuracyMedium>
      <AccuracyLong>0.46</AccuracyLong>
      <RangedWeapon_Cooldown>3.0</RangedWeapon_Cooldown>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>EDF_HEAVYI</researchPrerequisite>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
      	<li>EDF_FabricBench</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Steel>85</Steel>
      <ComponentIndustrial>16</ComponentIndustrial>
    </costList>
    <equippedStatOffsets>
      <MoveSpeed>-0.3</MoveSpeed>
    </equippedStatOffsets>
    <weaponTags Inherit="False">
      <li>EDF_FG_I</li>
    </weaponTags>
    <tradeability>Sellable</tradeability>
    <generateCommonality>1</generateCommonality>
    <generateAllowChance>1</generateAllowChance>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_EDFFGI</defaultProjectile>
        <warmupTime>3.0</warmupTime>
        <range>30.9</range>
        <burstShotCount>18</burstShotCount>
        <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
        <soundCast>Shot_Minigun</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>6</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>18</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <relicChance>0</relicChance>
  </ThingDef>

