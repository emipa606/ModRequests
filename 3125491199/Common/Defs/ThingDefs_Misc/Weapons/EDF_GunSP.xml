  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>EDF_III_PRI</defName>
    <label>Electro Paralyzer</label>
    <description>A special weapon that blocks the enemy's movement. Stuns an opponent hit by a light bullet for a certain period of time.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Weapon/SP/EDF_PR</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.4</drawSize>
      <drawOffsetNorth>(0.0, 0.0, 0.0)</drawOffsetNorth>
      <drawOffsetEast>(0.15, 0.0, 0.0)</drawOffsetEast>
      <drawOffsetSouth>(0.0, 0.0, 0.0)</drawOffsetSouth>
      <drawOffsetWest>(-0.15, 0.0, 0.0)</drawOffsetWest>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <WorkToMake>30000</WorkToMake>
      <Mass>3.5</Mass>
      <AccuracyTouch>0.62</AccuracyTouch>
      <AccuracyShort>0.7</AccuracyShort>
      <AccuracyMedium>0.67</AccuracyMedium>
      <AccuracyLong>0.6</AccuracyLong>
      <RangedWeapon_Cooldown>5</RangedWeapon_Cooldown>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>EDF_EN</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
      	<li>EDF_FabricBench</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Steel>65</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <weaponTags Inherit="False">
      <li>EDF_PR_I</li>
    </weaponTags>
    <tradeability>Sellable</tradeability>
    <generateCommonality>1</generateCommonality>
    <generateAllowChance>1</generateAllowChance>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_EDFPRI</defaultProjectile>
        <warmupTime>1.5</warmupTime>
        <range>30.9</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
        <soundCast>Shot_ChargeRifle</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <relicChance>0</relicChance>
  </ThingDef>

