  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>EDF_Knife</defName>
    <label>EDF Combat Knife</label>
    <description>A combat knife widely deployed by EDF infantry. It can also be used as a bayonet and has excellent basic performance. However, since it is intended only for use against humans, it was not useful in combat against invaders who attacked with giant insects as their main force.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Weapon/EDF_Knife</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.1</drawSize>
      <drawOffsetNorth>(0.0, 0.0, 0.0)</drawOffsetNorth>
      <drawOffsetEast>(0.15, 0.0, 0.0)</drawOffsetEast>
      <drawOffsetSouth>(0.0, 0.0, 0.0)</drawOffsetSouth>
      <drawOffsetWest>(-0.15, 0.0, 0.0)</drawOffsetWest>
    </graphicData>
    <uiIconScale>1.6</uiIconScale>
    <equippedAngleOffset>-45</equippedAngleOffset>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <WorkToMake>2000</WorkToMake>
      <Mass>1.2</Mass>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>EDF_TI</researchPrerequisite>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
      	<li>EDF_FabricBench</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Steel>35</Steel>
    </costList>
    <weaponTags Inherit="False">
      <li>EDF_Knife</li>
    </weaponTags>
    <tradeability>Sellable</tradeability>
    <generateCommonality>1</generateCommonality>
    <generateAllowChance>1</generateAllowChance>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>12</power>
        <cooldownTime>1.8</cooldownTime>
      </li>
      <li>
        <label>blade</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>18</power>
        <cooldownTime>1.3</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>16</power>
        <cooldownTime>1.6</cooldownTime>
      </li>
    </tools>
    <relicChance>0</relicChance>
  </ThingDef>

