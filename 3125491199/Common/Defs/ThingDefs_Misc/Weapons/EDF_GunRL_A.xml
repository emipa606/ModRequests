  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>EDF_IV_RLI</defName>
    <label>Stingray M1</label>
    <description>Standard rocket launcher widely deployed in the EDF. Often used against large or armored targets, it is also effective against groups of smaller enemies because of the blast it delivers.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Weapon/RL/EDF_STI</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.4</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <WorkToMake>45000</WorkToMake>
      <Mass>8.5</Mass>
      <RangedWeapon_Cooldown>4</RangedWeapon_Cooldown>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>EDF_TIRL</researchPrerequisite>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
      	<li>EDF_FabricBench</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Steel>100</Steel>
      <ComponentIndustrial>16</ComponentIndustrial>
      <Shell_HighExplosive>1</Shell_HighExplosive>
    </costList>
    <weaponTags Inherit="False">
      <li>EDF_IV_RocketI</li>
    </weaponTags>
    <tradeability>Sellable</tradeability>
    <generateCommonality>1</generateCommonality>
    <generateAllowChance>1</generateAllowChance>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_EDFRLSTI</defaultProjectile>
        <forcedMissRadius>2</forcedMissRadius>
        <ai_AvoidFriendlyFireRadius>3</ai_AvoidFriendlyFireRadius>
        <warmupTime>2.5</warmupTime>
        <range>35.9</range>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <soundCast>EDF_RocketL</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>10</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <relicChance>0</relicChance>
  </ThingDef>

