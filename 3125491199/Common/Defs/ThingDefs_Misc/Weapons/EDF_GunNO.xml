<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<ThingDef ParentName="BaseHumanMakeableGun">
    <defName>EDF_IV_NOVAI</defName>
    <label>Nova Blaster</label>
    <description>A special laser rifle that contains tremendous energy. When the trigger is pulled, all the energy is released at once, and the gun is able to push a tremendous amount of power to a single point, but the body of the gun cannot withstand the energy radiation and dissolves. As a result, it can only be used once, so you need to think carefully about how to use it.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Weapon/AR/EDF_FB</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.3</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <WorkToMake>20000</WorkToMake>
      <Mass>5</Mass>
      <RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>EDF_TILR</researchPrerequisite>
      <skillRequirements>
        <Crafting>12</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
      	<li>EDF_FabricBench</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>25</ComponentIndustrial>
      <Shell_AntigrainWarhead>1</Shell_AntigrainWarhead>
    </costList>
    <weaponTags Inherit="False">
      <li>EDF_NOVA</li>
    </weaponTags>
    <thingSetMakerTags>
      <li>SingleUseWeapon</li>
    </thingSetMakerTags>
    <tradeability>Sellable</tradeability>
    <generateCommonality>1</generateCommonality>
    <generateAllowChance>1</generateAllowChance>
    <verbs>
      <li>
        <verbClass>Verb_ShootOneUse</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <onlyManualCast>true</onlyManualCast>
        <defaultProjectile>Bullet_EDFNOVAI</defaultProjectile>
        <forcedMissRadius>0.1</forcedMissRadius>
        <warmupTime>3</warmupTime>
        <range>74.9</range>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <soundCast>EDF_laserX</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>20</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <relicChance>0</relicChance>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_EDFNOVAI</defName>
    <label>Nova ray</label>
    <graphicData>
      <texPath>Things/Projectile/EDF_ARay</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>10</drawSize>
    </graphicData>
    <thingClass>Projectile_Explosive</thingClass>
    <projectile>
      <damageDef>BombSuper</damageDef>
      <damageAmountBase>2500</damageAmountBase>
      <explosionRadius>1.5</explosionRadius>
      <speed>600</speed>
      <flyOverhead>true</flyOverhead>
    </projectile>
  </ThingDef>

