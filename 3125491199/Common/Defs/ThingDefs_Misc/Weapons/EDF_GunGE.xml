<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ================================= EDF2 ==================================== -->

  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>EDF_II_GENO</defName>
    <label>Genocide Canon</label>
    <description>It is the ultimate weapon of destruction among those created by EDF. It fires an ultra-high-energy sphere that devastates a wide area centered on the point of impact, destroying everything in its path. It is said to be a recreation of the ultimate weapon of the invaders they once fought.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Weapon/RL/EDF_GEII</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.5</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <WorkToMake>200000</WorkToMake>
      <Mass>15</Mass>
      <RangedWeapon_Cooldown>15</RangedWeapon_Cooldown>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>EDF_Genocide</researchPrerequisite>
      <skillRequirements>
        <Crafting>20</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
      	<li>EDF_FabricBench</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Steel>300</Steel>
      <ComponentIndustrial>100</ComponentIndustrial>
      <Shell_HighExplosive>25</Shell_HighExplosive>
      <Shell_AntigrainWarhead>25</Shell_AntigrainWarhead>
    </costList>
    <weaponTags Inherit="False">
      <li>EDF_GE</li>
    </weaponTags>
    <tradeability>Sellable</tradeability>
    <generateCommonality>1</generateCommonality>
    <generateAllowChance>1</generateAllowChance>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_EDFGENOII</defaultProjectile>
        <forcedMissRadius>1</forcedMissRadius>
        <ai_AvoidFriendlyFireRadius>31</ai_AvoidFriendlyFireRadius>
        <warmupTime>2.5</warmupTime>
        <range>74.9</range>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <soundCast>InfernoCannon_Fire</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>10</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <relicChance>0</relicChance>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_EDFGENOII</defName>
    <label>Genocide Ray</label>
    <graphicData>
      <texPath>Things/Projectile/EDF_EXRay</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>3</drawSize>
    </graphicData>
    <thingClass>Projectile_Explosive</thingClass>
    <projectile>
      <damageDef>GENOCIDE_GUN</damageDef>
      <explosionRadius>50</explosionRadius>
      <speed>20</speed>
      <postExplosionSpawnThingDef>Filth_Ash</postExplosionSpawnThingDef>
      <postExplosionSpawnChance>1</postExplosionSpawnChance>
      <postExplosionSpawnThingCount>1</postExplosionSpawnThingCount>
      <flyOverhead>true</flyOverhead>
    </projectile>
  </ThingDef>

