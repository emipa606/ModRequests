<Defs>

  <!-- ================================= EDF4 ==================================== -->

  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>EDF_IV_BLAI</defName>
    <label>AL laser rifle</label>
    <description>High energy laser weapon developed by EDF. It destroys targets by shooting energy lasers in burst fire. It is an extremely powerful weapon, but it is produced in small numbers and is only equipped in small quantities by the elite "Omega Team.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Weapon/AR/EDF_FB</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.3</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <WorkToMake>60000</WorkToMake>
      <Mass>4.5</Mass>
      <AccuracyTouch>0.8</AccuracyTouch>
      <AccuracyShort>0.8</AccuracyShort>
      <AccuracyMedium>0.8</AccuracyMedium>
      <AccuracyLong>0.8</AccuracyLong>
      <RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>EDF_TILR</researchPrerequisite>
      <skillRequirements>
        <Crafting>12</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
      	<li>EDF_FabricBench</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>16</ComponentIndustrial>
    </costList>
    <weaponTags Inherit="False">
      <li>EDF_IV_BLAI</li>
    </weaponTags>
    <tradeability>Sellable</tradeability>
    <generateCommonality>1</generateCommonality>
    <generateAllowChance>1</generateAllowChance>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_EDFBLAI</defaultProjectile>
        <warmupTime>1.5</warmupTime>
        <range>32.9</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
        <soundCast>EDF_laserX</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <relicChance>0</relicChance>
  </ThingDef>

