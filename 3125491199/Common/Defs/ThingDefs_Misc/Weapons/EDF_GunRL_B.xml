<Defs>

  <!-- ================================= EDF4 ==================================== -->
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>EDF_IV_RLPI</defName>
    <label>A1 Plasma Bomber</label>
    <description>A special weapon that fires a plasma sphere. When the plasma ball hits something, it releases energy and explodes, blasting a wide area with an ultra-high-temperature blast. It is a powerful weapon, but it requires an enormous amount of energy, and there are only a few deployed even within EDF.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Weapon/RL/EDF_STI</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.4</drawSize>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <WorkToMake>60000</WorkToMake>
      <Mass>8.8</Mass>
      <RangedWeapon_Cooldown>5</RangedWeapon_Cooldown>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>EDF_TILR</researchPrerequisite>
      <skillRequirements>
        <Crafting>12</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
      	<li>EDF_FabricBench</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>30</ComponentIndustrial>
      <Shell_HighExplosive>2</Shell_HighExplosive>
    </costList>
    <weaponTags Inherit="False">
      <li>EDF_IV_RocketPI</li>
    </weaponTags>
    <tradeability>Sellable</tradeability>
    <generateCommonality>1</generateCommonality>
    <generateAllowChance>1</generateAllowChance>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_EDFRLPI</defaultProjectile>
        <forcedMissRadius>1</forcedMissRadius>
        <ai_AvoidFriendlyFireRadius>4</ai_AvoidFriendlyFireRadius>
        <warmupTime>3.5</warmupTime>
        <range>35.9</range>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <soundCast>EDF_RocketL</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>10</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <relicChance>0</relicChance>
  </ThingDef>

