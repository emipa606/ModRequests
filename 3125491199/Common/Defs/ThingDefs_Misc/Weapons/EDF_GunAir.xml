          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1</cooldownTime>
      </li>
    </tools>
    <relicChance>0</relicChance>
  </ThingDef>

  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>EDF_Air_BeetleI</defName>
    <label>Assault Beetle</label>
    <description>A beetle-shaped projectile weapon. It is loaded with high-performance explosives and explodes after being thrown. It is said that the reason they are made in the shape of beetles is to blend in with insect-type invader organisms, but the truth is not known.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Weapon/AIR/EDF_BeetleBombI</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.9</drawSize>
      <drawOffsetNorth>(0.0, 0.0, 0.0)</drawOffsetNorth>
      <drawOffsetEast>(0.15, 0.0, 0.0)</drawOffsetEast>
      <drawOffsetSouth>(0.0, 0.0, 0.0)</drawOffsetSouth>
      <drawOffsetWest>(-0.15, 0.0, 0.0)</drawOffsetWest>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <WorkToMake>20000</WorkToMake>
      <Mass>2.0</Mass>
      <RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>EDF_TIGR</researchPrerequisite>
      <skillRequirements>
        <Crafting>9</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
      	<li>EDF_FabricBench</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <weaponTags Inherit="False">
      <li>EDF_Null</li>
    </weaponTags>
    <tradeability>Sellable</tradeability>
    <generateCommonality>1</generateCommonality>
    <generateAllowChance>1</generateAllowChance>
    <verbs>
      <li>
        <verbClass>Verb_LaunchProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <range>19.9</range>
        <forcedMissRadius>0.9</forcedMissRadius>
        <warmupTime>0.3</warmupTime>
        <noiseRadius>1</noiseRadius>
        <soundCast>ThrowGrenade</soundCast>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <muzzleFlashScale>0</muzzleFlashScale>
        <defaultProjectile>Proj_BeetleI</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
    <tools>
      <li>
        <label>horn</label>
        <capacities>
          <li>Poke</li>
        </capacities>
        <power>6</power>
        <cooldownTime>1</cooldownTime>
      </li>
    </tools>
    <relicChance>0</relicChance>
  </ThingDef>

