  <ThingDef ParentName="BaseMeleeWeapon_Blunt_Quality">
    <defName>EDF_Air_Transmitter</defName>
    <label>EDF Transmitter</label>
    <description>Radio equipment widely operated by EDF. This is not connected to any channel and can only be used as a blunt instrument.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Apparel/Equipment/EDF_Transmitter</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.3</drawSize>
      <drawOffsetNorth>(0.0, 0.0, 0.0)</drawOffsetNorth>
      <drawOffsetEast>(0.15, 0.0, 0.0)</drawOffsetEast>
      <drawOffsetSouth>(0.0, 0.0, 0.0)</drawOffsetSouth>
      <drawOffsetWest>(-0.15, 0.0, 0.0)</drawOffsetWest>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <WorkToMake>2000</WorkToMake>
      <Mass>3.5</Mass>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>EDF_RequestI</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
