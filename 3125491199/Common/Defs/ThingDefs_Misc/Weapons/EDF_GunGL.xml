  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>EDF_IV_GLI</defName>
    <label>UM1</label>
    <description>Standard EDF grenade launcher. It fires grenade projectiles of the contact detonation type. It is easy to handle and has a certain level of rapid-fire power.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Weapon/GL/EDF_UMI</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.3</drawSize>
      <drawOffsetNorth>(0.0, 0.0, 0.0)</drawOffsetNorth>
      <drawOffsetEast>(0.15, 0.0, 0.0)</drawOffsetEast>
      <drawOffsetSouth>(0.0, 0.0, 0.0)</drawOffsetSouth>
      <drawOffsetWest>(-0.15, 0.0, 0.0)</drawOffsetWest>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <WorkToMake>40000</WorkToMake>
      <Mass>6.5</Mass>
      <RangedWeapon_Cooldown>5</RangedWeapon_Cooldown>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>EDF_TIGR</researchPrerequisite>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
      	<li>EDF_FabricBench</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>12</ComponentIndustrial>
      <Shell_HighExplosive>1</Shell_HighExplosive>
    </costList>
    <weaponTags Inherit="False">
      <li>EDF_IV_GLI</li>
    </weaponTags>
    <tradeability>Sellable</tradeability>
    <generateCommonality>1</generateCommonality>
    <generateAllowChance>1</generateAllowChance>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_EDFGLI</defaultProjectile>
        <forcedMissRadius>1</forcedMissRadius>
        <ai_AvoidFriendlyFireRadius>3</ai_AvoidFriendlyFireRadius>
        <warmupTime>2.5</warmupTime>
        <range>28.9</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>20</ticksBetweenBurstShots>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <soundCast>EDF_GL_lite</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>10</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <relicChance>0</relicChance>
  </ThingDef>

