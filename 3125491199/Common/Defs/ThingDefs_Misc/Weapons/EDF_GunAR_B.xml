  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>EDF_III_TITAI</defName>
    <label>Titania Auto Cannon</label>
    <description>A portable autocannon developed by Titania. It uses large-caliber bullets, so it can be expected to have high power and penetration, but it is also heavy and difficult to handle.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Weapon/AR/EDF_TITA</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.4</drawSize>
      <drawOffsetNorth>(0.0, 0.0, 0.0)</drawOffsetNorth>
      <drawOffsetEast>(0.15, 0.0, 0.0)</drawOffsetEast>
      <drawOffsetSouth>(0.0, 0.0, 0.0)</drawOffsetSouth>
      <drawOffsetWest>(-0.15, 0.0, 0.0)</drawOffsetWest>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <WorkToMake>50000</WorkToMake>
      <Mass>20</Mass>
      <AccuracyTouch>0.62</AccuracyTouch>
      <AccuracyShort>0.64</AccuracyShort>
      <AccuracyMedium>0.63</AccuracyMedium>
      <AccuracyLong>0.57</AccuracyLong>
      <RangedWeapon_Cooldown>2.5</RangedWeapon_Cooldown>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>EDF_TIAR</researchPrerequisite>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
      	<li>EDF_FabricBench</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>12</ComponentIndustrial>
    </costList>
    <equippedStatOffsets>
      <MoveSpeed>-0.4</MoveSpeed>
    </equippedStatOffsets>
    <weaponTags Inherit="False">
      <li>EDF_ARTITA_I</li>
    </weaponTags>
    <tradeability>Sellable</tradeability>
    <generateCommonality>1</generateCommonality>
    <generateAllowChance>1</generateAllowChance>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_EDFTITAI</defaultProjectile>
        <warmupTime>1.5</warmupTime>
        <range>32.9</range>
        <burstShotCount>5</burstShotCount>
        <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
        <soundCast>EDF_heavy</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>14</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <relicChance>0</relicChance>
  </ThingDef>

