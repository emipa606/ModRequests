<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="OrbitalStrikeBase">
    <defName>EDF_Bombardment</defName>
    <label>bombardment</label>
    <thingClass>Bombardment</thingClass>
    <comps>
      <li Class="CompProperties_OrbitalBeam">
        <width>0.2</width>
        <color>(255, 255, 255, 242)</color>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="OrbitalStrikeBase">
    <defName>EDF_PowerBeam</defName>
    <label>Satellite Blaster</label>
    <thingClass>PowerBeam</thingClass>
    <comps>
      <li Class="CompProperties_OrbitalBeam">
        <width>8</width>
        <color>(50, 200, 255, 250)</color>
        <sound>OrbitalBeam</sound>
      </li>
      <li Class="CompProperties_CameraShaker">
        <mag>0.03</mag>
      </li>
      <li Class="CompProperties_AffectsSky">
        <skyColors>
          <sky>(200, 230, 255)</sky>
          <shadow>(100, 220, 225)</shadow>
          <overlay>(255, 255, 255)</overlay>
          <saturation>1.3</saturation>
        </skyColors>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="OrbitalStrikeBase">
    <defName>EDF_PowerBeamII</defName>
    <label>Satellite Blaster</label>
    <thingClass>PowerBeam</thingClass>
    <comps>
      <li Class="CompProperties_OrbitalBeam">
        <width>8</width>
        <color>(50, 200, 255, 250)</color>
        <sound>OrbitalBeam</sound>
      </li>
      <li Class="CompProperties_CameraShaker">
        <mag>0.03</mag>
      </li>
      <li Class="CompProperties_AffectsSky">
        <skyColors>
          <sky>(200, 230, 255)</sky>
          <shadow>(100, 220, 225)</shadow>
          <overlay>(255, 255, 255)</overlay>
          <saturation>1.3</saturation>
        </skyColors>
      </li>
    </comps>
  </ThingDef>

</Defs>
