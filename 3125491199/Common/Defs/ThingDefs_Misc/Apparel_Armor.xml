<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="ArmorMachineableBase">
        <defName>EDF_VI_Camo</defName>
        <label>EDF camo uniform</label>
        <description>EDF old type camouflage uniform. deployed for second-line and lower fronts and auxiliary personnel, but tough enough to withstand a minimum of combat.</description>
        <tradeability>Sellable</tradeability>
        <graphicData>
        <texPath>Things/Apparel/Armor/EDF_VI_Camo/EDF_Camo</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>0.9</drawSize>
      </graphicData>
      <costList>
        <Steel>10</Steel>
        <Cloth>40</Cloth>
      </costList>
      <statBases>
        <WorkToMake>10000</WorkToMake>
        <MaxHitPoints>100</MaxHitPoints>
        <Mass>1.0</Mass>
        <Flammability>0.4</Flammability>
        <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
        <ArmorRating_Heat>0.35</ArmorRating_Heat>
        <Insulation_Cold>10</Insulation_Cold>
        <Insulation_Heat>10</Insulation_Heat>
        <EquipDelay>1.5</EquipDelay>
      </statBases>
      <thingCategories Inherit="False">
        <li>ApparelMisc</li>
      </thingCategories>
      <apparel>
        <bodyPartGroups>
          <li>Torso</li>
          <li>Neck</li>
          <li>Shoulders</li>
          <li>Arms</li>
          <li>Hands</li>
        </bodyPartGroups>
        <wornGraphicPath>Things/Apparel/Armor/EDF_VI_Camo/EDF_Camo</wornGraphicPath>
        <layers>
          <li>OnSkin</li>
        </layers>
        <tags Inherit="False">
          <li>EDF</li>
        </tags>
        <defaultOutfitTags Inherit="False">
          <li>EDF</li>
        </defaultOutfitTags>
        <useDeflectMetalEffect>true</useDeflectMetalEffect>
      </apparel>
      <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <only>(0.3,0.5,0.3,1)</only>
        </li>
      </options>
      </colorGenerator>
      <recipeMaker>
          <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
          <researchPrerequisite>EDF_TI</researchPrerequisite>
        <skillRequirements>
          <Crafting>6</Crafting>
        </skillRequirements>
        <recipeUsers Inherit="False">
          <li>EDF_FabricBench</li>
        </recipeUsers>
      </recipeMaker>
    </ThingDef>

