<Defs>

    <ThingDef ParentName="ArmorHelmetMakeableBase">
        <defName>EDF_VI_CamoKepi</defName>
        <label>EDF Camo Kepi</label>
        <description>EDF's old-style camouflage cap. It is more like an officer's uniform than a combat cap, but it is sturdily made and can withstand combat to some extent.</description>
        <tradeability>Sellable</tradeability>
        <graphicData>
        <texPath>Things/Apparel/Helmet/EDF_VI_CamoKepi/EDF_CamoKepi</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>0.9</drawSize>
      </graphicData>
      <costList>
        <Steel>10</Steel>
        <Cloth>20</Cloth>
      </costList>
      <statBases>
        <WorkToMake>3000</WorkToMake>
        <MaxHitPoints>100</MaxHitPoints>
        <Mass>0.3</Mass>
        <Flammability>0.4</Flammability>
        <ArmorRating_Sharp>0.25</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
        <ArmorRating_Heat>0.4</ArmorRating_Heat>
        <Insulation_Cold>2</Insulation_Cold>
        <Insulation_Heat>4</Insulation_Heat>
        <EquipDelay>1.5</EquipDelay>
      </statBases>
      <thingCategories Inherit="False">
        <li>Headgear</li>
      </thingCategories>
      <apparel>
        <bodyPartGroups>
          <li>UpperHead</li>
        </bodyPartGroups>
        <wornGraphicPath>Things/Apparel/Helmet/EDF_VI_CamoKepi/EDF_CamoKepi</wornGraphicPath>
        <layers>
          <li>Overhead</li>
        </layers>
        <tags Inherit="False">
          <li>EDF</li>
        </tags>
        <defaultOutfitTags Inherit="False">
          <li>EDF</li>
        </defaultOutfitTags>
      </apparel>
      <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <only>(0.3,0.5,0.3,1)</only>
        </li>
      </options>
      </colorGenerator>
      <recipeMaker>
          <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
          <researchPrerequisite>EDF_TI</researchPrerequisite>
        <skillRequirements>
          <Crafting>6</Crafting>
        </skillRequirements>
        <recipeUsers Inherit="False">
          <li>EDF_FabricBench</li>
        </recipeUsers>
