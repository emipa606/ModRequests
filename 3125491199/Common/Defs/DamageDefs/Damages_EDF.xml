<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <DamageDef Name="EDFBombAcid">
    <defName>EDF_Acid</defName>
    <label>Acid</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <isExplosive>true</isExplosive>
    <deathMessage>{0} was dissolved in acid and died.</deathMessage>
    <hediff>ChemicalBurn</hediff>
    <hediffSolid>ChemicalBurn</hediffSolid>
    <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
    <impactSoundType>Blunt</impactSoundType>
    <armorCategory>Sharp</armorCategory>
    <minDamageToFragment>10</minDamageToFragment>
    <defaultDamage>20</defaultDamage>
    <defaultStoppingPower>0.3</defaultStoppingPower>
    <defaultArmorPenetration>0.7</defaultArmorPenetration>
    <buildingDamageFactorImpassable>0.5</buildingDamageFactorImpassable>
    <buildingDamageFactorPassable>0.5</buildingDamageFactorPassable>
    <plantDamageFactor>1.5</plantDamageFactor>
    <corpseDamageFactor>0.5</corpseDamageFactor>
    <explosionAffectOutsidePartsOnly>false</explosionAffectOutsidePartsOnly>
    <explosionHeatEnergyPerCell>0</explosionHeatEnergyPerCell>
    <explosionCellFleck>BlastEMP</explosionCellFleck>
    <explosionColorCenter>(0.9, 0.7, 0.4)</explosionColorCenter>
    <explosionColorEdge>(0.9, 0.8, 0.5)</explosionColorEdge>
    <overkillPctToDestroyPart>0.4~0.7</overkillPctToDestroyPart>
    <soundExplosion>EDF_AcidBurn</soundExplosion>
    <combatLogRules>Damage_Bomb</combatLogRules>
  </DamageDef>

