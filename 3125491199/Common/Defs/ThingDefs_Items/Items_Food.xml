<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="MealBase">
    <defName>MealSolasbread</defName>
    <label>Solas bread</label>
    <description>A cute bread with a Solas motif. A popular product of Acid Bakery.</description>
    <graphicData>
      <texPath>Things/Item/EDF_Solasbread</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <DeteriorationRate>0.25</DeteriorationRate>
      <MarketValue>10</MarketValue>
      <Mass>0.2</Mass>
      <WorkToMake>400</WorkToMake>
      <Nutrition>0.6</Nutrition>
    </statBases>
    <ingestible>
      <preferability>MealSimple</preferability>
      <tasteThought>AteFineMeal</tasteThought>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
    </ingestible>
    <tradeability>Buyable</tradeability>
  </ThingDef>

  <ThingDef ParentName="MealBase">
    <defName>EDF_SushiA</defName>
    <label>Air raider Sushi</label>
    <description>This is Air Raider's special high-end nigirizushi. It is unclear what kind of meat is used, much less whether it is even fish, but the only thing that is certain is that this nigirizushi is very tasty. but Because it is perishable, it is very easily damaged and should be eaten or frozen as soon as possible.</description>
    <graphicData>
      <texPath>Things/Item/EDF_SushiA</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <DeteriorationRate>0.25</DeteriorationRate>
      <MarketValue>10</MarketValue>
      <Mass>0.2</Mass>
      <Nutrition>0.6</Nutrition>
    </statBases>
    <stackLimit>10</stackLimit>
    <ingestible>
      <preferability>MealLavish</preferability>
      <tasteThought>AteLavishMeal</tasteThought>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
    </ingestible>
    <tradeability>Sellable</tradeability>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>0.50</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="MealBase">
    <defName>EDF_SushiB</defName>
    <label>Packaged Air raider Sushi</label>
    <description>Sushi packaged for easy storage. As usual, the ingredients are unknown, but that is a minor issue before the taste. The flavor of the sushi has been slightly reduced by the packing, but at the same time, it is less prone to damage.</description>
    <graphicData>
      <texPath>Things/Item/EDF_SushiB</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <DeteriorationRate>0.25</DeteriorationRate>
      <MarketValue>10</MarketValue>
      <Mass>0.25</Mass>
      <Nutrition>0.6</Nutrition>
    </statBases>
    <stackLimit>30</stackLimit>
    <ingestible>
      <preferability>MealFine</preferability>
      <tasteThought>AteFineMeal</tasteThought>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
    </ingestible>
    <tradeability>Sellable</tradeability>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>1.5</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
  </ThingDef>

</Defs>
