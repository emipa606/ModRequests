<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>EDF_Credit</defName>
    <label>EDF Credit</label>
    <description>A ticket indicating that you have contributed to EDF. Also called reload points or merit values. They can be exchanged for items at dedicated facilities and can be used to reload some weapons.</description>
    <graphicData>
      <texPath>Things/Item/EDF_Credit</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <resourceReadoutPriority>First</resourceReadoutPriority>
    <soundInteract>Silver_Drop</soundInteract>
    <soundDrop>Silver_Drop</soundDrop>
    <useHitPoints>false</useHitPoints>
    <resourceReadoutAlwaysShow>false</resourceReadoutAlwaysShow>
    <statBases>
      <MarketValue>0</MarketValue>
      <Mass>0.001</Mass>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <stackLimit>5000</stackLimit>
    <deepCommonality>0</deepCommonality>
    <burnableByRecipe>false</burnableByRecipe>
    <smeltable>false</smeltable>
    <stuffProps>
      <categories></categories>
      <color>(1,1,1)</color>
      <commonality>0</commonality>
      <constructEffect>ConstructMetal</constructEffect>
      <statOffsets>
        <Beauty>1</Beauty>
      </statOffsets>
      <statFactors>
        <MaxHitPoints>1</MaxHitPoints>
        <Beauty>1</Beauty>
      </statFactors>
    </stuffProps>
  </ThingDef>

</Defs>
