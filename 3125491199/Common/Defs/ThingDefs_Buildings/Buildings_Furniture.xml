<Defs>

  <!-- Item Box -->

  <DesignatorDropdownGroupDef>
    <defName>EDF_PropGroup_ItemBox</defName>
    <label>ItemBox</label>
  </DesignatorDropdownGroupDef>

    <ThingDef ParentName="FurnitureBase">
    <defName>EDF_ArmorBoxA</defName>
    <label>EDF ArmorBox</label>
    <description>Storage box for armor.</description>
    <designatorDropdown>EDF_PropGroup_ItemBox</designatorDropdown>
    <graphicData>	
      <texPath>Things/Building/Props/EDF_ARBoxIV</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2.3,1.3)</drawSize>
    </graphicData>
    <tickerType>Normal</tickerType>
    <researchPrerequisites>
      <li>EDF_Prop</li>
    </researchPrerequisites>
    <altitudeLayer>Building</altitudeLayer>
    <castEdgeShadows>False</castEdgeShadows>
    <passability>PassThroughOnly</passability>
    <blockWind>true</blockWind>
    <fillPercent>0.5</fillPercent>
    <pathCost>50</pathCost>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <repairEffect>ConstructMetal</repairEffect>
    <statBases>
      <MaxHitPoints>20</MaxHitPoints>
      <WorkToBuild>100</WorkToBuild>
      <Mass>10</Mass>
      <Flammability>0.2</Flammability>
      <Beauty>3</Beauty>
    </statBases>
    <size>(2,1)</size>
    <costList>
      <Steel>10</Steel>
    </costList>
    <uiIconScale>1</uiIconScale>
  </ThingDef>

