  <!-- Table Top -->

  <DesignatorDropdownGroupDef>
    <defName>EDF_PropGroup_TableTop</defName>
    <label>TableTop Prop</label>
  </DesignatorDropdownGroupDef>

    <ThingDef ParentName="FurnitureBase">
    <defName>EDF_AFPropA</defName>
    <label>AF-14(A)</label>
    <description>EDF service rifle. Non-movable model.</description>
    <designatorDropdown>EDF_PropGroup_TableTop</designatorDropdown>
    <graphicData>	
      <texPath>Things/Building/Props/EDF_PropItems/EDF_AF14PropA</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.3,1.3)</drawSize>
    </graphicData>
    <tickerType>Normal</tickerType>
    <researchPrerequisites>
      <li>EDF_Prop</li>
    </researchPrerequisites>
    <altitudeLayer>Item</altitudeLayer>
    <castEdgeShadows>False</castEdgeShadows>
    <passability>Standable</passability>
    <blockWind>false</blockWind>
    <fillPercent>0</fillPercent>
    <pathCost>0</pathCost>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <repairEffect>ConstructMetal</repairEffect>
    <building>
      <isEdifice>false</isEdifice>
      <isInert>true</isInert>
    </building>
    <statBases>
      <MaxHitPoints>10</MaxHitPoints>
      <WorkToBuild>10</WorkToBuild>
      <Mass>5</Mass>
      <Flammability>0.1</Flammability>
      <Beauty>3</Beauty>
    </statBases>
    <size>(1,1)</size>
    <costList>
      <Steel>10</Steel>
    </costList>
    <uiIconScale>1</uiIconScale>
    <clearBuildingArea>false</clearBuildingArea>
  </ThingDef>

