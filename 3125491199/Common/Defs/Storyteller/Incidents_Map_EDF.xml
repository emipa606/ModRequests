<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <IncidentDef>
    <defName>EDF_RavagerShipCrash</defName>
    <label>RavagerShipCrash</label>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>IncidentWorker_CrashedShipPart</workerClass>
    <letterLabel>Ravager transport ship</letterLabel>
    <letterText>After a loud bang, the Ravager transport crashed! It appears to be heavily damaged, but the material transfer equipment in the lower part of the hull continues to emit a faint glow. Vital parts still seem to be functioning...</letterText>
    <letterDef>ThreatBig</letterDef>
    <baseChance>0.2</baseChance>
    <baseChanceWithRoyalty>0.2</baseChanceWithRoyalty>
    <minRefireDays>25</minRefireDays>
    <tags>
      <li>RavagerShip</li>
    </tags>
    <refireCheckTags>
      <li>RavagerShip</li>
    </refireCheckTags>
    <category>ThreatBig</category>
    <pointsScaleable>true</pointsScaleable>
    <minThreatPoints>400</minThreatPoints>
    <mechClusterBuilding>EDF_CrasedRavagerShip</mechClusterBuilding>
    <tale>ShipPartCrash</tale>
  </IncidentDef>

  <ThingDef ParentName="BuildingBase">
    <defName>EDF_CrasedRavagerShip</defName>
    <label>Crased RavagerShip</label>
    <description>An invasion transport ship operated by Ravager. It was severely damaged by some kind of attack and is in a dormant state. Its electromagnetic armor, which neutralizes conventional firearms, seems to have been lost in the crash and can be destroyed by attack.
However, there is a danger that the remaining energy will activate the transporter, and the Ravager's attack force will emerge.</description>
    <altitudeLayer>Building</altitudeLayer>
    <pathCost>50</pathCost>
    <blockWind>true</blockWind>
    <passability>PassThroughOnly</passability>
    <fillPercent>1.0</fillPercent>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <drawerType>MapMeshAndRealTime</drawerType>
    <repairEffect>ConstructMetal</repairEffect>
    <forceDebugSpawnable>true</forceDebugSpawnable>
    <receivesSignals>true</receivesSignals>
    <isMechClusterThreat>false</isMechClusterThreat>
    <size>(8,4)</size>
    <statBases>
      <MaxHitPoints>3000</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>-20</Beauty>
      <WorkToBuild>500</WorkToBuild>
    </statBases>
    <graphicData>
      <texPath>Things/Building/Enemy/EDF_RavagerTShip_A</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(8,4)</drawSize>
      <shadowData>
        <volume>(1.8, 0.7, 2.8)</volume>
      </shadowData>
    </graphicData>
    <building>
      <combatPower>100</combatPower>
      <buildingTags>
        <li>None</li>
      </buildingTags>
      <roofCollapseDamageMultiplier>0.2</roofCollapseDamageMultiplier>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <costList>
      <ComponentIndustrial>30</ComponentIndustrial>
      <Plasteel>80</Plasteel>
    </costList>
    <killedLeavings>
      <ChunkSlagSteel>6</ChunkSlagSteel>
      <ComponentIndustrial>25</ComponentIndustrial>
      <Plasteel>75</Plasteel>
    </killedLeavings>
    <damageMultipliers>
      <li>
        <damageDef>Flame</damageDef>
        <multiplier>0</multiplier>
      </li>
    </damageMultipliers>
    <comps>
      <li Class="CompProperties_CanBeDormant" />
      <li Class="CompProperties_WakeUpDormant">
        <wakeUpSound>MechanoidsWakeUp</wakeUpSound>
      </li>
      <li Class="CompProperties_PawnSpawnOnWakeup">
        <points>800~3600</points>
        <spawnablePawnKinds>
          <li>Mech_HectorA_MG</li>
          <li>Mech_HectorA_GL</li>
        </spawnablePawnKinds>
        <spawnSound>CryptosleepCasket_Eject</spawnSound>
        <lordJob>LordJob_MechanoidsDefend</lordJob>
        <shouldJoinParentLord>True</shouldJoinParentLord>
      </li>
    </comps>
  </ThingDef>

</Defs>