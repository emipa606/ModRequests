<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <RecipeDef>
    <defName>EDF_Calculation</defName>
    <label>EDF Business Support</label>
    <description>Assist EDF regarding its external operations. If you complete the work, you will be recognized for some contribution.</description>
    <jobString>Working for EDF.</jobString>
    <effectWorking>Research</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>20000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <products>
      <EDF_Credit>5</EDF_Credit>
    </products>
    <recipeUsers>
      <li>EDF_Workstation</li>
    </recipeUsers>
    <researchPrerequisite>EDF_Advanced</researchPrerequisite>
  </RecipeDef>

  <RecipeDef>
    <defName>EDF_OfferCorpses</defName>
    <label>Offer Corpses for sushi items</label>
    <description>Offer sushi items to air raiders.</description>
    <jobString>Offering sushi items.</jobString>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>300</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <autoStripCorpses>false</autoStripCorpses>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Corpses</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <products>
      <EDF_Credit>5</EDF_Credit>
    </products>
    <fixedIngredientFilter>
      <categories>
        <li>Corpses</li>
      </categories>
    </fixedIngredientFilter>
    <defaultIngredientFilter>
      <thingDefs>
        <li>Corpse_Human</li>
      </thingDefs>
      <specialFiltersToAllow>
        <li>AllowCorpsesColonist</li>
        <li>AllowCorpsesStranger</li>
      </specialFiltersToAllow>
    </defaultIngredientFilter>
    <recipeUsers>
      <li>EDF_AirSushiya</li>
    </recipeUsers>
  </RecipeDef>

  <RecipeDef>
    <defName>EDF_OfferCorpsesS</defName>
    <label>Offer Corpses for sushi items(fresh)</label>
    <description>Offer sushi items to air raiders.(Offers limited to fresh)</description>
    <jobString>Offering sushi items.</jobString>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>300</workAmount>
