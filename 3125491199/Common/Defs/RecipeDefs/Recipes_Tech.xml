<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <RecipeDef>
    <defName>EDF_TechResearchI</defName>
    <label>Production EDF Techprint(Forefront)</label>
    <description>Analyze a huge database of EDFs and produce tech prints for advanced technology unlocking. Analysis takes a long time.</description>
    <jobString>Analyze technology.</jobString>
    <workAmount>100000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
    <skillRequirements>
       <Crafting>8</Crafting>
    </skillRequirements>
	<researchPrerequisite>EDF_TA</researchPrerequisite>
    <products>
      <Techprint_EDF_Forefront>1</Techprint_EDF_Forefront>
    </products>
    <ingredients Inherit="False">
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
      <recipeUsers>
          <li>EDF_Workstation</li>
      </recipeUsers>
  </RecipeDef>

