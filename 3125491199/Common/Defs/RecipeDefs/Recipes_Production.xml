<Defs>

  <RecipeDef>
    <defName>EDF_MakePlasteel</defName>
    <label>production Plasteel</label>
    <description>Special processing is applied to Steel to produce Plasteel with superior strength.</description>
    <jobString>Tuning nanomachines.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>3000</workAmount>
    <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>30</count>
      </li>
    </ingredients>
    <recipeUsers>
      <li>EDF_NanoBench</li>
    </recipeUsers>
    <products>
      <Plasteel>15</Plasteel>
    </products>
    <skillRequirements>
      <Crafting>14</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <displayPriority>0</displayPriority>
  </RecipeDef>

