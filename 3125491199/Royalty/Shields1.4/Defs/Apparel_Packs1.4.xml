<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ================================== EDF4.5.6 ====================================-->

  <ThingDef ParentName="ApparelNoQualityBase">
    <thingClass>EDF_Deployment.EDF_Deployshield</thingClass>
    <defName>EDF_ShieldPackI</defName>
    <label>Electromagnetic bunker</label>
    <description>An installed energy shield generator. It can be carried by individuals and can be deployed at any location to establish a defense point. The device is equipped with a system that identifies the target of the assault of a passing object, preventing enemy attacks while allowing friendly attacks to pass through.The installed equipment will self-destruct to prevent overloading after operating for a certain period of time.</description>
    <tradeability>Sellable</tradeability>
    <graphicData>
      <texPath>Things/Apparel/Equipment/EDF_Bunker</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>8000</WorkToMake>
      <Mass>10</Mass>
      <Flammability>0.4</Flammability>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <comps>
      <li Class="CompProperties_Reloadable">
        <maxCharges>1</maxCharges>
        <destroyOnEmpty>true</destroyOnEmpty>
        <soundReload>Standard_Reload</soundReload>
        <hotKey>Misc4</hotKey>
        <chargeNoun>shield</chargeNoun>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
      </li>
    </comps>
    <verbs>
      <li>
        <verbClass>EDF_Deployment.Verb_EDF_DeployshieldI</verbClass>
        <label>deploy bunker</label>
        <violent>false</violent>
        <hasStandardCommand>true</hasStandardCommand>
        <targetable>false</targetable>
        <nonInterruptingSelfCast>true</nonInterruptingSelfCast>
        <onlyManualCast>True</onlyManualCast>
      </li>
    </verbs>
    <costList>
      <Steel>30</Steel>
      <Plasteel>5</Plasteel>
      <ComponentIndustrial>20</ComponentIndustrial>
    </costList>
    <tickerType>Normal</tickerType>
    <thingCategories Inherit="False">
      <li>ApparelUtility</li>
    </thingCategories>
    <generateAllowChance>1</generateAllowChance>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <scoreOffset>4</scoreOffset>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups>
        <li>Waist</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <tags Inherit="False">
        <li>EDF</li>
      </tags>
      <defaultOutfitTags Inherit="False">
        <li>EDF</li>
      </defaultOutfitTags>
    </apparel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedPack</unfinishedThingDef>
      <researchPrerequisite>EDF_Support</researchPrerequisite>
      <skillRequirements>
        <Crafting>14</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>EDF_FabricBench</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>

