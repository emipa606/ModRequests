<Patch>
    
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Furniture Expanded - Power</li>
        </mods>
        <match Class="PatchOperationAddModExtension">
            <xpath>/Defs/WeatherDef[defName="VPE_RadioactiveFog"]</xpath>
            <value>
                <li Class="UINotIncluded.WeatherDefExtension">
                    <icon>GD/UI/Icons/Weather/VPE_RadioactiveFog</icon>
                </li>
            </value>
        </match>
    </Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>ReGrowth 2</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationAddModExtension">
                    <xpath>/Defs/WeatherDef[defName="RG_Windy"]</xpath>
                    <value>
                        <li Class="UINotIncluded.WeatherDefExtension">
                            <icon>GD/UI/Icons/Weather/RG_Windy</icon>
                        </li>
                    </value>
                </li>
                <li Class="PatchOperationAddModExtension">
                    <xpath>/Defs/WeatherDef[defName="RG_Drizzle"]</xpath>
                    <value>
                        <li Class="UINotIncluded.WeatherDefExtension">
                            <icon>GD/UI/Icons/Weather/RG_Drizzle</icon>
                        </li>
                    </value>
                </li>

                <li Class="PatchOperationAddModExtension">
                    <xpath>/Defs/WeatherDef[defName="RG_FoggySnow"]</xpath>
                    <value>
                        <li Class="UINotIncluded.WeatherDefExtension">
                            <icon>GD/UI/Icons/Weather/RG_FoggySnow</icon>
                        </li>
                    </value>
                </li>
                
				<li Class="PatchOperationAddModExtension">
                    <xpath>/Defs/WeatherDef[defName="RG_FogStorm"]</xpath>
                    <value>
                        <li Class="UINotIncluded.WeatherDefExtension">
                            <icon>GD/UI/Icons/Weather/RG_FogStorm</icon>
                        </li>
                    </value>
                </li>
                
            </operations>
		</match>
    </Operation>

</Patch>