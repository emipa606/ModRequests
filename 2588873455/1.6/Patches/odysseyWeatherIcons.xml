<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Odyssey</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationAddModExtension">
                    <xpath>/Defs/WeatherDef[defName="Windy"]</xpath>
                    <value>
                        <li Class="UINotIncluded.WeatherDefExtension">
                            <icon>GD/UI/Icons/Weather/RG_Windy</icon>
                        </li>
                    </value>
                </li>
				<li Class="PatchOperationAddModExtension">
                    <xpath>/Defs/WeatherDef[defName="ToxRain"]</xpath>
                    <value>
                        <li Class="UINotIncluded.WeatherDefExtension">
                            <icon>GD/UI/Icons/Weather/ToxRain</icon>
                        </li>
                    </value>
                </li>
				<li Class="PatchOperationAddModExtension">
                    <xpath>/Defs/WeatherDef[defName="Sandstorm"]</xpath>
                    <value>
                        <li Class="UINotIncluded.WeatherDefExtension">
                            <icon>GD/UI/Icons/Weather/RG_SandStorm</icon>
                        </li>
                    </value>
                </li>
				<li Class="PatchOperationAddModExtension">
                    <xpath>/Defs/WeatherDef[defName="BlindFog"]</xpath>
                    <value>
                        <li Class="UINotIncluded.WeatherDefExtension">
                            <icon>GD/UI/Icons/Weather/BlindFog</icon>
                        </li>
                    </value>
                </li>
				<li Class="PatchOperationAddModExtension">
                    <xpath>/Defs/WeatherDef[defName="Overcast"]</xpath>
                    <value>
                        <li Class="UINotIncluded.WeatherDefExtension">
                            <icon>GD/UI/Icons/Weather/RG_Overcast</icon>
                        </li>
                    </value>
                </li>
				<li Class="PatchOperationAddModExtension">
                    <xpath>/Defs/WeatherDef[defName="Blizzard"]</xpath>
                    <value>
                        <li Class="UINotIncluded.WeatherDefExtension">
                            <icon>GD/UI/Icons/Weather/RG_Blizzard</icon>
                        </li>
                    </value>
                </li>
				<li Class="PatchOperationAddModExtension">
                    <xpath>/Defs/WeatherDef[defName="TorrentialRain"]</xpath>
                    <value>
                        <li Class="UINotIncluded.WeatherDefExtension">
                            <icon>GD/UI/Icons/Weather/RG_Monsoon</icon>
                        </li>
                    </value>
                </li>
				<li Class="PatchOperationAddModExtension">
                    <xpath>/Defs/WeatherDef[defName="Orbit"]</xpath>
                    <value>
                        <li Class="UINotIncluded.WeatherDefExtension">
                            <icon>GD/UI/Icons/Weather/Orbit</icon>
                        </li>
                    </value>
                </li>
            </operations>
		</match>
    </Operation>

</Patch>