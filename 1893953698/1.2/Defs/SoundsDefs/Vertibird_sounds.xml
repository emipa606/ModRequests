<Defs>

	<!-- ==================== takeoff ================================ -->

	<SoundDef>
		<defName>vertibirdtakeoff</defName>
		<context>MapOnly</context>
		<eventNames />  
		<maxSimultaneous>2</maxSimultaneous>
		<subSounds>
			<li>
				<grains>
					<li Class="AudioGrain_Clip">
						<clipPath>vertibirdtakeoff</clipPath>
					</li>
				</grains>
				<pitchRange>
					<min>0.9152174</min>
					<max>1.042391</max>
				</pitchRange>
			</li>
		</subSounds>
	</SoundDef>

