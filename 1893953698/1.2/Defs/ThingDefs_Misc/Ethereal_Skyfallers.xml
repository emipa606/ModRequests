<?xml version="1.0" encoding="utf-8" ?>
<Defs>


  <ThingDef ParentName="SkyfallerBase">
    <defName>VertibirdIncoming</defName>
    <label>Vertibird(incoming)</label>
		<thingClass>DropPodIncoming</thingClass>
    <graphicData>
      <texPath>Vertibird_active</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>9</drawSize>
    </graphicData>
    <skyfaller>
      <movementType>Decelerate</movementType>
      <shadow>Things/Skyfaller/SkyfallerShadowDropPod</shadow>
      <shadowSize>(6,3)</shadowSize>
      <anticipationSound>vertibirdlanding</anticipationSound>
      <anticipationSoundTicks>150</anticipationSoundTicks>
      <motesPerCell>1</motesPerCell>
    </skyfaller>
  </ThingDef>

  <ThingDef ParentName="SkyfallerBase">
    <defName>VertibirdLeaving</defName>
    <label>Vertibird(leaving)</label>
		<thingClass>VertibirdHelo.VertibirdLeaving</thingClass>
    <graphicData>
      <texPath>Vertibird_active</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>9</drawSize>
    </graphicData>
    <skyfaller>
      <movementType>Decelerate</movementType>
      <reversed>true</reversed>
      <shadow>Things/Skyfaller/SkyfallerShadowDropPod</shadow>
      <shadowSize>(6,3)</shadowSize>
      <anticipationSound>vertibirdtakeoff</anticipationSound>
      <anticipationSoundTicks>-60</anticipationSoundTicks>
      <ticksToImpactRange><min>-60</min><max>-60</max></ticksToImpactRange>
    </skyfaller>
  </ThingDef>




</Defs>
