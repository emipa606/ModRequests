<?xml version="1.0" encoding="utf-8" ?>
<Defs>


  


  <ThingDef ParentName="SkyfallerBase">
    <defName>VertihawkIncoming</defName>
    <label>Vertihawk(incoming)</label>
		<thingClass>DropPodIncoming</thingClass>
    <graphicData>
      <texPath>Vertihawk_active</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>9</drawSize>
    </graphicData>
    <skyfaller>
      <movementType>Decelerate</movementType>
      <shadow>Things/Skyfaller/SkyfallerShadowDropPod</shadow>
      <shadowSize>(6,3)</shadowSize>
      <anticipationSound>vertihawklanding</anticipationSound>
      <anticipationSoundTicks>50</anticipationSoundTicks>
      <motesPerCell>1</motesPerCell>
    </skyfaller>
  </ThingDef>

  <ThingDef ParentName="SkyfallerBase">
    <defName>VertihawkLeaving</defName>
    <label>Vertihawk(leaving)</label>
		<thingClass>VertihawkHelo.VertihawkLeaving</thingClass>
    <graphicData>
      <texPath>Vertihawk_active</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>9</drawSize>
    </graphicData>
    <skyfaller>
      <movementType>Decelerate</movementType>
      <reversed>true</reversed>
      <shadow>Things/Skyfaller/SkyfallerShadowDropPod</shadow>
      <shadowSize>(6,3)</shadowSize>
      <anticipationSound>vertihawktakeoff</anticipationSound>
      <anticipationSoundTicks>-150</anticipationSoundTicks>
      <ticksToImpactRange><min>-150</min><max>-150</max></ticksToImpactRange>
    </skyfaller>
  </ThingDef>


</Defs>
