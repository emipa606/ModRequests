<?xml version="1.0" encoding="utf-8" ?>
<Defs>


  
<ThingDef ParentName="BuildingBase">
    <defName>Building_Vertihawk</defName>
    <label>XVH-01 Vertihawk</label>
    <description>A reworked version of the XVB-02, formerly known as "Vertibird" troop transport. Following the new Brotherhood doctrine establishing surface exploration as a priority, several recovered vertibirds undergone a drastic modification procedure, known as the Vertihawk Program. Compared to its predecessor, the main improvement is the replacement of the classic four-blades propellers by two hybrid pulse-turbofans engines, providing subsonic flight capabilities while retaining the VTOL design, and also accepting most common type of carburants. The XVH-01 Vertihawk variant is mainly dedicated to planetary reconnaissance or swift troop transport, although some wastelanders reports having seen them providing brief air support for Brotherhood ground troops.</description>
    <graphicData>
      <texPath>Vertihawk</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
<shaderType>CutoutComplex</shaderType>
      <drawSize>(9,9)</drawSize>
    </graphicData>
<staticSunShadowHeight>2</staticSunShadowHeight>
 <castEdgeShadows>false</castEdgeShadows>
    <size>(3,6)</size>
    <rotatable>true</rotatable>
    <tickerType>Normal</tickerType>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <designationCategory>Misc</designationCategory>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
 <thingCategories>
               <li>BuildingsSpecial</li>
    </thingCategories>
 <minifiedDef>MinifiedThing</minifiedDef>
    <statBases>
      <MaxHitPoints>650</MaxHitPoints>
      <WorkToBuild>4600</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Mass>7000</Mass>
    </statBases>
    <costList>
	  <Plasteel>450</Plasteel>
      <Steel>450</Steel>
<TechprofSubpersonaCore>1</TechprofSubpersonaCore>
      <ComponentIndustrial>24</ComponentIndustrial>
	  <ComponentSpacer>12</ComponentSpacer>
    </costList>
<defaultPlacingRot>East</defaultPlacingRot>
    <comps>
      <li Class="CompProperties_Transporter">
        <restEffectiveness>0.7</restEffectiveness>
		<massCapacity>800</massCapacity>
      </li>
      <li Class="VertihawkHelo.CompProperties_LaunchableHelicopter" />
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>300.0</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>75</initialConfigurableTargetFuelLevel>
        <fuelFilter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </fuelFilter>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
		<drawFuelGaugeInMap>false</drawFuelGaugeInMap>
 </li>
	  <li Class="CompProperties_Explosive">
        <explosiveRadius>7</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <chanceNeverExplodeFromDamage>0.2</chanceNeverExplodeFromDamage>
      
      </li>
    </comps>
    <inspectorTabs>
      <li>ITab_TransporterContents</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_NotUnderRoof</li>
    </placeWorkers>
		<researchPrerequisites>
			<li>BoS_Vertihawk</li>
		</researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <uiIconScale>0.85</uiIconScale>
  </ThingDef>
  




<ThingDef ParentName="BuildingBase">
		<defName>DRK_VertihawkModel</defName>
		<label>Vertihawk model</label>
		<description>A very accurate and nicely painted miniature Vertihawk model. Handle with care.</description>
		<category>Building</category>
		<thingClass>Building</thingClass>
		<graphicData>
			<texPath>VertihawkModel</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawRotated>false</drawRotated>
			<drawSize>(1,1)</drawSize>
			<damageData>
				<rect>(0.35,0.35,0.3,0.3)</rect>
			</damageData>
		</graphicData>
		<uiIconPath>VertihawkModel</uiIconPath>
		<uiIconScale>1</uiIconScale>
		<uiIconOffset>(0,0.15)</uiIconOffset>
		<rotatable>true</rotatable>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>8</pathCost>
		<constructEffect>ConstructWood</constructEffect>
		<fillPercent>0.15</fillPercent>
		<statBases>
			<MaxHitPoints>40</MaxHitPoints>
			<WorkToBuild>100</WorkToBuild>
			<Flammability>0</Flammability>
			<Mass>1</Mass>
			<Beauty>20</Beauty>
		</statBases>
		<selectable>true</selectable>
		<costList>
			<WoodLog>10</WoodLog>
		</costList>
		<building>
			<isEdifice>false</isEdifice>
		</building>
		<soundImpactDefault>BulletImpact_Ground</soundImpactDefault>
		<defaultPlacingRot>South</defaultPlacingRot>
		<designationCategory>Furniture</designationCategory>
		<destroyable>true</destroyable>
		<tradeability>Sellable</tradeability>
		<clearBuildingArea>false</clearBuildingArea>
		<minifiedDef>MinifiedThing</minifiedDef>		
		<thingCategories>
			<li>BuildingsFurniture</li>
		</thingCategories>
		<constructionSkillPrerequisite>8</constructionSkillPrerequisite>
<researchPrerequisites>
			<li>BoS_Vertihawk</li>
		</researchPrerequisites>
	</ThingDef>

  

  
  <ThingDef ParentName="BuildingBase">
    <defName>Building_Vertibird</defName>
    <label>XVB-02 Vertibird</label>
    <description>Vertibirds are a type of Vertical Take Off and Landing (VTOL) aircraft designed for the United States Armed Forces in the years leading up to the Great War of 2077. The most advanced pre-war model was designated the XVB-02, though other models of unknown designations were also developed both before and after the war. The Vertibird's VTOL flight mechanics allow it to approach landing zones with the speed of a fixed-wing aircraft and transition into a hovering mode of flight, by tilting its rotors vertically upwards 90 degrees. While the design of a Vertibird is convenient, its dual rotor-blades serve as a flight hazard, for if the aircraft were to suffer a single rotary malfunction at a substantial altitude, the Vertibird's airframe and distribution of down-wash would cause the aircraft to fall on its side in a dramatic and likely fatal crash. In addition, flight controllers have been modernized and assisted with a semi-autonomous artificial intelligence unit, greatly reducing the risk of human error, and allowing the Vertihawk to remain operationnal even with a fully inexperienced pilot.</description>
    <graphicData>
      <texPath>Vertibird</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
<shaderType>CutoutComplex</shaderType>
      <drawSize>(9,9)</drawSize>
    </graphicData>
<staticSunShadowHeight>2</staticSunShadowHeight>
 <castEdgeShadows>false</castEdgeShadows>
    <size>(3,6)</size>
    <rotatable>true</rotatable>
    <tickerType>Normal</tickerType>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.5</fillPercent>
    <designationCategory>Misc</designationCategory>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
 <thingCategories>
               <li>BuildingsSpecial</li>
    </thingCategories>
 <minifiedDef>MinifiedThing</minifiedDef>
    <statBases>
      <MaxHitPoints>850</MaxHitPoints>
      <WorkToBuild>4600</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Mass>7000</Mass>
    </statBases>
    <costList>
	  <Plasteel>400</Plasteel>
<TechprofSubpersonaCore>1</TechprofSubpersonaCore>
      <Steel>400</Steel>
      <ComponentIndustrial>20</ComponentIndustrial>
	  <ComponentSpacer>10</ComponentSpacer>
    </costList>
<defaultPlacingRot>East</defaultPlacingRot>
    <comps>
      <li Class="CompProperties_Transporter">
        <restEffectiveness>0.7</restEffectiveness>
		<massCapacity>1200</massCapacity>
      </li>
      <li Class="VertibirdHelo.CompProperties_LaunchableHelicopter" />
      <li Class="CompProperties_Refuelable">
        <fuelCapacity>150.0</fuelCapacity>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>75</initialConfigurableTargetFuelLevel>
        <fuelFilter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </fuelFilter>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <autoRefuelPercent>1</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <drawOutOfFuelOverlay>false</drawOutOfFuelOverlay>
		<drawFuelGaugeInMap>false</drawFuelGaugeInMap>
 </li>
	  <li Class="CompProperties_Explosive">
        <explosiveRadius>7</explosiveRadius>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <chanceNeverExplodeFromDamage>0.2</chanceNeverExplodeFromDamage>
      
      </li>
    </comps>
    <inspectorTabs>
      <li>ITab_TransporterContents</li>
    </inspectorTabs>
    <placeWorkers>
      <li>PlaceWorker_NotUnderRoof</li>
    </placeWorkers>
		<researchPrerequisites>
			<li>BoS_Vertibird</li>
		</researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <uiIconScale>0.85</uiIconScale>
  </ThingDef>
  




