<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Combat Extended</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[@Name='Addie_BaseTripmineGrenadeProjectile']/projectile</xpath>
          <value>
            <projectile Class="CombatExtended.ProjectilePropertiesCE">
              <damageDef>Bomb</damageDef>
              <explosionRadius>1.9</explosionRadius>
              <explosionDelay>50</explosionDelay>
              <speed>12</speed>
            </projectile>
          </value>
        </li>

        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[@Name='Addie_BaseIncendiaryGrenadeProjectile']/projectile</xpath>
          <value>
            <projectile Class="CombatExtended.ProjectilePropertiesCE">
              <damageDef>Flame</damageDef>
              <speed>12</speed>
              <arcHeightFactor>2</arcHeightFactor>
              <shadowSize>0.6</shadowSize>
              <explosionDamageFalloff>true</explosionDamageFalloff>
              <explosionRadius>2.5</explosionRadius>
              <explosionDelay>0</explosionDelay>
              <flyOverhead>false</flyOverhead>
              <preExplosionSpawnThingDef>Filth_Fuel</preExplosionSpawnThingDef>
              <preExplosionSpawnChance>1</preExplosionSpawnChance>
              <ai_IsIncendiary>true</ai_IsIncendiary>
              <screenShakeFactor>0.5</screenShakeFactor>
            </projectile>
          </value>
        </li>

      </operations>
    </match>
  </Operation>

</Patch>
