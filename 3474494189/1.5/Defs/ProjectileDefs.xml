      <texPath>Projectiles/IncendiaryGrenade</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>Addie_GoldenGunBullet_Nighthawk</defName>
