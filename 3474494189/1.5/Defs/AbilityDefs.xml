  <VFECore.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>Addie_VPESH_DeadshotGoldenGun</defName>
    <label>deadshot golden gun</label>
    <description>Activate to auto-target hostiles in the surrounding area with deadly golden gun shots.</description>
    <iconPath>Abilities/DeadshotGoldenGun</iconPath>
    <castSound>Psycast_Skip_Exit</castSound>
    <targetMode>Self</targetMode>
    <castTime>2</castTime>
    <durationTime>600</durationTime>
    <abilityClass>AddieSolarHunter.Ability_DeadshotGoldenGun</abilityClass>
    <needsTicking>true</needsTicking>
    <radius>12.9</radius>
    <modExtensions>
      <li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
        <path>Addie_VPESolarHunter</path>
        <level>4</level>
        <order>1</order>
        <psyfocusCost>0.75</psyfocusCost>
        <entropyGain>40</entropyGain>
        <psychic>true</psychic>
        <prerequisites>
          <li>Addie_VPESH_IncendiaryGrenade</li>
        </prerequisites>
      </li>
      <li Class="VFECore.Abilities.AbilityExtension_Hediff">
        <hediff>Addie_VPESH_DeadshotHediff</hediff>
        <durationMultiplier>PsychicSensitivity</durationMultiplier>
      </li>
      <li Class="AddieSolarHunter.VPESH_RadiusExtension">
        <targetRadius>18.9</targetRadius>
      </li>
    </modExtensions>
  </VFECore.Abilities.AbilityDef>

  <VFECore.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>Addie_VPESH_NighthawkGoldenGun</defName>
    <label>nighthawk golden gun</label>
    <description>fire a single golden gun shot at a target, dealing extreme damage and ignoring all armour.</description>
    <iconPath>Abilities/MarksmanGoldenGun</iconPath>
    <abilityClass>VFECore.Abilities.Ability_ShootProjectile</abilityClass>
    <castTime>2</castTime>
    <range>32</range>
    <castSound>Addie_GoldenGunSoundNighthawk</castSound>
    <targetingParameters>
      <canTargetPawns>true</canTargetPawns>
      <canTargetBuildings>true</canTargetBuildings>
      <canTargetLocations>true</canTargetLocations>
    </targetingParameters>
    <targetMode>Location</targetMode>
    <modExtensions>
      <li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
        <path>Addie_VPESolarHunter</path>
        <level>4</level>
        <order>2</order>
        <psyfocusCost>0.33</psyfocusCost>
        <entropyGain>40</entropyGain>
        <prerequisites>
          <li>Addie_VPESH_TripmineGrenade</li>
        </prerequisites>
      </li>
      <li Class="VFECore.Abilities.AbilityExtension_Projectile">
        <projectile>Addie_GoldenGunBullet_Nighthawk</projectile>
        <accuracyStatFactors>
          <PsychicSensitivity>1</PsychicSensitivity>
        </accuracyStatFactors>
      </li>
    </modExtensions>
  </VFECore.Abilities.AbilityDef>

</Defs>