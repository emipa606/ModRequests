<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--  Paracausal Jump -->

  <VFECore.Abilities.AbilityDef ParentName="VPE_PsycastBase">
      <defName>Addie_VPESH_ParacausalJump</defName>
      <label>Strafe Jump</label>
      <description>A paracausal jump, leap to target position.</description>
      <iconPath>Abilities/Jump</iconPath>
      <abilityClass>AddieSolarHunter.Ability_ParacausalJump</abilityClass>
      <castTime>1.5</castTime>
      <targetMode>Location</targetMode>
      <range>10.9</range>
      <rangeStatFactors>
        <PsychicSensitivity>1</PsychicSensitivity>
      </rangeStatFactors>
      <castSound>VPE_PowerLeap_Cast</castSound>
      <modExtensions>
        <li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
          <path>Addie_VPESolarHunter</path>
          <level>1</level>
          <order>1</order>
          <psyfocusCost>0.02</psyfocusCost>
          <entropyGain>8</entropyGain>
          <prerequisites>
          </prerequisites>
        </li>
      </modExtensions>
    </VFECore.Abilities.AbilityDef>

    <!--  Tripmine Grenade -->

    <VFECore.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>Addie_VPESH_TripmineGrenade</defName>
    <label>Tripmine grenade</label>
    <description>Tripmine Grenade. a grenade with high damage and a short blast radius</description>
    <iconPath>Abilities/TripmineGrenade</iconPath>
    <abilityClass>VFECore.Abilities.Ability_ShootProjectile</abilityClass>
    <castTime>12</castTime>
    <range>15.9</range>
    <castSound>ThrowGrenade</castSound>
    <targetingParameters>
      <canTargetPawns>true</canTargetPawns>
      <canTargetBuildings>true</canTargetBuildings>
      <canTargetLocations>true</canTargetLocations>
    </targetingParameters>
    <targetMode>Location</targetMode>
    <modExtensions>
      <li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
        <path>Addie_VPESolarHunter</path>
        <level>3</level>
        <order>1</order>
        <psyfocusCost>0.15</psyfocusCost>
        <entropyGain>18</entropyGain>
        <prerequisites>
          <li>Addie_VPESH_MarksmansDodge</li>
        </prerequisites>
      </li>
      <li Class="VFECore.Abilities.AbilityExtension_Projectile">
        <projectile>Addie_VPESH_TripmineGrenadeProjectile</projectile>
        <accuracyStatFactors>
          <PsychicSensitivity>1</PsychicSensitivity>
        </accuracyStatFactors>
      </li>
    </modExtensions>
  </VFECore.Abilities.AbilityDef>

  <VFECore.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>Addie_VPESH_IncendiaryGrenade</defName>
    <label>incendiary grenade</label>
    <description>An explosive grenade that catches enemies on fire, causing additional damage over time</description>
    <iconPath>Abilities/IncendiaryGrenade</iconPath>
    <abilityClass>VFECore.Abilities.Ability_ShootProjectile</abilityClass>
    <castTime>12</castTime>
    <range>15.9</range>
    <castSound>ThrowGrenade</castSound>
    <targetingParameters>
      <canTargetPawns>true</canTargetPawns>
      <canTargetBuildings>true</canTargetBuildings>
      <canTargetLocations>true</canTargetLocations>
    </targetingParameters>
    <targetMode>Location</targetMode>
    <modExtensions>
      <li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
        <path>Addie_VPESolarHunter</path>
        <level>3</level>
        <order>2</order>
        <psyfocusCost>0.15</psyfocusCost>
        <entropyGain>15</entropyGain>
        <prerequisites>
          <li>Addie_VPESH_GamblersDodge</li>
        </prerequisites>
      </li>
      <li Class="VFECore.Abilities.AbilityExtension_Projectile">
        <projectile>Addie_VPESH_IncendGrenadeProjectile</projectile>
        <accuracyStatFactors>
          <PsychicSensitivity>1</PsychicSensitivity>
        </accuracyStatFactors>
      </li>
    </modExtensions>
  </VFECore.Abilities.AbilityDef>

  <VFECore.Abilities.AbilityDef ParentName="VPE_PsycastBase">
    <defName>Addie_VPESH_MarksmansDodge</defName>
    <label>marksman dodge</label>
    <description>Activate to provide moderate improvements to weapon performance for the pawn for a moderate amount of time.</description>
    <iconPath>Abilities/MarksmansDodge</iconPath>
    <castSound>Psycast_Skip_Exit</castSound>
    <targetMode>Self</targetMode>
    <castTime>15</castTime>
    <durationTime>1800</durationTime>
    <abilityClass>VFECore.Abilities.Ability_Blank</abilityClass>
    <modExtensions>
      <li Class="VanillaPsycastsExpanded.AbilityExtension_Psycast">
        <path>Addie_VPESolarHunter</path>
        <level>2</level>
        <order>1</order>
        <psyfocusCost>0.18</psyfocusCost>
        <entropyGain>26</entropyGain>
        <psychic>true</psychic>
        <prerequisites>
          <li>Addie_VPESH_ParacausalJump</li>
        </prerequisites>
      </li>
      <li Class="VFECore.Abilities.AbilityExtension_Hediff">
        <hediff>Addie_VPESH_MarksmansDodgeHediff</hediff>
        <durationMultiplier>PsychicSensitivity</durationMultiplier>
      </li>
    </modExtensions>
  </VFECore.Abilities.AbilityDef>

