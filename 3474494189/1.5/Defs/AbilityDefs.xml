        <level>2</level>
        <order>2</order>
        <psyfocusCost>0.18</psyfocusCost>
        <entropyGain>26</entropyGain>
        <psychic>true</psychic>
        <prerequisites>
          <li>Addie_VPESH_ParacausalJump</li>
        </prerequisites>
      </li>
      <li Class="VFECore.Abilities.AbilityExtension_Hediff">
