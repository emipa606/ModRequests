<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<HediffDef ParentName="PsycastHediffBase">
		<defName>Addie_VPESH_MarksmansDodgeHediff</defName>
		<label>marksman dodge</label>
		<description>Activate to provide moderate improvements to weapon performance for the pawn
			for a moderate amount of time.</description>
		<hediffClass>VFECore.Abilities.Hediff_Ability</hediffClass>
		<isBad>false</isBad>
		<stages>
			<li>
				<statFactors>
					<VEF_RangeAttackDamageFactor>1.65</VEF_RangeAttackDamageFactor>
					<VEF_VerbRangeFactor>1.35</VEF_VerbRangeFactor>
				</statFactors>
			</li>
		</stages>
	</HediffDef>

	<HediffDef ParentName="PsycastHediffBase">
		<defName>Addie_VPESH_GamblersDodgeHediff</defName>
		<label>gamblers dodge</label>
		<description>Activate to provide moderate improvements to weapon performance for the pawn
			for a moderate amount of time.</description>
		<hediffClass>VFECore.Abilities.Hediff_Ability</hediffClass>
		<isBad>false</isBad>
		<stages>
			<li>
				<statFactors>
					<VEF_MeleeAttackDamageFactor>1.65</VEF_MeleeAttackDamageFactor>
					<VEF_MeleeAttackSpeedFactor>2</VEF_MeleeAttackSpeedFactor>
				</statFactors>
			</li>
		</stages>
	</HediffDef>

	<HediffDef ParentName="PsycastHediffBase">
		<defName>Addie_VPESH_DeadshotHediff</defName>
		<label>deadshot</label>
		<description>dramatically
			increases the damage, armour penetration, and massively improves weapon handling
			characteristics.</description>
		<hediffClass>VFECore.Abilities.Hediff_Ability</hediffClass>
		<isBad>false</isBad>

		<stages>
			<li>
				<statFactors>
					<VEF_RangeAttackDamageFactor>1.65</VEF_RangeAttackDamageFactor>
					<VEF_VerbRangeFactor>1.45</VEF_VerbRangeFactor>
					<VEF_RangedCooldownFactor>0.75</VEF_RangedCooldownFactor>
				</statFactors>
			</li>
		</stages>
	</HediffDef>

</Defs>