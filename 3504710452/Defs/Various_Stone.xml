<Defs>
  <!-- ================ Sedimentary ================ -->

  <ThingDef ParentName="UglyRockBase" Name="RSS_SedimentaryBase">
    <defName>RSS_Sedimentary</defName>
    <label>sedimentary stone</label>
    <description>A rock made of compacted sediments.</description>
    <graphicData>
      <color>(160,137,103)</color>
    </graphicData>
    <statBases>
      <MaxHitPoints>400</MaxHitPoints>
    </statBases>
    <building>
      <mineableThing>RSS_ChunkSedimentary</mineableThing>
      <mineableDropChance>0.25</mineableDropChance>
      <smoothedThing>RSS_SmoothedSedimentary</smoothedThing>
    </building>
  </ThingDef>

  <ThingDef ParentName="RSS_SedimentaryBase">
    <defName>RSS_SmoothedSedimentary</defName>
    <label>smoothed sedimentary stone</label>
    <description>A rock made of compacted sediments. The sediments have been polished to a flat, smooth surface.</description>
    <uiIconPath>Things/Building/Linked/WallSmooth_MenuIcon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/Linked/RockSmooth_Atlas</texPath>
    </graphicData>
    <statBases>
      <Beauty>1</Beauty>
      <MarketValue>7</MarketValue>
    </statBases>
    <building>
      <isNaturalRock>false</isNaturalRock>
      <canBuildNonEdificesUnder>true</canBuildNonEdificesUnder>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
      <paintable>true</paintable>
      <smoothedThing />
    </building>
    <saveCompressible>false</saveCompressible>
    <repairEffect>Repair</repairEffect>
  </ThingDef>

  <ThingDef ParentName="ChunkRockBase">
    <defName>RSS_ChunkSedimentary</defName>
    <label>sedimentary chunk</label>
    <graphicData>
      <color>(158,153,135)</color>
    </graphicData>
    <statBases>
      <Mass>20</Mass>
    </statBases>
    <soundDrop>ChunkRock_Drop</soundDrop>
    <butcherProducts>
      <BlocksSandstone>20</BlocksSandstone>
    </butcherProducts>
  </ThingDef>
  
  <ThingDef ParentName="StoneBlocksBase">
    <defName>RSS_BlocksSedimentary</defName>
    <label>sedimentary blocks</label>
    <description>Blocks of solid sedimentary stone. Lightweight and easy to build with.</description>
    <graphicData>
      <color>(158,153,135)</color>
    </graphicData>
    <statBases>
      <Mass>0.85</Mass>
      <SharpDamageMultiplier>0.5</SharpDamageMultiplier>
    </statBases>
    <stuffProps>
      <color>(158,153,135)</color>
      <soundImpactBullet>BulletImpact_Ground</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Stone</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Stone</soundMeleeHitBlunt>
      <soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Stone</soundImpactMelee>
      <stuffAdjective>sedimentary stone</stuffAdjective>
      <statFactors>
        <Beauty>1</Beauty>  
        <MaxHitPoints>1.3</MaxHitPoints>
        <WorkToBuild>4.5</WorkToBuild>
        <WorkToMake>1.1</WorkToMake>
      </statFactors>
      <canSuggestUseDefaultStuff>true</canSuggestUseDefaultStuff>
    </stuffProps>
  </ThingDef>

  <RecipeDef ParentName="MakeStoneBlocksBase">
    <defName>RSS_Make_StoneBlocksSedimentary</defName>
    <label>make sedimentary blocks</label>
    <description>Cuts sedimentary chunks into usable blocks.</description>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RSS_ChunkSedimentary</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RSS_ChunkSedimentary</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <RSS_BlocksSedimentary>20</RSS_BlocksSedimentary>
    </products>
  </RecipeDef>

  <!-- ================ Metamorphic ================ -->

  <ThingDef ParentName="UglyRockBase" Name="RSS_MetamorphicBase">
    <defName>RSS_Metamorphic</defName>
    <label>metamorphic stone</label>
    <description>A soft metamorphic rock.</description>
    <graphicData>
      <color>(132,135,132)</color>
    </graphicData>
    <statBases>
      <MaxHitPoints>450</MaxHitPoints>
      <Beauty>-1</Beauty>
    </statBases>
    <building>
      <mineableThing>ChunkMarble</mineableThing>
      <mineableDropChance>0.25</mineableDropChance>
      <smoothedThing>SmoothedMarble</smoothedThing>
    </building>
  </ThingDef>

  <ThingDef ParentName="RSS_MetamorphicBase">
    <defName>RSS_SmoothedMetamorphic</defName>
    <label>smoothed metamorphic stone</label>
    <description>A soft metamorphic rock. This semi-transparent rock almost appears to glow with its own inner light.</description>
    <uiIconPath>Things/Building/Linked/WallSmooth_MenuIcon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/Linked/RockSmooth_Atlas</texPath>
    </graphicData>
    <statBases>
      <Beauty>2</Beauty>
      <MarketValue>7</MarketValue>
    </statBases>
    <building>
      <isNaturalRock>false</isNaturalRock>
      <canBuildNonEdificesUnder>true</canBuildNonEdificesUnder>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
      <smoothedThing />
      <paintable>true</paintable>
    </building>
    <saveCompressible>false</saveCompressible>
    <repairEffect>Repair</repairEffect>
  </ThingDef>
  
  <ThingDef ParentName="ChunkRockBase">
    <defName>RSS_ChunkMetamorphic</defName>
    <label>metamorphic chunk</label>
    <graphicData>
      <color>(132,135,132)</color>
    </graphicData>
    <statBases>
      <Mass>25</Mass>
    </statBases>
    <soundDrop>ChunkRock_Drop</soundDrop>
    <butcherProducts>
      <BlocksMarble>20</BlocksMarble>
    </butcherProducts>
  </ThingDef>

  <ThingDef ParentName="StoneBlocksBase">
    <defName>RSS_BlocksMetamorphic</defName>
    <label>metamorphic blocks</label>
    <description>Blocks of solid metamorphic stone. Mostly useful for luxury and visual flair.</description>
    <graphicData>
      <color>(132,135,132)</color>
    </graphicData>
    <statBases>
      <Mass>1.25</Mass>
    </statBases>
    <stuffProps>
      <color>(132,135,132)</color>
      <soundImpactBullet>BulletImpact_Ground</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Stone</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Stone</soundMeleeHitBlunt>
      <soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Stone</soundImpactMelee>
      <stuffAdjective>metamorphic stone</stuffAdjective>
      <statFactors>
        <Beauty>1.4</Beauty>
        <MaxHitPoints>1.4</MaxHitPoints>
        <WorkToBuild>6</WorkToBuild>
        <WorkToMake>1.15</WorkToMake>
      </statFactors>
      <statOffsets>
        <Beauty>1</Beauty>
      </statOffsets>
      <canSuggestUseDefaultStuff>true</canSuggestUseDefaultStuff>
    </stuffProps>
  </ThingDef>

  <RecipeDef ParentName="MakeStoneBlocksBase">
    <defName>RSS_Make_StoneBlocksMetamorphic</defName>
    <label>make metamorphic blocks</label>
    <description>Cuts metamorphic chunks into usable blocks.</description>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RSS_ChunkMetamorphic</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RSS_ChunkMetamorphic</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <RSS_BlocksMetamorphic>20</RSS_BlocksMetamorphic>
    </products>
  </RecipeDef>

  <!-- ================ Igneous ================ -->

