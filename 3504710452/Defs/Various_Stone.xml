  <ThingDef ParentName="StoneBlocksBase">
    <defName>RSS_BlocksIgneous</defName>
    <label>igneous blocks</label>
    <description>Blocks of solid igneous stone. Mostly useful for building long-lasting, simple structures.</description>
    <graphicData>
