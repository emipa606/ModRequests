<Defs>
    <ReplaceLib.ReplacerDef>
        <defName>RSS_Simplifier_Sedimentary</defName>
        <replacers>
            <li>
                <replace>Limestone</replace>
                <with>RSS_Sedimentary</with>
            </li>
            <li>
                <replace>Sandstone</replace>
                <with>RSS_Sedimentary</with>
            </li>

            <li>
                <replace>SmoothedLimestone</replace>
                <with>RSS_SmoothedSedimentary</with>
            </li>
            <li>
                <replace>SmoothedSandstone</replace>
                <with>RSS_SmoothedSedimentary</with>
            </li>

            <li>
                <replace>ChunkLimestone</replace>
                <with>RSS_ChunkSedimentary</with>
            </li>
            <li>
                <replace>ChunkSandstone</replace>
                <with>RSS_ChunkSedimentary</with>
            </li>

            <li>
                <replace>BlocksLimestone</replace>
                <with>RSS_BlocksSedimentary</with>
            </li>
            <li>
                <replace>BlocksSandstone</replace>
                <with>RSS_BlocksSedimentary</with>
            </li>
        </replacers>
    </ReplaceLib.ReplacerDef>

    <ReplaceLib.ReplacerDef>
        <defName>RSS_Simplifier_Metamorphic</defName>
        <replacers>
            <li>
                <replace>Marble</replace>
                <with>RSS_Metamorphic</with>
            </li>
            <li>
                <replace>Slate</replace>
                <with>RSS_Metamorphic</with>
            </li>

            <li>
                <replace>SmoothedMarble</replace>
                <with>RSS_SmoothedMetamorphic</with>
            </li>
            <li>
                <replace>SmoothedSlate</replace>
                <with>RSS_SmoothedMetamorphic</with>
            </li>

            <li>
                <replace>ChunkMarble</replace>
                <with>RSS_ChunkMetamorphic</with>
            </li>
            <li>
                <replace>ChunkSlate</replace>
                <with>RSS_ChunkMetamorphic</with>
            </li>

            <li>
                <replace>BlocksMarble</replace>
                <with>RSS_BlocksMetamorphic</with>
            </li>
            <li>
                <replace>BlocksSlate</replace>
                <with>RSS_BlocksMetamorphic</with>
            </li>
        </replacers>
    </ReplaceLib.ReplacerDef>

    <ReplaceLib.ReplacerDef>
        <defName>RSS_Simplifier_Igneous</defName>
        <replacers>
            <li>
                <replace>Granite</replace>
                <with>RSS_Igneous</with>
            </li>

            <li>
                <replace>SmoothedGranite</replace>
                <with>RSS_SmoothedIgneous</with>
            </li>

            <li>
                <replace>ChunkGranite</replace>
                <with>RSS_ChunkIgneous</with>
            </li>

            <li>
                <replace>BlocksGranite</replace>
                <with>RSS_BlocksIgneous</with>
            </li>
        </replacers>
    </ReplaceLib.ReplacerDef>
</Defs>