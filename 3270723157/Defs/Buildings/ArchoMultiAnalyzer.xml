<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="BuildingBase">
        <defName>ArchoMultiAnalyzer</defName>
        <label>archon multi-analyzer</label>
		<description>The Archon Multi-Analyzer is an advanced yet inferior imitation of true Archotech technology.\nWhile it cannot compare to genuine Archotech devices, this crafted analyzer significantly boosts research efficiency by 400%.\nUtilizing cutting-edge techniques and materials, it simulates the incredible capabilities of its mysterious predecessors, making it an invaluable tool for any high-tech research facility.</description>
		<graphicData>
			<texPath>ArchoMultiAnalyzer/ArchoMultiAnalyzer</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3,2)</drawSize>
			<damageData>
				<rect>(0.15,0.15,1.7,1.7)</rect>
			</damageData>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.35</staticSunShadowHeight>
		<fillPercent>0.5</fillPercent>
		<canOverlapZones>false</canOverlapZones>
		<pathCost>60</pathCost>
		<rotatable>true</rotatable>
		<statBases>
			<MaxHitPoints>800</MaxHitPoints>
			<WorkToBuild>50000</WorkToBuild>
			<Mass>200</Mass>
			<Flammability>1.0</Flammability>
		</statBases>
		<size>(3,2)</size>
		<costList>
			<ComponentSpacer>15</ComponentSpacer>
			<ComponentIndustrial>40</ComponentIndustrial>
			<Steel>1500</Steel>
			<Plasteel>500</Plasteel>
			<Gold>250</Gold>
		</costList>
		<researchPrerequisites>
			<li>ArchoMultiAnalyzer</li>
		</researchPrerequisites>
		<designationCategory>Misc</designationCategory>
		<minifiedDef>MinifiedThing</minifiedDef>
		<constructionSkillPrerequisite>15</constructionSkillPrerequisite>
		<thingCategories>
			<li>BuildingsMisc</li>
		</thingCategories>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<shortCircuitInRain>true</shortCircuitInRain>
				<basePowerConsumption>5000</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Facility">
				<statOffsets>
					<ResearchSpeedFactor>4.00</ResearchSpeedFactor>
				</statOffsets>
				<maxSimultaneous>5</maxSimultaneous>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
		</placeWorkers>
	</ThingDef>

</Defs>