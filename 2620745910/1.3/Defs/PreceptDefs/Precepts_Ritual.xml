<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  
  <!-- Precepts -->

  <PreceptDef Name="SacrificeBase" Abstract="True">
    <description>A ritualistic sacrifice. The organizer will give a speech to excite the crowd, then cut the victim's throat. Once the victim is dead, the organizer will speak some finishing words.</description>
    <issue>Ritual</issue>
    <impact>Medium</impact>
    <preceptClass>Precept_Ritual</preceptClass>
    <allowDuplicates>true</allowDuplicates>
    <countsTowardsPreceptLimit>false</countsTowardsPreceptLimit>
    <ignoreLimitsInEditMode>true</ignoreLimitsInEditMode>
    <receivesExpectationsQualityOffset>true</receivesExpectationsQualityOffset>
  </PreceptDef>
  
  <PreceptDef ParentName="FestivalBase">
    <defName>RitualAnimalSacrifice</defName>
    <label>animal sacrifice</label>
    <preceptClass>Precept_Ritual</preceptClass>
    <iconPath>UI/Icons/Rituals/RitualAnimalSacrifice</iconPath>
    <ritualPatternBase>SacrificeAnimal</ritualPatternBase>
    <canGenerateAsSpecialPrecept>false</canGenerateAsSpecialPrecept>
    <receivesExpectationsQualityOffset>true</receivesExpectationsQualityOffset>
  </PreceptDef>
  
  <PreceptDef ParentName="FestivalBase">
    <defName>RitualPrisonerSacrifice</defName>
    <label>prisoner sacrifice</label>
    <preceptClass>Precept_Ritual</preceptClass>
    <iconPath>UI/Icons/Rituals/RitualPrisonerSacrifice</iconPath>
    <ritualPatternBase>SacrificePrisoner</ritualPatternBase>
    <canGenerateAsSpecialPrecept>false</canGenerateAsSpecialPrecept>
    <receivesExpectationsQualityOffset>true</receivesExpectationsQualityOffset>
  </PreceptDef>
  
  <PreceptDef ParentName="FestivalBase">
    <defName>RitualBurnCircle</defName>
    <label>burn circle</label>
    <preceptClass>Precept_Ritual</preceptClass>
    <iconPath>UI/Icons/Rituals/BurnCircle</iconPath>
    <ritualPatternBase>BurnCircle</ritualPatternBase>
    <canGenerateAsSpecialPrecept>false</canGenerateAsSpecialPrecept>
    <receivesExpectationsQualityOffset>true</receivesExpectationsQualityOffset>
  </PreceptDef>
</Defs>