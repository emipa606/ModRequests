<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Core</li>
        </mods>
        <match Class="PatchOperationSequence">
            <success>Normal</success>
            <operations>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs/FactionDef[@Name="OutlanderFactionBase"]/structureMemeWeights</xpath>
                    <value>
						<Structure_OriginDaoist MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginDaoist>
						<Structure_OriginShinto MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginShinto>
						<Structure_OriginNorse MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginNorse>
						<Structure_OriginHellenic MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginHellenic>
						<Structure_OriginKemet MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginKemet>
						<Structure_OriginAztec MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginAztec>
						<Structure_OriginDruidic MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginDruidic>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>/Defs/FactionDef[@Name="TribeBase"]/structureMemeWeights</xpath>
                    <value>
						<Structure_OriginDaoist MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginDaoist>
						<Structure_OriginShinto MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginShinto>
						<Structure_OriginNorse MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginNorse>
						<Structure_OriginHellenic MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginHellenic>
						<Structure_OriginKemet MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginKemet>
						<Structure_OriginAztec MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginAztec>
						<Structure_OriginDruidic MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginDruidic>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>
	

</Patch>