  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>VBY_LS13_Shotgun</defName>
    <label>LS13 shotgun</label>
    <description>The LS13 Shotgun (nicknamed "Lucky Strike"), also known as the M13 Semi-Automatic Shotgun, is an ISA weapon that fires a dense cloud of pellets with every shot, as all shotguns do.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/VBY_Blackjack_LS134</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_Shotgun</soundInteract>
    <recipeMaker>
      <researchPrerequisite>GasOperation</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
    </recipeMaker>
    <thingSetMakerTags><li>RewardStandardQualitySuper</li></thingSetMakerTags>
