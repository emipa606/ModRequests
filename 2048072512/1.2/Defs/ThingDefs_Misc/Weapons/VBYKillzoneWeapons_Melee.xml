    </graphicData>
    <uiIconScale>1.2</uiIconScale>
    <techLevel>Industrial</techLevel>    
	<costList>
	   <Plasteel>2</Plasteel>
	</costList>   
    <weaponTags>
      <li>MedievalMeleeAdvanced</li>
    </weaponTags>
    <statBases>
      <WorkToMake>500</WorkToMake>
      <Mass>0.20</Mass>
    </statBases>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <stuffCategories>
      <li>Metallic</li>      
    </stuffCategories>
	<costStuffCount>12</costStuffCount>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>1.8</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>14</power>
        <cooldownTime>1.5</cooldownTime>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>20</power>
        <cooldownTime>1.5</cooldownTime>
      </li>
    </tools>
    <recipeMaker>
      <researchPrerequisite>Smithing</researchPrerequisite>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
    </recipeMaker>
  </ThingDef>
  
  
</Defs>  