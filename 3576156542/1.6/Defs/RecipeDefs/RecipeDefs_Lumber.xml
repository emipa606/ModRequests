<Defs>
	
	<!-- Abstracts -->
	<!-- MakeLumber Base -->
	<RecipeDef Name="EW2_MakeLumberBase" Abstract="True">
		<jobString>Processing lumber.</jobString>
		<workAmount>250</workAmount>
		<unfinishedThingDef>EW2_UnfinishedLumber</unfinishedThingDef>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<workSkill>Crafting</workSkill>
		<workSkillLearnFactor>0.25</workSkillLearnFactor>
		<effectWorking>CutStone</effectWorking>
		<soundWorking>Recipe_MakeWoodPlanks_Electric</soundWorking>
		<requiredGiverWorkType>Crafting</requiredGiverWorkType>
		<targetCountAdjustment>15</targetCountAdjustment>
		<recipeUsers>
			<li>CraftingSpot</li>
			<li>EW2_TableWoodworking</li>
			<li>EW2_ElectricTableWoodworking</li>
			<li>EW2_FueledTableWoodworking</li>
		</recipeUsers>
	</RecipeDef>
	
	<!-- Fresh Lumber -->
	<RecipeDef>
		<defName>EW2_MakeLumber</defName>
		<label>make fresh lumber</label>
		<description>Saw fresh lumber from raw wood logs..</description>
		<workerCounterClass>ExpandedWoodworking.RecipeWorkerCounter_MakeWoodLumber</workerCounterClass>
		<jobString>Processing lumber from wood.</jobString>
		<workAmount>250</workAmount>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<workSkill>Crafting</workSkill>
		<workSkillLearnFactor>0.25</workSkillLearnFactor>
		<effectWorking>CutStone</effectWorking>
		<soundWorking>Recipe_MakeWoodPlanks_Electric</soundWorking>
		<requiredGiverWorkType>Crafting</requiredGiverWorkType>
		<targetCountAdjustment>15</targetCountAdjustment>
		<recipeUsers>
			<li>CraftingSpot</li>
			<li>EW2_TableWoodworking</li>
			<li>EW2_ElectricTableWoodworking</li>
			<li>EW2_FueledTableWoodworking</li>
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>EW2_WoodLog</li>
					</categories>
				</filter>
				<count>15</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<categories>
				<li>EW2_WoodLog</li>
			</categories>
		</fixedIngredientFilter>
		<specialProducts>
			<li>Butchery</li>
		</specialProducts>
		<researchPrerequisites>
			<li>EW2_Woodworking</li>
		</researchPrerequisites>
	</RecipeDef>

	<!-- Lumber Bundle -->
	<RecipeDef ParentName="EW2_MakeLumberBase">
		<defName>EW2_MakeLumberBundle</defName>
		<label>bundle wooden planks</label>
		<description>Bundle together spare wooden planks.</description>
		<allowMixingIngredients>true</allowMixingIngredients>
		<recipeUsers>
			<li>CraftingSpot</li>
			<li>EW2_TableWoodworking</li>
			<li>EW2_ElectricTableWoodworking</li>
			<li>EW2_FueledTableWoodworking</li>
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>WoodLumber</li>
					</categories>
				</filter>
				<count>5</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<categories>
				<li>WoodLumber</li>
			</categories>
			<disallowedThingDefs>
				<li>WoodLumberMixed</li>
			</disallowedThingDefs>
		</fixedIngredientFilter>
		<products>
			<WoodLumberMixed>5</WoodLumberMixed>
		</products>
	</RecipeDef>

</Defs>
