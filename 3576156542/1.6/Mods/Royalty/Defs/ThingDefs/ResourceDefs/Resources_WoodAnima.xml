<Defs>

    <!-- Anima Fresh Lumber -->
    <ThingDef ParentName="EW2_FreshLumberBase">
        <defName>EW2_FreshLumberAnima</defName>
        <label>fresh mystic wood lumber</label>
        <statBases>
            <Mass>0.35</Mass>
        </statBases>
    </ThingDef>

    <!-- Anima Wood Log - Anima wood has been based on Oak -->
    <ThingDef ParentName="EW2_WoodLogBase">
        <defName>EW2_WoodLog_Anima</defName>	<!-- SG: 0.75  W: 755  H: 1350 -->
        <label>mystic wood logs</label>
        <description>Raw wood from an anima tree. Useful for building simple structures and weapons, it must be processed into fresh lumber and left to dry before becoming suitable for advanced projects. It could be used as fuel for campfires and generators, or be refined into chemfuel, but why would you? In a pinch, a piece of wood can be used as a weapon or a leg. Anima wood is similar to a very durable hardwood.</description>
        <graphicData>
            <texPath>Things/Item/Resource/WoodLogAnima</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <statBases>
            <Mass>0.7</Mass>
            <MarketValue>1.6</MarketValue>
            <DeteriorationRate>0.5</DeteriorationRate>
        </statBases>
        <stuffProps>
            <stuffAdjective>mystic</stuffAdjective>
            <commonality>0</commonality>
            <color>(173,208,195)</color>
            <statFactors>
                <MaxHitPoints>0.65</MaxHitPoints>
                <Beauty>2.35</Beauty>
                <WorkToMake>0.6</WorkToMake>
                <WorkToBuild>0.6</WorkToBuild>
                <DoorOpenSpeed>1.0</DoorOpenSpeed>
            </statFactors>
        </stuffProps>
        <butcherProducts>
            <EW2_FreshLumberAnima>30</EW2_FreshLumberAnima>
        </butcherProducts>
    </ThingDef>

    <ThingDef ParentName="WoodLumberBase">
        <defName>WoodLumberAnima</defName>
        <label>mystic wood planks</label>
        <description>Processed anima wood planks, useful for building advanced structures and furniture. Anima wood is similar to a very durable hardwood.</description>
        <graphicData>
            <color>(173,208,195)</color>
        </graphicData>
        <statBases>
            <Mass>0.35</Mass>
            <MarketValue>3.75</MarketValue>
            <DeteriorationRate>1</DeteriorationRate>
        </statBases>
        <stuffProps>
            <stuffAdjective>mystic wood</stuffAdjective>
            <commonality>0</commonality>
            <color>(173,208,195)</color>
            <statFactors>
                <MaxHitPoints>0.65</MaxHitPoints>
                <Beauty>2.35</Beauty>
                <WorkToMake>0.6</WorkToMake>
                <WorkToBuild>0.6</WorkToBuild>
                <DoorOpenSpeed>1.0</DoorOpenSpeed>
            </statFactors>
        </stuffProps>
    </ThingDef>

</Defs>
