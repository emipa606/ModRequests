<Patch>

    <!-- Anima trees now drop Anima wood logs -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName = "Plant_TreeAnima"]/plant</xpath>
        <value>
            <harvestedThingDef>EW2_WoodLog_Anima</harvestedThingDef>
        </value>
    </Operation>

</Patch>
