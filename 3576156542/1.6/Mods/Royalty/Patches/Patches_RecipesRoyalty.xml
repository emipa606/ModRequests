<Patch>

    <!-- Weapons -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<!-- Axes and warhammers can no longer be made of wood -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName = "MeleeWeapon_Axe" or defName="MeleeWeapon_Warhammer"]/stuffCategories/li[.="Woody"]</xpath>
			</li>

		</operations>
	</Operation>

</Patch>
