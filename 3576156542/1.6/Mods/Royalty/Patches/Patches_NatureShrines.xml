<Patch>

    <Operation Class="PatchOperationSequence">
        <operations>

            <!-- Replaces Woody with RawWoody for Nature Shrine stuffCategories -->
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[@Name = "NatureShrineBase"]/stuffCategories/li[.="Woody"]</xpath>
                <value>
                    <li>EW2_RawWoody</li>
                </value>
            </li>

            <!-- Adjust colour of wood nature shrines -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[@Name = "NatureShrineBase"]</xpath>
                <value>
                    <colorPerStuff>
                    <li>
                        <stuff>WoodLog</stuff>
                        <color>(255,255,255)</color>
                    </li>

                    <li>
                        <stuff>EW2_WoodLog_Bamboo</stuff>
                        <color>(255,255,255)</color>
                    </li>

                    <li>
                        <stuff>EW2_WoodLog_Palm</stuff>
                        <color>(255,255,255)</color>
                    </li>

                    <li>
                        <stuff>EW2_WoodLog_Birch</stuff>
                        <color>(255,255,255)</color>
                    </li>

                    <li>
                        <stuff>EW2_WoodLog_Cecropia</stuff>
                        <color>(255,255,255)</color>
                    </li>

                    <li>
                        <stuff>EW2_WoodLog_Cocoa</stuff>
                        <color>(255,255,255)</color>
                    </li>

                    <li>
                        <stuff>EW2_WoodLog_Cypress</stuff>
                        <color>(255,255,255)</color>
                    </li>

                    <li>
                        <stuff>EW2_WoodLog_Drago</stuff>
                        <color>(255,255,255)</color>
                    </li>

                    <li>
                        <stuff>EW2_WoodLog_Maple</stuff>
                        <color>(255,255,255)</color>
                    </li>

                    <li>
                        <stuff>EW2_WoodLog_Oak</stuff>
                        <color>(255,255,255)</color>
                    </li>

                    <li>
                        <stuff>EW2_WoodLog_Pine</stuff>
                        <color>(255,255,255)</color>
                    </li>

                    <li>
                        <stuff>EW2_WoodLog_Poplar</stuff>
                        <color>(255,255,255)</color>
                    </li>

                    <li>
                        <stuff>EW2_WoodLog_Succulent</stuff>
                        <color>(255,255,255)</color>
                    </li>

                    <li>
                        <stuff>EW2_WoodLog_Shroom</stuff>
                        <color>(255,255,255)</color>
                    </li>

                    <li>
                        <stuff>EW2_WoodLog_Teak</stuff>
                        <color>(255,255,255)</color>
                    </li>

                    <li>
                        <stuff>EW2_WoodLog_Willow</stuff>
                        <color>(255,255,255)</color>
                    </li>

                    <li>
                        <stuff>EW2_WoodLog_Anima</stuff>
                        <color>(255,255,255)</color>
                    </li>
                </colorPerStuff>
                </value>
            </li>

        </operations>
	</Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Ideology</li>
        </mods>
        <match Class="PatchOperationAdd">
             <xpath>Defs/ThingDef[@Name = "NatureShrineBase"]/colorPerStuff</xpath>
             <value>
                 <li>
                     <stuff>EW2_WoodLog_Gaur</stuff>
                     <color>(255,255,255)</color>
                 </li>

             </value>
        </match>
    </Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Biotech</li>
