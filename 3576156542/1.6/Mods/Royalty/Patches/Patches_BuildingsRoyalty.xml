<Patch>

    <!-- Drape -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Drape"]/costList</xpath>
        <value>
            <costList>
                <WoodLumberMixed>50</WoodLumberMixed>
            </costList>
        </value>
    </Operation>

    <!-- Joy/Recreation -->
	<!-- Original Author: KennethSamael for Expanded Woodworking -->
	<Operation Class="PatchOperationSequence">

        <!-- Stuffable Harp -->
        <operations>

            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[defName = "Harp"]/costList</xpath>
                <value>
                    <stuffCategories>
                        <li>Woody</li>
                    </stuffCategories>
                    <costStuffCount>150</costStuffCount>
                </value>
            </li>

            <!-- Stuffable Harpsichord -->
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[defName = "Harpsichord"]/costList</xpath>
                <value>
                    <stuffCategories>
                        <li>Woody</li>
                    </stuffCategories>
                    <costStuffCount>250</costStuffCount>
                </value>
            </li>

            <!-- Stuffable Piano -->
            <li Class="PatchOperationConditional">
                <xpath>Defs/ThingDef[defName = "Piano"]/stuffCategories</xpath>
                <nomatch Class="PatchOperationSequence">
                    <operations>
                        <li Class="PatchOperationRemove">
                            <xpath>Defs/ThingDef[defName = "Piano"]/costList/WoodLog</xpath>
                        </li>

                        <li Class="PatchOperationAdd">
                            <xpath>Defs/ThingDef[defName = "Piano"]</xpath>
                            <value>
                                <stuffCategories>
                                    <li>Woody</li>
                                </stuffCategories>
                                <costStuffCount>220</costStuffCount>
                            </value>
                        </li>

                    </operations>
                </nomatch>
            </li>

        </operations>
    </Operation>

</Patch>
