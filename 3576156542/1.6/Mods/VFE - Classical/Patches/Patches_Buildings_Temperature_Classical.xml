<Patch>

    <Operation Class="PatchOperationSequence">
        <operations>

			<!-- Removes constructEffect so it doesn't produce an error when the costList is changed to a stuffCategory -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName = "VFEC_LargePassiveCooler" or defName="VFEC_HeatStones"]/constructEffect</xpath>
			</li>

			<!-- Replaces dedicated WoodLog costList with EW2_RawWoody stuffCategory -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="VFEC_LargePassiveCooler"]/costList</xpath>
				<value>
					<stuffCategories>
                        <li>EW2_RawWoody</li>
                    </stuffCategories>
                    <costStuffCount>150</costStuffCount>
				</value>
			</li>

             <!-- Replaces dedicated WoodLog costList with EW2_RawWoody stuffCategory -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="VFEC_HeatStones"]/costList</xpath>
				<value>
					<stuffCategories>
                        <li>EW2_RawWoody</li>
                    </stuffCategories>
                    <costStuffCount>50</costStuffCount>
				</value>
			</li>

        </operations>

	</Operation>
</Patch>
