<Patch>

    <Operation Class="PatchOperationSequence">
        <operations>

			<!-- Removes dedicated WoodLog costList -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName="VFEC_Turret_Scorpion"]/costList/WoodLog</xpath>
			</li>

             <!-- Adds Woody stuffCategory so it can be made with planks -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="VFEC_Turret_Scorpion"]</xpath>
				<value>
					<stuffCategories>
                        <li>Woody</li>
                    </stuffCategories>
                    <costStuffCount>70</costStuffCount>
				</value>
			</li>

        </operations>
	</Operation>

</Patch>
