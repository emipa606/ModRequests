<Patch>

    <Operation Class="PatchOperationSequence">
        <operations>

            <!-- Remove dedicated WoodLog costList from Meat Drying Rack and Crafting Bench -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEC_MeatDryingRack" or defName="VFEC_CraftingBench"]/costList/WoodLog</xpath>
            </li>

			<!-- Adds EW2_RawWoody stuffCategory, so Meat Drying Rack can be made with raw logs -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="VFEC_MeatDryingRack"]</xpath>
				<value>
                    <stuffCategories>
                        <li>EW2_RawWoody</li>
                    </stuffCategories>
                    <costStuffCount>80</costStuffCount>
				</value>
			</li>

            <!-- Adds EW2_RawWoody stuffCategory, so Meat Drying Rack can be made with raw wood -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="VFEC_MeatDryingRack"]</xpath>
				<value>
                    <stuffCategories>
                        <li>EW2_RawWoody</li>
                    </stuffCategories>
                    <costStuffCount>50</costStuffCount>
				</value>
			</li>

            <!-- Adds Woody stuffCategory, so Meat Drying Rack can be made with planks -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="VFEC_CraftingBench"]</xpath>
				<value>
                    <stuffCategories>
                        <li>Woody</li>
                    </stuffCategories>
                    <costStuffCount>50</costStuffCount>
				</value>
			</li>

			<!-- Replaces dedicated WoodLog costList with Woody stuffCategory -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="VFEC_TyrianFarm"]/costList</xpath>
				<value>
					<stuffCategories>
                        <li>Woody</li>
                    </stuffCategories>
                    <costStuffCount>150</costStuffCount>
				</value>
			</li>

        </operations>
    </Operation>

</Patch>
