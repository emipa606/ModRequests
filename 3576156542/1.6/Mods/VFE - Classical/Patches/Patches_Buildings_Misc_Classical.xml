<Patch>

    <Operation Class="PatchOperationSequence">
        <operations>

			<!-- Removes dedicated WoodLog costList -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName="VFEC_Beacon"]/costList/WoodLog</xpath>
			</li>

             <!-- Adds EW2_RawWoody stuffCategory so it can be made with raw logs -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="VFEC_Beacon"]</xpath>
				<value>
					<stuffCategories>
                        <li>EW2_RawWoody</li>
                    </stuffCategories>
                    <costStuffCount>150</costStuffCount>
				</value>
			</li>

        </operations>
	</Operation>

</Patch>
