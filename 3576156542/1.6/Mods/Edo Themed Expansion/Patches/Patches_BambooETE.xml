<Patch>

    <Operation Class="PatchOperationSequence">
        <operations>

            <!-- ETE bamboo trees drop EW2 WoodLog_Bamboo -->
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[@Name = "HSEDOTreeBase"]/plant/harvestedThingDef</xpath>
                <value>
                    <harvestedThingDef>EW2_WoodLog_Bamboo</harvestedThingDef>
                </value>
            </li>

            <!-- Replaces EW2 bamboo graphic with ETE's -->
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[defName = "EW2_WoodLog_Bamboo"]/graphicData</xpath>
                    <value>
                            <graphicData>
                                <texPath>Things/Item/Resource/Bamboo</texPath>
                            </graphicData>
                    </value>
            </li>

            <!-- Removes ETE bamboo conversion recipe -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/RecipeDef[defName = "BambooConversion" or defName ="BambooConversion25x"]</xpath>
            </li>

            <!-- Removes ETE bamboo -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName = "hs_Edo_Bamboo"]</xpath>
            </li>

        </operations>
    </Operation>

</Patch>
