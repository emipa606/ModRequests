<Patch>

    <!-- Armour Neolithic -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<!-- Wooden Armour -->
			<!-- Replaces Woody category with EW2_RawWoody -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="VAE_Apparel_WoodenArmor"]/stuffCategories/li[.="Woody"]</xpath>
				<value>
					<li>EW2_RawWoody</li>
				</value>
			</li>

		</operations>
	</Operation>


</Patch>
