<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationSequence">
        <operations>
            <!-- Add EW2 wood logs to default storage settings -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="ASF_LargeLogPile"]/building/defaultStorageSettings/filter</xpath>
                <value>
                    <categories>
                        <li>EW2_WoodLog</li>
                    </categories>
                </value>
            </li>

            <!-- Add EW2 wood logs to fixed storage settings -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="ASF_LargeLogPile"]/building/fixedStorageSettings/filter</xpath>
                <value>
                    <categories>
                        <li>EW2_WoodLog</li>
                    </categories>
                </value>
            </li>
        </operations>
    </Operation>

    <Operation Class="PatchOperationSequence">
        <operations>
            <!-- Add EW2 wood logs to default storage settings -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="ASF_SmallLogPile"]/building/defaultStorageSettings/filter</xpath>
                <value>
                    <categories>
                        <li>EW2_WoodLog</li>
                    </categories>
                </value>
            </li>

            <!-- Add EW2 wood logs to fixed storage settings -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="ASF_SmallLogPile"]/building/fixedStorageSettings/filter</xpath>
                <value>
                    <categories>
                        <li>EW2_WoodLog</li>
                    </categories>
                </value>
            </li>
        </operations>
    </Operation>

    <!-- Remove unneeded stuffCategories and costStuffCount -->
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[defName="ASF_SmallLogPile" or defName="ASF_LargeLogPile"]/stuffCategories  |   Defs/ThingDef[defName="ASF_SmallLogPile" or defName="ASF_LargeLogPile"]/costStuffCount</xpath>
    </Operation>
</Patch>
