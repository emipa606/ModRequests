<Patch>

    <Operation Class="PatchOperationSequence">
        <operations>

			<!-- Removes the WoodLog cost from the Burnbong -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName = "Burnbong"]/costList/WoodLog</xpath>

			</li>

			<!-- Adds EW2 RawWoody category to the Burnbong -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "Burnbong"]</xpath>
				<value>
					<stuffCategories>
						<li>EW2_RawWoody</li>
					</stuffCategories>
					<costStuffCount>30</costStuffCount>
				</value>
			</li>

            <!-- Replaces Effigy costList with the RawWoody category, so it can be made with raw logs -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "Effigy"]/costList</xpath>
				<value>
					<stuffCategories>
						<li>EW2_RawWoody</li>
					</stuffCategories>
					<costStuffCount>80</costStuffCount>
				</value>
			</li>

			<!-- Replaces Incense Shrine costList with the Woody category, so it can be made with planks -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "IncenseShrine"]/costList</xpath>
				<value>
					<stuffCategories>
						<li>Woody</li>
					</stuffCategories>
					<costStuffCount>100</costStuffCount>
				</value>
			</li>

			<!-- Replaces Pyre costList with the RawWoody category, so it can be made with logs -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "Pyre"]/costList</xpath>
				<value>
					<stuffCategories>
						<li>EW2_RawWoody</li>
					</stuffCategories>
					<costStuffCount>100</costStuffCount>
				</value>
			</li>

        </operations>
	</Operation>

</Patch>
