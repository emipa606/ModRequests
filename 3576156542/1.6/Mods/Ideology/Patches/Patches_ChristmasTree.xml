<Patch>

    <Operation Class="PatchOperationSequence">
        <operations>

            <!-- Replaces the WoodLog cost of the Christmas Tree -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName = "ChristmasTree"]/costList/WoodLog</xpath>
            </li>

            <!-- Adds the stuffCategory RawWoody to the Christmas Tree so it can be made with raw logs -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName = "ChristmasTree"]</xpath>
                <value>
                    <stuffCategories>
                        <li>EW2_RawWoody</li>
                    </stuffCategories>
                    <costStuffCount>70</costStuffCount>
                </value>
            </li>

        </operations>
    </Operation>

    <!-- Prevents the christmas tree from being colourable based on wood type -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName = "ChristmasTree"]</xpath>
        <value>
            <colorPerStuff>
                <li>
                    <stuff>WoodLog</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Bamboo</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Palm</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Birch</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Cecropia</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Cocoa</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Cypress</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Drago</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Maple</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Oak</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Pine</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Poplar</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Shroom</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Succulent</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Teak</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Willow</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Gaur</stuff>
                    <color>(255,255,255)</color>
                </li>

            </colorPerStuff>
        </value>
    </Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Royalty</li>
        </mods>

        <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName = "ChristmasTree"]/colorPerStuff</xpath>
            <value>
                    <li>
                        <stuff>EW2_WoodLog_Anima</stuff>
                        <color>(255,255,255)</color>
                    </li>
            </value>
        </match>
    </Operation>

    <Operation Class="PatchOperationFindMod">
