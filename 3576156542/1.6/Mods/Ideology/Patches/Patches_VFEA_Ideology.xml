<Patch>

	<!-- Add Gauranlen Parquet if Vanilla Furniture Expanded - Architect is detected -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Furniture Expanded - Architect</li>
		</mods>
		<match Class="PatchOperationAdd">
			<xpath>Defs</xpath>
			<value>

				<TerrainDef ParentName="VFEArch_WoodenParquetBase">
					<defName>EW2_WoodenParquetGaur</defName>
					<label>living wood parquet</label>
					<color>(194,112,56)</color>
					<costList Inherit="False">
						<WoodLumberGaur>12</WoodLumberGaur>
					</costList>
					<pollutionShaderType MayRequire="Ludeon.RimWorld.Biotech">TerrainFadeRoughSoftLight</pollutionShaderType>
					<pollutionOverlayTexturePath>Terrain/Surfaces/PollutionFloorSmooth</pollutionOverlayTexturePath>
					<isPaintable>true</isPaintable>
				</TerrainDef>

			</value>
		</match>
	</Operation>

	<!-- Add Fine Gauranlen Floors if Vanilla Furniture Expanded - Architect and Royalty are detected -->
	<Operation Class="PatchOperationFindMod">
		<mods>
            <li>Vanilla Furniture Expanded - Architect</li>
		</mods>

		<match Class="PatchOperationFindMod">
			<mods>
				<li>Royalty</li>
			</mods>

			<match Class="PatchOperationAdd">
				<xpath>Defs</xpath>
				<value>

					<TerrainDef ParentName="FloorBase">
						<defName>EW2_FineWoodenFloorGaur</defName>
						<label>fine living wood floor</label>
						<description>Beautiful wooden parquet, made with no compromises, for expressing economic status. Slow to construct.</description>
						<texturePath>Terrains/FineWoodenFloor</texturePath>
						<renderPrecedence>228</renderPrecedence>
						<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
						<color>(194,112,56)</color>
						<costList>
							<WoodLumberGaur>20</WoodLumberGaur>
						</costList>
						<statBases>
							<WorkToBuild>5000</WorkToBuild>
							<Beauty>3</Beauty>
							<Flammability>0.22</Flammability>
						</statBases>
						<tags>
							<li>FineFloor</li>
						</tags>
						<constructEffect>ConstructWood</constructEffect>
						<designatorDropdown>VFEArch_FineWoodenFloor</designatorDropdown>
					</TerrainDef>

				</value>
			</match>
		</match>
	</Operation>

</Patch>
