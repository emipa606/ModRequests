<Defs>

    <!-- Gaur Fresh Lumber -->
    <ThingDef ParentName="EW2_FreshLumberBase">
        <defName>EW2_FreshLumberGaur</defName>
        <label>fresh living wood lumber</label>
        <statBases>
            <Mass>0.3</Mass>
        </statBases>
    </ThingDef>

    <!-- Gaur Wood Log - Gaur wood has been based on Oak -->
    <ThingDef ParentName="EW2_WoodLogBase">
        <defName>EW2_WoodLog_Gaur</defName>	<!-- SG: 0.75  W: 755  H: 1350 -->
        <label>living wood logs</label>
        <description>Raw wood from a gauranlen tree. Useful for building simple structures and weapons, it must be processed into fresh lumber and left to dry before becoming suitable for advanced projects. It could be used as fuel for campfires and generators, or be refined into chemfuel, but why would you? In a pinch, a piece of wood can be used as a weapon or a leg. Gauranlen wood is similar to a nondurable to perishable hardwood. A faint weeping can be heard when you press your ear against the logs.</description>
        <graphicData>
            <texPath>Things/Item/Resource/WoodLogGaur</texPath>
        </graphicData>
        <statBases>
            <Mass>0.6</Mass>
            <MarketValue>2</MarketValue>
            <DeteriorationRate>6</DeteriorationRate>
        </statBases>
        <stuffProps>
            <stuffAdjective>living wood</stuffAdjective>
            <commonality>0</commonality>
            <color>(194,112,56)</color>
            <statFactors>
                <MaxHitPoints>0.55</MaxHitPoints>
                <Beauty>2.7</Beauty>
                <WorkToMake>0.45</WorkToMake>
                <WorkToBuild>0.45</WorkToBuild>
                <DoorOpenSpeed>1.1</DoorOpenSpeed>
            </statFactors>
        </stuffProps>
        <butcherProducts>
            <EW2_FreshLumberGaur>30</EW2_FreshLumberGaur>
        </butcherProducts>
    </ThingDef>

    <ThingDef ParentName="WoodLumberBase">
        <defName>WoodLumberGaur</defName>
        <label>living wood planks</label>
        <description>Processed gauranlen wood planks, useful for advanced building structures and furniture. Gauranlen wood is similar to a nondurable to perishable hardwood.</description>
        <graphicData>
            <color>(194,112,56)</color>
        </graphicData>
        <statBases>
            <Mass>0.3</Mass>
            <MarketValue>3</MarketValue>
            <DeteriorationRate>7</DeteriorationRate>
        </statBases>
        <stuffProps>
            <stuffAdjective>living wood</stuffAdjective>
            <commonality>0</commonality>
            <color>(194,112,56)</color>
            <statFactors>
                <MaxHitPoints>0.55</MaxHitPoints>
                <Beauty>2.7</Beauty>
                <WorkToMake>0.45</WorkToMake>
                <WorkToBuild>0.45</WorkToBuild>
                <DoorOpenSpeed>1.1</DoorOpenSpeed>
            </statFactors>
        </stuffProps>
    </ThingDef>

</Defs>
