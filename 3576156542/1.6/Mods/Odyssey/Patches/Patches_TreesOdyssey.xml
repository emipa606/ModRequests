<Patch>

	<!-- Archean trees drop archean wood -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName = "Plant_TreeArchean"]/plant</xpath>
		<value>
			<harvestedThingDef>EW2_WoodLog_Archean</harvestedThingDef>
		</value>
	</Operation>

	<!-- If Biotech is detected, snagroots drop rotwood -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Biotech</li>
		</mods>
		<match Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName = "Plant_TreeSnagroot"]/plant</xpath>
			<value>
				<harvestedThingDef>EW2_WoodLog_Rot</harvestedThingDef>
			</value>
		</match>
	</Operation>
	
</Patch>
