<Defs>

    <!-- Archean Fresh Lumber -->
    <ThingDef ParentName="EW2_FreshLumberBase">
        <defName>EW2_FreshLumberArchean</defName>
        <label>fresh archean wood lumber</label>
        <statBases>
            <Mass>0.3</Mass>
        </statBases>
    </ThingDef>

    <!-- Archean Wood Log - Archean wood is beautiful yet delicate -->
    <ThingDef ParentName="EW2_WoodLogBase">
        <defName>EW2_WoodLog_Archean</defName>
        <label>archean wood logs</label>
        <description>Raw wood from an archean tree. Useful for building simple structures and weapons, it must be processed into fresh lumber and left to dry before becoming suitable for advanced projects. It could be used as fuel for campfires and generators, or be refined into chemfuel, but why would you? In a pinch, a piece of wood can be used as a weapon or a leg. Archean wood is similar to a nondurable hardwood, and is considered delicate yet beautiful.</description>
        <graphicData>
            <color>(214,224,137)</color>
        </graphicData>
        <statBases>
            <Mass>0.3</Mass>
            <MarketValue>2</MarketValue>
            <DeteriorationRate>6</DeteriorationRate>
        </statBases>
        <stuffProps>
            <stuffAdjective>archean log</stuffAdjective>
            <commonality>0</commonality>
            <color>(214,224,137)</color>
            <statFactors>
                <MaxHitPoints>0.1</MaxHitPoints>
                <Beauty>3</Beauty>
                <WorkToMake>0.65</WorkToMake>
                <WorkToBuild>0.65</WorkToBuild>
                <DoorOpenSpeed>1.0</DoorOpenSpeed>
            </statFactors>
        </stuffProps>
        <butcherProducts>
            <EW2_FreshLumberArchean>30</EW2_FreshLumberArchean>
        </butcherProducts>
    </ThingDef>

    <ThingDef ParentName="WoodLumberBase">
        <defName>WoodLumberArchean</defName>
        <label>archean wood planks</label>
        <description>Processed archean wood planks, useful for advanced building structures and furniture. Archean wood is similar to a nondurable hardwood, and is considered delicate yet beautiful.</description>
        <graphicData>
            <color>(214,224,137)</color>
        </graphicData>
        <statBases>
            <Mass>0.3</Mass>
            <MarketValue>3</MarketValue>
            <DeteriorationRate>7</DeteriorationRate>
        </statBases>
        <stuffProps>
            <stuffAdjective>archean wood</stuffAdjective>
            <commonality>0</commonality>
            <color>(214,224,137)</color>
            <statFactors>
                <MaxHitPoints>0.1</MaxHitPoints>
                <Beauty>3</Beauty>
                <WorkToMake>0.65</WorkToMake>
                <WorkToBuild>0.65</WorkToBuild>
                <DoorOpenSpeed>1.0</DoorOpenSpeed>
            </statFactors>
        </stuffProps>
    </ThingDef>

</Defs>
