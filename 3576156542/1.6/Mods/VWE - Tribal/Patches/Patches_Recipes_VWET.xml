<Patch>

	<!-- Weapons Melee -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<!-- Clubs -->
			<!-- Replaces Woody category with EW2_RawWoody -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="VWE_MeleeWeapon_HeavyClub" or defName="VWE_MeleeWeapon_LightClub"]/stuffCategories/li[.="Woody"]</xpath>
				<value>
					<li>EW2_RawWoody</li>
				</value>
			</li>

			<!-- Tribal Axe and Shiv -->
			<!-- Remove Woody category -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName="VWE_MeleeWeapon_TribalAxe" or defName="VWE_MeleeWeapon_Shiv"]/stuffCategories/li[.="Woody"]</xpath>
			</li>

		</operations>
	</Operation>

	<!-- Weapons Ranged -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<!-- Sling -->
			<!-- Replaces the dedicated WoodLog costList with EW2_RawWoody stuffCategory -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="VWE_Sling"]/costList</xpath>
				<value>
					<stuffCategories>
						<li>EW2_RawWoody</li>
					</stuffCategories>
					<costStuffCount>10</costStuffCount>
				</value>
			</li>

		</operations>
	</Operation>

</Patch>
