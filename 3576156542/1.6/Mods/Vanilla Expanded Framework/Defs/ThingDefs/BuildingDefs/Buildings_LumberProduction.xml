<Defs>

	<!-- Drying Spot -->
	<ThingDef ParentName="BuildingBase">
		<defName>EW2_LumberDryingSpot</defName>
		<label>drying spot</label>
		<description>A place to dry fresh lumber into planks suitable for construction. The drying process is susceptible to envriomental effects.</description>
		<thingClass>Building</thingClass>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Production/DryingSpot</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2,2)</drawSize>
		</graphicData>
		<altitudeLayer>FloorEmplacement</altitudeLayer>
		<useHitPoints>false</useHitPoints>
		<statBases>
			<WorkToBuild>0</WorkToBuild>
			<WorkTableWorkSpeedFactor>0.5</WorkTableWorkSpeedFactor>
		</statBases>
		<scatterableOnMapGen>false</scatterableOnMapGen>
		<size>(1,1)</size>
		<designationCategory>Production</designationCategory>
		<passability>Standable</passability>
		<surfaceType>Item</surfaceType>
		<inspectorTabs>
			<li>PipeSystem.ITab_Processor</li>
		</inspectorTabs>
		<comps>
			<li Class="PipeSystem.CompProperties_AdvancedResourceProcessor">
				<notWorkingKey>EW2_SpotNotWorking</notWorkingKey>
				<processes>
					<li>EW2_DryLumberGeneric</li>
					<li>EW2_DryLumberBamboo</li>
					<li>EW2_DryLumberPalm</li>
					<li>EW2_DryLumberBirch</li>
					<li>EW2_DryLumberCecropia</li>
					<li>EW2_DryLumberCocoa</li>
					<li>EW2_DryLumberCypress</li>
					<li>EW2_DryLumberDrago</li>
					<li>EW2_DryLumberMaple</li>
					<li>EW2_DryLumberOak</li>
					<li>EW2_DryLumberPine</li>
					<li>EW2_DryLumberPoplar</li>
					<li>EW2_DryLumberShroom</li>
					<li>EW2_DryLumberSucculent</li>
					<li>EW2_DryLumberTeak</li>
					<li>EW2_DryLumberWillow</li>
				</processes>
				<inProgressTexture>Things/Building/Production/DryingSpotFull</inProgressTexture>
				<finishedTexture>Things/Building/Production/DryingSpotFull</finishedTexture>
				<progressBarOffset>(0,0,-0.5)</progressBarOffset>
				<hideSettings>true</hideSettings>
			</li>
			<li Class="CompProperties_Forbiddable" />
		</comps>
		<tickerType>Rare</tickerType>
		<rotatable>false</rotatable>
		<building>
			<sowTag>SupportPlantsOnly</sowTag>
			<canPlaceOverImpassablePlant>false</canPlaceOverImpassablePlant>
			<ai_chillDestination>false</ai_chillDestination>
			<wakeDormantPawnsOnConstruction>false</wakeDormantPawnsOnConstruction>
			<artificialForMeditationPurposes>false</artificialForMeditationPurposes>
			<buildingTags>
				<li>Production</li>
			</buildingTags>
			<relatedBuildCommands>
				<li>EW2_TableWoodworking</li>
				<li>EW2_ElectricTableWoodworking</li>
				<li>EW2_FueledTableWoodworking</li>
			</relatedBuildCommands>
		</building>
		<researchPrerequisites>
			<li>EW2_Woodworking</li>
		</researchPrerequisites>
	</ThingDef>

	<!-- Drying Rack -->
	<ThingDef ParentName="BuildingBase">
		<defName>EW2_LumberDryingRack</defName>
		<label>drying rack</label>
		<description>A rack to dry fresh lumber into planks suitable for construction. The drying process is susceptible to envriomental effects.</description>
		<thingClass>Building</thingClass>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
		<texPath>Things/Building/Production/LumberDryingRack</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(2,2)</drawSize>
			<damageData>
				<rectN>(0.125,0.296875,0.734375,0.421875)</rectN>
				<rectS>(0.125,0.296875,0.734375,0.421875)</rectS>
				<rectE>(0.234375,0.296875,0.5,0.546875)</rectE>
				<rectW>(0.234375,0.296875,0.5,0.546875)</rectW>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
			<shadowData>
				<volume>(0.5, 0.5, 0.5)</volume>
				<offset>(0,0,-0.25)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Building/Production/LumberDryingRack_north</uiIconPath>
		<stuffCategories>
			<li>Woody</li>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>10</costStuffCount>
		<altitudeLayer>Building</altitudeLayer>
		<fillPercent>0.3</fillPercent>
		<castEdgeShadows>true</castEdgeShadows>
		<useHitPoints>True</useHitPoints>
		<statBases>
			<Mass>4</Mass>
			<MaxHitPoints>75</MaxHitPoints>
			<WorkToBuild>500</WorkToBuild>
			<Flammability>1.0</Flammability>
		</statBases>
		<designationCategory>Production</designationCategory>
		<passability>PassThroughOnly</passability>
		<pathCost>70</pathCost>
		<modExtensions>
			<li MayRequire="mlie.perspectivebuildings" Class="Perspective.Offsetter" />
		</modExtensions>
		<inspectorTabs>
			<li>PipeSystem.ITab_Processor</li>
		</inspectorTabs>
		<comps>
			<li Class="PipeSystem.CompProperties_AdvancedResourceProcessor">
				<notWorkingKey>EW2_SpotNotWorking</notWorkingKey>
				<processes>
					<li>EW2_DryLumberGeneric</li>
					<li>EW2_DryLumberBamboo</li>
					<li>EW2_DryLumberPalm</li>
					<li>EW2_DryLumberBirch</li>
					<li>EW2_DryLumberCecropia</li>
					<li>EW2_DryLumberCocoa</li>
					<li>EW2_DryLumberCypress</li>
					<li>EW2_DryLumberDrago</li>
					<li>EW2_DryLumberMaple</li>
					<li>EW2_DryLumberOak</li>
					<li>EW2_DryLumberPine</li>
					<li>EW2_DryLumberPoplar</li>
					<li>EW2_DryLumberShroom</li>
					<li>EW2_DryLumberSucculent</li>
					<li>EW2_DryLumberTeak</li>
					<li>EW2_DryLumberWillow</li>
				</processes>
				<inProgressTexture>Things/Building/Production/LumberDryingRackFull</inProgressTexture>
				<finishedTexture>Things/Building/Production/LumberDryingRackFull</finishedTexture>
				<progressBarOffset>(0,0,-0.5)</progressBarOffset>
				<hideSettings>true</hideSettings>
			</li>
			<li Class="CompProperties_Forbiddable" />
		</comps>
		<tickerType>Rare</tickerType>
		<rotatable>false</rotatable>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
			<li>BuildingsProduction</li>
		</thingCategories>
		<building>
			<uninstallWork>125</uninstallWork>
			<buildingTags>
				<li>Production</li>
			</buildingTags>
			<relatedBuildCommands>
				<li>EW2_TableWoodworking</li>
				<li>EW2_ElectricTableWoodworking</li>
				<li>EW2_FueledTableWoodworking</li>
			</relatedBuildCommands>
		</building>
		<researchPrerequisites>
			<li>EW2_Woodworking</li>
		</researchPrerequisites>
	</ThingDef>

	<!-- Trestle -->
	<ThingDef ParentName="BenchBase">
		<defName>EW2_TableWoodworking</defName>
		<label>trestle</label>
		<thingClass>Building_WorkTable</thingClass>
		<description>A pair of trestles for sawing logs into fresh lumber.</description>
		<graphicData>
			<texPath>Things/Building/Production/Trestle</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(3.5,1.5)</drawSize>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.20</staticSunShadowHeight>
		<costList>
			<Steel>30</Steel>
		</costList>
		<stuffCategories>
			<li>Woody</li>
		</stuffCategories>
		<costStuffCount>75</costStuffCount>
		<altitudeLayer>Building</altitudeLayer>
		<fillPercent>0.5</fillPercent>
		<useHitPoints>True</useHitPoints>
		<statBases>
			<WorkToBuild>2000</WorkToBuild>
			<MaxHitPoints>180</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<Cleanliness>-5</Cleanliness>
			<WorkTableWorkSpeedFactor>0.5</WorkTableWorkSpeedFactor>
		</statBases>
		<size>(3,1)</size>
		<designationCategory>Production</designationCategory>
		<passability>PassThroughOnly</passability>
		<pathCost>70</pathCost>
		<hasInteractionCell>True</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<surfaceType>Item</surfaceType>
		<inspectorTabs>
			<li>ITab_Bills</li>
		</inspectorTabs>
		<building>
			<spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
		</building>
		<comps>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
					<li>ToolCabinet</li>
				</linkableFacilities>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>EW2_Woodworking</li>
		</researchPrerequisites>
	</ThingDef>
	
	<!-- Electric Table Saw -->
	<ThingDef ParentName="BenchBase">
		<defName>EW2_ElectricTableWoodworking</defName>
		<label>electric table saw</label>
		<thingClass>Building_WorkTable_HeatPush</thingClass>
		<description>An electric table saw for sawing logs into fresh lumber.</description>
		<graphicData>
		<texPath>Things/Building/Production/TableWoodworking</texPath> <!-- Really needs a new graphic -->
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(3.5,1.5)</drawSize>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.20</staticSunShadowHeight>
		<costList>
			<Steel>50</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>75</costStuffCount>
		<altitudeLayer>Building</altitudeLayer>
		<fillPercent>0.5</fillPercent>
		<useHitPoints>True</useHitPoints>
		<statBases>
			<WorkToBuild>2500</WorkToBuild>
			<MaxHitPoints>180</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<Cleanliness>-3</Cleanliness>
		</statBases>
		<size>(3,1)</size>
		<designationCategory>Production</designationCategory>
		<passability>PassThroughOnly</passability>
		<pathCost>70</pathCost>
		<hasInteractionCell>True</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<surfaceType>Item</surfaceType>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<inspectorTabs>
			<li>ITab_Bills</li>
		</inspectorTabs>
		<building>
			<workTableRoomRole>Workshop</workTableRoomRole>
			<workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
			<spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
			<heatPerTickWhileWorking>0.08</heatPerTickWhileWorking>
		</building>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<shortCircuitInRain>true</shortCircuitInRain>
				<basePowerConsumption>200</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
					<li>ToolCabinet</li>
				</linkableFacilities>
			</li>
			<li Class="CompProperties_Breakdownable"/>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>EW2_Woodworking</li>
			<li>Electricity</li>
		</researchPrerequisites>
	</ThingDef>

	<!-- Fueled Table Saw -->
	<ThingDef ParentName="BenchBase">
		<defName>EW2_FueledTableWoodworking</defName>
		<label>fueled table saw</label>
		<thingClass>Building_WorkTable_HeatPush</thingClass>
		<description>A fueled table saw for sawing logs into fresh lumber.</description>
		<graphicData>
		<texPath>Things/Building/Production/FueledTableWoodworking</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(3.5,1.5)</drawSize>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.20</staticSunShadowHeight>
		<costList>
			<Steel>50</Steel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>75</costStuffCount>
		<altitudeLayer>Building</altitudeLayer>
		<fillPercent>0.5</fillPercent>
		<useHitPoints>True</useHitPoints>
		<statBases>
			<WorkToBuild>2500</WorkToBuild>
			<MaxHitPoints>180</MaxHitPoints>
			<Flammability>2.0</Flammability>
			<Cleanliness>-5</Cleanliness>
		</statBases>
		<size>(3,1)</size>
		<designationCategory>Production</designationCategory>
		<passability>PassThroughOnly</passability>
		<pathCost>70</pathCost>
		<hasInteractionCell>True</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<surfaceType>Item</surfaceType>
		<constructionSkillPrerequisite>4</constructionSkillPrerequisite>
		<inspectorTabs>
			<li>ITab_Bills</li>
		</inspectorTabs>
		<building>
			<workTableRoomRole>Workshop</workTableRoomRole>
			<workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
			<spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
			<heatPerTickWhileWorking>0.1</heatPerTickWhileWorking>
		</building>
		<comps>
			<li Class="CompProperties_Refuelable">
				<fuelConsumptionRate>80.0</fuelConsumptionRate>
				<fuelCapacity>50.0</fuelCapacity>
				<fuelFilter>
					<thingDefs>
						<li>WoodLog</li>
					</thingDefs>
				</fuelFilter>
				<consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
				<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
				<canEjectFuel>true</canEjectFuel>
			</li>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
					<li>ToolCabinet</li>
				</linkableFacilities>
			</li>
			<li Class="CompProperties_Breakdownable"/>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
		<researchPrerequisites>
			<li>EW2_Woodworking</li>
			<li>Electricity</li>
		</researchPrerequisites>
	</ThingDef>

</Defs>
