<Patch>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>VV - New Harvest</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>

				<li Class="PatchOperationAdd">
					<xpath>Defs</xpath>
					<value>

					<!-- Add Processor Defs -->
					<!-- Cedar -->
					<PipeSystem.ProcessDef>
                        <defName>EW2_DryLumberCedar</defName>
                        <label>Dry cedar lumber</label>
                        <description>Leave cedar lumber to dry.</description>
                        <spawnOnInteractionCell>true</spawnOnInteractionCell>
                        <labelOverride>Dry cedar lumber</labelOverride>
                        <priorityInBillList>0</priorityInBillList>
                        <ingredients>
                            <li>
                                <thing>EW2_FreshLumberCedar</thing>
                                <countNeeded>75</countNeeded>
                            </li>
                        </ingredients>
                        <ticks>36000</ticks>
                        <results>
                            <li>
                                <thing>WoodLumberCedar</thing>
                                <count>75</count>
                            </li>
                        </results>
                        <autoExtract>false</autoExtract>
                        <isRainDependingProcess>true</isRainDependingProcess>
                        <temperatureRuinable>true</temperatureRuinable>
                        <minSafeTemperature>0</minSafeTemperature>
                        <maxSafeTemperature>40</maxSafeTemperature>
                        <researchPrerequisites><li>EW2_Woodworking</li></researchPrerequisites>
                    </PipeSystem.ProcessDef>

					<!-- Ebony -->
					<PipeSystem.ProcessDef>
                        <defName>EW2_DryLumberEbony</defName>
                        <label>Dry ebony lumber</label>
                        <description>Leave ebony lumber to dry.</description>
                        <spawnOnInteractionCell>true</spawnOnInteractionCell>
                        <labelOverride>Dry ebony lumber</labelOverride>
                        <priorityInBillList>0</priorityInBillList>
                        <ingredients>
                            <li>
                                <thing>EW2_FreshLumberEbony</thing>
                                <countNeeded>75</countNeeded>
                            </li>
                        </ingredients>
                        <ticks>36000</ticks>
                        <results>
                            <li>
                                <thing>WoodLumberEbony</thing>
                                <count>75</count>
                            </li>
                        </results>
                        <autoExtract>false</autoExtract>
                        <isRainDependingProcess>true</isRainDependingProcess>
                        <temperatureRuinable>true</temperatureRuinable>
                        <minSafeTemperature>0</minSafeTemperature>
                        <maxSafeTemperature>40</maxSafeTemperature>
                        <researchPrerequisites><li>EW2_Woodworking</li></researchPrerequisites>
                    </PipeSystem.ProcessDef>

					<!-- Mahogany-->
					<PipeSystem.ProcessDef>
                        <defName>EW2_DryLumberMahogany</defName>
                        <label>Dry mahogany lumber</label>
                        <description>Leave mahogany lumber to dry.</description>
                        <spawnOnInteractionCell>true</spawnOnInteractionCell>
                        <labelOverride>Dry mahogany lumber</labelOverride>
                        <priorityInBillList>0</priorityInBillList>
                        <ingredients>
                            <li>
                                <thing>EW2_FreshLumberMahogany</thing>
                                <countNeeded>75</countNeeded>
                            </li>
                        </ingredients>
                        <ticks>36000</ticks>
                        <results>
                            <li>
                                <thing>WoodLumberMahogany</thing>
                                <count>75</count>
                            </li>
                        </results>
                        <autoExtract>false</autoExtract>
                        <isRainDependingProcess>true</isRainDependingProcess>
                        <temperatureRuinable>true</temperatureRuinable>
                        <minSafeTemperature>0</minSafeTemperature>
                        <maxSafeTemperature>40</maxSafeTemperature>
                        <researchPrerequisites><li>EW2_Woodworking</li></researchPrerequisites>
                    </PipeSystem.ProcessDef>

					<!-- Rosewood -->
					<PipeSystem.ProcessDef>
                        <defName>EW2_DryLumberRosewood</defName>
                        <label>Dry rosewood lumber</label>
                        <description>Leave rosewood lumber to dry.</description>
                        <spawnOnInteractionCell>true</spawnOnInteractionCell>
                        <labelOverride>Dry rosewood lumber</labelOverride>
                        <priorityInBillList>0</priorityInBillList>
                        <ingredients>
                            <li>
                                <thing>EW2_FreshLumberRosewood</thing>
                                <countNeeded>75</countNeeded>
                            </li>
                        </ingredients>
                        <ticks>36000</ticks>
                        <results>
                            <li>
                                <thing>WoodLumberRosewood</thing>
                                <count>75</count>
                            </li>
                        </results>
                        <autoExtract>false</autoExtract>
                        <isRainDependingProcess>true</isRainDependingProcess>
                        <temperatureRuinable>true</temperatureRuinable>
                        <minSafeTemperature>0</minSafeTemperature>
                        <maxSafeTemperature>40</maxSafeTemperature>
                        <researchPrerequisites><li>EW2_Woodworking</li></researchPrerequisites>
                    </PipeSystem.ProcessDef>

				</value>
            </li>

				<!-- Adds recipes to drying spot and drying rack -->
				<!-- Dry Fresh Cedar Lumber -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "EW2_LumberDryingRack" or defName="EW2_LumberDryingSpot"]/comps/li["PipeSystem.CompProperties_AdvancedResourceProcessor"]/processes</xpath>
					<value>
						<li>EW2_DryLumberCedar</li>
					</value>
				</li>

				<!-- Dry Fresh Ebony Lumber -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "EW2_LumberDryingRack" or defName="EW2_LumberDryingSpot"]/comps/li["PipeSystem.CompProperties_AdvancedResourceProcessor"]/processes</xpath>
					<value>
						<li>EW2_DryLumberEbony</li>
					</value>
				</li>

				<!-- Dry Fresh Mahogany Lumber -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "EW2_LumberDryingRack" or defName="EW2_LumberDryingSpot"]/comps/li["PipeSystem.CompProperties_AdvancedResourceProcessor"]/processes</xpath>
					<value>
						<li>EW2_DryLumberMahogany</li>
					</value>
				</li>

				<!-- Dry Fresh Rosewood Lumber -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "EW2_LumberDryingRack" or defName="EW2_LumberDryingSpot"]/comps/li["PipeSystem.CompProperties_AdvancedResourceProcessor"]/processes</xpath>
					<value>
						<li>EW2_DryLumberRosewood</li>
					</value>
				</li>

			</operations>
		</match>
    </Operation>

</Patch>
