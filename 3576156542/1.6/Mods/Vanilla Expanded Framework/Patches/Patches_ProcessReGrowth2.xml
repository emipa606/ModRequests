<Patch>

    <Operation Class="PatchOperationFindMod">
		<mods>
            <li>ReGrowth 2</li>
		</mods>
        <match Class="PatchOperationSequence">
        <operations>

            <!-- Dry Fresh Elm Lumber -->
            <li Class="PatchOperationAdd">
                <xpath>Defs</xpath>
                <value>
                    <PipeSystem.ProcessDef>
                        <defName>EW2_DryLumberElm</defName>
                        <label>Dry elm lumber</label>
                        <description>Leave elm lumber to dry.</description>
                        <spawnOnInteractionCell>true</spawnOnInteractionCell>
                        <labelOverride>Dry elm lumber</labelOverride>
                        <priorityInBillList>0</priorityInBillList>
                        <ingredients>
                            <li>
                                <thing>EW2_FreshLumberElm</thing>
                                <countNeeded>75</countNeeded>
                            </li>
                        </ingredients>
                        <ticks>36000</ticks>
                        <results>
                            <li>
                                <thing>WoodLumberElm</thing>
                                <count>75</count>
                            </li>
                        </results>
                        <autoExtract>false</autoExtract>
                        <isRainDependingProcess>true</isRainDependingProcess>
                        <temperatureRuinable>true</temperatureRuinable>
                        <minSafeTemperature>0</minSafeTemperature>
                        <maxSafeTemperature>40</maxSafeTemperature>
                        <researchPrerequisites><li>EW2_Woodworking</li></researchPrerequisites>
                    </PipeSystem.ProcessDef>
                </value>
            </li>

            <!-- Adds drying recipe to drying spot/rack -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName = "EW2_LumberDryingRack" or defName="EW2_LumberDryingSpot"]/comps/li["PipeSystem.CompProperties_AdvancedResourceProcessor"]/processes</xpath>
                <value>
                    <li>EW2_DryLumberElm</li>
                </value>
            </li>

        </operations>
        </match>
    </Operation>

</Patch>
