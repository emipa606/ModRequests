<Patch>

    <Operation Class="PatchOperationFindMod">
		<mods>
            <li>Medieval Overhaul</li>
		</mods>
        <match Class="PatchOperationSequence">
        <operations>

            <!-- Adds drying recipe to drying spot/rack -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName = "EW2_LumberDryingRack" or defName="EW2_LumberDryingSpot"]/comps/li["ProcessorFramework.CompProperties_Processor"]/processes</xpath>
                <value>
                    <li>EW2_DryLumberDark</li>
                </value>
            </li>

        </operations>
        </match>
    </Operation>

</Patch>
