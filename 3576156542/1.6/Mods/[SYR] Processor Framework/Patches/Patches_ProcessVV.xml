<Patch>

	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>VV - New Harvest</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>

				<li Class="PatchOperationAdd">
					<xpath>Defs</xpath>
					<value>

						<!-- Add Processor Defs -->
						<!-- Cedar -->
						<ProcessorFramework.ProcessDef>
							<defName>EW2_DryLumberCedar</defName>
							<processDays>0.67</processDays>
							<fuelUseFactor>2.0</fuelUseFactor>
							<temperatureIdeal>10~100</temperatureIdeal>
							<temperatureSafe>-50~200</temperatureSafe>
							<filledGraphicSuffix>Full</filledGraphicSuffix>
							<sunFactor>0.4~1.0</sunFactor>
							<rainFactor>1~0</rainFactor>
							<snowFactor>1~0</snowFactor>
							<windFactor>0.8~1.0</windFactor>
							<thingDef>WoodLumberCedar</thingDef>
							<ingredientFilter>
								<thingDefs>
									<li>EW2_FreshLumberCedar</li>
								</thingDefs>
							</ingredientFilter>
						</ProcessorFramework.ProcessDef>

						<!-- Ebony -->
						<ProcessorFramework.ProcessDef>
							<defName>EW2_DryLumberEbony</defName>
							<processDays>0.67</processDays>
							<fuelUseFactor>2.0</fuelUseFactor>
							<temperatureIdeal>10~100</temperatureIdeal>
							<temperatureSafe>-50~200</temperatureSafe>
							<filledGraphicSuffix>Full</filledGraphicSuffix>
							<sunFactor>0.4~1.0</sunFactor>
							<rainFactor>1~0</rainFactor>
							<snowFactor>1~0</snowFactor>
							<windFactor>0.8~1.0</windFactor>
							<thingDef>WoodLumberEbony</thingDef>
							<ingredientFilter>
								<thingDefs>
								<li>EW2_FreshLumberEbony</li>
							</thingDefs>
							</ingredientFilter>
						</ProcessorFramework.ProcessDef>

						<!-- Mahogany-->
						<ProcessorFramework.ProcessDef>
							<defName>EW2_DryLumberMahogany</defName>
							<processDays>0.67</processDays>
							<fuelUseFactor>2.0</fuelUseFactor>
							<temperatureIdeal>10~100</temperatureIdeal>
							<temperatureSafe>-50~200</temperatureSafe>
							<filledGraphicSuffix>Full</filledGraphicSuffix>
							<sunFactor>0.4~1.0</sunFactor>
							<rainFactor>1~0</rainFactor>
							<snowFactor>1~0</snowFactor>
							<windFactor>0.8~1.0</windFactor>
							<thingDef>WoodLumberMahogany</thingDef>
							<ingredientFilter>
								<thingDefs>
									<li>EW2_FreshLumberMahogany</li>
								</thingDefs>
							</ingredientFilter>
						</ProcessorFramework.ProcessDef>

						<!-- Rosewood -->
						<ProcessorFramework.ProcessDef>
							<defName>EW2_DryLumberRosewood</defName>
							<processDays>0.67</processDays>
							<fuelUseFactor>2.0</fuelUseFactor>
							<temperatureIdeal>10~100</temperatureIdeal>
							<temperatureSafe>-50~200</temperatureSafe>
							<filledGraphicSuffix>Full</filledGraphicSuffix>
							<sunFactor>0.4~1.0</sunFactor>
							<rainFactor>1~0</rainFactor>
							<snowFactor>1~0</snowFactor>
							<windFactor>0.8~1.0</windFactor>
							<thingDef>WoodLumberRosewood</thingDef>
							<ingredientFilter>
								<thingDefs>
									<li>EW2_FreshLumberRosewood</li>
								</thingDefs>
							</ingredientFilter>
						</ProcessorFramework.ProcessDef>
					</value>

				</li>

				<!-- Adds recipes to drying spot and drying rack -->
				<!-- Dry Fresh Cedar Lumber -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "EW2_LumberDryingRack" or defName="EW2_LumberDryingSpot"]/comps/li["ProcessorFramework.CompProperties_Processor"]/processes</xpath>
					<value>
						<li>EW2_DryLumberCedar</li>
					</value>
				</li>

				<!-- Dry Fresh Ebony Lumber -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "EW2_LumberDryingRack" or defName="EW2_LumberDryingSpot"]/comps/li["ProcessorFramework.CompProperties_Processor"]/processes</xpath>
					<value>
						<li>EW2_DryLumberEbony</li>
					</value>
				</li>

				<!-- Dry Fresh Mahogany Lumber -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "EW2_LumberDryingRack" or defName="EW2_LumberDryingSpot"]/comps/li["ProcessorFramework.CompProperties_Processor"]/processes</xpath>
					<value>
						<li>EW2_DryLumberMahogany</li>
					</value>
				</li>

				<!-- Dry Fresh Rosewood Lumber -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "EW2_LumberDryingRack" or defName="EW2_LumberDryingSpot"]/comps/li["ProcessorFramework.CompProperties_Processor"]/processes</xpath>
					<value>
						<li>EW2_DryLumberRosewood</li>
					</value>
				</li>

			</operations>
		</match>
    </Operation>

</Patch>
