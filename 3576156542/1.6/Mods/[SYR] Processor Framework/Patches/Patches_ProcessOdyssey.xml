<Patch>

    <Operation Class="PatchOperationFindMod">
		<mods>
			<li>Odyssey</li>
		</mods>
        <match Class="PatchOperationSequence">
        <operations>

            <!-- Dry Fresh Archean Lumber -->
            <li Class="PatchOperationAdd">
                <xpath>Defs</xpath>
                <value>
                    <ProcessorFramework.ProcessDef>
                        <defName>EW2_DryLumberArchean</defName>
                        <filledGraphicSuffix>Full</filledGraphicSuffix>
                        <processDays>0.67</processDays>
                        <fuelUseFactor>0</fuelUseFactor>
                        <usesTemperature>false</usesTemperature>
                        <temperatureIdeal>10~100</temperatureIdeal>
                        <temperatureSafe>-50~200</temperatureSafe>
                        <speedBelowSafe>0.1</speedBelowSafe>
                        <speedAboveSafe>1.0</speedAboveSafe>
                        <sunFactor>0.4~1.0</sunFactor>
                        <rainFactor>1~0</rainFactor>
                        <snowFactor>1~0</snowFactor>
                        <windFactor>0.8~1.0</windFactor>
                        <thingDef>WoodLumberArchean</thingDef>
                        <ingredientFilter>
                            <thingDefs>
                                <li>EW2_FreshLumberArchean</li>
                            </thingDefs>
                        </ingredientFilter>
                        <usesQuality>false</usesQuality>
                        <qualityDays>(1, 3, 8, 14, 20, 50, 120)</qualityDays>
                    </ProcessorFramework.ProcessDef>
                </value>
            </li>

            <!-- Adds drying recipe to drying spot/rack -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName = "EW2_LumberDryingRack" or defName="EW2_LumberDryingSpot"]/comps/li["ProcessorFramework.CompProperties_Processor"]/processes</xpath>
                <value>
                    <li>EW2_DryLumberArchean</li>
                </value>
            </li>

        </operations>
        </match>
    </Operation>

</Patch>
