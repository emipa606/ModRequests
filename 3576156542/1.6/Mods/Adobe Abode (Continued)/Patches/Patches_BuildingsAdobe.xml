<Patch>

    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[defName = "JKN_AdobeBakingFrame"]/costList</xpath>
    </Operation>

    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[defName = "JKN_AdobeBakingFrame"]/constructEffect</xpath>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName = "JKN_AdobeBakingFrame"]</xpath>
        <value>
            <stuffCategories>
                <li>Woody</li>
            </stuffCategories>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName = "JKN_AdobeBakingFrame"]</xpath>
        <value>
            <costStuffCount>15</costStuffCount>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName = "JKN_AdobeBakingFrame"]/graphicData/texPath</xpath>
        <value>
            <texPath>Things/Building/Production/AdobeFrame</texPath>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName = "JKN_AdobeBakingFrame"]/graphicData</xpath>
        <value>
            <shaderType>CutoutComplex</shaderType>
        </value>
    </Operation>

</Patch>
