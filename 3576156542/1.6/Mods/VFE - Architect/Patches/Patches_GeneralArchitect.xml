							<WoodLumberMixed>20</WoodLumberMixed>
						</costList>
					</value>
				</li>

				<!-- Remove Fine Walnut floors -->
				<li Class="PatchOperationRemove">
					<xpath>Defs/TerrainDef[defName = "VFEArch_FineWoodenFloorWalnut"]</xpath>
