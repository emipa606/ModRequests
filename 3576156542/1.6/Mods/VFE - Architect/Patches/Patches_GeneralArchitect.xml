<Patch>

	<!-- Log Walls use EW2 logs -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName = "VFEArch_LogWall"]/costList</xpath>
			<value>
				<stuffCategories>
					<li>EW2_RawWoody</li>
				</stuffCategories>
				<costStuffCount>5</costStuffCount>
			</value>
	</Operation>

	<!-- Wooden Parquet uses planks -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/TerrainDef[@Name = "VFEArch_WoodenParquetBase"]/costList</xpath>
			<value>
				<costList>
					<WoodLumberMixed>12</WoodLumberMixed>
				</costList>
			</value>
	</Operation>

	<!-- Disables Walnut floors -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<!-- Plank Floors -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/TerrainDef[defName = "VFEArch_WoodPlankFloorWalnut"]</xpath>
			</li>

			<!-- Parquet Floors -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/TerrainDef[defName = "VFEArch_WoodenParquetWalnut"]</xpath>
			</li>

		</operations>
	</Operation>

	<!-- Disables Birch floors -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<!-- Plank Floors -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/TerrainDef[defName = "VFEArch_WoodPlankFloorBirch"]</xpath>
			</li>

			<!-- Parquet Floors -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/TerrainDef[defName = "VFEArch_WoodenParquetBirch"]</xpath>
			</li>

		</operations>
	</Operation>

	<!-- Disables Mahogany floors -->
	<Operation Class="PatchOperationSequence">
			<operations>

				<!-- Plank Floors -->
				<li Class="PatchOperationRemove">
					<xpath>Defs/TerrainDef[defName = "VFEArch_WoodPlankFloorMahogany"]</xpath>
				</li>

				<!-- Parquet Floors -->
				<li Class="PatchOperationRemove">
					<xpath>Defs/TerrainDef[defName = "VFEArch_WoodenParquetMahogany"]</xpath>
				</li>

			</operations>
	</Operation>

