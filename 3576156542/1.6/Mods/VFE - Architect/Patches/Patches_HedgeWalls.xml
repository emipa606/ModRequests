<Patch>

    <!-- Hedges use EW2 logs -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName = "VFEArch_HedgeWall"]/costList</xpath>
			<value>
				<stuffCategories>
					<li>EW2_RawWoody</li>
				</stuffCategories>
				<costStuffCount>5</costStuffCount>
			</value>
	</Operation>

	<!-- Hedges do not tint their texture based on stuff -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName = "VFEArch_HedgeWall"]</xpath>
			<value>
				<colorPerStuff>
					<li>
						<stuff>WoodLog</stuff>
						<color>(255,255,255)</color>
					</li>
					<li>
						<stuff>EW2_WoodLog_Bamboo</stuff>
						<color>(255,255,255)</color>
					</li>
					<li>
						<stuff>EW2_WoodLog_Palm</stuff>
						<color>(255,255,255)</color>
					</li>
					<li>
						<stuff>EW2_WoodLog_Birch</stuff>
						<color>(255,255,255)</color>
					</li>
					<li>
						<stuff>EW2_WoodLog_Cecropia</stuff>
						<color>(255,255,255)</color>
					</li>
					<li>
						<stuff>EW2_WoodLog_Cocoa</stuff>
						<color>(255,255,255)</color>
					</li>
					<li>
						<stuff>EW2_WoodLog_Cypress</stuff>
						<color>(255,255,255)</color>
					</li>
					<li>
						<stuff>EW2_WoodLog_Drago</stuff>
						<color>(255,255,255)</color>
					</li>
					<li>
						<stuff>EW2_WoodLog_Maple</stuff>
						<color>(255,255,255)</color>
					</li>
					<li>
						<stuff>EW2_WoodLog_Oak</stuff>
						<color>(255,255,255)</color>
					</li>
					<li>
						<stuff>EW2_WoodLog_Pine</stuff>
						<color>(255,255,255)</color>
					</li>
					<li>
						<stuff>EW2_WoodLog_Poplar</stuff>
						<color>(255,255,255)</color>
					</li>
					<li>
						<stuff>EW2_WoodLog_Shroom</stuff>
						<color>(255,255,255)</color>
					</li>
					<li>
						<stuff>EW2_WoodLog_Succulent</stuff>
						<color>(255,255,255)</color>
					</li>
					<li>
						<stuff>EW2_WoodLog_Teak</stuff>
						<color>(255,255,255)</color>
					</li>
					<li>
						<stuff>EW2_WoodLog_Willow</stuff>
						<color>(255,255,255)</color>
					</li>
				</colorPerStuff>
			</value>
	</Operation>

	<!-- Ideology -->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Ideology</li>
        </mods>
        <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName = "VFEArch_HedgeWall"]/colorPerStuff</xpath>
            <value>
                    <li>
                        <stuff>EW2_WoodLog_Gaur</stuff>
                        <color>(255,255,255)</color>
                    </li>
            </value>
        </match>
	</Operation>

    <!-- Royalty -->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Royalty</li>
        </mods>
        <match Class="PatchOperationAdd">
