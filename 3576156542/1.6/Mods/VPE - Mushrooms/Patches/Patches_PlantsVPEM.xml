<Patch>

    <!-- Timbercaps now drop shroomstalk -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName = "VPE_Plant_Timbercap"]/plant/harvestedThingDef</xpath>
        <value>
            <harvestedThingDef>EW2_WoodLog_Shroom</harvestedThingDef>
        </value>
    </Operation>

</Patch>
