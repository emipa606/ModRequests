<Patch>

    <!-- Timbered Wall -->
    <Operation Class="PatchOperationSequence">
        <operations>

            <!-- Remove dedicated WoodLog costList -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEM2_TimberedWall"]/costList/WoodLog</xpath>
            </li>

            <!-- Add Woody stuffCategory so they can be made with various wood planks -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_TimberedWall"]</xpath>
                <value>
                    <costList>
                        <WoodLumberMixed>1</WoodLumberMixed>
                    </costList>
                </value>
            </li>

        </operations>
    </Operation>

    <!-- Pallisades -->
    <!-- Replaces Woody stuffCategory with EW2_RawWoody, so it can be made with raw logs -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="VFEM2_Palisade"]/stuffCategories/li[.="Woody"]</xpath>
        <value>
            <li>EW2_RawWoody</li>
        </value>
    </Operation>

</Patch>

