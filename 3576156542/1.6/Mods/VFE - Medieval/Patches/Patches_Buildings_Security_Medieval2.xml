<Patch>

    <!-- Wall-Mounted Arbalest and Arquebus -->
    <Operation Class="PatchOperationSequence">
        <operations>

            <!-- Remove dedicated WoodLog costList -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEM2_Turret_WallMountedArbalest" or defName="VFEM2_Turret_WallMountedArquebus"]/costList/WoodLog</xpath>
            </li>

            <!-- Add WoodLumber so Wall-Mounted Arbalest takes generic lumber instead of generic logs -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_Turret_WallMountedArbalest"]</xpath>
                <value>
                    <costList>
                        <WoodLumberMixed>50</WoodLumberMixed>
                    </costList>
                </value>
            </li>

            <!-- Add WoodLumber so Wall-Mounted Arquebus takes generic lumber instead of generic logs -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_Turret_WallMountedArquebus"]</xpath>
                <value>
                    <costList>
                        <WoodLumberMixed>90</WoodLumberMixed>
                    </costList>
                </value>
            </li>

        </operations>
    </Operation>

</Patch>
