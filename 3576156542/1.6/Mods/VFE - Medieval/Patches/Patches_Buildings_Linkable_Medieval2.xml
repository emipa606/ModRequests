<Patch>

    <Operation Class="PatchOperationSequence">
        <operations>

            <!-- Remove the dedicated WoodLog costList from Notes Stack, Carving Board, and Mannequin Stand -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEM2_NotesStack" or defName ="VFEM2_CarvingBoard" or defName="VFEM2_MannequinStand"]/costList</xpath>
            </li>

             <!-- Remove the dedicated WoodLog costList from Forge Bellows -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEM2_ForgeBellows"]/costList/WoodLog</xpath>
            </li>

             <!-- Add Woody stuffCategory so Forge Bellows can be made with various plank types -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_ForgeBellows"]</xpath>
                <value>
                    <stuffCategories>
						<li>Woody</li>
					</stuffCategories>
					<costStuffCount>30</costStuffCount>
                </value>
            </li>
        </operations>
    </Operation>

</Patch>
