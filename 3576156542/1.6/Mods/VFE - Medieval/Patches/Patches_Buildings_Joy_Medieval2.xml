<Patch>

    <!-- Archery and Training Target -->
    <Operation Class="PatchOperationSequence">
        <operations>

            <!-- Remove dedicated WoodLog costList -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEM2_ArcheryTarget" or defName="VFEM2_TrainingDummy"]/costList/WoodLog</xpath>
            </li>

            <!-- Add EW2_RawWoody so they can be made with planks -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_ArcheryTarget" or defName="VFEM2_TrainingDummy"]</xpath>
                <value>
                   <stuffCategories>
						<li>Woody</li>
					</stuffCategories>
					<costStuffCount>25</costStuffCount>
                </value>
            </li>

        </operations>
    </Operation>

</Patch>
