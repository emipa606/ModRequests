<Patch>

    <!-- Standing Banner -->
    <Operation Class="PatchOperationSequence">
        <operations>

            <!-- Remove dedicated WoodLog costList -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEM2_StandingBanner"]/costList/WoodLog</xpath>
            </li>

            <!-- Add Woody stuffCategory so they can be made with various wood planks -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_StandingBanner"]</xpath>
                <value>
                   <stuffCategories>
						<li>Woody</li>
					</stuffCategories>
					<costStuffCount>50</costStuffCount>
                </value>
            </li>

        </operations>
    </Operation>

    <!-- Beds -->
    <Operation Class="PatchOperationSequence">
        <operations>

            <!-- Remove dedicated WoodLog costList -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEM2_FurBed" or defName="VFEM2_DoubleFurBed"]/costList</xpath>
            </li>

            <!-- Add WoodLumberMixed costList so Fur Bed can be made with generic planks instead of generic logs -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_FurBed"]</xpath>
                <value>
                    <costList>
                        <WoodLumberMixed>25</WoodLumberMixed>
                    </costList>
                </value>
            </li>

            <!-- Add WoodLumberMixed costList so Double Fur Bed can be made with generic planks instead of generic logs -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_DoubleFurBed"]</xpath>
                <value>
                    <costList>
                        <WoodLumberMixed>45</WoodLumberMixed>
                    </costList>
                </value>
            </li>

            </operations>
        </Operation>

</Patch>
