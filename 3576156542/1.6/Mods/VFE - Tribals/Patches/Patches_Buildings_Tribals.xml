<Patch>

    <!-- Security -->
    <!-- Animal Trap -->
    <!-- Replaces Woody category with EW2_RawWoody, so it can be built with logs -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="VFET_AnimalTrap"]/stuffCategories/li[.="Woody"]</xpath>
        <value>
            <li>EW2_RawWoody</li>
        </value>
    </Operation>

    <!-- Temperature -->
    <!-- Large Fire -->
    <Operation Class="PatchOperationSequence">
        <operations>

            <!-- Replaces Woody category with EW2_RawWoody, so it can be built with logs -->
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[defName="VFET_LargeFire"]/costList</xpath>
                <value>
                    <stuffCategories>
                        <li>EW2_RawWoody</li>
                    </stuffCategories>
                    <costStuffCount>150</costStuffCount>
                </value>
            </li>

            <!-- Removes the construct effect so it does not produce an error -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFET_LargeFire"]/constructEffect</xpath>
            </li>

        </operations>
    </Operation>

</Patch>
