<Patch>

    <!-- Apparel -->
    <!-- War Tribalwear -->
    <!-- Replaces Woody category with EW2_RawWoody, so it can be built with logs -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="VFET_Apparel_TribalWar"]/stuffCategories/li[.="Woody"]</xpath>
        <value>
            <li>EW2_RawWoody</li>
        </value>
    </Operation>

    <!-- Weapons Melee-->
    <!-- Stake -->
    <!-- Replaces dedicated WoodLog costList with EW2_RawWoody category -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="VFET_Stake"]/costList</xpath>
        <value>
            <stuffCategories>
                <li>EW2_RawWoody</li>
            </stuffCategories>
            <costStuffCount>5</costStuffCount>
        </value>
    </Operation>

    <!-- Weapons Ranged -->
    <!-- Throwspikes -->
    <!-- Replaces dedicated WoodLog costList with EW2_RawWoody category -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="VFET_Throwspikes"]/costList</xpath>
        <value>
            <stuffCategories>
                <li>EW2_RawWoody</li>
            </stuffCategories>
            <costStuffCount>15</costStuffCount>
        </value>
    </Operation>

</Patch>
