<Defs>

    <!-- Rotwood Fresh Lumber -->
    <ThingDef ParentName="EW2_FreshLumberBase">
        <defName>EW2_FreshLumberRot</defName>
        <label>fresh rotwood lumber</label>
        <statBases>
            <Mass>0.3</Mass>
        </statBases>
    </ThingDef>

    <!-- Rotwood Wood Log - Rotwood is durable but ugly. -->
    <ThingDef ParentName="EW2_WoodLogBase">
        <defName>EW2_WoodLog_Rot</defName>
        <label>rotwood logs</label>
        <description>Raw wood from a polluted tree like pollux or witchwood. Useful for building simple structures and weapons, it must be processed into fresh lumber and left to dry before becoming suitable for advanced projects. It is a good fuel for campfires and generators, and can be refined into chemfuel. In a pinch, a piece of wood can be used as a weapon or a leg. Rotwood is similar to a high durability hardwood, but isn't considered aesthetically pleasing.</description>
        <graphicData>
            <color>(107,90,100)</color>
        </graphicData>
        <statBases>
            <Mass>0.3</Mass>
            <MarketValue>0.5</MarketValue>
            <DeteriorationRate>1</DeteriorationRate>
        </statBases>
        <stuffProps>
            <stuffAdjective>rotwood</stuffAdjective>
            <commonality>0</commonality>
             <color>(107,90,100)</color>
            <statFactors>
                <MaxHitPoints>0.50</MaxHitPoints>
                <Beauty>0</Beauty>
                <WorkToMake>0.65</WorkToMake>
                <WorkToBuild>0.65</WorkToBuild>
                <DoorOpenSpeed>1.0</DoorOpenSpeed>
            </statFactors>
        </stuffProps>
        <butcherProducts>
            <EW2_FreshLumberRot>30</EW2_FreshLumberRot>
        </butcherProducts>
    </ThingDef>

    <ThingDef ParentName="WoodLumberBase">
        <defName>WoodLumberRot</defName>
        <label>rotwood planks</label>
        <description>Processed rotwood planks, useful for building advanced structures and furniture. Rotwood is similar to a high durability hardwood, but isn't considered aesthetically pleasing.</description>
        <graphicData>
            <color>(107,90,100)</color>
        </graphicData>
        <statBases>
            <Mass>0.3</Mass>
            <MarketValue>1</MarketValue>
            <DeteriorationRate>1</DeteriorationRate>
        </statBases>
        <stuffProps>
            <stuffAdjective>rotwood</stuffAdjective>
            <commonality>0</commonality>
             <color>(107,90,100)</color>
            <statFactors>
                <MaxHitPoints>0.50</MaxHitPoints>
                <Beauty>0</Beauty>
                <WorkToMake>0.65</WorkToMake>
                <WorkToBuild>0.65</WorkToBuild>
                <DoorOpenSpeed>1.0</DoorOpenSpeed>
            </statFactors>
        </stuffProps>
    </ThingDef>

</Defs>
