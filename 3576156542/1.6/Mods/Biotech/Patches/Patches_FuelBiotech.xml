<Patch>

    <!-- Fuel Filter - This patch also applies to the internal fueled table saw. Anima, Archean, and Gauranlen wood are not available as fuel. -->
	<!-- Original Author: Aquiles-->
	<Operation Class="PatchOperationSequence">
			<operations>

				<!-- Adds the new WoodLogs to the fuel list -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef/comps/li[@Class="CompProperties_Refuelable" and fuelFilter/thingDefs/li[.="WoodLog"]]/fuelFilter/thingDefs</xpath>
					<value>
						<li>EW2_WoodLog_Rot</li>
					</value>
				</li>

			</operations>
	</Operation>

</Patch>
