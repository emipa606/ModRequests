<Patch>

	<!-- Biotech added trees now drop rotwood -->
	<Operation Class="PatchOperationSequence">
			<operations>
			
				<!-- Grey Pines drop rot wood-->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "Plant_TreeGrayPine"]/plant</xpath>
					<value>
						<harvestedThingDef>EW2_WoodLog_Rot</harvestedThingDef>
					</value>
				</li>

				<!-- Pebble Cacti drop rot wood-->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "Plant_PebbleCactus"]/plant</xpath>
					<value>
						<harvestedThingDef>EW2_WoodLog_Rot</harvestedThingDef>
					</value>
				</li>

				<!-- Witchwoods drop rot wood -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "Plant_Witchwood"]/plant</xpath>
					<value>
						<harvestedThingDef>EW2_WoodLog_Rot</harvestedThingDef>
					</value>
				</li>

				<!-- Rat Palms drop rot wood -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "Plant_RatPalm"]/plant</xpath>
					<value>
						<harvestedThingDef>EW2_WoodLog_Rot</harvestedThingDef>
					</value>
				</li>

				<!-- Pollux trees drop rot wood -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "Plant_TreePolux"]/plant</xpath>
					<value>
						<harvestedThingDef>EW2_WoodLog_Rot</harvestedThingDef>
					</value>
				</li>

			</operations>
	</Operation>
	
</Patch>
