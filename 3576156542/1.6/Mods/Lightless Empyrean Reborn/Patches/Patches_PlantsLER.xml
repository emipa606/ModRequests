<Patch>

	<Operation Class="PatchOperationSequence">
		<operations>

			<!-- Lightless Empyrean Trees Drop Oak Logs -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "pphhyy_LightlessEmpyrean_LightlessEmpyreanTree"]/plant</xpath>
				<value>
					<harvestedThingDef>EW2_WoodLog_Oak</harvestedThingDef>
				</value>
			</li>

			<!-- Lightless Trees Drop Oak Logs -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "pphhyy_LightlessEmpyrean_LightlessTree"]/plant</xpath>
				<value>
					<harvestedThingDef>EW2_WoodLog_Oak</harvestedThingDef>
				</value>
			</li>

		</operations>
	</Operation>

	<!-- Check for Biotech -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Biotech</li>
		</mods>

		<!-- If it is not found, dead trees drop oak wood -->
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName = "pphhyy_LightlessEmpyrean_DeadTree"]/plant</xpath>
			<value>
				<harvestedThingDef>EW2_WoodLog_Oak</harvestedThingDef>
			</value>
		</nomatch>

		<!-- if it is found, dead trees drop rotwood -->
		<match>
			<xpath>Defs/ThingDef[defName = "pphhyy_LightlessEmpyrean_DeadTree"]/plant</xpath>
			<value>
				<harvestedThingDef>EW2_WoodLog_Rot</harvestedThingDef>
			</value>
		</match>
	</Operation>

</Patch>
