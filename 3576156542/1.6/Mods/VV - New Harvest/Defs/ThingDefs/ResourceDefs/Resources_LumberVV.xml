<Defs>

	<!-- Fresh Lumber -->
	<!-- Cedar -->
	<ThingDef ParentName="EW2_FreshLumberBase">
		<defName>EW2_FreshLumberCedar</defName>
		<label>fresh cedar lumber</label>
		<statBases>
			<Mass>0.5</Mass>
		</statBases>
	</ThingDef>

	<!-- Ebony -->
	<ThingDef ParentName="EW2_FreshLumberBase">
		<defName>EW2_FreshLumberEbony</defName>
		<label>fresh ebony lumber</label>
		<statBases>
			<Mass>0.5</Mass>
		</statBases>
	</ThingDef>

	<!-- Mahogany -->
	<ThingDef ParentName="EW2_FreshLumberBase">
		<defName>EW2_FreshLumberMahogany</defName>
		<label>fresh mahogany lumber</label>
		<statBases>
			<Mass>0.5</Mass>
        </statBases>
	</ThingDef>

	<!-- Rosewood -->
	<ThingDef ParentName="EW2_FreshLumberBase">
		<defName>EW2_FreshLumberRosewood</defName>
		<label>fresh rosewood lumber</label>
		<statBases>
			<Mass>0.4</Mass>
		</statBases>
	</ThingDef>

	<!-- Planks -->
	<!-- Cedar -->
	<ThingDef ParentName="WoodLumberBase">
		<defName>WoodLumberCedar</defName>
		<label>cedar wood planks</label>
		<description>Processed cedar planks. Fragrant, lightweight and naturally resistant to decay and insects, it is favored for storage chests, roofing, and construction requiring durability without excess weight.</description>
		<graphicData>
			<color>(201,151,112)</color>
		</graphicData>
		<statBases>
			<Mass>0.25</Mass>
			<MarketValue>2.8</MarketValue>
			<DeteriorationRate>4</DeteriorationRate>
		</statBases>
		<stuffProps>
			<stuffAdjective>cedar wood</stuffAdjective>
			<commonality>0.50</commonality>
			<color>(201,151,112)</color>
			<statFactors>
				<MaxHitPoints>0.5</MaxHitPoints>
				<Beauty>1.65</Beauty>
				<WorkToMake>0.25</WorkToMake>
				<WorkToBuild>0.25</WorkToBuild>
				<DoorOpenSpeed>1.3</DoorOpenSpeed>
			</statFactors>
		</stuffProps>
	</ThingDef>

		<!-- Ebony -->
		<ThingDef ParentName="WoodLumberBase">
			<defName>WoodLumberEbony</defName>
			<label>ebony wood planks</label>
			<description>Processed ebony planks. Dense, dark and extremely durable and sought after for high-end furniture, construction and tools. Though heavier and harder to work with, its beauty and strength are unmatched.</description>
			<graphicData>
				<color>(45,46,41)</color> <!-- old (40,40,42) -->
			</graphicData>
			<statBases>
				<Mass>0.5</Mass>
				<MarketValue>3.0</MarketValue>
				<DeteriorationRate>1</DeteriorationRate>
			</statBases>
			<stuffProps>
				<stuffAdjective>ebony wood</stuffAdjective>
				<commonality>0.20</commonality>
				<color>(45,46,41)</color>
				<statFactors>
					<MaxHitPoints>0.75</MaxHitPoints>
					<Beauty>2.8</Beauty>
					<WorkToMake>0.6</WorkToMake>
					<WorkToBuild>0.6</WorkToBuild>
					<DoorOpenSpeed>1.0</DoorOpenSpeed>
				</statFactors>
			</stuffProps>
		</ThingDef>

		<!-- Mahogany -->
		<ThingDef ParentName="WoodLumberBase">
			<defName>WoodLumberMahogany</defName>
			<label>mahogany wood planks</label>
			<description>Processed mahogany planks. Though lighter than ebony, it is richly colored and smooth, and highly valued for its balance between beauty, strength, and workability, making it ideal for furniture and decorative construction.</description>
			<graphicData>
				<color>(92,31,31)</color>
			</graphicData>
			<statBases>
				<Mass>0.5</Mass>
				<MarketValue>3.1</MarketValue>
				<DeteriorationRate>1.25</DeteriorationRate>
			</statBases>
			<stuffProps>
				<stuffAdjective>mahogany wood</stuffAdjective>
				<commonality>0.30</commonality>
				<color>(92,31,31)</color>
				<statFactors>
					<MaxHitPoints>0.5</MaxHitPoints>
					<Beauty>2.8</Beauty>
					<WorkToMake>0.5</WorkToMake>
					<WorkToBuild>0.5</WorkToBuild>
					<DoorOpenSpeed>1.1</DoorOpenSpeed>
				</statFactors>
			</stuffProps>
		</ThingDef>

		<!-- Rosewood -->
		<ThingDef ParentName="WoodLumberBase">
			<defName>WoodLumberRosewood</defName>
			<label>rosewood planks</label>
			<description>Processed rosewood planks. Elegant and richly colored and renowned for its deep red to purple hue, it is highly sought after for crafting high-end furniture and decorative items.</description>
			<graphicData>
				<color>(119,13,60)</color>
			</graphicData>
			<statBases>
				<Mass>0.4</Mass>
				<MarketValue>3.8</MarketValue>
				<DeteriorationRate>3</DeteriorationRate>
			</statBases>
			<stuffProps>
				<stuffAdjective>rosewood</stuffAdjective>
				<commonality>0.40</commonality>
				<color>(119,13,60)</color>
				<statFactors>
					<MaxHitPoints>0.4</MaxHitPoints>
					<Beauty>3.4</Beauty>
					<WorkToMake>0.4</WorkToMake>
					<WorkToBuild>0.4</WorkToBuild>
					<DoorOpenSpeed>1.1</DoorOpenSpeed>
				</statFactors>
			</stuffProps>
		</ThingDef>

</Defs>
