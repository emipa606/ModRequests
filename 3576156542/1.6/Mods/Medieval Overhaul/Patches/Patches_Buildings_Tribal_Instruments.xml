<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>TribalInstruments (Royalty)</li>
        </mods>

        <match Class="PatchOperationSequence">
            <operations>

    <!-- Ogolupe and Ranat -->
    <!-- Removes the dedicated WoodLog costList from the Ranat and Ogolupe -->
    <li Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[defName="Ogolupe" or defName="Ranat"]/costList</xpath>
    </li>

    <!-- Adds DankPyon_RawWood stuffCategory -->
    <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Ogolupe" or defName="Ranat"]</xpath>
        <value>
            <stuffCategories>
                <li>DankPyon_RawWood</li>
            </stuffCategories>
            <costStuffCount>40</costStuffCount>
        </value>
    </li>

    <!-- Prevent all the instruments from being stuff colourable, so we don't need to make new stuffable textures -->
    <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Ogolupe" or defName="Ranat"]</xpath>
        <value>
            <colorPerStuff>
                <li>
                    <stuff>DankPyon_RawWood</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>DankPyon_RawDarkWood</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Bamboo</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Palm</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Birch</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Cecropia</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Cocoa</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Cypress</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Drago</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Maple</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Oak</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Pine</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Poplar</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Shroom</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Succulent</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Teak</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Willow</stuff>
                    <color>(255,255,255)</color>
                </li>
            </colorPerStuff>
        </value>
    </li>
</operations>
</match>
</Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Royalty</li>
        </mods>
        <match Class="PatchOperationFindMod">
            <mods>
