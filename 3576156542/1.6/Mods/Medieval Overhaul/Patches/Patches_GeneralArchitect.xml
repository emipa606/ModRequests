<Patch>

	<!--Check for VFEA -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Furniture Expanded - Architect</li>
		</mods>

		<match Class="PatchOperationSequence">
			<operations>

				<!-- Log Walls uses logs -->
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName = "VFEArch_LogWall"]/costList</xpath>
					<value>
						<stuffCategories>
							<li>DankPyon_RawWood</li>
						</stuffCategories>
						<costStuffCount>5</costStuffCount>
					</value>
				</li>

				<!-- Wooden Parquet uses planks -->
				<li Class="PatchOperationReplace">
					<xpath>Defs/TerrainDef[@Name = "VFEArch_WoodenParquetBase"]/costList</xpath>
					<value>
						<costList>
							<WoodLog>12</WoodLog>
						</costList>
					</value>
				</li>

				<!-- Disable Walnut Floors -->
				<li Class="PatchOperationRemove">
					<xpath>Defs/TerrainDef[defName = "VFEArch_WoodPlankFloorWalnut" or defName = "VFEArch_WoodenParquetWalnut"]</xpath>
				</li>

				<!-- Disable Birch Floors -->
				<li Class="PatchOperationRemove">
					<xpath>Defs/TerrainDef[defName = "VFEArch_WoodPlankFloorBirch" or defName = "VFEArch_WoodenParquetBirch"]</xpath>
				</li>

				<!-- Disable Mahogany Floors -->
				<li Class="PatchOperationRemove">
					<xpath>Defs/TerrainDef[defName = "VFEArch_WoodPlankFloorMahogany" or defName = "VFEArch_WoodenParquetMahogany"]</xpath>
				</li>

			</operations>
		</match>
	</Operation>

