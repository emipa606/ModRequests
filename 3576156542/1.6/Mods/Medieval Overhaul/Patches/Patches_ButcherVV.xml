<Patch>

		<!-- VV logs drop fresh lumber when processed -->
		<Operation Class="PatchOperationFindMod">
			<mods>
				<li>VV - New Harvest</li>
			</mods>
			<match Class="PatchOperationSequence">
				<operations>

					<!-- Cedar -->
					<li Class="PatchOperationReplace">
						<xpath>Defs/ThingDef[defName="DankPyon_Log_VV_CedarWood"]</xpath>
						<value>
							<ThingDef ParentName="EW2_WoodLogBase">
								<defName>DankPyon_Log_VV_CedarWood</defName>
								<label>cedar logs</label>
								<description>Cedar logs, they must be processed into fresh lumber and left to dry before becoming suitable for construction. Cedar is a durable softwood.</description>
								<graphicData>
									<texPath>Things/Items/Resources/EW/VV_NHCP_CedarWood</texPath>
									<!-- <color>(201,151,112)</color> -->
								</graphicData>
								<statBases>
									<Mass>0.45</Mass>
									<MarketValue>1.8</MarketValue>
									<DeteriorationRate>2</DeteriorationRate>
								</statBases>
								<stuffProps>
									<stuffAdjective>cedar</stuffAdjective>
									<commonality>0.01</commonality>
									<color>(201,151,112)</color>
									<statFactors>
										<MaxHitPoints>0.35</MaxHitPoints>
										<Beauty>2.0</Beauty>
										<WorkToMake>0.3</WorkToMake>
										<WorkToBuild>0.3</WorkToBuild>
										<DoorOpenSpeed>1.25</DoorOpenSpeed>
									</statFactors>
								</stuffProps>
								<butcherProducts>
									<EW2_FreshLumberCedar>2</EW2_FreshLumberCedar>
								</butcherProducts>
							</ThingDef>
						</value>
					</li>

					<!-- Ebony -->
					<li Class="PatchOperationReplace">
						<xpath>Defs/ThingDef[defName="DankPyon_Log_VV_EbonyWood"]</xpath>
						<value>
							<ThingDef ParentName="EW2_WoodLogBase">
								<defName>DankPyon_Log_VV_EbonyWood</defName>
								<label>ebony logs</label>
								<description>Ebony logs, they must be processed into fresh lumber and left to dry before becoming suitable for construction. Ebony is among the most durable hardwoods.</description>
								<graphicData>
									<texPath>Things/Items/Resources/EW/VV_NHCP_EbonyWood</texPath>
									<!-- <color>(40,40,42)</color> -->
								</graphicData>
								<statBases>
									<Mass>0.65</Mass>
									<MarketValue>1.5</MarketValue>
									<DeteriorationRate>0.5</DeteriorationRate>
								</statBases>
								<stuffProps>
									<stuffAdjective>ebony</stuffAdjective>
									<commonality>0.01</commonality>
									<color>(40,40,42)</color>
									<statFactors>
										<MaxHitPoints>0.75</MaxHitPoints>
										<Beauty>2.8</Beauty>
										<WorkToMake>0.6</WorkToMake>
										<WorkToBuild>0.6</WorkToBuild>
										<DoorOpenSpeed>1.0</DoorOpenSpeed>
									</statFactors>
								</stuffProps>
								<butcherProducts>
									<EW2_FreshLumberEbony>2</EW2_FreshLumberEbony>
								</butcherProducts>
							</ThingDef>
						</value>
					</li>

					<!-- Mahogany -->
					<li Class="PatchOperationReplace">
						<xpath>Defs/ThingDef[defName="DankPyon_Log_VV_MahoganyWood"]</xpath>
						<value>
							<ThingDef ParentName="EW2_WoodLogBase">
								<defName>DankPyon_Log_VV_MahoganyWood</defName>
								<label>mahogany logs</label>
								<description>Mahogany logs, they must be processed into fresh lumber and left to dry before becoming suitable for construction. Mahogany is a very durable hardwood.</description>
								<graphicData>
									<texPath>Things/Items/Resources/EW/VV_NHCP_MahoganyWood</texPath>
									<!-- <color>(92,31,31)</color> -->
								</graphicData>
								<statBases>
									<Mass>0.6</Mass>
									<MarketValue>1.6</MarketValue>
									<DeteriorationRate>0.75</DeteriorationRate>
								</statBases>
								<stuffProps>
									<stuffAdjective>mahogany</stuffAdjective>
									<commonality>0.01</commonality>
									<color>(92,31,31)</color>
									<statFactors>
										<MaxHitPoints>0.5</MaxHitPoints>
										<Beauty>2.8</Beauty>
										<WorkToMake>0.5</WorkToMake>
										<WorkToBuild>0.5</WorkToBuild>
										<DoorOpenSpeed>1.1</DoorOpenSpeed>
									</statFactors>
								</stuffProps>
								<butcherProducts>
									<EW2_FreshLumberMahogany>2</EW2_FreshLumberMahogany>
								</butcherProducts>
							</ThingDef>
						</value>
					</li>

					<!-- Rosewood -->
					<li Class="PatchOperationReplace">
						<xpath>Defs/ThingDef[defName="DankPyon_Log_VV_RosewoodWood"]</xpath>
						<value>
							<ThingDef ParentName="EW2_WoodLogBase">
								<defName>DankPyon_Log_VV_RosewoodWood</defName>
								<label>rosewood logs</label>
								<description>Rosewood logs, they must be processed into fresh lumber and left to dry before becoming suitable for construction. Rosewood is a durable hardwood.</description>
								<graphicData>
									<texPath>Things/Items/Resources/EW/VV_NHCP_RosewoodWood</texPath>
									<!-- <color>(119,13,60)</color> -->
								</graphicData>
								<statBases>
									<Mass>0.6</Mass>
									<MarketValue>1.8</MarketValue>
									<DeteriorationRate>1.5</DeteriorationRate>
								</statBases>
								<stuffProps>
									<stuffAdjective>rosewood</stuffAdjective>
									<commonality>0.01</commonality>
									<color>(119,13,60)</color>
									<statFactors>
										<MaxHitPoints>0.4</MaxHitPoints>
										<Beauty>3.2</Beauty>
										<WorkToMake>0.4</WorkToMake>
										<WorkToBuild>0.4</WorkToBuild>
										<DoorOpenSpeed>1.1</DoorOpenSpeed>
									</statFactors>
								</stuffProps>
								<butcherProducts>
									<EW2_FreshLumberRosewood>2</EW2_FreshLumberRosewood>
								</butcherProducts>
							</ThingDef>

						</value>
					</li>

			</operations>
		</match>
	</Operation>

</Patch>
