<Patch>

    <Operation Class="PatchOperationFindMod">
    <mods>
        <li>Vanilla Factions Expanded - Classical</li>
    </mods>

    <match Class="PatchOperationSequence">
        <operations>

            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEC_MeleeWeapon_Spatha"]/stuffCategories/li[.="Woody"]</xpath>
            </li>

            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEC_Javelin" or defName="VFEC_Weapon_Scorpion"]/costList/WoodLog</xpath>
            </li>

            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEC_Javelin"]</xpath>
                <value>
                    <stuffCategories>
                        <li>Woody</li>
                    </stuffCategories>
                    <costStuffCount>25</costStuffCount>
                </value>
            </li>

            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEC_Weapon_Scorpion"]</xpath>
                <value>
                    <stuffCategories>
                        <li>Woody</li>
                    </stuffCategories>
                    <costStuffCount>70</costStuffCount>
                </value>
            </li>

            <!--
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[defName="VFEC_Shield_Heavy"]/costList/WoodLog</xpath>
                <value>
                    <WoodLog>60</WoodLog>
                </value>
            </li>
            -->
        </operations>
        </match>
    </Operation>

</Patch>
