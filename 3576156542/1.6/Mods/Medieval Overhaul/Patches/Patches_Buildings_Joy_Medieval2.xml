<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Factions Expanded - Medieval 2</li>
        </mods>

        <match Class="PatchOperationSequence">
        <operations>

            <!-- Remove dedicated WoodLog costList -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEM2_ArcheryTarget" or defName="VFEM2_TrainingDummy"]/costList/WoodLog</xpath>
            </li>

            <!-- Add Woody category so they can be made with planks -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_ArcheryTarget" or defName="VFEM2_TrainingDummy"]</xpath>
                <value>
                   <stuffCategories>
						<li>Woody</li>
					</stuffCategories>
					<costStuffCount>25</costStuffCount>
                </value>
            </li>

        </operations>
        </match>
    </Operation>

</Patch>
