<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Factions Expanded - Medieval 2</li>
        </mods>

        <match Class="PatchOperationSequence">
        <operations>

            <!-- Remove dedicated WoodLog costList and constructEffect -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEM2_LeatherBoilpot"]/costList/WoodLog   |   Defs/ThingDef[defName="VFEM2_LeatherBoilpot"]/constructEffect</xpath>
            </li>

            <!-- Add Woody stuffCategory so they can be made with various wood planks -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_LeatherBoilpot"]</xpath>
                <value>
                   <stuffCategories>
						<li>Woody</li>
					</stuffCategories>
					<costStuffCount>30</costStuffCount>
                </value>
            </li>

            <!-- Remove dedicated WoodLog costList and constructEffect -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEM2_MeadFermentingBarrel" or defName="VFEM2_WineBarrel"]/costList/WoodLog   |   Defs/ThingDef[defName="VFEM2_MeadFermentingBarrel" or defName="VFEM2_WineBarrel"]/constructEffect</xpath>
            </li>

            <!-- Add Woody stuffCategory so they can be made with various wood planks -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_MeadFermentingBarrel"]</xpath>
                <value>
                    <stuffCategories>
                        <li>Woody</li>
                    </stuffCategories>
                    <costStuffCount>45</costStuffCount>
                </value>
            </li>

            <!-- Add Woody stuffCategory so they can be made with various wood planks -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_WineBarrel"]</xpath>
                <value>
                    <stuffCategories>
                        <li>Woody</li>
                    </stuffCategories>
                    <costStuffCount>30</costStuffCount>
                </value>
            </li>

        </operations>
        </match>
    </Operation>

</Patch>
