<Patch>

    <!-- Check for VFEA -->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Furniture Expanded - Architect</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>

                <!-- Hedges use raw logs -->
                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName = "VFEArch_HedgeWall"]/costList</xpath>
                    <value>
                        <stuffCategories>
                            <li>DankPyon_RawWood</li>
                        </stuffCategories>
                        <costStuffCount>5</costStuffCount>
                    </value>
                </li>

                <!-- Hedges do not tint their texture based on stuff -->
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName = "VFEArch_HedgeWall"]</xpath>
                    <value>
                        <colorPerStuff>
                            <li>
                                <stuff>DankPyon_RawWood</stuff>
                                <color>(255,255,255)</color>
                            </li>
                            <li>
                                <stuff>EW2_WoodLog_Bamboo</stuff>
                                <color>(255,255,255)</color>
                            </li>
                            <li>
                                <stuff>EW2_WoodLog_Palm</stuff>
                                <color>(255,255,255)</color>
                            </li>
                            <li>
                                <stuff>EW2_WoodLog_Birch</stuff>
                                <color>(255,255,255)</color>
                            </li>
                            <li>
                                <stuff>EW2_WoodLog_Cecropia</stuff>
                                <color>(255,255,255)</color>
                            </li>
                            <li>
                                <stuff>EW2_WoodLog_Cocoa</stuff>
                                <color>(255,255,255)</color>
                            </li>
                            <li>
                                <stuff>EW2_WoodLog_Cypress</stuff>
                                <color>(255,255,255)</color>
                            </li>
                            <li>
                                <stuff>DankPyon_RawDarkWood</stuff>
                                <color>(255,255,255)</color>
                            </li>
                            <li>
                                <stuff>EW2_WoodLog_Drago</stuff>
                                <color>(255,255,255)</color>
                            </li>
                            <li>
                                <stuff>EW2_WoodLog_Maple</stuff>
                                <color>(255,255,255)</color>
                            </li>
                            <li>
                                <stuff>EW2_WoodLog_Oak</stuff>
                                <color>(255,255,255)</color>
                            </li>
                            <li>
                                <stuff>EW2_WoodLog_Pine</stuff>
                                <color>(255,255,255)</color>
                            </li>
                            <li>
                                <stuff>EW2_WoodLog_Poplar</stuff>
                                <color>(255,255,255)</color>
                            </li>
                            <li>
                                <stuff>EW2_WoodLog_Shroom</stuff>
                                <color>(255,255,255)</color>
                            </li>
                            <li>
                                <stuff>EW2_WoodLog_Succulent</stuff>
                                <color>(255,255,255)</color>
                            </li>
                            <li>
                                <stuff>EW2_WoodLog_Teak</stuff>
                                <color>(255,255,255)</color>
                            </li>
                            <li>
                                <stuff>EW2_WoodLog_Willow</stuff>
                                <color>(255,255,255)</color>
                            </li>
                        </colorPerStuff>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>

	<!-- Check for VFEA -->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Furniture Expanded - Architect</li>
        </mods>

        <!-- If found, check for Ideology -->
        <match Class="PatchOperationFindMod">
            <mods>
                 <li>Ideology</li>
            </mods>

            <match Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName = "VFEArch_HedgeWall"]/colorPerStuff</xpath>
                <value>
                    <li>
                        <stuff>EW2_WoodLog_Gaur</stuff>
                        <color>(255,255,255)</color>
                    </li>
                </value>
            </match>
        </match>
	</Operation>

    <!-- Check for VFEA -->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Furniture Expanded - Architect</li>
        </mods>

        <!-- If found, check for Royalty -->
        <match Class="PatchOperationFindMod">
            <mods>
                <li>Royalty</li>
            </mods>

            <match Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName = "VFEArch_HedgeWall"]/colorPerStuff</xpath>
                <value>
                    <li>
                        <stuff>EW2_WoodLog_Anima</stuff>
                        <color>(255,255,255)</color>
                    </li>
                </value>
            </match>
        </match>
	</Operation>

    <!-- Check for VFEA -->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Furniture Expanded - Architect</li>
        </mods>

        <!-- If found, check for Biotech -->
        <match Class="PatchOperationFindMod">
