	</Operation>

    <!-- Check for VFEA -->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Furniture Expanded - Architect</li>
        </mods>

        <!-- If found, check for Odyssey -->
        <match Class="PatchOperationFindMod">
            <mods>
                 <li>Odyssey</li>
            </mods>

            <match Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName = "VFEArch_HedgeWall"]/colorPerStuff</xpath>
                <value>
                    <li>
                        <stuff>EW2_WoodLog_Archean</stuff>
                        <color>(255,255,255)</color>
                    </li>
                </value>
            </match>
        </match>
	</Operation>

	<!-- Check for VFEA -->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Furniture Expanded - Architect</li>
        </mods>

        <!-- If found, check for ReGrowth 2 -->
        <match Class="PatchOperationFindMod">
            <mods>
                <li>ReGrowth 2</li>
            </mods>

            <match Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName = "VFEArch_HedgeWall"]/colorPerStuff</xpath>
                <value>
                    <li>
                        <stuff>EW2_WoodLog_Elm</stuff>
                        <color>(255,255,255)</color>
                    </li>
                </value>
            </match>
        </match>
	</Operation>

	<!-- Check for VFEA -->
	<Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Furniture Expanded - Architect</li>
        </mods>

        <!-- If found, check for VV New Harvest -->
        <match Class="PatchOperationFindMod">
            <mods>
                <li>VV - New Harvest</li>
            </mods>

            <match Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName = "VFEArch_HedgeWall"]/colorPerStuff</xpath>
                <value>
                    <li>
                        <stuff>DankPyon_Log_VV_CedarWood</stuff>
                        <color>(255,255,255)</color>
                    </li>
                    <li>
                        <stuff>DankPyon_Log_VV_EbonyWood</stuff>
                        <color>(255,255,255)</color>
                    </li>
                    <li>
                        <stuff>DankPyon_Log_VV_MahoganyWood</stuff>
                        <color>(255,255,255)</color>
                    </li>
                    <li>
                        <stuff>DankPyon_Log_VV_RosewoodWood</stuff>
                        <color>(255,255,255)</color>
                    </li>
                </value>
            </match>
        </match>
    </Operation>

</Patch>
