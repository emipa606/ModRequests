<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Factions Expanded - Tribals</li>
        </mods>

        <match Class="PatchOperationSequence">
            <operations>

                <!-- Apparel -->
                <!-- War Tribalwear -->
                <!-- Replaces Woody category with DankPyon_RawWood, so it can be built with logs -->
                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="VFET_Apparel_TribalWar"]/stuffCategories/li[.="Woody"]</xpath>
                    <value>
                        <li>DankPyon_RawWood</li>
                    </value>
                </li>

                <!-- Weapons Melee-->
                <!-- Stake -->
                <!-- Replaces dedicated WoodLog costList with DankPyon_RawWood category -->
                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="VFET_Stake"]/costList</xpath>
                    <value>
                        <stuffCategories>
                            <li>DankPyon_RawWood</li>
                        </stuffCategories>
                        <costStuffCount>5</costStuffCount>
                    </value>
                </li>

                <!-- Weapons Ranged -->
                <!-- Throwspikes -->
                <!-- Replaces dedicated WoodLog costList with DankPyon_RawWood category -->
                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="VFET_Throwspikes"]/costList</xpath>
                    <value>
                        <stuffCategories>
                            <li>DankPyon_RawWood</li>
                        </stuffCategories>
                        <costStuffCount>15</costStuffCount>
                    </value>
                </li>


            </operations>
        </match>
    </Operation>

</Patch>
