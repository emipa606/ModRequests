<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Factions Expanded - Tribals</li>
        </mods>

        <match Class="PatchOperationSequence">
            <operations>

                <!-- Security -->
                <!-- Animal Trap -->
                <!-- Replaces Woody category with DankPyon_RawWood, so it can be built with logs -->
                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="VFET_AnimalTrap"]/stuffCategories/li[.="Woody"]</xpath>
                    <value>
                        <li>DankPyon_RawWood</li>
                    </value>
                </li>

                <!-- Temperature -->
                <!-- Large Fire -->
                <!-- Replaces Woody category with DankPyon_RawWood, so it can be built with logs -->
                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="VFET_LargeFire"]/costList</xpath>
                    <value>
                        <stuffCategories>
                            <li>DankPyon_RawWood</li>
                        </stuffCategories>
                        <costStuffCount>150</costStuffCount>
                    </value>
                </li>

                <!-- Removes the construct effect so it does not produce an error -->
                <li Class="PatchOperationRemove">
                    <xpath>Defs/ThingDef[defName="VFET_LargeFire"]/constructEffect</xpath>
                </li>

            </operations>
        </match>
    </Operation>

</Patch>
