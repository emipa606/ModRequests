<Patch>

	<Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Weapons Expanded - Tribal</li>
        </mods>

        <match Class="PatchOperationSequence">
            <operations>

				<!-- Clubs -->
				<!-- Replaces Woody category with DankPyon_RawWood -->
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="VWE_MeleeWeapon_HeavyClub" or defName="VWE_MeleeWeapon_LightClub"]/stuffCategories/li[.="Woody"]</xpath>
					<value>
						<li>DankPyon_RawWood</li>
					</value>
				</li>

				<!-- Tribal Axe and Shiv -->
				<!-- Remove Woody category -->
				<li Class="PatchOperationRemove">
					<xpath>Defs/ThingDef[defName="VWE_MeleeWeapon_TribalAxe" or defName="VWE_MeleeWeapon_Shiv"]/stuffCategories/li[.="Woody"]</xpath>
				</li>

				<!-- Sling -->
				<!-- Replaces the dedicated WoodLog costList with DankPyon_RawWood stuffCategory -->
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="VWE_Sling"]/costList</xpath>
					<value>
						<stuffCategories>
							<li>DankPyon_RawWood</li>
						</stuffCategories>
						<costStuffCount>10</costStuffCount>
					</value>
				</li>

			</operations>
		</match>
	</Operation>

</Patch>
