<Patch>

<Operation Class="PatchOperationFindMod">
    <mods>
        <li>Vanilla Factions Expanded - Medieval 2</li>
    </mods>

    <match Class="PatchOperationSequence">
        <operations>

            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEM2_Shield_Round"]/costList/WoodLog</xpath>
            </li>

            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_Shield_Round"]</xpath>
                <value>
                    <stuffCategories>
                        <li>Woody</li>
                    </stuffCategories>
                    <costStuffCount>75</costStuffCount>
                </value>
            </li>
        </operations>
    </match>
    </Operation>

</Patch>
