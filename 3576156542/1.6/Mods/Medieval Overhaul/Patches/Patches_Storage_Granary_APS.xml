<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationSequence">
        <operations>

            <!-- Granary now uses planks instead of logs -->
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[defName="ASF_Granary"]/costList/WoodLog</xpath>
                <value>
                    <WoodLog>25</WoodLog>
                </value>
            </li>

        </operations>
    </Operation>

</Patch>
