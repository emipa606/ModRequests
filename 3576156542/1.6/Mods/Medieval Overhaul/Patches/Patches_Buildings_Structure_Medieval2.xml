<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Factions Expanded - Medieval 2</li>
        </mods>

        <match Class="PatchOperationSequence">
        <operations>

            <!-- Remove dedicated WoodLog costList -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEM2_TimberedWall"]/costList/WoodLog</xpath>
            </li>

            <!-- Add Woody stuffCategory so they can be made with various wood planks -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_TimberedWall"]</xpath>
                <value>
                    <costList>
                        <WoodLog>1</WoodLog>
                    </costList>
                </value>
            </li>

    <!-- Pallisades -->
    <!-- Replaces Woody stuffCategory with DankPyron_RawWood, so it can be made with raw logs -->
        <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="VFEM2_Palisade"]/stuffCategories/li[.="Woody"]</xpath>
        <value>
            <li>DankPyon_RawWood</li>
        </value>
    </li>
    </operations>
    </match>
</Operation>


</Patch>

