<Patch>

	<Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Weapons Expanded</li>
        </mods>

        <match Class="PatchOperationSequence">
            <operations>

				<!-- Axe and Hammer -->
				<!-- Remove Woody category -->
				<li Class="PatchOperationRemove">
					<xpath>Defs/ThingDef[defName="VWE_MeleeWeapon_Axe" or defName="VWE_MeleeWeapon_Hammer"]/stuffCategories/li[.="Woody"]</xpath>
				</li>

				<!-- Long Bow -->
				<!-- Replaces Woody category with DankPyon_RawWood -->
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="VWE_Bow_Long"]/costList</xpath>
					<value>
						<stuffCategories>
							<li>DankPyon_RawWood</li>
						</stuffCategories>
						<costStuffCount>65</costStuffCount>
					</value>
				</li>

				<!-- Crossbow, Musket, Flintlock-->
				<!-- Remove dedicated WoodLog costList -->
				<li Class="PatchOperationRemove">
					<xpath>Defs/ThingDef[defName="VWE_Bow_Long" or defName="VWE_Gun_Musket" or defName="VWE_Gun_Flintlock"]/costList/WoodLog</xpath>
				</li>

				<!-- Then add Woody stuffCategory so Crossbow can be made with planks -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="VWE_Bow_Long"]</xpath>
					<value>
						<stuffCategories>
							<li>Woody</li>
						</stuffCategories>
						<costStuffCount>100</costStuffCount>
					</value>
				</li>

				<!-- Then add DankPyon_RawWood stuffCategory so Musket can be made with logs -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="VWE_Gun_Musket"]</xpath>
					<value>
						<stuffCategories>
							<li>Woody</li>
						</stuffCategories>
						<costStuffCount>80</costStuffCount>
					</value>
				</li>

				<!-- Then add DankPyon_RawWood stuffCategory so Flintlock can be made with logs -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="VWE_Gun_Flintlock"]</xpath>
					<value>
						<stuffCategories>
							<li>Woody</li>
						</stuffCategories>
						<costStuffCount>30</costStuffCount>
					</value>
				</li>

			</operations>
		</match>
	</Operation>

</Patch>
