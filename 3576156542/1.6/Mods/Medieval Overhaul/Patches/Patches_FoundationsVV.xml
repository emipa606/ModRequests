<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>VV - New Harvest</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>

   <li Class="PatchOperationReplace">
       <xpath>Defs/TerrainDef[defName="VV_NHCP_Cedar_Bridge"]/costList</xpath>
       <value>
           <costList>
               <VV_CedarWood>12</VV_CedarWood>
           </costList>
       </value>
   </li>

   <li Class="PatchOperationReplace">
       <xpath>Defs/TerrainDef[defName="VV_NHCP_Ebony_Bridge"]/costList</xpath>
       <value>
           <costList>
               <VV_EbonyWood>12</VV_EbonyWood>
           </costList>
       </value>
   </li>

   <li Class="PatchOperationReplace">
       <xpath>Defs/TerrainDef[defName="VV_NHCP_Mahogany_Bridge"]/costList</xpath>
       <value>
           <costList>
               <VV_MahoganyWood>12</VV_MahoganyWood>
           </costList>
       </value>
   </li>

   <li Class="PatchOperationReplace">
       <xpath>Defs/TerrainDef[defName="VV_NHCP_Rosewood_Bridge"]/costList</xpath>
       <value>
           <costList>
               <VV_RosewoodWood>12</VV_RosewoodWood>
           </costList>
       </value>
   </li>
</operations>
</match>
</Operation>

</Patch>
