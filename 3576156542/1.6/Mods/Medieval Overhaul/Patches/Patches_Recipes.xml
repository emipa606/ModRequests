<Patch>

    <!-- Chemfuel Recipes  have their ingredient categories changed to DankPyon_RawWood -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<li Class="PatchOperationReplace">
				<xpath>Defs/RecipeDef[defName = "Make_ChemfuelFromWood"]/ingredients/li/filter/thingDefs</xpath>
				<value>
					<categories>
						<li>DankPyon_RawWood</li>
					</categories>
				</value>
			</li>

			<li Class="PatchOperationReplace">
				<xpath>Defs/RecipeDef[defName = "Make_ChemfuelFromWood"]/fixedIngredientFilter/thingDefs</xpath>
				<value>
					<categories>
						<li>DankPyon_RawWood</li>
					</categories>
				</value>
			</li>

		</operations>
	</Operation>

	<!-- Apparel -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<!-- Wood Mask has its stuffCategory changed to DankPyon_RawWood, so it can be made with logs -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "Apparel_WarMask"]/stuffCategories/li[.="Woody"]</xpath>
				<value>
					<li>DankPyon_RawWood</li>
				</value>
			</li>

			<!-- Plate Armour can no longer be made from wood -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName = "Apparel_PlateArmor"]/stuffCategories/li[.="Woody"]</xpath>
			</li>

		</operations>
	</Operation>

	<!-- Art -->
	<Operation Class="PatchOperationSequence">
		<success>Always</success>
		<operations>

			<!-- Scupltures have their stuffCategory changed to DankPyon_RawWood, so they can be with from logs -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "SculptureSmall" or defName = "SculptureLarge" or defName = "SculptureGrand"]/stuffCategories/li[.="Woody"]</xpath>
				<value>
					<li>DankPyon_RawWood</li>
				</value>
			</li>

		</operations>
	</Operation>

	<!-- Base Weapons -->
	<!-- Sharp weapons can no longer be made out of wood -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[@Name="BaseMeleeWeapon_Sharp"]/recipeMaker/defaultIngredientFilter</xpath>
				<value>
					<disallowedCategories>
						<li>DankPyon_RawWood</li>
						<li>DankPyon_Wood</li>
					</disallowedCategories>
				</value>
			</li>

			<!-- Remove Woody category from the Gladius, Longsword, Spear, and Ikwa -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName="MeleeWeapon_Gladius" or defName="MeleeWeapon_LongSword" or defName = "MeleeWeapon_Spear" or defName ="MeleeWeapon_Ikwa"]/stuffCategories/li[.="Woody"]</xpath>
			</li>

		</operations>
	</Operation>

	<!-- Weapon(Ranged Medieval) -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<!-- Crossbow -->
			<!-- Remove woodlog/woodplanks from dedicated costList -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName = "DankPyon_Crossbow"]/costList/WoodLog</xpath>
			</li>

			<!-- Add woody category so it takes any planks -->
			<li Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName = "DankPyon_Crossbow"]</xpath>
				<value>
					<stuffCategories>
						<li>Woody</li>
					</stuffCategories>
					<costStuffCount>50</costStuffCount>
				</value>
			</li>

			<!-- Heavy Crossbow -->
			<!-- Remove woodlog/woodplanks from dedicated costList -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName = "DankPyon_CrossbowHeavy"]/costList/WoodLog</xpath>
			</li>

			<!-- Add woody category so it takes any planks -->
			<li Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName = "DankPyon_CrossbowHeavy"]</xpath>
				<value>
					<stuffCategories>
						<li>Woody</li>
					</stuffCategories>
					<costStuffCount>60</costStuffCount>
				</value>
			</li>

			<!-- Handgonne -->
			<!-- Remove woodlog/woodplanks from dedicated costList -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName = "DankPyon_Handgonne"]/costList/WoodLog</xpath>
			</li>

			<!-- Add woody category so it takes any planks -->
			<li Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName = "DankPyon_Handgonne"]</xpath>
				<value>
					<stuffCategories>
						<li>Woody</li>
					</stuffCategories>
					<costStuffCount>20</costStuffCount>
				</value>
			</li>

		</operations>
	</Operation>

	<!-- Weapon (Melee Medieval) -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<!-- Maces can no longer be made of wood -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName = "MeleeWeapon_Mace"]/stuffCategories/li[.="Woody"]</xpath>
			</li>

		</operations>
	</Operation>

	<!-- Weapons (Melee Neolithic) -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<!-- Maces can be made from raw wood -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "MeleeWeapon_Club"]/stuffCategories/li[.="Woody"]</xpath>
				<value>
					<li>DankPyon_RawWood</li>
				</value>
			</li>

		</operations>
	</Operation>

	<!-- Weapon(Ranged Neolithic) -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "Bow_Short"]/costList</xpath>
				<value>
					<stuffCategories>
						<li>DankPyon_RawWood</li>
					</stuffCategories>
					<costStuffCount>30</costStuffCount>
				</value>
			</li>

			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "Pila"]/costList</xpath>
				<value>
					<stuffCategories>
						<li>DankPyon_RawWood</li>
					</stuffCategories>
					<costStuffCount>70</costStuffCount>
				</value>
			</li>

			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "Bow_Recurve"]/costList</xpath>
				<value>
					<stuffCategories>
						<li>DankPyon_RawWood</li>
					</stuffCategories>
					<costStuffCount>40</costStuffCount>
				</value>
			</li>

			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "Bow_Great"]/costList</xpath>
				<value>
					<stuffCategories>
						<li>DankPyon_RawWood</li>
					</stuffCategories>
					<costStuffCount>50</costStuffCount>
				</value>
			</li>

			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "DankPyon_Bow_Hunting"]/costList</xpath>
				<value>
					<stuffCategories>
						<li>DankPyon_RawWood</li>
					</stuffCategories>
					<costStuffCount>50</costStuffCount>
				</value>
			</li>

			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "Bow_War"]/costList</xpath>
				<value>
					<stuffCategories>
						<li>DankPyon_RawWood</li>
					</stuffCategories>
					<costStuffCount>70</costStuffCount>
				</value>
			</li>

		</operations>
	</Operation>

</Patch>
