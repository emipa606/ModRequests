<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Factions Expanded - Medieval 2</li>
        </mods>

        <match Class="PatchOperationSequence">
        <operations>

            <!-- Torch Belt -->
            <!-- Replaces dedicated WoodLog costList so that the Torch Belt can be made with various wood logs -->
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[defName="VFEM2_Apparel_TorchBelt"]/costList</xpath>
                <value>
                    <stuffCategories>
                        <li>DankPyon_RawWood</li>
                    </stuffCategories>
                    <costStuffCount>20</costStuffCount>
                </value>
            </li>

            <!-- Plague Mask -->
            <!-- Removes dedicated WoodLog costList -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEM2_Apparel_PlagueMask"]/costList/WoodLog</xpath>
            </li>

            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_Apparel_PlagueMask"]</xpath>
                <value>
                    <stuffCategories>
                        <li>Woody</li>
                    </stuffCategories>
                    <costStuffCount>25</costStuffCount>
                </value>
            </li>

        </operations>
    </match>
    </Operation>

</Patch>
