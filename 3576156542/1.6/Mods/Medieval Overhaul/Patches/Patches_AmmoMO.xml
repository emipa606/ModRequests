<Patch>

    <!-- Replace Scorpio/Ballista Bolt ingredients -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/RecipeDef[defName="DankPyon_MakeBullet_ScorpioBolt" or defName="DankPyon_MakeBullet_BallistaBolt"]/ingredients</xpath>
        <value>
            <ingredients>
                <li>
                    <filter>
                        <thingDefs>
                            <li>DankPyon_IronIngot</li>
                        </thingDefs>
                    </filter>
                    <count>10</count>
                </li>
                <li>
                    <filter>
                        <categories>
                            <li>DankPyon_Wood</li>
                        </categories>
                    </filter>
                    <count>30</count>
                </li>
            </ingredients>
        </value>
    </Operation>

    <!-- Replace Scorpia/Ballista Bolt Bulk ingredients -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/RecipeDef[defName="DankPyon_MakeBullet_ScorpioBoltBulk" or defName="DankPyon_MakeBullet_BallistaBoltBulk"]/ingredients</xpath>
        <value>
            <ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>DankPyon_IronIngot</li>
					</thingDefs>
				</filter>
				<count>50</count>
			</li>
             <li>
				<filter>
					<categories>
                        <li>DankPyon_Wood</li>
                    </categories>
				</filter>
				<count>150</count>
			</li>
            </ingredients>
        </value>
    </Operation>

    <!-- Adjusts the fixedIngredient filter for Scorpia/Ballista Bolts -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/RecipeDef[defName="DankPyon_MakeBullet_ScorpioBolt" or defName="DankPyon_MakeBullet_BallistaBolt" or defName="DankPyon_MakeBullet_ScorpioBoltBulk" or defName="DankPyon_MakeBullet_BallistaBoltBulk"]/fixedIngredientFilter</xpath>
        <value>
            <fixedIngredientFilter>
                    <categories>
                        <li>DankPyon_Wood</li>
                    </categories>
            </fixedIngredientFilter>
        </value>
    </Operation>

</Patch>
