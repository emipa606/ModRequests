<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Factions Expanded - Medieval 2</li>
        </mods>

        <match Class="PatchOperationSequence">
        <operations>

            <!-- Remove Woody stuffCategory so items can no longer be made with wood -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEM2_MeleeWeapon_HeavyMace" or defName="VFEM2_MeleeWeapon_DaneAxe" or defName="VFEM2_ThrowingAxe" or defName="VFEM2_MeleeWeapon_Claymore" or defName="VFEM2_MeleeWeapon_Halberd" or defName="VFEM2_MeleeWeapon_Pike" or defName="VFEM2_MeleeWeapon_Shortsword" or defName="VFEM2_MeleeWeapon_Flail"]/stuffCategories/li[.="Woody"]</xpath>
            </li>

            <!-- Remove dedicated WoodLog costList from the Standard -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEM2_MeleeWeapon_Standard"]/costList/WoodLog</xpath>
            </li>

            <!-- Adds Woody stuffCategory so the Standard can be made with various wood planks -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_MeleeWeapon_Standard"]</xpath>
                <value>
                    <stuffCategories>
						<li>Woody</li>
					</stuffCategories>
					<costStuffCount>80</costStuffCount>
                </value>
            </li>

            <!-- Remove dedicated WoodLog costList from the Arquebus, Hand Cannon, Arbalest, and Warbow -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEM2_Gun_Arquebus" or defName="VFEM2_Gun_HandCannon" or defName="VFEM2_Arbalest" or defName="VFEM2_Warbow"]/costList/WoodLog</xpath>
            </li>

            <!-- Adds Woody stuffCategory so the Arquebus can be made with various wood planks -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_Gun_Arquebus"]</xpath>
                <value>
                    <stuffCategories>
                        <li>Woody</li>
                    </stuffCategories>
                    <costStuffCount>60</costStuffCount>
                </value>
            </li>

            <!-- Adds Woody stuffCategory so the Hand Cannon can be made with various wood planks -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_Gun_HandCannon"]</xpath>
                <value>
                    <stuffCategories>
                        <li>Woody</li>
                    </stuffCategories>
                    <costStuffCount>50</costStuffCount>
                </value>
            </li>

            <!-- Adds Woody stuffCategory so the Arbalest and Warbow can be made with various wood planks -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_Arbalest" or defName="VFEM2_Warbow"]</xpath>
                <value>
                    <stuffCategories>
                        <li>Woody</li>
                    </stuffCategories>
                    <costStuffCount>70</costStuffCount>
                </value>
            </li>

        </operations>
    </match>
    </Operation>

</Patch>
