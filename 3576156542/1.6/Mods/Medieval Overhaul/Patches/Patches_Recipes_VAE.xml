<Patch>

		<Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Armour Expanded</li>
        </mods>

        <match Class="PatchOperationSequence">
            <operations>

				<!-- Wooden Armour -->
				<!-- Replaces Woody category with DankPyon_RawWood -->
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName="VAE_Apparel_WoodenArmor"]/stuffCategories/li[.="Woody"]</xpath>
					<value>
						<li>DankPyon_RawWood</li>
					</value>
				</li>

			</operations>
		</match>
	</Operation>

</Patch>
