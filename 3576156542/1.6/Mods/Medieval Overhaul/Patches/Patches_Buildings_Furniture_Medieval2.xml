<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Factions Expanded - Medieval 2</li>
        </mods>

        <match Class="PatchOperationSequence">
        <operations>

            <!-- Remove dedicated WoodLog costList -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEM2_StandingBanner"]/costList/WoodLog</xpath>
            </li>

            <!-- Add Woody stuffCategory so they can be made with various wood planks -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_StandingBanner"]</xpath>
                <value>
                   <stuffCategories>
						<li>Woody</li>
					</stuffCategories>
					<costStuffCount>50</costStuffCount>
                </value>
            </li>

            <!-- Remove dedicated WoodLog costList -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="VFEM2_FurBed" or defName="VFEM2_DoubleFurBed"]/costList</xpath>
            </li>

            <!-- Add WoodLog costList so Fur Bed can be made with generic planks instead of generic logs -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_FurBed"]</xpath>
                <value>
                    <costList>
                        <WoodLog>25</WoodLog>
                    </costList>
                </value>
            </li>

            <!-- Add WoodLog costList so Double Fur Bed can be made with generic planks instead of generic logs -->
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="VFEM2_DoubleFurBed"]</xpath>
                <value>
                    <costList>
                        <WoodLog>45</WoodLog>
                    </costList>
                </value>
            </li>

            </operations>
        </match>
    </Operation>

</Patch>
