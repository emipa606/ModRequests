<Patch>

    <Operation Class="PatchOperationSequence">
        <operations>

            <!-- Adds DankPyon_RawWood category to the Burnbong -->
            <li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "Burnbong"]</xpath>
				<value>
					<stuffCategories>
						<li>DankPyon_RawWood</li>
					</stuffCategories>
					<costStuffCount>30</costStuffCount>
				</value>
			</li>

            <!-- Replaces Effigy costList with the DankPyon_RawWood category, so it can be made with raw logs -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "Effigy"]/costList</xpath>
				<value>
					<stuffCategories>
						<li>DankPyon_RawWood</li>
					</stuffCategories>
					<costStuffCount>80</costStuffCount>
				</value>
			</li>

			<!-- Replaces Pyre costList with the RawWoody category, so it can be made with logs -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "Pyre"]/costList</xpath>
				<value>
					<stuffCategories>
						<li>DankPyon_RawWood</li>
					</stuffCategories>
					<costStuffCount>100</costStuffCount>
				</value>
			</li>

        </operations>
	</Operation>

</Patch>
