<Patch>

    <Operation Class="PatchOperationFindMod">
    <mods>
        <li>Vanilla Factions Expanded - Classical</li>
    </mods>

    <match Class="PatchOperationSequence">
        <operations>

			<!-- Removes constructEffect so it doesn't produce an error when the costList is changed to a stuffCategory -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName = "VFEC_LargePassiveCooler" or defName="VFEC_HeatStones"]/constructEffect</xpath>
			</li>

			<!-- Replaces dedicated WoodLog costList with DankPyon_RawWood stuffCategory -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="VFEC_LargePassiveCooler"]/costList</xpath>
				<value>
					<stuffCategories>
                        <li>DankPyon_RawWood</li>
                    </stuffCategories>
                    <costStuffCount>150</costStuffCount>
				</value>
			</li>

             <!-- Replaces dedicated WoodLog costList with DankPyon_RawWood stuffCategory -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName="VFEC_HeatStones"]/costList</xpath>
				<value>
					<stuffCategories>
                        <li>DankPyon_RawWood</li>
                    </stuffCategories>
                    <costStuffCount>50</costStuffCount>
				</value>
			</li>

        </operations>
		</match>

	</Operation>
</Patch>
