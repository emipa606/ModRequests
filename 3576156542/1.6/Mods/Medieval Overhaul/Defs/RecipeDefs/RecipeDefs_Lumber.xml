<Defs>

	<!-- MakeLumber Base -->
	<RecipeDef Name="EW2_MakeLumberBase" Abstract="True">
		<jobString>Processing lumber.</jobString>
		<workAmount>250</workAmount>
		<unfinishedThingDef>EW2_UnfinishedLumber</unfinishedThingDef>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<workSkill>Crafting</workSkill>
		<workSkillLearnFactor>0.25</workSkillLearnFactor>
		<effectWorking>CutStone</effectWorking>
		<soundWorking>Recipe_MakeWoodPlanks_Electric</soundWorking>
		<requiredGiverWorkType>Crafting</requiredGiverWorkType>
		<targetCountAdjustment>15</targetCountAdjustment>
		<recipeUsers>
			<li>CraftingSpot</li>
			<li>DankPyon_Trestle</li>
			<li>DankPyon_SawTable</li>
			<li>EW2_FueledTableWoodworking</li>
		</recipeUsers>
	</RecipeDef>

	<!-- Lumber Bundle -->
	<RecipeDef ParentName="EW2_MakeLumberBase">
		<defName>EW2_MakeLumberBundle</defName>
		<label>bundle wooden planks</label>
		<description>Bundle together spare wooden planks.</description>
		<allowMixingIngredients>true</allowMixingIngredients>
		<recipeUsers>
			<li>CraftingSpot</li>
			<li>DankPyon_Trestle</li>
			<li>DankPyon_SawTable</li>
			<li>EW2_FueledTableWoodworking</li>
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>DankPyon_Wood</li>
					</categories>
				</filter>
				<count>3</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<categories>
				<li>DankPyon_Wood</li>
			</categories>
			<disallowedThingDefs>
				<li>WoodLog</li>
			</disallowedThingDefs>
		</fixedIngredientFilter>
		<products>
			<WoodLog>3</WoodLog>
		</products>
	</RecipeDef>

