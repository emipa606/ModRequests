<Defs>

  <!-- Abstracts -->
  <!-- FreshLumber Base -->
  <ThingDef Name="EW2_FreshLumberBase" ParentName="ResourceBase" Abstract="True">
    <defName>EW2_FreshLumberBase</defName>
    <label>fresh lumber</label>
    <description>This lumber has been freshly cut from logs, but has yet to be dried in a controlled environment.</description>
    <graphicData>
      <texPath>Things/Item/Resource/WoodLumber</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(140,150,67)</color>
    </graphicData>
    <soundInteract>Wood_Drop</soundInteract>
    <soundDrop>Wood_Drop</soundDrop>
    <statBases>
      <MarketValue>1</MarketValue>
      <MaxHitPoints>125</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>25</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>EW2_FreshLumber</li>
    </thingCategories>
  </ThingDef>

