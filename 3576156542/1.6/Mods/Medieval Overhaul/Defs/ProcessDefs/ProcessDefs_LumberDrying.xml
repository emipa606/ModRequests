<Defs>

    <!-- Bamboo -->
    <ProcessorFramework.ProcessDef>
        <defName>EW2_DryLumberBamboo</defName>
        <filledGraphicSuffix>Full</filledGraphicSuffix>
        <processDays>0.67</processDays>
        <fuelUseFactor>0</fuelUseFactor>
        <usesTemperature>false</usesTemperature>
        <temperatureIdeal>10~100</temperatureIdeal>
        <temperatureSafe>-50~200</temperatureSafe>
        <speedBelowSafe>0.1</speedBelowSafe>
        <speedAboveSafe>1.0</speedAboveSafe>
        <sunFactor>0.4~1.0</sunFactor>
        <rainFactor>1~0</rainFactor>
        <snowFactor>1~0</snowFactor>
        <windFactor>0.8~1.0</windFactor>
        <thingDef>WoodLumberBamboo</thingDef>
        <ingredientFilter>
            <thingDefs>
                <li>EW2_FreshLumberBamboo</li>
            </thingDefs>
        </ingredientFilter>
        <usesQuality>false</usesQuality>
        <qualityDays>(1, 3, 8, 14, 20, 50, 120)</qualityDays>
    </ProcessorFramework.ProcessDef>

