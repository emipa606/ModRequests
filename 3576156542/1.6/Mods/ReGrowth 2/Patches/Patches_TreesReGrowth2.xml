<Patch>

	<Operation Class="PatchOperationSequence">
			<operations>
			
				<!-- Pines Drop Pine Logs -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="RG_Plant_OrangeTreePine" or defName="RG_Plant_BlueTreePine" or defName="RG_Plant_LargeTreePine" or defName="RG_Tree_TundraTreePine"]/plant</xpath>
					<value>
						<harvestedThingDef>EW2_WoodLog_Pine</harvestedThingDef>
					</value>
				</li>
				<!-- Willows Drop Willow Logs -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="RG_Plant_TreeWhiteWillow"]/plant</xpath>
					<value>
						<harvestedThingDef>EW2_WoodLog_Willow</harvestedThingDef>
					</value>
				</li>

				<!-- Tall Palms Drop Palm Logs -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "RG_Plant_TallPalmTree" or defName="RG_Plant_TreeDwarfPalm"]/plant</xpath>
					<value>
						<harvestedThingDef>EW2_WoodLog_Palm</harvestedThingDef>
					</value>
				</li>

				<!-- Cornish Trees Drop Elm Logs -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "RG_Plant_TreeCornish"]/plant</xpath>
					<value>
						<harvestedThingDef>EW2_WoodLog_Elm</harvestedThingDef>
					</value>
				</li>

			</operations>
	</Operation>

	<!-- ReGrowth 2: Aspen -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>ReGrowth 2: Aspen</li>
		</mods>
		<match Class="PatchOperationSequence">
		<operations>

			<!-- Aspen Trees Drop Poplar Logs -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="RG_Plant_TreeAspenRed" or defName="RG_Plant_TreeAspenYellow"]/plant</xpath>
				<value>
					<harvestedThingDef>EW2_WoodLog_Poplar</harvestedThingDef>
				</value>
			</li>

		</operations>
		</match>
	</Operation>
	
</Patch>
