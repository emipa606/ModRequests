<Defs>

    <!-- Elm Fresh Lumber -->
    <ThingDef ParentName="EW2_FreshLumberBase">
        <defName>EW2_FreshLumberElm</defName>
        <label>fresh elm wood lumber</label>
        <statBases>
            <Mass>0.5</Mass>
        </statBases>
    </ThingDef>

    <!-- Elm Wood Log  -->
    <ThingDef ParentName="EW2_WoodLogBase">
        <defName>EW2_WoodLog_Elm</defName>	<!-- SG:   W:   H:  -->
        <label>elm wood logs</label>
        <description>Raw wood from an elm tree. Useful for building simple structures and weapons, it must be processed into fresh lumber and left to dry before becoming suitable for advanced projects. It is a good fuel for campfires and generators, and can be refined into chemfuel. In a pinch, a piece of wood can be used as a weapon or a leg. Elm is a non-durable hardwood.</description>
        <graphicData>
            <color>(208,165,133)</color>
        </graphicData>
        <statBases>
            <Mass>0.5</Mass>
            <MarketValue>1.5</MarketValue>
            <DeteriorationRate>6</DeteriorationRate>
        </statBases>
        <stuffProps>
            <stuffAdjective>elm</stuffAdjective>
            <commonality>0.3</commonality>
            <color>(208,165,133)</color>
            <statFactors>
                <MaxHitPoints>0.45</MaxHitPoints>
                <Beauty>2</Beauty>
                <WorkToMake>0.4</WorkToMake>
                <WorkToBuild>0.4</WorkToBuild>
                <DoorOpenSpeed>1.2</DoorOpenSpeed>
            </statFactors>
        </stuffProps>
        <butcherProducts>
            <EW2_FreshLumberElm>30</EW2_FreshLumberElm>
        </butcherProducts>
    </ThingDef>

    <!--Elm Planks -->
    <ThingDef ParentName="WoodLumberBase">
        <defName>WoodLumberElm</defName>
        <label>elm wood planks</label>
        <description>Processed elm wood planks, useful for building advanced structures and furniture. Elm is a non-durable hardwood.</description>
        <graphicData>
            <color>(208,165,133)</color>
        </graphicData>
        <statBases>
            <Mass>0.5</Mass>
            <MarketValue>1.4</MarketValue>
            <DeteriorationRate>10</DeteriorationRate>
        </statBases>
        <stuffProps>
            <stuffAdjective>elm wood</stuffAdjective>
            <commonality>0.3</commonality>
            <color>(208,165,133)</color>
            <statFactors>
                <MaxHitPoints>0.4</MaxHitPoints>
                <Beauty>2</Beauty>
                <WorkToMake>0.4</WorkToMake>
                <WorkToBuild>0.4</WorkToBuild>
                <DoorOpenSpeed>1.2</DoorOpenSpeed>
            </statFactors>
        </stuffProps>
    </ThingDef>

</Defs>
