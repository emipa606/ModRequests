<Patch>

    <!-- Chemfuel Recipes  have their ingredient categories changed to EW2 WoodLog-->
	<Operation Class="PatchOperationSequence">
		<operations>

			<li Class="PatchOperationReplace">
				<xpath>Defs/RecipeDef[defName = "Make_ChemfuelFromWood"]/ingredients/li/filter/thingDefs</xpath>
				<value>
					<categories>
						<li>EW2_WoodLog</li>
					</categories>
				</value>
			</li>

			<li Class="PatchOperationReplace">
				<xpath>Defs/RecipeDef[defName = "Make_ChemfuelFromWood"]/fixedIngredientFilter/thingDefs</xpath>
				<value>
					<categories>
						<li>EW2_WoodLog</li>
					</categories>
				</value>
			</li>

		</operations>
	</Operation>

	<!-- Apparel -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<!-- Wood Mask has its stuffCategory changed to RawWoody, so it can be made with logs -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "Apparel_WarMask"]/stuffCategories/li[.="Woody"]</xpath>
				<value>
					<li>EW2_RawWoody</li>
				</value>
			</li>

			<!-- Plate Armour can no longer be made from wood -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName = "Apparel_PlateArmor"]/stuffCategories/li[.="Woody"]</xpath>
			</li>

		</operations>
	</Operation>

	<!-- Art -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<!-- Scupltures have their stuffCategory changed to RawWoody, so they can be with from logs -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "SculptureSmall" or defName = "SculptureLarge" or defName = "SculptureGrand"]/stuffCategories/li[.="Woody"]</xpath>
				<value>
					<li>EW2_RawWoody</li>
				</value>
			</li>

		</operations>
	</Operation>

	<!-- Base Weapons -->
	<!-- Sharp weapons can no longer be made out of wood -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[@Name="BaseMeleeWeapon_Sharp"]/recipeMaker/defaultIngredientFilter</xpath>
				<value>
					<disallowedCategories>
						<li>EW2_WoodLog</li>
						<li>WoodLumber</li>
					</disallowedCategories>
				</value>
			</li>

			<!-- Remove Woody category from the Gladius, Longsword, Spear, and Ikwa -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName="MeleeWeapon_Gladius" or defName="MeleeWeapon_LongSword" or defName = "MeleeWeapon_Spear" or defName ="MeleeWeapon_Ikwa"]/stuffCategories/li[.="Woody"]</xpath>
			</li>

		</operations>
	</Operation>

	<!-- Weapon (Melee Medieval) -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<!-- Maces can no longer be made of wood -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName = "MeleeWeapon_Mace"]/stuffCategories/li[.="Woody"]</xpath>
			</li>

		</operations>
	</Operation>

	<!-- Weapons (Melee Neolithic) -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<!-- Clubs can be made from raw wood -->
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "MeleeWeapon_Club"]/stuffCategories/li[.="Woody"]</xpath>
				<value>
					<li>EW2_RawWoody</li>
				</value>
			</li>

		</operations>
	</Operation>

	<!-- Weapon(Ranged Neolithic) -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "Bow_Short"]/costList</xpath>
				<value>
					<stuffCategories>
						<li>EW2_RawWoody</li>
					</stuffCategories>
					<costStuffCount>30</costStuffCount>
				</value>
			</li>

			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "Pila"]/costList</xpath>
				<value>
					<stuffCategories>
						<li>EW2_RawWoody</li>
					</stuffCategories>
					<costStuffCount>70</costStuffCount>
				</value>
			</li>

			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "Bow_Recurve"]/costList</xpath>
				<value>
					<stuffCategories>
						<li>EW2_RawWoody</li>
					</stuffCategories>
					<costStuffCount>40</costStuffCount>
				</value>
			</li>

			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "Bow_Great"]/costList</xpath>
				<value>
					<stuffCategories>
						<li>EW2_RawWoody</li>
					</stuffCategories>
					<costStuffCount>50</costStuffCount>
				</value>
			</li>

		</operations>
	</Operation>

</Patch>
