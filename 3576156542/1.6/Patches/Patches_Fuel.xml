<Patch>

    <!-- Fuel Filter - This patch also applies to the internal fueled table saw. Anima, Archean, and Gauranlen wood are not available as fuel. -->
	<!-- Original Author: Aquiles-->
	<Operation Class="PatchOperationSequence">
			<operations>

				<!-- Adds the new WoodLogs to the fuel list -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef/comps/li[@Class="CompProperties_Refuelable" and fuelFilter/thingDefs/li[.="WoodLog"]]/fuelFilter/thingDefs</xpath>
					<value>
						<li>EW2_WoodLog_Bamboo</li>
						<li>EW2_WoodLog_Palm</li>
						<li>EW2_WoodLog_Birch</li>
						<li>EW2_WoodLog_Cecropia</li>
						<li>EW2_WoodLog_Cocoa</li>
						<li>EW2_WoodLog_Cypress</li>
						<li>EW2_WoodLog_Drago</li>
						<li>EW2_WoodLog_Maple</li>
						<li>EW2_WoodLog_Oak</li>
						<li>EW2_WoodLog_Pine</li>
						<li>EW2_WoodLog_Poplar</li>
						<li>EW2_WoodLog_Shroom</li>
						<li>EW2_WoodLog_Succulent</li>
						<li>EW2_WoodLog_Teak</li>
						<li>EW2_WoodLog_Willow</li>
					</value>
				</li>

				<!-- Prevents lumber and planks being used as fuel -->
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef/comps/li[@Class="CompProperties_Refuelable"]/fuelFilter</xpath>
					<value>
						<disallowedCategories>
							<li>EW2_FreshLumber</li>
							<li>WoodLumber</li>
						</disallowedCategories>
					</value>
				</li>

			</operations>
	</Operation>

</Patch>
