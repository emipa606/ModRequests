<Patch>

    <!-- Trees now drop coresponding EW2 logs -->
	<!-- Arid Trees -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<!-- Saguaro -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "Plant_SaguaroCactus"]/plant</xpath>
				<value>
					<harvestedThingDef>EW2_WoodLog_Succulent</harvestedThingDef>
				</value>
			</li>

			<!-- Drago -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "Plant_TreeDrago"]/plant</xpath>
				<value>
					<harvestedThingDef>EW2_WoodLog_Drago</harvestedThingDef>
				</value>
			</li>

		</operations>
	</Operation>

	<!-- Swamp Trees -->
	<Operation Class="PatchOperationSequence">
		<success>Always</success>
		<operations>

			<!-- Willow -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "Plant_TreeWillow"]/plant</xpath>
				<value>
					<harvestedThingDef>EW2_WoodLog_Willow</harvestedThingDef>
				</value>
			</li>

			<!-- Cypress -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "Plant_TreeCypress"]/plant</xpath>
				<value>
					<harvestedThingDef>EW2_WoodLog_Cypress</harvestedThingDef>
				</value>
			</li>

			<!-- Maple -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "Plant_TreeMaple"]/plant</xpath>
				<value>
					<harvestedThingDef>EW2_WoodLog_Maple</harvestedThingDef>
				</value>
			</li>

		</operations>
	</Operation>

	<!-- Temperate Trees -->
	<Operation Class="PatchOperationSequence">
		<success>Always</success>
		<operations>

			<!-- Oak -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "Plant_TreeOak"]/plant</xpath>
				<value>
					<harvestedThingDef>EW2_WoodLog_Oak</harvestedThingDef>
				</value>
			</li>

			<!-- Poplar -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "Plant_TreePoplar"]/plant</xpath>
				<value>
					<harvestedThingDef>EW2_WoodLog_Poplar</harvestedThingDef>
				</value>
			</li>

			<!-- Pine -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "Plant_TreePine"]/plant</xpath>
				<value>
					<harvestedThingDef>EW2_WoodLog_Pine</harvestedThingDef>
				</value>
			</li>

			<!-- Birch -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "Plant_TreeBirch"]/plant</xpath>
				<value>
					<harvestedThingDef>EW2_WoodLog_Birch</harvestedThingDef>
				</value>
			</li>

		</operations>
	</Operation>

	<!-- Tropical Trees -->
	<Operation Class="PatchOperationSequence">
		<success>Always</success>
		<operations>

			<!-- Teak -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "Plant_TreeTeak"]/plant</xpath>
				<value>
					<harvestedThingDef>EW2_WoodLog_Teak</harvestedThingDef>
				</value>
			</li>

			<!-- Cecropia -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "Plant_TreeCecropia"]/plant</xpath>
				<value>
					<harvestedThingDef>EW2_WoodLog_Cecropia</harvestedThingDef>
				</value>
			</li>

			<!-- Palm -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "Plant_TreePalm"]/plant</xpath>
				<value>
					<harvestedThingDef>EW2_WoodLog_Palm</harvestedThingDef>
				</value>
			</li>

			<!-- Bamboo -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "Plant_TreeBamboo"]/plant</xpath>
				<value>
					<harvestedThingDef>EW2_WoodLog_Bamboo</harvestedThingDef>
				</value>
			</li>

		</operations>
	</Operation>

	<!-- Timbershroom -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName = "Plant_Timbershroom"]/plant</xpath>
		<value>
			<harvestedThingDef>EW2_WoodLog_Shroom</harvestedThingDef>
		</value>
	</Operation>


	<!-- Produce Trees require a special thingClass in order to drop both a "fruit" and a wood -->
	<!-- Cocoa -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "Plant_TreeCocoa"]</xpath>
				<value>
					<thingClass>ExpandedWoodworking.Cocoa</thingClass>
				</value>
			</li>

		</operations>
	</Operation>

</Patch>
