            <xpath>Defs/ThingDef[defName="Bow_Short" or defName="Pila" or defName="Bow_Recurve" or defName="Bow_Great"]/colorPerStuff</xpath>
            <value>
                <li>
                    <stuff>EW2_WoodLog_Anima</stuff>
                    <color>(255,255,255)</color>
                </li>
            </value>
        </match>
    </Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Ideology</li>
        </mods>
        <match Class="PatchOperationAdd">
