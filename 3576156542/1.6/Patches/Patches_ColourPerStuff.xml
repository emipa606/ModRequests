<Patch>

     <!-- Prevents items from being colourable by their stuff type -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Bow_Short" or defName="Pila" or defName="Bow_Recurve" or defName="Bow_Great"]</xpath>
        <value>
            <colorPerStuff>
                <li>
                    <stuff>WoodLog</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Bamboo</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Palm</stuff>
                    <color>(255,255,255)</color>
                </li>

                <li>
                    <stuff>EW2_WoodLog_Birch</stuff>
