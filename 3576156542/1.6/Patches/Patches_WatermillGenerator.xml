<Patch>

        <!-- Adjusts the building cost of the Watermill Generator -->
        <Operation Class="PatchOperationSequence">
            <operations>

                <!-- Remove the constructEffect and the dedicated WoodLog costList -->
                <li Class="PatchOperationRemove">
                    <xpath>Defs/ThingDef[defName = "WatermillGenerator"]/costList/WoodLog   |   Defs/ThingDef[defName = "WatermillGenerator"]/constructEffect</xpath>
                </li>

                <!-- Then add the Woody stuffCategory, so it can be made with planks -->
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName = "WatermillGenerator"]</xpath>
                    <value>
                        <stuffCategories>
                            <li>Woody</li>
                        </stuffCategories>
                        <costStuffCount>280</costStuffCount>
                    </value>
                </li>

                <!-- Prevent the generator from being stuff colourable, so we don't need to make a new stuffable texture -->
                <li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "WatermillGenerator"]</xpath>
                    <value>
                        <colorPerStuff>
                            <li>
                                <stuff>WoodLumberBamboo</stuff>
                                <color>(255,255,255)</color>
                            </li>

                            <li>
                                <stuff>WoodLumberPalm</stuff>
                                <color>(255,255,255)</color>
                            </li>

                            <li>
                                <stuff>WoodLumberBirch</stuff>
                                <color>(255,255,255)</color>
                            </li>

                            <li>
                                <stuff>WoodLumberCecropia</stuff>
                                <color>(255,255,255)</color>
                            </li>

                            <li>
                                <stuff>WoodLumberCocoa</stuff>
                                <color>(255,255,255)</color>
                            </li>

                            <li>
                                <stuff>WoodLumberCypress</stuff>
                                <color>(255,255,255)</color>
                            </li>

                            <li>
                                <stuff>WoodLumberDrago</stuff>
                                <color>(255,255,255)</color>
                            </li>

                            <li>
                                <stuff>WoodLumberMaple</stuff>
                                <color>(255,255,255)</color>
                            </li>

                            <li>
                                <stuff>WoodLumberMixed</stuff>
                                <color>(255,255,255)</color>
                            </li>

                            <li>
                                <stuff>WoodLumberOak</stuff>
                                <color>(255,255,255)</color>
                            </li>

                            <li>
                                <stuff>WoodLumberPine</stuff>
                                <color>(255,255,255)</color>
                            </li>

                            <li>
                                <stuff>WoodLumberPoplar</stuff>
                                <color>(255,255,255)</color>
                            </li>

                            <li>
                                <stuff>WoodLumberShroom</stuff>
                                <color>(255,255,255)</color>
                            </li>

                            <li>
                                <stuff>WoodLumberSucculent</stuff>
                                <color>(255,255,255)</color>
                            </li>

                            <li>
                                <stuff>WoodLumberTeak</stuff>
                                <color>(255,255,255)</color>
                            </li>

                            <li>
                                <stuff>WoodLumberWillow</stuff>
                                <color>(255,255,255)</color>
                            </li>
                        </colorPerStuff>
                    </value>
				</li>
            </operations>
	</Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Royalty</li>
        </mods>
        <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName = "WatermillGenerator"]/colorPerStuff</xpath>
            <value>
                    <li>
                        <stuff>WoodLumberAnima</stuff>
                        <color>(255,255,255)</color>
                    </li>
            </value>
        </match>
    </Operation>

    <Operation Class="PatchOperationFindMod">
