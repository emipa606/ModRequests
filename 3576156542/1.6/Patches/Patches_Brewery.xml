<Patch>

    <!-- Remove the constructEffect from the Brewery and Fermenting Barrel -->
    <!-- First, check if they have a constructEffect, useful for MO compatibility -->
    <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName = "Brewery"or  defName = "FermentingBarrel"]/constructEffect</xpath>

        <!-- If they do, remove it -->
        <match Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName = "Brewery"or  defName = "FermentingBarrel"]/constructEffect</xpath>
        </match>
    </Operation>

    <!-- Brewery and Fermenting Barrel -->
	<Operation Class="PatchOperationSequence">
		<operations>

			<!-- Remove the costList from the Brewery and Fermenting Barrel -->
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[defName = "Brewery" or defName = "FermentingBarrel"]/costList/WoodLog</xpath>
			</li>

			<!-- Add Woody stuffCategory, so the Brewery can be made with lumber -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "Brewery"]</xpath>
				<value>
					<stuffCategories>
						<li>Woody</li>
					</stuffCategories>
					<costStuffCount>120</costStuffCount>
				</value>
			</li>

			<!-- Add Woody stuffCategory, so the Fermenting Barrel can be made with lumber -->
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "FermentingBarrel"]</xpath>
				<value>
					<stuffCategories>
						<li>Woody</li>
					</stuffCategories>
					<costStuffCount>30</costStuffCount>
				</value>
			</li>

		</operations>
	</Operation>

    <!-- Add CutoutComplex shaderType to support proper stuffable textures -->
	<Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Brewery" or defName="FermentingBarrel"]/graphicData</xpath>
        <value>
            <shaderType>CutoutComplex</shaderType>
        </value>
    </Operation>

	<!-- First check if Vanilla Textures Expanded is installed -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Textures Expanded</li>
		</mods>

		<!-- If found, prevent the brewery table from adapting to stuffable colours, so we don't need to make a new texture -->
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Brewery" or defName="FermentingBarrel"]</xpath>
			<value>
				 <colorPerStuff>
					<li>
						<stuff>WoodLumberBamboo</stuff>
						<color>(255,255,255)</color>
					</li>

					<li>
						<stuff>WoodLumberPalm</stuff>
						<color>(255,255,255)</color>
					</li>

					<li>
						<stuff>WoodLumberBirch</stuff>
						<color>(255,255,255)</color>
					</li>

					<li>
						<stuff>WoodLumberCecropia</stuff>
						<color>(255,255,255)</color>
					</li>

					<li>
						<stuff>WoodLumberCocoa</stuff>
						<color>(255,255,255)</color>
					</li>

					<li>
						<stuff>WoodLumberCypress</stuff>
						<color>(255,255,255)</color>
					</li>

					<li>
						<stuff>WoodLumberDrago</stuff>
						<color>(255,255,255)</color>
					</li>

					<li>
						<stuff>WoodLumberMaple</stuff>
						<color>(255,255,255)</color>
					</li>

					<li>
						<stuff>WoodLumberMixed</stuff>
						<color>(255,255,255)</color>
					</li>

					<li>
						<stuff>WoodLumberOak</stuff>
						<color>(255,255,255)</color>
					</li>

					<li>
						<stuff>WoodLumberPine</stuff>
						<color>(255,255,255)</color>
					</li>

					<li>
						<stuff>WoodLumberPoplar</stuff>
						<color>(255,255,255)</color>
					</li>

					<li>
						<stuff>WoodLumberShroom</stuff>
						<color>(255,255,255)</color>
					</li>

					<li>
						<stuff>WoodLumberSucculent</stuff>
						<color>(255,255,255)</color>
					</li>

					<li>
						<stuff>WoodLumberTeak</stuff>
						<color>(255,255,255)</color>
					</li>

					<li>
						<stuff>WoodLumberWillow</stuff>
						<color>(255,255,255)</color>
					</li>
				</colorPerStuff>
			</value>
		</match>

	</Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Textures Expanded</li>
        </mods>

        <match Class="PatchOperationFindMod">
            <mods>
                <li>Royalty</li>
            </mods>

            <match Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="Brewery" or defName="FermentingBarrel"]/colorPerStuff</xpath>
                <value>
                    <li>
                        <stuff>WoodLumberAnima</stuff>
                        <color>(255,255,255)</color>
                    </li>
                </value>
            </match>

        </match>
    </Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Textures Expanded</li>
        </mods>

        <match Class="PatchOperationFindMod">
            <mods>
                <li>Ideology</li>
            </mods>

            <match Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="Brewery" or defName="FermentingBarrel"]/colorPerStuff</xpath>
                <value>
                    <li>
                        <stuff>WoodLumberGaur</stuff>
                        <color>(255,255,255)</color>
                    </li>
                </value>
            </match>

        </match>
    </Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Textures Expanded</li>
        </mods>

        <match Class="PatchOperationFindMod">
            <mods>
                <li>Biotech</li>
            </mods>

            <match Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="Brewery" or defName="FermentingBarrel"]/colorPerStuff</xpath>
                <value>
                    <li>
                        <stuff>WoodLumberRot</stuff>
                        <color>(255,255,255)</color>
                    </li>
                </value>
            </match>

        </match>
    </Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Textures Expanded</li>
        </mods>

        <match Class="PatchOperationFindMod">
            <mods>
                <li>Odyssey</li>
            </mods>

            <match Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="Brewery" or defName="FermentingBarrel"]/colorPerStuff</xpath>
                <value>
                    <li>
                        <stuff>WoodLumberArchean</stuff>
                        <color>(255,255,255)</color>
                    </li>
                </value>
            </match>

        </match>
    </Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Textures Expanded</li>
        </mods>

        <match Class="PatchOperationFindMod">
            <mods>
                <li>ReGrowth 2</li>
            </mods>

            <match Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="Brewery" or defName="FermentingBarrel"]/colorPerStuff</xpath>
                <value>
                    <li>
                        <stuff>WoodLumberElm</stuff>
                        <color>(255,255,255)</color>
                    </li>
                </value>
            </match>

        </match>
    </Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Textures Expanded</li>
        </mods>

        <match Class="PatchOperationFindMod">
            <mods>
                <li>VV - New Harvest</li>
            </mods>

            <match Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="Brewery" or defName="FermentingBarrel"]/colorPerStuff</xpath>
                <value>
                    <li>
                        <stuff>WoodLumberCedar</stuff>
                        <color>(255,255,255)</color>
                    </li>

                    <li>
                        <stuff>WoodLumberEbony</stuff>
                        <color>(255,255,255)</color>
                    </li>

                    <li>
                        <stuff>WoodLumberMahogany</stuff>
                        <color>(255,255,255)</color>
                    </li>

                    <li>
                        <stuff>WoodLumberRosewood</stuff>
                        <color>(255,255,255)</color>
                    </li>
                </value>
            </match>

        </match>
    </Operation>

</Patch>
