<?xml version="1.0" encoding="utf-8" ?>

<Patch>

  <Operation Class="PatchOperationFindMod">
		<mods>
			<li>Watermelons</li>
		</mods>
		<match Class="PatchOperationSequence">          <!-- GD=8, LD/GD=8, LS=64 Min=.65 est/harvest=12 -->  <!--Real=14.77-->
			<operations> 
			  
			   <li Class="PatchOperationReplace">  <!-- GD=9.2, LD/GD=5, LS=46 Min=.65 est/harvest=12 -->  <!--Real=16.98-->
				<success>Always</success>
				<xpath>Defs/ThingDef[defName="WATERMELON_PLANT_DEF"]/plant/growDays</xpath>
				<value>
					<growDays>9.2</growDays>					
				</value>
			  </li>
			  <li Class="PatchOperationReplace">  
				<success>Always</success>
				<xpath>Defs/ThingDef[defName="WATERMELON_PLANT_DEF"]/plant/harvestYield</xpath>
				<value>
					<harvestYield>11</harvestYield>			<!--  17 -->
					<harvestAfterGrowth>0.65</harvestAfterGrowth>
				</value>
			  </li>
			  <li Class="PatchOperationAdd">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="WATERMELON_PLANT_DEF"]/plant</xpath>
					<value>
						<lifespanDaysPerGrowDays>5</lifespanDaysPerGrowDays>
						<harvestWork>125</harvestWork>
					</value>
			  </li>	
			  
			</operations>
		</match>
  </Operation>                              <!-- FinalValue= LS=46 --> <!--Real=5.94/4.89Full Yield V=52, New=55 -->
  
  
  
</Patch> 