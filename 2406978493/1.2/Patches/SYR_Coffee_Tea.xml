<?xml version="1.0" encoding="utf-8" ?>

<Patch>

  <Operation Class="PatchOperationFindMod">
		<mods>
			<li>[SYR] Coffee and Tea</li>
		</mods>
		<match Class="PatchOperationSequence">   <!-- GD=12, LD/GD=8, LS=96 Min=.65 est/harvest=12 -->  <!--Real=22.15/21.04-->
			<operations> 
			  
			  <li Class="PatchOperationReplace">  <!-- GD=13, LD/GD=55, LS=715 Min=.65 est/harvest=12 -->  <!--Real=24-->
				<success>Always</success>
				<xpath>Defs/ThingDef[defName="Plant_SyrCoffee"]/plant/growDays</xpath>
				<value>
					<growDays>13</growDays>				
				</value>
			  </li>
			  <li Class="PatchOperationReplace">  
				<success>Always</success>
				<xpath>Defs/ThingDef[defName="Plant_SyrCoffee"]/plant/harvestYield</xpath>
				<value>
					<harvestYield>7</harvestYield>					
				</value>
			  </li>
			  <li Class="PatchOperationReplace">  
				<success>Always</success>
				<xpath>Defs/ThingDef[defName="Plant_SyrCoffee"]/plant/harvestAfterGrowth</xpath>
				<value>
					<harvestAfterGrowth>0.42</harvestAfterGrowth>				
				</value>
			  </li>
			  <li Class="PatchOperationAdd">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="Plant_SyrCoffee"]/plant</xpath>
					<value>
						<lifespanDaysPerGrowDays>55</lifespanDaysPerGrowDays>
						<harvestMinGrowth>0.80</harvestMinGrowth>
						<harvestWork>135</harvestWork>
					</value>
			  </li>
			  
			</operations>
		</match>
  </Operation>                          <!-- FinalValue= LS=715 --> <!--Real=13.92/49.64Full  Yield V=330, New=350-->
  
  
