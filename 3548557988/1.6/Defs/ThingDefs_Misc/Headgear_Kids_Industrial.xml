<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- ##### Industrial ##### -->
	<!-- +++++ Kid Eltex Helmet +++++ -->
  <ThingDef ParentName="PsychicApparelBase" MayRequire="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Biotech">
    <defName>Apparel_KidEltexHelmet</defName>
    <label>kid eltex helmet</label>
    <description>A lightweight helmet designed for psychic focusing. While it provides little physical protection, its special materials enhance the wearer's psychic sensitivity and dissipate neural heat. Children in these helmets are often those selected to become great psycasters.</description>
    <thingCategories>
      <li>Headgear</li>
    </thingCategories>
    <graphicData>
      <texPath>Things/Headgear/KidEltexHelmet/KidEltexHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>500</MarketValue>
      <MaxHitPoints>80</MaxHitPoints>
      <Mass>0.4</Mass>
      <ArmorRating_Sharp>0.09</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.09</ArmorRating_Blunt>
      <ArmorRating_Heat>0.27</ArmorRating_Heat>
      <Insulation_Cold>4</Insulation_Cold>
      <Insulation_Heat>1</Insulation_Heat>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <PsychicSensitivityOffset>0.15</PsychicSensitivityOffset>
      <PsychicEntropyRecoveryRate>0.066</PsychicEntropyRecoveryRate>
    </equippedStatOffsets>
    <apparel>
    <developmentalStageFilter>Child</developmentalStageFilter>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Headgear/KidEltexHelmet/KidEltexHelmet</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <only>(57,87,93)</only>
        </li>
        <li>
          <only>(51,27,49)</only>
        </li>
      </options>
    </colorGenerator>
  </ThingDef>
  <!-- +++++ Kid Eltex Skullcap +++++ -->
<ThingDef ParentName="PsychicApparelBase" MayRequire="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Biotech">
    <defName>Apparel_KidEltexSkullcap</defName>
    <label>kid eltex skullcap</label>
    <description>A tight skullcap designed for psychic focusing. It provides no physical protection, but its special materials enhance the wearer's psychic sensitivity and dissipate neural heat. A favorite choice of children destined to become imperial psycasters.</description>
    <thingCategories>
      <li>Headgear</li>
    </thingCategories>
    <graphicData>
      <texPath>Things/Headgear/KidEltexSkullcap/KidEltexSkullcap</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>500</MarketValue>
      <MaxHitPoints>80</MaxHitPoints>
      <Mass>0.4</Mass>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <PsychicSensitivityOffset>0.4</PsychicSensitivityOffset>
      <PsychicEntropyRecoveryRate>0.091</PsychicEntropyRecoveryRate>
    </equippedStatOffsets>
    <apparel>
    <developmentalStageFilter>Child</developmentalStageFilter>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Headgear/KidEltexSkullcap/KidEltexSkullcap</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <only>(90,90,90)</only>
        </li>
        <li>
          <only>(135,135,135)</only>
        </li>
        <li>
          <only>(160,160,160)</only>
        </li>
      </options>
    </colorGenerator>
  </ThingDef>
  <!-- +++++ Kid Flak Helmet +++++ -->
	<ThingDef ParentName="ArmorHelmetMakeableBase">
 <defName>Apparel_AdvancedKidHelmet</defName>
    <label>kid flak helmet</label>
    <description>A lightweight combat helmet with a complex design, reinforced with plasteel. For the especially valuable conscript, to keep them alive long enough to die as an adult instead.</description>
    <techLevel>Industrial</techLevel>
    <recipeMaker>
      <researchPrerequisite>FlakArmor</researchPrerequisite>
      <unfinishedThingDef>UnfinishedMetallicTechArmor</unfinishedThingDef>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
      <displayPriority>205</displayPriority>
    </recipeMaker>
    <graphicData>
      <texPath>Things/Headgear/KidFlakHelmet/KidFlakHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconScale>1.4</uiIconScale>
    <statBases>
      <WorkToMake>6400</WorkToMake>
      <MaxHitPoints>120</MaxHitPoints>
      <Mass>0.6</Mass>
      <StuffEffectMultiplierArmor>0.7</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>20</costStuffCount>
    <costList>
      <ComponentIndustrial>1</ComponentIndustrial>
      <Plasteel>5</Plasteel>
    </costList>
    <apparel>
    <developmentalStageFilter>Child</developmentalStageFilter>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Headgear/KidFlakHelmet/KidFlakHelmet</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <tags>
        <li>IndustrialMilitaryAdvanced</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.33,0.33,0.33,1)</only>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.65,0.65,0.65,1)</only>
        </li>
        <li>
          <weight>6</weight>
          <min>(0.3,0.3,0.3,1)</min>
          <max>(0.5,0.5,0.5,1)</max>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.9,0.9,0.9,1)</only>
        </li>
      </options>
    </colorGenerator>
    <tradeTags>
      <li>Armor</li>
    </tradeTags>
  </ThingDef>
	<!-- +++++ Kid Foil Helmet +++++ -->
	<ThingDef ParentName="HatBase">
    <defName>Apparel_KidPsychicFoil</defName>
    <label>kid psychic foil helmet</label>
    <description>A thin helmet containing finely-tuned sheets of psychically-absorptive foil. This genius invention was made to protect the children of the rimworlds from government psycasters.</description>
    <graphicData>
      <texPath>Things/Headgear/KidPsychicFoil/KidPsychicFoil</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconScale>1.3</uiIconScale>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <MarketValue>250</MarketValue>
      <Mass>0.5</Mass>
      <Flammability>0.4</Flammability>
      <ArmorRating_Sharp>0.09</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.09</ArmorRating_Blunt>
      <ArmorRating_Heat>0.27</ArmorRating_Heat>
      <Insulation_Cold>2</Insulation_Cold>
      <Insulation_Heat>1</Insulation_Heat>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <PsychicSensitivity>-0.90</PsychicSensitivity>
    </equippedStatOffsets>
    <generateCommonality>0.1</generateCommonality>
    <smeltable>false</smeltable>
    <apparel>
	<developmentalStageFilter>Child</developmentalStageFilter>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Headgear/KidPsychicFoil/KidPsychicFoil</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <tags>
        <li>IndustrialMilitaryBasic</li>
        <li>IndustrialMilitaryAdvanced</li>
        <li>SpacerMilitary</li>
      </tags>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.33,0.33,0.33,1)</only>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.65,0.65,0.65,1)</only>
        </li>
        <li>
          <weight>6</weight>
          <min>(0.3,0.3,0.3,1)</min>
          <max>(0.5,0.5,0.5,1)</max>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.9,0.9,0.9,1)</only>
        </li>
      </options>
    </colorGenerator>
    <tradeTags>
      <li>Clothing</li>
    </tradeTags>
    <thingSetMakerTags>
      <li>RewardStandardLowFreq</li>
    </thingSetMakerTags>
  </ThingDef>
  <!-- +++++ Learnlink +++++ -->
   <ThingDef ParentName="ApparelArmorHelmetReconBase">
    <defName>Apparel_Learnlink</defName>
    <label>learnlink</label>
    <description>An educational assistant that helps the user to learn on a personal basis. It analyzes targets using infrared, visible, and millimeter-wave electromagnetic sensors. An onboard computer displays educational facts on a retinal projection. It offers no protection at all.</description>
    <graphicData>
      <texPath>Things/Headgear/Learnlink/Learnlink</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <equippedStatOffsets>
      <LearningRateFactor>0.2</LearningRateFactor>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0</VacuumResistance>
    </equippedStatOffsets>
    <statBases>
      <ArmorRating_Sharp>0</ArmorRating_Sharp>
      <ArmorRating_Blunt>0</ArmorRating_Blunt>
      <ArmorRating_Heat>0</ArmorRating_Heat>
      <Insulation_Cold>0</Insulation_Cold>
      <Insulation_Heat>0</Insulation_Heat>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>Gunlink</researchPrerequisite>
      <displayPriority>400</displayPriority>
    </recipeMaker>
    <costList>
      <ComponentSpacer>1</ComponentSpacer>
      <Plasteel>5</Plasteel>
    </costList>
    <apparel>
      <wornGraphicPath>Things/Headgear/Learnlink/Learnlink</wornGraphicPath>
      <renderSkipFlags>
        <li>None</li>
      </renderSkipFlags>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <developmentalStageFilter>Child</developmentalStageFilter>
      <bodyPartGroups Inherit="False">
        <li>UpperHead</li>
      </bodyPartGroups>
      <tags Inherit="False">
        <li>Gunlink</li>
      </tags>
      <defaultOutfitTags Inherit="False">
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <tradeTags>
      <li>Clothing</li>
    </tradeTags>
    <thingSetMakerTags Inherit="False">
      <li>RewardStandardLowFreq</li>
    </thingSetMakerTags>
    <comps Inherit="False">
      <li Class="CompProperties_Biocodable"/>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Styleable" />
      <li>
        <compClass>CompColorable</compClass>
      </li>
    </comps>
  </ThingDef>
</Defs>