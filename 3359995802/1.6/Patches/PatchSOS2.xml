<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Save Our Ship 2</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="Nix_Core"]/equippedStatOffsets</xpath>
                    <value>
                        <HypoxiaResistance>0.8</HypoxiaResistance>
                        <DecompressionResistance>0.8</DecompressionResistance>
                        <VacuumSpeedMultiplier>1</VacuumSpeedMultiplier>
                    </value>
                </li>
                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="Nix_Core"]/statBases/Insulation_Cold</xpath>
                    <value>
                        <Insulation_Cold>100</Insulation_Cold>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Save Our Ship 2</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="Gravis_Core"]/equippedStatOffsets</xpath>
                    <value>
                        <HypoxiaResistance>0.7</HypoxiaResistance>
                        <DecompressionResistance>0.7</DecompressionResistance>
                        <VacuumSpeedMultiplier>1</VacuumSpeedMultiplier>
                    </value>
                </li>
                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="Gravis_Core"]/statBases/Insulation_Cold</xpath>
                    <value>
                        <Insulation_Cold>100</Insulation_Cold>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>

</Patch>