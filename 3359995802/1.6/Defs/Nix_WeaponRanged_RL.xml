<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--Nix MG-->
  <ThingDef ParentName="ModuleItemBase"><!--module-->
    <defName>Nix_Module_RL</defName>
    <label>Exo Rocket launcher</label>
    <description>Large rocket launcher. It is designed to be mounted on an exoskeleton platform manipulator, so it cannot normally be handled by humans. It can continuously fire long-range rockets and is effective against distant targets and dense enemies.</description>
    <descriptionHyperlinks>
      <ThingDef>Nix_Weapon_RL</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Item/Nix_Rocket</texPath>
    </graphicData>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>100.0</Mass>
    </statBases>
    <recipeMaker>
      <researchPrerequisites>
        <li>Nix_Rifle</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
      <effectWorking>Repair</effectWorking>
      <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
      <workAmount>50000</workAmount>
      <soundWorking>Recipe_Machining</soundWorking>
    </recipeMaker>
    <costList>
      <Steel>200</Steel>
      <ComponentIndustrial>18</ComponentIndustrial>
      <Shell_HighExplosive>5</Shell_HighExplosive>
    </costList>
    <comps>
      <li Class="Exosuit.CompProperties_ExosuitModule">
        <EquipedThingDef>Nix_Apparel_RL</EquipedThingDef>
        <occupiedSlots>
          <li>ArmRight</li>
          <li>ArmLeft</li>
        </occupiedSlots>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ModuleApparelBase"><!--apprel-->
    <defName>Nix_Apparel_RL</defName>
    <label>Exo Rocket launcher</label>
    <description>Large rocket launcher. It is designed to be mounted on an exoskeleton platform manipulator, so it cannot normally be handled by humans. It can continuously fire long-range rockets and is effective against distant targets and dense enemies.</description>
    <descriptionHyperlinks>
      <ThingDef>Nix_Weapon_RL</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Weapons/Nix_Rocket</texPath>
    </graphicData>
    <statBases>
      <Mass>100.00</Mass>
    </statBases>
    <apparel>
      <parentTagDef>WGApparelBody</parentTagDef>
      <bodyPartGroups>
        <li>Arms</li>
      </bodyPartGroups>
      <layers>
        <li>ExosuitLayer_Core</li>
      </layers>
    </apparel>
    <comps>
      <li Class="Exosuit.CompProperties_ExosuitModule">
        <ItemDef>Nix_Module_RL</ItemDef>
        <occupiedSlots>
          <li>ArmRight</li>
          <li>ArmLeft</li>
        </occupiedSlots>
      </li>
      <li Class="Exosuit.CompProperties_ModuleWeapon">
        <weapon>Nix_Weapon_RL</weapon>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseEDFWalkerWeapon"><!--weapon-->
    <defName>Nix_Weapon_RL</defName>
    <label>Exo Rocket launcher</label>
    <description>Large rocket launcher. It is designed to be mounted on an exoskeleton platform manipulator, so it cannot normally be handled by humans. It can continuously fire long-range rockets and is effective against distant targets and dense enemies.</description>
    <graphicData>
      <texPath>Things/Weapons/Nix_Rocket</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>2.3</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>2000</MarketValue>
      <Mass>0</Mass>
      <RangedWeapon_Cooldown>1</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Proj_Rocket</defaultProjectile>
        <forcedMissRadius>2</forcedMissRadius>
        <ai_AvoidFriendlyFireRadius>3</ai_AvoidFriendlyFireRadius>
        <warmupTime>1.5</warmupTime>
        <range>36.9</range>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <soundCast>RocketswarmLauncher_Fire</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>10</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>1.6</cooldownTime>
      </li>
    </tools>
  </ThingDef>

</Defs>