<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--Nix MC-->
  <ThingDef ParentName="ModuleItemBase"><!--module-->
    <defName>Nix_Module_Gatling</defName>
    <label>Revolver Cannon</label>
    <description>Large caliber Gatling gun. It is designed to be mounted on the manipulator of an exoskeleton platform, so it cannot normally be handled by humans. It has a stable rapid-firing capability and a moderate range, making it very effective in medium- to long-range combat.</description>
    <descriptionHyperlinks>
      <ThingDef>Nix_Weapon_Gatling</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Item/Nix_Gatling</texPath>
    </graphicData>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>100.0</Mass>
    </statBases>
    <recipeMaker>
      <researchPrerequisites>
        <li>Nix_Rifle</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
      <effectWorking>Repair</effectWorking>
      <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
      <workAmount>50000</workAmount>
      <soundWorking>Recipe_Machining</soundWorking>
    </recipeMaker>
    <costList>
      <Steel>300</Steel>
      <ComponentIndustrial>18</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="Exosuit.CompProperties_ExosuitModule">
        <EquipedThingDef>Nix_Apparel_Gatling</EquipedThingDef>
        <occupiedSlots>
          <li>ArmRight</li>
          <li>ArmLeft</li>
        </occupiedSlots>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ModuleApparelBase"><!--apprel-->
    <defName>Nix_Apparel_Gatling</defName>
    <label>Revolver Cannon</label>
    <description>Large caliber Gatling gun. It is designed to be mounted on the manipulator of an exoskeleton platform, so it cannot normally be handled by humans. It has a stable rapid-firing capability and a moderate range, making it very effective in medium- to long-range combat.</description>
    <descriptionHyperlinks>
      <ThingDef>Nix_Weapon_Gatling</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Weapons/Nix_Gatling</texPath>
    </graphicData>
    <statBases>
      <Mass>100.00</Mass>
    </statBases>
    <apparel>
      <parentTagDef>WGApparelBody</parentTagDef>
      <bodyPartGroups>
        <li>Arms</li>
      </bodyPartGroups>
      <layers>
        <li>ExosuitLayer_Core</li>
      </layers>
    </apparel>
    <comps>
      <li Class="Exosuit.CompProperties_ExosuitModule">
        <ItemDef>Nix_Module_Gatling</ItemDef>
        <occupiedSlots>
          <li>ArmRight</li>
          <li>ArmLeft</li>
        </occupiedSlots>
      </li>
      <li Class="Exosuit.CompProperties_ModuleWeapon">
        <weapon>Nix_Weapon_Gatling</weapon>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseEDFWalkerWeapon"><!--weapon-->
    <defName>Nix_Weapon_Gatling</defName>
    <label>Revolver Cannon</label>
    <description>Large caliber Gatling gun. It is designed to be mounted on the manipulator of an exoskeleton platform, so it cannot normally be handled by humans. It has a stable rapid-firing capability and a moderate range, making it very effective in medium- to long-range combat.</description>
    <graphicData>
      <texPath>Things/Weapons/Nix_Gatling</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>2.3</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>2000</MarketValue>
      <Mass>0</Mass>
      <AccuracyTouch>0.68</AccuracyTouch>
      <AccuracyShort>0.70</AccuracyShort>
      <AccuracyMedium>0.74</AccuracyMedium>
      <AccuracyLong>0.71</AccuracyLong>
      <RangedWeapon_Cooldown>2.5</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_NixMC_EXO</defaultProjectile>
        <warmupTime>1.5</warmupTime>
        <minRange>2.1</minRange>
        <range>33.9</range>
        <ticksBetweenBurstShots>5</ticksBetweenBurstShots>
        <burstShotCount>16</burstShotCount>
        <soundCast>Shot_TurretSniper</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>1.6</cooldownTime>
      </li>
    </tools>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_NixMC_EXO</defName>
    <label>large-caliber Bullet</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>2</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>24</damageAmountBase>
      <stoppingPower>1.5</stoppingPower>
      <speed>100</speed>
    </projectile>
  </ThingDef>


