<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--Nix MG-->
  <ThingDef ParentName="ModuleItemBase"><!--module-->
    <defName>Nix_Module_MG</defName>
    <label>Exo Machine Gun</label>
    <description>Large machine gun with a large caliber. Since it is developed to fit into exoskeleton platforms manipulator, it cannot normally be handled by humans. It boasts good rapid-firing capability and an overwhelming number of bullets, making it suitable for setting up a barrage.</description>
    <descriptionHyperlinks>
      <ThingDef>Nix_Weapon_MG</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Item/Nix_MachineGun</texPath>
    </graphicData>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>100.0</Mass>
    </statBases>
    <recipeMaker>
      <researchPrerequisites>
        <li>Nix_Rifle</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
      <effectWorking>Repair</effectWorking>
      <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
      <workAmount>50000</workAmount>
      <soundWorking>Recipe_Machining</soundWorking>
    </recipeMaker>
    <costList>
      <Steel>300</Steel>
      <ComponentIndustrial>16</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="Exosuit.CompProperties_ExosuitModule">
        <EquipedThingDef>Nix_Apparel_MG</EquipedThingDef>
        <occupiedSlots>
          <li>ArmRight</li>
          <li>ArmLeft</li>
        </occupiedSlots>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ModuleApparelBase"><!--apprel-->
    <defName>Nix_Apparel_MG</defName>
    <label>Exo Machine Gun</label>
    <description>Large machine gun with a large caliber. Since it is developed to fit into exoskeleton platforms manipulator, it cannot normally be handled by humans. It boasts good rapid-firing capability and an overwhelming number of bullets, making it suitable for setting up a barrage.</description>
    <descriptionHyperlinks>
      <ThingDef>Nix_Weapon_MG</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Weapons/Nix_MachineGun</texPath>
    </graphicData>
    <statBases>
      <Mass>100.00</Mass>
    </statBases>
    <apparel>
      <parentTagDef>WGApparelBody</parentTagDef>
      <bodyPartGroups>
        <li>Arms</li>
      </bodyPartGroups>
      <layers>
        <li>ExosuitLayer_Core</li>
      </layers>
    </apparel>
    <comps>
      <li Class="Exosuit.CompProperties_ExosuitModule">
        <ItemDef>Nix_Module_MG</ItemDef>
        <occupiedSlots>
          <li>ArmRight</li>
          <li>ArmLeft</li>
        </occupiedSlots>
      </li>
      <li Class="Exosuit.CompProperties_ModuleWeapon">
        <weapon>Nix_Weapon_MG</weapon>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseEDFWalkerWeapon"><!--weapon-->
    <defName>Nix_Weapon_MG</defName>
    <label>Exo Machine Gun</label>
    <description>Large machine gun with a large caliber. Since it is developed to fit into exoskeleton platforms manipulator, it cannot normally be handled by humans. It boasts good rapid-firing capability and an overwhelming number of bullets, making it suitable for setting up a barrage.</description>
    <graphicData>
      <texPath>Things/Weapons/Nix_MachineGun</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>2.3</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>2000</MarketValue>
      <Mass>0</Mass>
      <AccuracyTouch>0.7</AccuracyTouch>
      <AccuracyShort>0.71</AccuracyShort>
      <AccuracyMedium>0.71</AccuracyMedium>
      <AccuracyLong>0.64</AccuracyLong>
      <RangedWeapon_Cooldown>2.0</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_NixMG_EXO</defaultProjectile>
        <warmupTime>1.5</warmupTime>
        <minRange>1.9</minRange>
        <range>31.9</range>
        <ticksBetweenBurstShots>5</ticksBetweenBurstShots>
        <burstShotCount>12</burstShotCount>
        <soundCast>Shot_TurretSniper</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>1.6</cooldownTime>
      </li>
    </tools>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_NixMG_EXO</defName>
    <label>large-caliber Bullet</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.6</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>18</damageAmountBase>
      <stoppingPower>1.5</stoppingPower>
      <speed>100</speed>
    </projectile>
  </ThingDef>

</Defs>