<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: global fire-control console -->
  <DNX_FireControlConsole.label>全局火控控制台</DNX_FireControlConsole.label>
  <!-- EN: A command console used to coordinate the defensive network. When operated by an assigned colonist, it improves the accuracy of Defensive Network Expanded turrets. -->
  <DNX_FireControlConsole.description>用于协调防御网络的指挥控制台。由指定殖民者操作时，可提高防御网络扩展炮塔的命中精度。</DNX_FireControlConsole.description>
  
  <!-- EN: multispectral fire-control recognition -->
  <DNX_MultispectralFireControlRecognition.label>多谱段火控识别装置</DNX_MultispectralFireControlRecognition.label>
  <!-- EN: A defensive network recognition node that fuses multispectral target data. While powered, supported DNX turrets ignore smoke interference when calculating firing solutions. -->
  <DNX_MultispectralFireControlRecognition.description>融合多光谱目标数据的防御网络识别节点。通电时，受支援的DNX炮塔在计算射击解算时会忽略烟雾干扰。</DNX_MultispectralFireControlRecognition.description>
  
</LanguageData>
