<LanguageData>
  
  <!-- EN: tactical marker tower -->
  <DNX_TacticalMarkerTower.label>战术标记塔</DNX_TacticalMarkerTower.label>
  <!-- EN: A fire-control marking tower that locks hostile targets, reveals invisible enemies, exposes weakpoints, and increases their chance to be hit. It is especially useful when building layered defensive positions. -->
  <DNX_TacticalMarkerTower.description>一种火控标记塔，可以锁定敌对目标、揭示隐形敌人、暴露弱点，并提高其被命中的概率。在构建层次化防御阵地时尤其有用。</DNX_TacticalMarkerTower.description>
  
  <!-- EN: Avenger twin autocannon turret -->
  <DNX_Turret_AvengerTwinCannon.label>“复仇者”双机炮炮塔</DNX_Turret_AvengerTwinCannon.label>
  <!-- EN: An experimental twin autocannon turret with medium-rate cannon fire and manually launched guided missiles. -->
  <DNX_Turret_AvengerTwinCannon.description>“复仇者”是一座定位明确的中口径双联速射炮塔，兼具持续火力、目标适应性与稳定的压制能力，是防御阵线中最可靠的中坚输出节点。两门机炮能够迅速处理成群步兵、轻型机械与中等装甲目标；当常规火力不足以终结高威胁单位时，炮塔还可发射两枚储备导弹，作为一次性重火力手段。不过导弹数量有限，重新装填也并不轻松——优秀的火控员通常会把它们留给真正值得复仇的目标。\n\n“复仇者从不记仇。”负责维护它的技师总是这样说。\n随后他指了指炮塔侧面密密麻麻的击毁标记：“但它的火控系统记得。”</DNX_Turret_AvengerTwinCannon.description>
  <!-- EN: autocannon ammunition -->
  <DNX_Turret_AvengerTwinCannon.comps.CompRefuelable-0.fuelGizmoLabel>自动炮弹药</DNX_Turret_AvengerTwinCannon.comps.CompRefuelable-0.fuelGizmoLabel>
  <!-- EN: autocannon ammunition -->
  <DNX_Turret_AvengerTwinCannon.comps.CompRefuelable-0.fuelLabel>自动炮弹药</DNX_Turret_AvengerTwinCannon.comps.CompRefuelable-0.fuelLabel>
  <!-- EN: autocannon ammunition depleted -->
  <DNX_Turret_AvengerTwinCannon.comps.CompRefuelable-0.outOfFuelMessage>自动炮弹药耗尽</DNX_Turret_AvengerTwinCannon.comps.CompRefuelable-0.outOfFuelMessage>
  <!-- EN: missile reserve -->
  <DNX_Turret_AvengerTwinCannon.comps.CompRefuelable-1.fuelGizmoLabel>导弹储备</DNX_Turret_AvengerTwinCannon.comps.CompRefuelable-1.fuelGizmoLabel>
  <!-- EN: missile reserve -->
  <DNX_Turret_AvengerTwinCannon.comps.CompRefuelable-1.fuelLabel>导弹储备</DNX_Turret_AvengerTwinCannon.comps.CompRefuelable-1.fuelLabel>
  <!-- EN: missile reserve depleted -->
  <DNX_Turret_AvengerTwinCannon.comps.CompRefuelable-1.outOfFuelMessage>导弹储备耗尽</DNX_Turret_AvengerTwinCannon.comps.CompRefuelable-1.outOfFuelMessage>
  <!-- EN: Manually select a target and launch a curved missile. -->
  <DNX_Turret_AvengerTwinCannon.comps.CompManualMissileLauncher.commandDesc>手动选择目标并发射曲线导弹。</DNX_Turret_AvengerTwinCannon.comps.CompManualMissileLauncher.commandDesc>
  <!-- EN: Launch missile -->
  <DNX_Turret_AvengerTwinCannon.comps.CompManualMissileLauncher.commandLabel>发射导弹</DNX_Turret_AvengerTwinCannon.comps.CompManualMissileLauncher.commandLabel>
  <!-- EN: missile reserve -->
  <DNX_Turret_AvengerTwinCannon.comps.CompManualMissileLauncher.refuelableFuelLabel>导弹储备</DNX_Turret_AvengerTwinCannon.comps.CompManualMissileLauncher.refuelableFuelLabel>
  
  <!-- EN: Flathead rocket turret -->
  <DNX_Turret_FlatheadRocketTurret.label>小平头火箭炮塔</DNX_Turret_FlatheadRocketTurret.label>
  <!-- EN: A compact 2x2 rocket turret that launches short salvos of high-explosive fly-overhead rockets against targets beyond close range. -->
  <DNX_Turret_FlatheadRocketTurret.description>“小平头”是防御网络早期技术体系中的简易火箭炮塔，以粗犷可靠的机械结构换取了较低的生产与维护门槛。它能够向中远距离目标连续发射四枚高爆火箭，对密集步兵、兽群及轻型机械集群形成有效的区域杀伤；但原始的制导装置和简陋的火控系统使其散布范围相当可观，既不适合攻击单个目标，也不应部署在友军前线过近的位置。“小平头”无法解决所有问题，但在殖民地尚未拥有精密火炮时，四枚落进敌群的火箭通常已经足够。</DNX_Turret_FlatheadRocketTurret.description>
  <!-- EN: Flathead rockets -->
  <DNX_Turret_FlatheadRocketTurret.comps.CompRefuelable.fuelGizmoLabel>小平头火箭</DNX_Turret_FlatheadRocketTurret.comps.CompRefuelable.fuelGizmoLabel>
  <!-- EN: Flathead rockets -->
  <DNX_Turret_FlatheadRocketTurret.comps.CompRefuelable.fuelLabel>小平头火箭</DNX_Turret_FlatheadRocketTurret.comps.CompRefuelable.fuelLabel>
  <!-- EN: Flathead rockets depleted -->
  <DNX_Turret_FlatheadRocketTurret.comps.CompRefuelable.outOfFuelMessage>小平头火箭已耗尽</DNX_Turret_FlatheadRocketTurret.comps.CompRefuelable.outOfFuelMessage>
  
  <!-- EN: Gemini gatling turret -->
  <DNX_Turret_GeminiGatling.label>“双子”加特林炮塔</DNX_Turret_GeminiGatling.label>
  <!-- EN: A twin gatling turret that pours dense rifle-caliber fire over a short period. -->
  <DNX_Turret_GeminiGatling.description>“双子座”加特林炮塔以极高射速和瞬间火力密度著称，能够在极短时间内向指定区域倾泻大量弹药，将冲锋中的敌人压制在掩体后，或直接撕碎缺乏重装甲保护的目标。</DNX_Turret_GeminiGatling.description>
  <!-- EN: gatling ammunition -->
  <DNX_Turret_GeminiGatling.comps.CompRefuelable.fuelGizmoLabel>加特林弹药</DNX_Turret_GeminiGatling.comps.CompRefuelable.fuelGizmoLabel>
  <!-- EN: gatling ammunition -->
  <DNX_Turret_GeminiGatling.comps.CompRefuelable.fuelLabel>加特林弹药</DNX_Turret_GeminiGatling.comps.CompRefuelable.fuelLabel>
  <!-- EN: gatling ammunition depleted -->
  <DNX_Turret_GeminiGatling.comps.CompRefuelable.outOfFuelMessage>加特林弹药耗尽</DNX_Turret_GeminiGatling.comps.CompRefuelable.outOfFuelMessage>
  
  <!-- EN: Sentinel HMG-4 armored machine gun turret -->
  <DNX_Turret_SentinelHMGFour.label>“哨兵”HMG-4装甲机枪炮塔</DNX_Turret_SentinelHMGFour.label>
  <!-- EN: A heavily armored machine gun turret with exceptional durability and steady close-to-medium suppression. -->
  <DNX_Turret_SentinelHMGFour.description>“哨兵”HMG-4是一种以结构可靠性和战场生存能力为核心设计的重机枪炮塔。它的输出并不突出，面对重装甲目标时尤其乏力，但厚重的装甲外壳、冗余驱动机构与简单坚固的内部结构，使其能够在炮火中持续运作。哨兵通常被部署在阵线前沿、通道入口或其他容易遭到集中攻击的位置；它未必能迅速消灭敌人，却能为后方火力争取最宝贵的时间。</DNX_Turret_SentinelHMGFour.description>
  <!-- EN: HMG ammunition -->
  <DNX_Turret_SentinelHMGFour.comps.CompRefuelable.fuelGizmoLabel>重机枪弹药</DNX_Turret_SentinelHMGFour.comps.CompRefuelable.fuelGizmoLabel>
  <!-- EN: HMG ammunition -->
  <DNX_Turret_SentinelHMGFour.comps.CompRefuelable.fuelLabel>重机枪弹药</DNX_Turret_SentinelHMGFour.comps.CompRefuelable.fuelLabel>
  <!-- EN: HMG ammunition depleted -->
  <DNX_Turret_SentinelHMGFour.comps.CompRefuelable.outOfFuelMessage>重机枪弹药耗尽</DNX_Turret_SentinelHMGFour.comps.CompRefuelable.outOfFuelMessage>
  
  <!-- EN: Shower grenade support system -->
  <DNX_Turret_ShowerGrenadeSupport.label>“暴雨”榴弹支援系统</DNX_Turret_ShowerGrenadeSupport.label>
  <!-- EN: An experimental twin grenade support turret that fires arcing HE grenades and can manually launch smoke, EMP, and stun utility grenades. -->
  <DNX_Turret_ShowerGrenadeSupport.description>“暴雨”是一座实验性的多用途榴弹支援炮塔，能够持续向目标区域投送高爆榴弹，为防线提供稳定的范围压制。除自动使用的常规弹药外，还可手动选择烟雾、电磁脉冲或眩晕榴弹，用于遮蔽友军、瘫痪机械单位和打断敌方冲锋。它的直接杀伤能力并不算顶尖，弹道也需要一定飞行时间，但在复杂战况中，“暴雨”往往比单纯增加一门火炮更有价值。</DNX_Turret_ShowerGrenadeSupport.description>
  <!-- EN: grenade reserve -->
  <DNX_Turret_ShowerGrenadeSupport.comps.CompRefuelable.fuelGizmoLabel>榴弹储备</DNX_Turret_ShowerGrenadeSupport.comps.CompRefuelable.fuelGizmoLabel>
  <!-- EN: grenade reserve -->
  <DNX_Turret_ShowerGrenadeSupport.comps.CompRefuelable.fuelLabel>榴弹储备</DNX_Turret_ShowerGrenadeSupport.comps.CompRefuelable.fuelLabel>
  <!-- EN: grenade reserve depleted -->
  <DNX_Turret_ShowerGrenadeSupport.comps.CompRefuelable.outOfFuelMessage>榴弹储备已耗尽</DNX_Turret_ShowerGrenadeSupport.comps.CompRefuelable.outOfFuelMessage>
  <!-- EN: grenade reserve -->
  <DNX_Turret_ShowerGrenadeSupport.comps.CompSpecialGrenadeLauncher.refuelableFuelLabel>榴弹储备</DNX_Turret_ShowerGrenadeSupport.comps.CompSpecialGrenadeLauncher.refuelableFuelLabel>
  
  <!-- EN: Vanguard 20mm suppressive cannon turret -->
  <DNX_Turret_Vanguard20mmSuppressiveCannon.label>“先锋”20mm压制炮塔</DNX_Turret_Vanguard20mmSuppressiveCannon.label>
  <!-- EN: A 20mm suppressive cannon turret with an escalating efficiency cycle. Sustained fire accelerates the weapon, but pushing it too far overheats the system and forces a short shutdown. -->
  <DNX_Turret_Vanguard20mmSuppressiveCannon.description>“先锋”是一座采用递增效率循环机构的20毫米压制炮塔：持续射击会使供弹、炮管驱动与火控修正逐步进入高效状态，射速和压制能力随之迅速攀升。然而，过度推高循环也会令散热系统达到极限，迫使炮塔强制停机冷却，因此操作员必须在火力峰值与系统稳定性之间作出取舍。该平台通常使用燃烧空尖弹，对缺乏防护的人员会造成极其严重的组织破坏，尤其在对付部落武装时效果过于残酷，也因此成为防御网络中名声最差的武器之一。</DNX_Turret_Vanguard20mmSuppressiveCannon.description>
  <!-- EN: 20mm suppressive ammunition -->
  <DNX_Turret_Vanguard20mmSuppressiveCannon.comps.CompRefuelable.fuelGizmoLabel>20mm压制弹药</DNX_Turret_Vanguard20mmSuppressiveCannon.comps.CompRefuelable.fuelGizmoLabel>
  <!-- EN: 20mm suppressive ammunition -->
  <DNX_Turret_Vanguard20mmSuppressiveCannon.comps.CompRefuelable.fuelLabel>20mm压制弹药</DNX_Turret_Vanguard20mmSuppressiveCannon.comps.CompRefuelable.fuelLabel>
  <!-- EN: 20mm suppressive ammunition depleted -->
  <DNX_Turret_Vanguard20mmSuppressiveCannon.comps.CompRefuelable.outOfFuelMessage>20mm压制弹药耗尽</DNX_Turret_Vanguard20mmSuppressiveCannon.comps.CompRefuelable.outOfFuelMessage>
  
  <!-- EN: Watcher long-range precision turret -->
  <DNX_Turret_WatcherLongRangePrecision.label>“守望者”远程精确炮塔</DNX_Turret_WatcherLongRangePrecision.label>
  <!-- EN: The Watcher is an experimental smart-projectile turret at the edge of current weapons technology, built to engage distant, high-value, and high-threat targets. After a brief analysis cycle, it fires three high-precision smart rounds in rapid succession, delivering a fast and concentrated pinpoint strike. Even moving targets or enemies relying on cover struggle to fully escape its ballistic correction. The tradeoff is just as clear: its specialized ammunition is expensive, and the complex guidance mechanisms require advanced components for upkeep, so the Watcher is poorly suited to wasting firepower on ordinary enemies.\n\nProcurement once asked why every shot had to be a three-round burst.\nThe engineer replied, "The first confirms the prediction, the second corrects the error, and the third makes sure the first two do not look wasted."\nAfter that, procurement requested that all ammunition unit costs be removed from the report. -->
  <DNX_Turret_WatcherLongRangePrecision.description>“守望者”是一座处于科技前沿的实验型智能射弹炮塔，专门用于处理远距离、高价值与高威胁目标。它会在完成短暂分析后连续发射三枚高精度智能射弹，对目标实施快速而集中的定点打击，即使敌人处于移动状态或依托掩体，也很难完全摆脱其弹道修正。代价同样明显：专用弹药造价高昂，复杂的制导机构还需要消耗高级零部件进行维护，因此“守望者”并不适合浪费火力清理普通敌人。\n\n采购部门曾询问，为什么每次射击必须连发三枚。\n工程师回答：“第一枚确认预测，第二枚修正误差，第三枚负责让前两枚不显得浪费。”\n此后，采购部门要求在报告中删除所有弹药单价。</DNX_Turret_WatcherLongRangePrecision.description>
  <DNX_Turret_WatcherLongRangePrecision.comps.CompRefuelable.fuelGizmoLabel>守望者精确弹药</DNX_Turret_WatcherLongRangePrecision.comps.CompRefuelable.fuelGizmoLabel>
  <DNX_Turret_WatcherLongRangePrecision.comps.CompRefuelable.fuelLabel>守望者精确弹药</DNX_Turret_WatcherLongRangePrecision.comps.CompRefuelable.fuelLabel>
  <DNX_Turret_WatcherLongRangePrecision.comps.CompRefuelable.outOfFuelMessage>守望者精确弹药已耗尽</DNX_Turret_WatcherLongRangePrecision.comps.CompRefuelable.outOfFuelMessage>
  
</LanguageData>
