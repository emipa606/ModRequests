<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: gun-launched missile ammo box -->
  <DNX_GunLaunchedMissileAmmoBox.label>炮射导弹弹药箱</DNX_GunLaunchedMissileAmmoBox.label>
  <!-- EN: A specialized missile feed crate for Hammer 120mm turrets. When linked, nearby Hammer turrets replace their standard 120mm shells with gun-launched guided missiles while this box has ammunition. -->
  <DNX_GunLaunchedMissileAmmoBox.description>供“重锤”120mm炮塔使用的专用导弹供给箱。联动后，只要箱内仍有弹药，附近的“重锤”炮塔就会以制导炮射导弹替代标准120mm炮弹。</DNX_GunLaunchedMissileAmmoBox.description>
  <!-- EN: gun-launched missiles -->
  <DNX_GunLaunchedMissileAmmoBox.comps.CompRefuelable.fuelGizmoLabel>炮射导弹</DNX_GunLaunchedMissileAmmoBox.comps.CompRefuelable.fuelGizmoLabel>
  <!-- EN: gun-launched missiles -->
  <DNX_GunLaunchedMissileAmmoBox.comps.CompRefuelable.fuelLabel>炮射导弹</DNX_GunLaunchedMissileAmmoBox.comps.CompRefuelable.fuelLabel>
  <!-- EN: gun-launched missiles depleted -->
  <DNX_GunLaunchedMissileAmmoBox.comps.CompRefuelable.outOfFuelMessage>炮射导弹已耗尽</DNX_GunLaunchedMissileAmmoBox.comps.CompRefuelable.outOfFuelMessage>
  
  <!-- EN: high-speed belt feeder -->
  <DNX_HighSpeedBeltFeeder.label>高速弹链供弹器</DNX_HighSpeedBeltFeeder.label>
  <!-- EN: A compact ammunition feeder for Gyrfalcon-M 20mm composite turrets. It links to nearby turrets, supplies 20mm ammunition, and can switch between armor-piercing, charge, and high-explosive belts. -->
  <DNX_HighSpeedBeltFeeder.description>供“矛隼-M”20mm复合炮塔使用的小型供弹装置。它会与附近炮塔联动，供应20mm弹药，并可在穿甲、充能和高爆弹链之间切换。</DNX_HighSpeedBeltFeeder.description>
  <!-- EN: 20mm belt ammunition -->
  <DNX_HighSpeedBeltFeeder.comps.CompRefuelable.fuelGizmoLabel>20mm弹链弹药</DNX_HighSpeedBeltFeeder.comps.CompRefuelable.fuelGizmoLabel>
  <!-- EN: 20mm belt ammunition -->
  <DNX_HighSpeedBeltFeeder.comps.CompRefuelable.fuelLabel>20mm弹链弹药</DNX_HighSpeedBeltFeeder.comps.CompRefuelable.fuelLabel>
  <!-- EN: 20mm belt ammunition depleted -->
  <DNX_HighSpeedBeltFeeder.comps.CompRefuelable.outOfFuelMessage>20mm弹链弹药已耗尽</DNX_HighSpeedBeltFeeder.comps.CompRefuelable.outOfFuelMessage>
  
</LanguageData>
