  <!-- EN: Manually select a target and launch a high-penetration anti-armor missile. -->
  <DNX_Turret_GyrfalconM20mmComposite.comps.CompManualMissileLauncher.commandDesc>手动选择目标并发射高侵彻反装甲导弹。</DNX_Turret_GyrfalconM20mmComposite.comps.CompManualMissileLauncher.commandDesc>
  <!-- EN: Launch AP missile -->
  <DNX_Turret_GyrfalconM20mmComposite.comps.CompManualMissileLauncher.commandLabel>发射穿甲导弹</DNX_Turret_GyrfalconM20mmComposite.comps.CompManualMissileLauncher.commandLabel>
  <!-- EN: AP missile reserve -->
