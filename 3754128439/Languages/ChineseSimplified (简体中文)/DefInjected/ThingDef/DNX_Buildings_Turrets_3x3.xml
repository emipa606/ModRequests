  <!-- EN: AP missile reserve -->
  <DNX_Turret_GyrfalconM20mmComposite.comps.CompRefuelable-1.fuelGizmoLabel>穿甲导弹储备</DNX_Turret_GyrfalconM20mmComposite.comps.CompRefuelable-1.fuelGizmoLabel>
  <!-- EN: AP missile reserve -->
