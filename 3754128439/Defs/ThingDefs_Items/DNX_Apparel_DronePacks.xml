<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="ApparelBase">
    <defName>DNX_Apparel_HunterDronePack</defName>
    <label>Hunter drone pack</label>
    <description>A compact tactical deployment pack carrying prepared Hunter combat drones. The wearer can launch one-way drones directly into the battlefield.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/DNX_HunterDronePack/DNX_HunterDronePack</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <generateAllowChance>0</generateAllowChance>
    <techLevel>Industrial</techLevel>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <Plasteel>20</Plasteel>
    </costList>
    <statBases>
      <WorkToMake>48000</WorkToMake>
      <MaxHitPoints>180</MaxHitPoints>
      <Mass>4.2</Mass>
      <Flammability>0.10</Flammability>
      <EquipDelay>3.5</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.3</MoveSpeed>
    </equippedStatOffsets>
    <apparel>
      <scoreOffset>3</scoreOffset>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups>
        <li>Torso</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <developmentalStageFilter>Adult</developmentalStageFilter>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/DNX_HunterDronePack/DNX_HunterDronePack</wornGraphicPath>
      <wornGraphicData>
        <renderUtilityAsPack>true</renderUtilityAsPack>
        <north>
          <offset>(0,-0.10)</offset>
        </north>
        <south>
          <offset>(0,0.18)</offset>
        </south>
        <east>
          <offset>(-0.38,-0.05)</offset>
        </east>
        <west>
          <offset>(0.38,-0.05)</offset>
        </west>
        <male>
          <scale>(0.72,0.72)</scale>
        </male>
        <female>
          <scale>(0.72,0.72)</scale>
        </female>
        <thin>
          <scale>(0.68,0.68)</scale>
        </thin>
        <hulk>
          <scale>(0.88,0.88)</scale>
        </hulk>
        <fat>
          <scale>(0.82,0.82)</scale>
        </fat>
      </wornGraphicData>
    </apparel>
    <comps>
      <li Class="CompProperties_ApparelReloadable">
        <maxCharges>2</maxCharges>
        <ammoDef>ComponentIndustrial</ammoDef>
        <ammoCountPerCharge>6</ammoCountPerCharge>
        <baseReloadTicks>90</baseReloadTicks>
        <soundReload>Standard_Reload</soundReload>
        <hotKey>Misc5</hotKey>
        <chargeNoun>prepared drone</chargeNoun>
        <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
      </li>
      <li Class="DNX.CompProperties_ApparelDronePack">
        <droneDef>DNX_ExperimentalCombatDrone</droneDef>
        <droneDefName>DNX_ExperimentalCombatDrone</droneDefName>
        <launchAnimationDef>DNX_ExperimentalCombatDroneLaunch</launchAnimationDef>
        <launchAnimationDefName>DNX_ExperimentalCombatDroneLaunch</launchAnimationDefName>
        <maxActiveDrones>2</maxActiveDrones>
        <autoDeployRadius>28</autoDeployRadius>
        <autoDeployScanIntervalTicks>180</autoDeployScanIntervalTicks>
        <autoDeployForNonPlayerWearers>false</autoDeployForNonPlayerWearers>
      </li>
    </comps>
    <researchPrerequisites>
      <li>DNX_LowAltitudeAutonomousNavigationTheory</li>
    </researchPrerequisites>
    <allowedArchonexusCount>1</allowedArchonexusCount>
  </ThingDef>

</Defs>
