<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="ApparelBase">
    <defName>DNX_Apparel_SynchronizedGunDroneHarness</defName>
    <label>Companion Attack Drone pack</label>
    <description>A squad-portable cooperative attack drone system. Once deployed, it follows its operator in flight and coordinates its attacks according to their movement, line of sight, and tactical orders. Its weapon is far from enough to decide a battle on its own, but a second firing angle, sustained suppression, and immediate reconnaissance are enough to make any enemy behind cover reconsider their position.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/DNX_SynchronizedGunDroneHarness/DNX_SynchronizedGunDroneHarness</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <generateAllowChance>0</generateAllowChance>
    <techLevel>Industrial</techLevel>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <Plasteel>20</Plasteel>
    </costList>
    <statBases>
      <WorkToMake>48000</WorkToMake>
      <MaxHitPoints>170</MaxHitPoints>
      <Mass>5.2</Mass>
      <Flammability>0.10</Flammability>
      <EquipDelay>3.8</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.22</MoveSpeed>
    </equippedStatOffsets>
    <apparel>
      <scoreOffset>3</scoreOffset>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <careIfWornByCorpse>false</careIfWornByCorpse>
      <careIfDamaged>false</careIfDamaged>
      <wearPerDay>0</wearPerDay>
      <bodyPartGroups>
        <li>Torso</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <developmentalStageFilter>Adult</developmentalStageFilter>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/DNX_SynchronizedGunDroneHarness/DNX_SynchronizedGunDroneHarness</wornGraphicPath>
      <wornGraphicData>
        <renderUtilityAsPack>true</renderUtilityAsPack>
        <north>
          <offset>(0,-0.10)</offset>
        </north>
        <south>
          <offset>(0,0.18)</offset>
        </south>
        <east>
          <offset>(-0.38,-0.05)</offset>
        </east>
        <west>
          <offset>(0.38,-0.05)</offset>
        </west>
        <male>
          <scale>(0.72,0.72)</scale>
        </male>
        <female>
          <scale>(0.72,0.72)</scale>
        </female>
        <thin>
          <scale>(0.68,0.68)</scale>
        </thin>
        <hulk>
          <scale>(0.88,0.88)</scale>
        </hulk>
        <fat>
          <scale>(0.82,0.82)</scale>
        </fat>
      </wornGraphicData>
    </apparel>
    <comps>
      <li Class="DNX.CompProperties_SynchronizedDroneCarrier">
        <droneDef>DNX_SynchronizedGunDrone</droneDef>
        <droneDefName>DNX_SynchronizedGunDrone</droneDefName>
        <droneCount>2</droneCount>
        <sideOffset>1.05</sideOffset>
        <rearOffset>0.15</rearOffset>
        <activeByDefault>true</activeByDefault>
        <autoActivateForNonPlayerWearers>false</autoActivateForNonPlayerWearers>
        <sortieRadius>24</sortieRadius>
      </li>
      <li Class="DNX.CompProperties_SynchronizedDroneCommand">
        <commandRange>30</commandRange>
      </li>
    </comps>
    <researchPrerequisites>
      <li>DNX_LowAltitudeAutonomousNavigationTheory</li>
    </researchPrerequisites>
    <allowedArchonexusCount>1</allowedArchonexusCount>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>DNX_SynchronizedGunDrone</defName>
    <label>Companion Attack Drone</label>
    <description>A compact cooperative attack drone carried by an infantry operator. It can hold formation beside its host or sortie to a commanded position, adding a second firing angle and immediate reconnaissance.</description>
    <thingClass>DNX.Thing_SynchronizedGunDrone</thingClass>
    <category>Building</category>
    <drawerType>RealtimeOnly</drawerType>
    <tickerType>Normal</tickerType>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <selectable>false</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <isSaveable>true</isSaveable>
    <useHitPoints>true</useHitPoints>
    <drawGUIOverlay>false</drawGUIOverlay>
    <passability>PassThroughOnly</passability>
    <fillPercent>0</fillPercent>
    <pathCost>0</pathCost>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <graphicData>
      <texPath>Things/Building/Security/DNX_SynchronizedGunDrone</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(0.92,0.92)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>55</MaxHitPoints>
      <Flammability>0</Flammability>
      <Mass>1.8</Mass>
    </statBases>
    <comps>
      <li Class="DNX.CompProperties_PointDefenseDroneTarget"/>
    </comps>
    <building>
      <claimable>false</claimable>
    </building>
    <modExtensions>
      <li Class="DNX.SynchronizedGunDroneExtension">
        <weaponDef>DNX_Gun_SynchronizedDroneLMG</weaponDef>
        <weaponDefName>DNX_Gun_SynchronizedDroneLMG</weaponDefName>
        <fallbackWeaponDefName>DNX_Gun_ExperimentalDroneLMG</fallbackWeaponDefName>
        <hoverDustMote>DNX_Mote_ExperimentalDroneDust</hoverDustMote>
        <hoverDustMoteName>DNX_Mote_ExperimentalDroneDust</hoverDustMoteName>
        <searchIntervalTicks>45</searchIntervalTicks>
        <fireCooldownTicks>120</fireCooldownTicks>
        <searchRadius>24</searchRadius>
        <moveSpeedPerTick>0.1333</moveSpeedPerTick>
        <accelerationPerTick>0.008</accelerationPerTick>
        <decelerationPerTick>0.012</decelerationPerTick>
        <teleportDistance>9</teleportDistance>
        <positionDeadZone>0.05</positionDeadZone>
        <turnSpeedDegreesPerTick>8</turnSpeedDegreesPerTick>
        <drawScale>0.92</drawScale>
        <hoverBobFrequency>0.11</hoverBobFrequency>
        <hoverBobAmplitude>0.055</hoverBobAmplitude>
        <hoverDustIntervalTicks>18</hoverDustIntervalTicks>
        <targetBuildings>true</targetBuildings>
        <maxTrailSegments>18</maxTrailSegments>
        <trailLifetimeTicks>26</trailLifetimeTicks>
        <trailWidth>0.12</trailWidth>
        <trailAlpha>0.38</trailAlpha>
      </li>
    </modExtensions>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
  </ThingDef>

  <ThingDef ParentName="BaseWeaponTurret">
    <defName>DNX_Gun_SynchronizedDroneLMG</defName>
    <label>companion drone light machine gun</label>
    <description>A very compact light machine gun carried by a Companion Attack Drone.</description>
    <graphicData>
      <texPath>Things/Building/Security/DNX_LightMachineGunTurret_Top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.70</AccuracyTouch>
      <AccuracyShort>0.62</AccuracyShort>
      <AccuracyMedium>0.38</AccuracyMedium>
      <AccuracyLong>0.18</AccuracyLong>
      <RangedWeapon_Cooldown>3.5</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>1</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>DNX_Bullet_LightMachineGun</defaultProjectile>
        <warmupTime>0.35</warmupTime>
        <range>24</range>
        <burstShotCount>4</burstShotCount>
        <ticksBetweenBurstShots>4</ticksBetweenBurstShots>
        <soundCast>GunShotA</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>4</muzzleFlashScale>
      </li>
    </verbs>
  </ThingDef>

</Defs>
