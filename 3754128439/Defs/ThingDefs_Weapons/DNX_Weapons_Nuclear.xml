<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="SkyfallerBase">
    <defName>DNX_TacticalNuke_Leaving</defName>
    <label>tactical nuclear missile</label>
    <thingClass>DNX.Skyfaller_TacticalNukeLeaving</thingClass>
    <size>(1,1)</size>
    <useHitPoints>false</useHitPoints>
    <graphicData>
      <texPath>Things/Building/Security/DNX_TacticalNuclearMissile</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>(6.5,6.5)</drawSize>
    </graphicData>
    <skyfaller>
      <movementType>Decelerate</movementType>
      <reversed>true</reversed>
      <ticksToImpactRange>
        <min>-55</min>
        <max>-35</max>
      </ticksToImpactRange>
      <speedCurve>
        <points>
          <li>0,0</li>
          <li>0.25,0.08</li>
          <li>0.5,0.25</li>
          <li>0.75,0.6</li>
          <li>1,1</li>
        </points>
      </speedCurve>
    </skyfaller>
  </ThingDef>

  <ThingDef ParentName="SkyfallerBase">
    <defName>DNX_TacticalNuke_Arriving</defName>
    <label>tactical nuclear missile</label>
    <thingClass>DNX.Skyfaller_TacticalNukeIncoming</thingClass>
    <size>(1,1)</size>
    <useHitPoints>false</useHitPoints>
    <graphicData>
      <texPath>Things/Building/Security/DNX_TacticalNuclearMissile</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>(6.5,6.5)</drawSize>
    </graphicData>
    <skyfaller>
      <shadowSize>(4,4)</shadowSize>
      <speed>0.55</speed>
      <movementType>Accelerate</movementType>
      <ticksToImpactRange>240~240</ticksToImpactRange>
    </skyfaller>
  </ThingDef>

</Defs>
