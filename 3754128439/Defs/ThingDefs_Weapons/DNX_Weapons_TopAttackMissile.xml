<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BaseBullet">
    <defName>DNX_Projectile_VerticalTopAttackMissile</defName>
    <label>vertical top-attack missile</label>
    <thingClass>DNX.Projectile_TopAttackMissile</thingClass>
    <graphicData>
      <texPath>Things/Projectile/DNX_TopAttackMissile</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
      <drawSize>(3.0,3.0)</drawSize>
    </graphicData>
    <drawOffscreen>true</drawOffscreen>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>160</damageAmountBase>
      <armorPenetrationBase>1.2</armorPenetrationBase>
      <stoppingPower>1.0</stoppingPower>
      <speed>40</speed>
      <flyOverhead>true</flyOverhead>
      <explosionRadius>1.7</explosionRadius>
      <soundExplode>MortarBomb_Explode</soundExplode>
      <explosionDamageFalloff>true</explosionDamageFalloff>
      <shadowSize>0.8</shadowSize>
    </projectile>
    <modExtensions>
      <li Class="DNX.TopAttackMissileExtension">
        <coldLaunchDistance>4.5</coldLaunchDistance>
        <coldLaunchTicks>38</coldLaunchTicks>
        <terminalDiveTicks>30</terminalDiveTicks>
        <preImpactNorthDistance>7.7</preImpactNorthDistance>
        <apexHeight>4.6</apexHeight>
        <cruiseArcHeight>6.4</cruiseArcHeight>
        <terminalStartHeight>4.4</terminalStartHeight>
        <cruiseSpeed>42</cruiseSpeed>
        <smokeIntervalTicks>4</smokeIntervalTicks>
        <smokeSize>0.75</smokeSize>
        <trailLifetimeTicks>16</trailLifetimeTicks>
        <trailWidth>0.22</trailWidth>
        <trailRed>1</trailRed>
        <trailGreen>1</trailGreen>
        <trailBlue>1</trailBlue>
        <trailAlpha>0.82</trailAlpha>
        <homingEnabled>true</homingEnabled>
        <homingUpdateIntervalTicks>2</homingUpdateIntervalTicks>
        <homingTurnRate>0.35</homingTurnRate>
        <loseTargetOnDowned>false</loseTargetOnDowned>
        <targetMarkMoteDefName>DNX_Mote_GhoulMarked</targetMarkMoteDefName>
        <targetMarkIntervalTicks>90</targetMarkIntervalTicks>
        <targetMarkScale>1</targetMarkScale>
        <ejectSoundDefName>DNX_VerticalMissileSilo_ColdLaunch</ejectSoundDefName>
        <igniteSoundDefName>DNX_Uplink_Missile</igniteSoundDefName>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
