<Defs>

  <ThingDef ParentName="BaseBullet">
    <defName>DNX_Projectile_HunterKillerEntryRocket</defName>
    <label>Hunter-Killer entry rocket</label>
    <thingClass>DNX.Projectile_HunterKillerTrailExplosive</thingClass>
    <graphicData>
      <texPath>Things/Projectile/mls16_p</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.05,1.05)</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>125</damageAmountBase>
      <armorPenetrationBase>0.70</armorPenetrationBase>
      <stoppingPower>1.0</stoppingPower>
      <speed>92</speed>
      <flyOverhead>true</flyOverhead>
      <explosionRadius>2.8</explosionRadius>
      <soundExplode>MortarBomb_Explode</soundExplode>
      <explosionDamageFalloff>true</explosionDamageFalloff>
    </projectile>
    <modExtensions>
      <li Class="DNX.TrailProjectileExtension">
        <trailWidth>0.16</trailWidth>
        <trailLifetimeTicks>16</trailLifetimeTicks>
        <trailAlpha>0.82</trailAlpha>
        <trailRed>1</trailRed>
        <trailGreen>1</trailGreen>
        <trailBlue>1</trailBlue>
      </li>
    </modExtensions>
  </ThingDef>

