  <ThingDef ParentName="ShuttleSkyfallerBase">
    <defName>DNX_HAD09Ghoul_Leaving</defName>
    <label>HAD-09 Ghoul</label>
    <description>The HAD-09 "Ghoul" is a high-altitude unmanned bomber designed for deep strikes and critical-target destruction. It performs rapid attack runs with precision micro-missiles or a 500kg-class aerial bomb, then returns to remote airspace for resupply, maintenance, and route reprogramming.</description>
    <thingClass>DNX.Skyfaller_GhoulBomberLeaving</thingClass>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Building/Security/DNX_HAD09Ghoul</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(5,5)</drawSize>
    </graphicData>
    <size>(5,5)</size>
    <skyfaller>
      <reversed>true</reversed>
      <anticipationSound>Shuttle_Leaving</anticipationSound>
      <anticipationSoundTicks>-10</anticipationSoundTicks>
      <ticksToImpactRange>-40~-15</ticksToImpactRange>
      <moteSpawnTime>0.05</moteSpawnTime>
      <shadow>Things/Skyfaller/SkyfallerShadowRectangle</shadow>
      <shadowSize>(5.5,5.5)</shadowSize>
      <motesPerCell>1</motesPerCell>
      <rotationCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.15,10)</li>
          <li>(0.5,-5)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0,0)</li>
          <li>(0.08,2)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0,0.2)</li>
          <li>(0.4,0.7)</li>
        </points>
      </speedCurve>
    </skyfaller>
  </ThingDef>

