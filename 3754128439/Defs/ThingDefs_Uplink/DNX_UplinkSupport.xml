<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>DNX_UplinkSupportConsole</defName>
    <label>uplink support console</label>
    <description>An experimental direct fire-control uplink. Hack the control terminal to authorize one support call. Activating it lets the player guide remote support fire through a centered reticle interface. The system re-locks after use and can be hacked again after ten days.</description>
    <thingClass>DNX.Building_UplinkSupportConsole</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>70</pathCost>
    <fillPercent>0.55</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <selectable>true</selectable>
    <size>(3,3)</size>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsSecurity</li>
    </thingCategories>
    <designationCategory>Security</designationCategory>
    <uiIconPath>Things/Building/Misc/DNX_FireControlConsole</uiIconPath>
    <graphicData>
      <texPath>Things/Building/Misc/DNX_FireControlConsole</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <statBases>
      <MaxHitPoints>620</MaxHitPoints>
      <WorkToBuild>12000</WorkToBuild>
      <Mass>160</Mass>
      <Flammability>0.35</Flammability>
      <Beauty>-10</Beauty>
    </statBases>
    <costList>
      <AIPersonaCore>1</AIPersonaCore>
      <Steel>200</Steel>
      <Plasteel>200</Plasteel>
      <ComponentIndustrial>10</ComponentIndustrial>
      <ComponentSpacer>10</ComponentSpacer>
    </costList>
    <researchPrerequisites>
      <li>DNX_UplinkSupport</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>1200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Hackable">
        <defence>100000</defence>
        <effectHacking>HackingTerminal</effectHacking>
        <lockoutDurationHoursRange>2~3</lockoutDurationHoursRange>
        <notHackedInspectString>Hack to authorize one uplink support call.</notHackedInspectString>
        <hackedInspectString>Uplink support call authorized.</hackedInspectString>
        <hackedMessage>{HACKER_labelShort} has authorized {SUBJECT_labelNoParenthesisDef}.</hackedMessage>
        <showProgressAfterHackCompletion>false</showProgressAfterHackCompletion>
        <intellectualSkillPrerequisite>18</intellectualSkillPrerequisite>
      </li>
    </comps>
    <modExtensions>
      <li Class="DNX.UplinkSupportExtension">
        <reticleTexPath>UI/DNX/Uplink/DNX_UplinkReticle</reticleTexPath>
        <rotatingReticleTexPath>UI/DNX/Uplink/DNX_UplinkRotatingReticle</rotatingReticleTexPath>
        <rotatingReticleSize>430</rotatingReticleSize>
        <rotatingReticleDegreesPerSecond>10</rotatingReticleDegreesPerSecond>
        <rotatingReticleAlpha>0.92</rotatingReticleAlpha>
        <rotatingReticleOffsetX>420</rotatingReticleOffsetX>
        <rotatingReticleOffsetY>220</rotatingReticleOffsetY>
        <leftCannonTexPath>UI/DNX/Uplink/DNX_UplinkCannon_Left</leftCannonTexPath>
        <fullscreenGuiTexPath>UI/DNX/Uplink/DNX_UplinkFullscreenGUI</fullscreenGuiTexPath>
        <fullscreenGuiFadeTicks>36</fullscreenGuiFadeTicks>
        <fullscreenGuiAlpha>1</fullscreenGuiAlpha>
        <reticleSize>230</reticleSize>
        <reticleRecoilScale>0.24</reticleRecoilScale>
        <reticleShakePixels>10</reticleShakePixels>
        <reticleRecoilTicks>12</reticleRecoilTicks>
        <leftCannonX>-64</leftCannonX>
        <leftCannonYPercent>0.25</leftCannonYPercent>
        <leftCannonWidth>560</leftCannonWidth>
        <leftCannonHeight>760</leftCannonHeight>
        <rightCannonRightMargin>-64</rightCannonRightMargin>
        <rightCannonYPercent>0.25</rightCannonYPercent>
        <rightCannonWidth>560</rightCannonWidth>
        <rightCannonHeight>760</rightCannonHeight>
        <cannonSlideTicks>42</cannonSlideTicks>
        <cannonSlideOvershootPixels>96</cannonSlideOvershootPixels>
        <cannonRecoilTicks>10</cannonRecoilTicks>
        <cannonShakePixels>8</cannonShakePixels>
        <cannonRecoilPixels>22</cannonRecoilPixels>
        <muzzleFlashTexPaths>
          <li>UI/DNX/Uplink/DNX_UplinkMuzzleFlash01</li>
          <li>UI/DNX/Uplink/DNX_UplinkMuzzleFlash02</li>
          <li>UI/DNX/Uplink/DNX_UplinkMuzzleFlash03</li>
        </muzzleFlashTexPaths>
        <muzzleFlashTicks>5</muzzleFlashTicks>
        <muzzleFlashAlpha>1</muzzleFlashAlpha>
        <burstCount>4</burstCount>
        <burstIntervalTicks>5</burstIntervalTicks>
        <fireCooldownTicks>54</fireCooldownTicks>
        <maxAmmo>500</maxAmmo>
        <spreadRadius>2.4</spreadRadius>
        <blastRadius>1.35</blastRadius>
        <damageAmount>140</damageAmount>
        <armorPenetration>1.32</armorPenetration>
        <missileSkyfallerDef>DNX_UplinkSupportMissile_Incoming</missileSkyfallerDef>
        <missileMarkMoteDef>DNX_Mote_GhoulMarked</missileMarkMoteDef>
        <missileCooldownTicks>600</missileCooldownTicks>
        <missileTargetRadius>10</missileTargetRadius>
        <missileMaxTargets>10</missileMaxTargets>
        <cannonFireSoundDef>DNX_Uplink_CannonFiring</cannonFireSoundDef>
        <targetLockedSoundDef>DNX_Uplink_TargetLocked</targetLockedSoundDef>
        <missileLaunchSoundDef>DNX_Uplink_Missile</missileLaunchSoundDef>
        <missileLaunchSoundCount>4</missileLaunchSoundCount>
        <missileLaunchSoundIntervalTicks>8</missileLaunchSoundIntervalTicks>
        <callCooldownTicks>600000</callCooldownTicks>
        <cameraMoveSpeedFactor>0.3</cameraMoveSpeedFactor>
      </li>
    </modExtensions>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <constructEffect>ConstructMetal</constructEffect>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>DNX_ShieldJammer</defName>
    <label>shield jammer</label>
    <description>An experimental electronic-warfare device. It projects a temporary disruption field over a selected area, repeatedly collapsing shield systems and marking suppressed targets with EMP particles.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>70</pathCost>
    <fillPercent>0.55</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <selectable>true</selectable>
    <size>(3,3)</size>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsSecurity</li>
    </thingCategories>
    <uiIconPath>Things/Building/Misc/DNX_FireControlConsole</uiIconPath>
    <graphicData>
      <texPath>Things/Building/Misc/DNX_FireControlConsole</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <statBases>
      <MaxHitPoints>520</MaxHitPoints>
      <WorkToBuild>9000</WorkToBuild>
      <Mass>130</Mass>
      <Flammability>0.35</Flammability>
      <Beauty>-10</Beauty>
    </statBases>
    <costList>
      <Steel>180</Steel>
      <Plasteel>120</Plasteel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <ComponentSpacer>6</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>900</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="DNX.CompProperties_ShieldJammer">
        <radius>10</radius>
        <durationTicks>600</durationTicks>
        <cooldownTicks>1800</cooldownTicks>
        <pulseIntervalTicks>30</pulseIntervalTicks>
        <fleckIntervalTicks>30</fleckIntervalTicks>
        <shieldSuppressionTicks>600</shieldSuppressionTicks>
        <empDamage>1</empDamage>
        <affectHostilesOnly>false</affectHostilesOnly>
        <commandLabel>Activate shield jammer</commandLabel>
        <commandDesc>Select a target area. For 10 seconds, shields inside radius 10 are repeatedly suppressed and marked with EMP particles.</commandDesc>
        <iconPath>Things/Building/Misc/DNX_FireControlConsole</iconPath>
        <fleckDef>BlastEMP</fleckDef>
        <fleckScale>0.8</fleckScale>
      </li>
    </comps>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <constructEffect>ConstructMetal</constructEffect>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
  </ThingDef>

  <ThingDef ParentName="SkyfallerBase">
    <defName>DNX_UplinkSupportMissile_Incoming</defName>
    <label>uplink support missile</label>
    <thingClass>DNX.Skyfaller_UplinkSupportMissileIncoming</thingClass>
    <size>(1,1)</size>
    <useHitPoints>false</useHitPoints>
    <graphicData>
      <texPath>Things/Building/Security/DNX_TacticalNuclearMissile</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutFlying</shaderType>
      <drawSize>(2.4,2.4)</drawSize>
    </graphicData>
    <skyfaller>
      <shadowSize>(1.6,1.6)</shadowSize>
      <speed>0.92</speed>
      <movementType>Accelerate</movementType>
      <ticksToImpactRange>48~64</ticksToImpactRange>
    </skyfaller>
  </ThingDef>

</Defs>

