<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>DNX_TacticalSimulation</defName>
    <label>tactical simulation</label>
    <description>This person has recently participated in a tactical simulation, improving their fire discipline, target acquisition, and movement coordination.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>300000</disappearsAfterTicks>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath"/>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <AimingDelayFactor>-0.4</AimingDelayFactor>
          <ShootingAccuracyPawn>2</ShootingAccuracyPawn>
          <MoveSpeed>0.8</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>DNX_WeakpointExposed</defName>
    <label>weakpoint exposed</label>
    <description>This target has been locked by a tactical marker tower, exposing structural weakpoints to the defensive network.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600</disappearsAfterTicks>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath"/>
    </comps>
    <stages>
      <li>
        <statFactors>
          <IncomingDamageFactor>1.2</IncomingDamageFactor>
          <ArmorRating_Sharp>0.6</ArmorRating_Sharp>
        </statFactors>
        <statOffsets>
          <MoveSpeed>-1.0</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
    <modExtensions>
      <li Class="DNX.ExperimentalTargetHitChanceExtension">
        <hitChanceOffset>0.20</hitChanceOffset>
      </li>
    </modExtensions>
  </HediffDef>

  <HediffDef>
    <defName>DNX_Suppressed</defName>
    <label>suppressed</label>
    <description>This target is pinned by fragmentation fire, reducing coordination, vision, and movement.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>900</disappearsAfterTicks>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath"/>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.40</offset>
          </li>
          <li>
            <capacity>Sight</capacity>
            <offset>-0.40</offset>
          </li>
        </capMods>
        <statOffsets>
          <MoveSpeed>-1.50</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
