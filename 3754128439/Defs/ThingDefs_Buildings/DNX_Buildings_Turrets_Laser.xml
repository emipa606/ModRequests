<?xml version="1.0" encoding="utf-8"?>
<Defs>

<ThingDef ParentName="DNX_BaseTurret2x2">
    <defName>DNX_Turret_LaserChargeEmitter</defName>
    <label>laser charge emitter</label>
    <description>An experimental laser defense turret that draws a visible charge beam before burning a compact target area.</description>
    <uiIconPath>Things/Building/Security/DNX_LaserChargeEmitter_MenuIcon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/Security/DNX_SentinelHMG4Turret_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <statBases>
      <MaxHitPoints>480</MaxHitPoints>
      <WorkToBuild>5200</WorkToBuild>
      <Mass>38</Mass>
      <Flammability>0.55</Flammability>
      <Beauty>-15</Beauty>
    </statBases>
    <costList>
      <Steel>260</Steel>
      <ComponentIndustrial>10</ComponentIndustrial>
      <Plasteel>35</Plasteel>
    </costList>
    <researchPrerequisites>
      <li>DNX_HighEnergyBeamConfinementTheory</li>
    </researchPrerequisites>
    <building>
      <turretGunDef>DNX_Gun_LaserChargeEmitter</turretGunDef>
      <turretBurstWarmupTime>3.6</turretBurstWarmupTime>
      <turretBurstCooldownTime>3.5</turretBurstCooldownTime>
      <turretTopDrawSize>3.2</turretTopDrawSize>
      <ai_combatDangerous>true</ai_combatDangerous>
    </building>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>680</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Glower">
        <glowRadius>4</glowRadius>
        <glowColor>(255,170,70,0)</glowColor>
      </li>
      <li Class="DNX.CompProperties_CapacitorConnectionStatus"/>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>DNX_GiantCapacitorArray</li>
        </linkableFacilities>
      </li>
    </comps>
    <placeWorkers Inherit="True">
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
  </ThingDef>

<ThingDef ParentName="BuildingBase">
    <defName>DNX_SustainedLaserEmitter</defName>
    <label>M-33 "Maxwell" dual-mode laser cannon</label>
    <description>The M-33 "Maxwell" is a large high-power directed-energy weapon that can switch between sustained irradiation and peak discharge modes as battlefield conditions demand. Sustained irradiation steadily burns through energy shields but has limited effect against mechanoids; when switched to peak discharge mode, the turret releases stored energy in a single burst to deliver a high-intensity strike against one target.</description>
    <thingClass>DNX.Building_SustainedLaserEmitter</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>80</pathCost>
    <fillPercent>0.65</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <selectable>true</selectable>
    <size>(3,3)</size>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsSecurity</li>
    </thingCategories>
    <designationCategory>Security</designationCategory>
    <uiIconPath>Things/Building/Security/DNX_M33MaxwellDualModeLaserCannon_MenuIcon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/Security/DNX_SentinelHMG4Turret_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <rect>(0.15,0.15,0.7,0.7)</rect>
      </damageData>
    </graphicData>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
      <WorkToBuild>5400</WorkToBuild>
      <Mass>40</Mass>
      <Flammability>0.35</Flammability>
      <Beauty>-14</Beauty>
    </statBases>
    <costList>
      <Steel>450</Steel>
      <Plasteel>200</Plasteel>
      <ComponentIndustrial>12</ComponentIndustrial>
      <ComponentSpacer>8</ComponentSpacer>
    </costList>
    <building>
      <combatPower>260</combatPower>
      <ai_combatDangerous>true</ai_combatDangerous>
    </building>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>2000</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Glower">
        <glowRadius>5</glowRadius>
        <glowColor>(255,170,70,0)</glowColor>
      </li>
      <li Class="DNX.CompProperties_MaxwellOverheat">
        <heatGainPerTick>0.00118</heatGainPerTick>
        <heatLossPerTick>0.00025</heatLossPerTick>
        <restartHeatThreshold>0.25</restartHeatThreshold>
        <overheatTicks>420</overheatTicks>
        <energyPulseIntervalTicks>30</energyPulseIntervalTicks>
        <energyPerPulse>50</energyPerPulse>
        <overheatMoteIntervalTicks>10</overheatMoteIntervalTicks>
        <overheatVentSmokeMote>DNX_Mote_VanguardWhiteVentSmoke</overheatVentSmokeMote>
        <overheatVentDurationTicks>120</overheatVentDurationTicks>
        <overheatVentIntervalTicks>3</overheatVentIntervalTicks>
        <overheatVentSideOffset>1.25</overheatVentSideOffset>
        <overheatVentForwardJitter>0.35</overheatVentForwardJitter>
        <overheatVentSpeedMin>1.35</overheatVentSpeedMin>
        <overheatVentSpeedMax>1.75</overheatVentSpeedMax>
        <overheatVentSmokeScaleMin>2.2</overheatVentSmokeScaleMin>
        <overheatVentSmokeScaleMax>3.0</overheatVentSmokeScaleMax>
      </li>
      <li Class="DNX.CompProperties_CapacitorConnectionStatus"/>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>DNX_GiantCapacitorArray</li>
        </linkableFacilities>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>DNX_HighEnergyBeamConfinementTheory</li>
    </researchPrerequisites>
    <modExtensions>
      <li Class="DNX.SustainedLaserEmitterExtension">
        <range>36</range>
        <scanIntervalTicks>20</scanIntervalTicks>
        <turnSpeedDegreesPerTick>2.2</turnSpeedDegreesPerTick>
        <aimToleranceDegrees>2.5</aimToleranceDegrees>
        <damageIntervalTicks>25</damageIntervalTicks>
        <damageAmount>36</damageAmount>
        <armorPenetration>0.8</armorPenetration>
        <requiresLineOfSight>true</requiresLineOfSight>
        <topTexPath>Things/Building/Security/DNX_M33MaxwellDualModeLaserCannon_Top</topTexPath>
        <topDrawSize>5.8</topDrawSize>
        <beamTexPath>Effects/Mote/DNX_SustainedLaserBeam</beamTexPath>
        <beamWidth>2.4</beamWidth>
        <beamStartOffset>(0.0,2.35)</beamStartOffset>
        <hitFlashScale>2.8</hitFlashScale>
        <beamCycleSoundDef>DNX_MaxwellBeamCycle</beamCycleSoundDef>
        <killSmokeMoteDef>DNX_Mote_VanguardWhiteVentSmoke</killSmokeMoteDef>
        <killSmokeCount>32</killSmokeCount>
        <killSmokeRadius>1.35</killSmokeRadius>
        <killSmokeScaleMin>2.2</killSmokeScaleMin>
        <killSmokeScaleMax>3.8</killSmokeScaleMax>
        <killSmokeSpeedMin>0.55</killSmokeSpeedMin>
        <killSmokeSpeedMax>1.35</killSmokeSpeedMax>
        <peakRange>36</peakRange>
        <peakCooldownTicks>330</peakCooldownTicks>
        <peakEnergyCost>1300</peakEnergyCost>
        <peakHeatGain>0.15</peakHeatGain>
        <peakBeamMoteDef>DNX_Mote_LaserImpactBeam</peakBeamMoteDef>
        <peakBeamWidth>1.8</peakBeamWidth>
        <peakImpactRadius>2.9</peakImpactRadius>
        <peakDamageAmount>180</peakDamageAmount>
        <peakArmorPenetration>1.8</peakArmorPenetration>
        <peakImpactSoundDef>DNX_Uplink_CannonFiring</peakImpactSoundDef>
        <peakFlashScale>3.6</peakFlashScale>
        <peakCameraShakeIntensity>0.95</peakCameraShakeIntensity>
        <peakCameraShakeRadius>55</peakCameraShakeRadius>
      </li>
    </modExtensions>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <constructEffect>ConstructMetal</constructEffect>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
  </ThingDef>

<ThingDef ParentName="BuildingBase">
    <defName>DNX_PrismLaserPointDefenseSystem</defName>
    <label>Prism laser point-defense system</label>
    <description>An experimental laser point-defense facility that discharges capacitor energy through a prism emitter to intercept hostile explosive projectiles and disrupt incoming enemy drop pods. &lt;color=yellow&gt;The Prism point-defense system can destroy projectiles and drones, including descending hostile drop pods, with a fairly high success rate and an extremely short cooldown. Each interception consumes energy from capacitor arrays, and high-energy beam limits keep its defensive range very small.&lt;/color&gt;</description>
    <thingClass>DNX.Building_PrismLaserPointDefense</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.55</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <selectable>true</selectable>
    <size>(2,2)</size>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsSecurity</li>
    </thingCategories>
    <designationCategory>Security</designationCategory>
    <uiIconPath>Things/Building/Security/DNX_PrismLaserPointDefense_MenuIcon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/Security/DNX_SentinelHMG4Turret_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <statBases>
      <MaxHitPoints>520</MaxHitPoints>
      <WorkToBuild>5600</WorkToBuild>
      <Mass>42</Mass>
      <Flammability>0.45</Flammability>
      <Beauty>-14</Beauty>
    </statBases>
    <costList>
      <Steel>260</Steel>
      <Plasteel>45</Plasteel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <building>
      <combatPower>120</combatPower>
      <ai_combatDangerous>true</ai_combatDangerous>
    </building>
    <researchPrerequisites>
      <li>DNX_HighEnergyBeamConfinementTheory</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>650</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Glower">
        <glowRadius>4</glowRadius>
        <glowColor>(255,170,70,0)</glowColor>
      </li>
      <li Class="DNX.CompProperties_PrismLaserPointDefense">
        <range>18</range>
        <scanIntervalTicks>8</scanIntervalTicks>
        <cooldownTicks>12</cooldownTicks>
        <interceptChance>0.9</interceptChance>
        <energyPerIntercept>200</energyPerIntercept>
        <beamMoteDef>DNX_Mote_LaserImpactBeam</beamMoteDef>
        <beamWidth>0.6</beamWidth>
        <topTexPath>Things/Building/Security/DNX_PrismLaserPointDefense_Top</topTexPath>
        <topDrawSize>4.41</topDrawSize>
        <fireSound>DNX_Uplink_CannonFiring</fireSound>
      </li>
      <li Class="DNX.CompProperties_ExperimentalDropPodInterceptor">
        <range>18</range>
        <scanIntervalTicks>6</scanIntervalTicks>
        <cooldownTicks>18</cooldownTicks>
        <interceptChance>0.9</interceptChance>
        <energyPerIntercept>200</energyPerIntercept>
        <beamMoteDef>DNX_Mote_LaserImpactBeam</beamMoteDef>
        <beamWidth>0.75</beamWidth>
        <fireSound>DNX_Uplink_CannonFiring</fireSound>
      </li>
      <li Class="DNX.CompProperties_CapacitorConnectionStatus"/>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>DNX_GiantCapacitorArray</li>
        </linkableFacilities>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <constructEffect>ConstructMetal</constructEffect>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
  </ThingDef>

</Defs>

