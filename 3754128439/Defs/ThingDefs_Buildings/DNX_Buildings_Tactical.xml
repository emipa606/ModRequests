<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>DNX_TacticalSimulationTable</defName>
    <label>tactical simulation table</label>
    <description>A defensive planning table used to run battlefield simulations and synchronize colony combat doctrine.</description>
    <thingClass>DNX.Building_TacticalSimulationTable</thingClass>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/Building/Misc/DNX_TacticalSimulationTable</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>2.65</drawSize>
      <drawRotated>false</drawRotated>
      <drawOffset>(0,0,-0.05)</drawOffset>
      <shadowData>
        <volume>(1.6875, 0.375, 2.125)</volume>
        <offset>(0,0,-0.12)</offset>
      </shadowData>
    </graphicData>
    <costList>
      <Steel>180</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
      <joyKind>Gaming_Cerebral</joyKind>
    </building>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>350</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Glower">
        <glowRadius>4.2</glowRadius>
        <glowColor>(80,170,255,255)</glowColor>
      </li>
    </comps>
    <ritualFocus MayRequire="Ludeon.RimWorld.Ideology">
      <spectateDistance>2~4</spectateDistance>
      <allowedSpectateSides>Down</allowedSpectateSides>
    </ritualFocus>
    <altitudeLayer>Building</altitudeLayer>
    <statBases>
      <MaxHitPoints>450</MaxHitPoints>
      <WorkToBuild>10000</WorkToBuild>
      <Flammability>0.4</Flammability>
      <Beauty>2</Beauty>
      <JoyGainFactor>1.4</JoyGainFactor>
      <Mass>80</Mass>
    </statBases>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,2)</interactionCellOffset>
    <interactionCellIcon>DiningChair</interactionCellIcon>
    <interactionCellIconReverse>true</interactionCellIconReverse>
    <fillPercent>0.45</fillPercent>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <designationCategory>Misc</designationCategory>
    <rotatable>false</rotatable>
    <canOverlapZones>false</canOverlapZones>
    <size>(3,3)</size>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">PlaceWorker_RitualFocus</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <researchPrerequisites>
      <li>DNX_TacticalSimulationTheory</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>7</constructionSkillPrerequisite>
  </ThingDef>

</Defs>
