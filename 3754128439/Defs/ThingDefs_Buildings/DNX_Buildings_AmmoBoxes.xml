<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>DNX_GunLaunchedMissileAmmoBox</defName>
    <label>gun-launched missile ammo box</label>
    <description>A specialized missile feed crate for Hammer 120mm turrets. When linked, nearby Hammer turrets replace their standard 120mm shells with gun-launched guided missiles while this box has ammunition.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.45</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <selectable>true</selectable>
    <size>(2,2)</size>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <designationCategory>Security</designationCategory>
    <uiIconPath>Things/Building/Misc/DNX_GunLaunchedMissileAmmoBox</uiIconPath>
    <graphicData>
      <texPath>Things/Building/Misc/DNX_GunLaunchedMissileAmmoBox</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <shadowData>
        <volume>(1.2, 0.35, 1.2)</volume>
        <offset>(0,0,-0.1)</offset>
      </shadowData>
    </graphicData>
    <statBases>
      <MaxHitPoints>420</MaxHitPoints>
      <WorkToBuild>5200</WorkToBuild>
      <Mass>36</Mass>
      <Flammability>0.4</Flammability>
      <Beauty>-10</Beauty>
    </statBases>
    <costList>
      <Steel>160</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Refuelable">
        <fuelLabel>gun-launched missiles</fuelLabel>
        <fuelGizmoLabel>gun-launched missiles</fuelGizmoLabel>
        <outOfFuelMessage>gun-launched missiles depleted</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>10</fuelCapacity>
        <fuelMultiplier>1</fuelMultiplier>
        <initialFuelPercent>0</initialFuelPercent>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>1</minimumFueledThreshold>
        <factorByDifficulty>false</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
      </li>
      <li Class="DNX.CompProperties_GunLaunchedMissileAmmoBox">
        <linkRadius>5</linkRadius>
        <targetTurretDefName>DNX_Turret_Hammer120mm</targetTurretDefName>
      </li>
      <li Class="CompProperties_Facility">
        <maxDistance>5</maxDistance>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>DNX_GunLaunchedMissileAdaptation</li>
    </researchPrerequisites>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <constructEffect>ConstructMetal</constructEffect>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>DNX_HighSpeedBeltFeeder</defName>
    <label>high-speed belt feeder</label>
    <description>A compact ammunition feeder for Gyrfalcon-M 20mm composite turrets. It links to nearby turrets, supplies 20mm ammunition, and can switch between armor-piercing, charge, and high-explosive belts.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.35</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <selectable>true</selectable>
    <size>(1,1)</size>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <designationCategory>Security</designationCategory>
    <uiIconPath>Things/Building/Misc/DNX_HighSpeedBeltFeeder</uiIconPath>
    <graphicData>
      <texPath>Things/Building/Misc/DNX_HighSpeedBeltFeeder</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <shadowData>
        <volume>(0.8, 0.25, 0.8)</volume>
        <offset>(0,0,-0.05)</offset>
      </shadowData>
    </graphicData>
    <statBases>
      <MaxHitPoints>280</MaxHitPoints>
      <WorkToBuild>4200</WorkToBuild>
      <Mass>22</Mass>
      <Flammability>0.45</Flammability>
      <Beauty>-8</Beauty>
    </statBases>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Refuelable">
        <fuelLabel>20mm belt ammunition</fuelLabel>
        <fuelGizmoLabel>20mm belt ammunition</fuelGizmoLabel>
        <outOfFuelMessage>20mm belt ammunition depleted</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>300</fuelCapacity>
        <fuelMultiplier>1</fuelMultiplier>
        <initialFuelPercent>0</initialFuelPercent>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>36</minimumFueledThreshold>
        <factorByDifficulty>false</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
      </li>
      <li Class="DNX.CompProperties_HighSpeedBeltFeeder">
        <linkRadius>5</linkRadius>
        <targetTurretDefName>DNX_Turret_GyrfalconM20mmComposite</targetTurretDefName>
        <targetTurretDefNames>
          <li>DNX_Turret_GyrfalconM20mmComposite</li>
          <li>DNX_Turret_Vanguard20mmSuppressiveCannon</li>
        </targetTurretDefNames>
      </li>
      <li Class="CompProperties_Facility">
        <maxDistance>5</maxDistance>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>DNX_Advanced20mmAmmunition</li>
    </researchPrerequisites>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <constructEffect>ConstructMetal</constructEffect>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
  </ThingDef>

</Defs>


