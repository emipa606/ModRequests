<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase" Name="DNX_BaseTurret" Abstract="True">
    <thingClass>DNX.Building_DNXTurretGun</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <drawHighlight>true</drawHighlight>
    <drawHighlightOnlyForHostile>true</drawHighlightOnlyForHostile>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <selectable>true</selectable>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <designationCategory>Security</designationCategory>
    <building>
      <ai_combatDangerous>true</ai_combatDangerous>
    </building>
    <placeWorkers>
      <li>PlaceWorker_TurretTop</li>
      <li>DNX.PlaceWorker_ShowDNXTurretRadius</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>GunTurrets</li>
    </researchPrerequisites>
    <constructEffect>ConstructMetal</constructEffect>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
  </ThingDef>

  <ThingDef ParentName="DNX_BaseTurret" Name="DNX_BaseTurret2x2" Abstract="True">
    <size>(2,2)</size>
    <pathCost>50</pathCost>
    <fillPercent>0.55</fillPercent>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="DNX_BaseTurret" Name="DNX_BaseTurret3x3Heavy" Abstract="True">
    <size>(3,3)</size>
    <pathCost>80</pathCost>
    <fillPercent>0.65</fillPercent>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <rect>(0.15,0.15,0.7,0.7)</rect>
      </damageData>
    </graphicData>
  </ThingDef>

</Defs>


