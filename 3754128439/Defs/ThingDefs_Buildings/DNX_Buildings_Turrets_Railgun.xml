<?xml version="1.0" encoding="utf-8"?>
<Defs>

<ThingDef ParentName="DNX_BaseTurret3x3Heavy">
    <defName>DNX_Turret_LittleTrainRGPrototype</defName>
    <label>Little Train RG prototype</label>
    <description>An experimental railgun turret that fires a high-energy penetrator, cutting through hostile targets in a long line and discharging EMP at the impact point.</description>
    <uiIconPath>Things/Building/Security/DNX_LittleTrainRGPrototype_MenuIcon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/Security/DNX_SentinelHMG4Turret_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <rect>(0.15,0.15,0.7,0.7)</rect>
      </damageData>
    </graphicData>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
      <WorkToBuild>9000</WorkToBuild>
      <Mass>95</Mass>
      <Flammability>0.45</Flammability>
      <Beauty>-26</Beauty>
    </statBases>
    <costList>
      <Steel>540</Steel>
      <Plasteel>70</Plasteel>
      <ComponentIndustrial>14</ComponentIndustrial>
      <ComponentSpacer>3</ComponentSpacer>
    </costList>
    <researchPrerequisites>
      <li>DNX_MagneticRailAccelerationTheory</li>
    </researchPrerequisites>
    <building>
      <turretGunDef>DNX_Gun_LittleTrainRGPrototype</turretGunDef>
      <turretBurstWarmupTime>3.2</turretBurstWarmupTime>
      <turretBurstCooldownTime>2.8</turretBurstCooldownTime>
      <turretTopDrawSize>7.1</turretTopDrawSize>
    </building>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>1200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="DNX.CompProperties_FireControlReceiver">
        <accuracyOffset>0.04</accuracyOffset>
      </li>
      <li Class="DNX.CompProperties_AimingExtensionReceiver"/>
      <li Class="DNX.CompProperties_RailgunWarmupVisual">
        <minSparkIntervalTicks>2</minSparkIntervalTicks>
        <maxSparkIntervalTicks>4</maxSparkIntervalTicks>
        <sparkScaleMin>1.2</sparkScaleMin>
        <sparkScaleMax>2.2</sparkScaleMax>
        <flashScaleMin>1.9</flashScaleMin>
        <flashScaleMax>3.0</flashScaleMax>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelLabel>railgun charge cells</fuelLabel>
        <fuelGizmoLabel>railgun charge cells</fuelGizmoLabel>
        <outOfFuelMessage>railgun charge cells depleted</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>30</fuelCapacity>
        <fuelMultiplier>0.3</fuelMultiplier>
        <initialFuelPercent>1</initialFuelPercent>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>1</minimumFueledThreshold>
        <factorByDifficulty>false</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
      </li>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>DNX_GiantCapacitorArray</li>
        </linkableFacilities>
      </li>
    </comps>
    <placeWorkers Inherit="True">
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
  </ThingDef>

<ThingDef ParentName="DNX_BaseTurret">
    <defName>DNX_Turret_ConvergenceDeathRay</defName>
    <label>convergence death ray turret</label>
    <description>An experimental high-energy weapon that converges three red focusing beams before firing a catastrophic white death ray at the target area.</description>
    <uiIconPath>Things/Building/Security/DNX_LittleTrainRGPrototype_MenuIcon</uiIconPath>
    <size>(4,4)</size>
    <pathCost>120</pathCost>
    <fillPercent>0.75</fillPercent>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <graphicData>
      <texPath>Things/Building/Security/DNX_SentinelHMG4Turret_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4)</drawSize>
      <damageData>
        <rect>(0.12,0.12,0.76,0.76)</rect>
      </damageData>
    </graphicData>
    <statBases>
      <MaxHitPoints>1200</MaxHitPoints>
      <WorkToBuild>16000</WorkToBuild>
      <Mass>160</Mass>
      <Flammability>0.35</Flammability>
      <Beauty>-35</Beauty>
    </statBases>
    <costList>
      <Steel>900</Steel>
      <Plasteel>160</Plasteel>
      <Uranium>80</Uranium>
      <ComponentIndustrial>24</ComponentIndustrial>
      <ComponentSpacer>8</ComponentSpacer>
    </costList>
    <building>
      <turretGunDef>DNX_Gun_ConvergenceDeathRay</turretGunDef>
      <turretBurstWarmupTime>3.0</turretBurstWarmupTime>
      <turretBurstCooldownTime>18.0</turretBurstCooldownTime>
      <turretTopDrawSize>9.2</turretTopDrawSize>
    </building>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>3600</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="DNX.CompProperties_DeathRayWarmupVisual">
        <focusDistance>4.2</focusDistance>
        <sourceForward>0.5</sourceForward>
        <sideOffset>1.45</sideOffset>
        <rearOffset>-0.85</rearOffset>
        <coreWidth>0.08</coreWidth>
        <glowWidth>0.46</glowWidth>
      </li>
      <li Class="DNX.CompProperties_CapacitorConnectionStatus"/>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>DNX_GiantCapacitorArray</li>
        </linkableFacilities>
      </li>
    </comps>
    <placeWorkers Inherit="True">
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
  </ThingDef>

</Defs>

