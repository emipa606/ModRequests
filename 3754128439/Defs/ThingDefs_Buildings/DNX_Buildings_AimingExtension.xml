<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>DNX_AimingExtensionArray</defName>
    <label>aiming extension array</label>
    <description>A close-range targeting support array that links to nearby Defensive Network Expanded turrets and extends their engagement range.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.45</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <selectable>true</selectable>
    <size>(2,2)</size>
    <tickerType>Normal</tickerType>
    <rotatable>false</rotatable>
    <designationCategory>Security</designationCategory>
    <uiIconPath>Things/Building/Misc/DNX_AimingExtensionArray</uiIconPath>
    <graphicData>
      <texPath>Things/Building/Misc/DNX_AimingExtensionArray</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <shadowData>
        <volume>(1.2, 0.35, 1.2)</volume>
        <offset>(0,0,-0.1)</offset>
      </shadowData>
    </graphicData>
    <statBases>
      <MaxHitPoints>360</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
      <Mass>45</Mass>
      <Flammability>0.5</Flammability>
      <Beauty>-8</Beauty>
    </statBases>
    <costList>
      <Steel>220</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>1200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="DNX.CompProperties_AimingExtensionArray">
        <linkRadius>4</linkRadius>
        <rangeBonus>8</rangeBonus>
      </li>
    </comps>
    <researchPrerequisites>
      <li>DNX_RemoteBallisticCorrection</li>
    </researchPrerequisites>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <constructEffect>ConstructMetal</constructEffect>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
  </ThingDef>

</Defs>


