<ThingDef ParentName="DNX_BaseTurret3x3Heavy">
    <defName>DNX_Turret_Vanguard20mmSuppressiveCannon</defName>
    <label>Vanguard 20mm suppressive cannon turret</label>
    <description>A 20mm suppressive cannon turret with an escalating efficiency cycle. Sustained fire accelerates the weapon, but pushing it too far overheats the system and forces a short shutdown.</description>
    <thingClass>DNX.Building_VanguardSuppressiveCannon</thingClass>
    <uiIconPath>Things/Building/Security/DNX_Vanguard20mmSuppressiveCannon_MenuIcon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/Security/DNX_GeminiGatlingTurret_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <rect>(0.15,0.15,0.7,0.7)</rect>
      </damageData>
    </graphicData>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
      <WorkToBuild>7600</WorkToBuild>
      <Mass>78</Mass>
      <Flammability>0.5</Flammability>
      <Beauty>-24</Beauty>
    </statBases>
    <costList>
      <Steel>460</Steel>
      <ComponentIndustrial>14</ComponentIndustrial>
      <Plasteel>45</Plasteel>
    </costList>
    <researchPrerequisites>
      <li>DNX_HighCycleWeaponEngineering</li>
    </researchPrerequisites>
    <building>
      <turretGunDef>DNX_Gun_Vanguard20mmSuppressiveCannon</turretGunDef>
      <turretBurstWarmupTime>1.0</turretBurstWarmupTime>
      <turretBurstCooldownTime>1.5</turretBurstCooldownTime>
      <turretTopDrawSize>6.5</turretTopDrawSize>
    </building>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>760</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="DNX.CompProperties_FireControlReceiver">
        <accuracyOffset>0.04</accuracyOffset>
      </li>
      <li Class="DNX.CompProperties_AimingExtensionReceiver"/>
      <li Class="DNX.CompProperties_HighSpeedBeltReceiver"/>
      <li Class="CompProperties_Refuelable">
        <fuelLabel>20mm suppressive ammunition</fuelLabel>
        <fuelGizmoLabel>20mm suppressive ammunition</fuelGizmoLabel>
        <outOfFuelMessage>20mm suppressive ammunition depleted</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>350</fuelCapacity>
        <fuelMultiplier>1.8</fuelMultiplier>
        <initialFuelPercent>1</initialFuelPercent>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>10</minimumFueledThreshold>
        <factorByDifficulty>false</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
      </li>
      <li Class="DNX.CompProperties_VanguardEfficiency">
        <threshold>0.30</threshold>
        <efficiencyGainPerShot>0.018</efficiencyGainPerShot>
        <efficiencyDecayPerTick>0.00012</efficiencyDecayPerTick>
        <cooldownFactorAtThreshold>0.05</cooldownFactorAtThreshold>
        <cooldownFactorAtMax>0.05</cooldownFactorAtMax>
        <burstIntervalFactorAtMax>0.34</burstIntervalFactorAtMax>
        <overheatTicksMin>420</overheatTicksMin>
        <overheatTicksMax>600</overheatTicksMax>
        <overheatMoteIntervalTicks>10</overheatMoteIntervalTicks>
        <overheatVentSmokeMote>DNX_Mote_VanguardWhiteVentSmoke</overheatVentSmokeMote>
        <overheatVentDurationTicks>120</overheatVentDurationTicks>
        <overheatVentIntervalTicks>3</overheatVentIntervalTicks>
        <overheatVentSideOffset>1.25</overheatVentSideOffset>
        <overheatVentForwardJitter>0.35</overheatVentForwardJitter>
        <overheatVentSpeedMin>1.35</overheatVentSpeedMin>
        <overheatVentSpeedMax>1.75</overheatVentSpeedMax>
        <overheatVentSmokeScaleMin>2.2</overheatVentSmokeScaleMin>
        <overheatVentSmokeScaleMax>3.0</overheatVentSmokeScaleMax>
      </li>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>DNX_HighSpeedBeltFeeder</li>
        </linkableFacilities>
      </li>
    </comps>
    <placeWorkers Inherit="True">
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
  </ThingDef>

