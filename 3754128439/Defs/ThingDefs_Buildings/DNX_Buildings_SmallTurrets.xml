<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase" Name="DNX_BaseSmallTurret" Abstract="True">
    <thingClass>DNX.Building_DNXTurretGun</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <drawHighlight>true</drawHighlight>
    <drawHighlightOnlyForHostile>true</drawHighlightOnlyForHostile>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/Security/DNX_LightMachineGunTurret_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
      <shadowData>
        <volume>(0.27,0.25,0.27)</volume>
        <offset>(0,0,0)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
    <selectable>true</selectable>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsSecurity</li>
    </thingCategories>
    <passability>PassThroughOnly</passability>
    <pathCost>35</pathCost>
    <fillPercent>0.35</fillPercent>
    <hasTooltip>true</hasTooltip>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Security</designationCategory>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <building>
      <combatPower>42</combatPower>
      <ai_combatDangerous>true</ai_combatDangerous>
    </building>
    <placeWorkers>
      <li>PlaceWorker_TurretTop</li>
      <li>PlaceWorker_ShowTurretRadius</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>DNX_AutomatedSentrySystems</li>
    </researchPrerequisites>
    <constructEffect>ConstructMetal</constructEffect>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
  </ThingDef>

  <ThingDef ParentName="DNX_BaseSmallTurret">
    <defName>DNX_Turret_LightMachineGun</defName>
    <label>light machine gun turret</label>
    <description>A compact light machine gun turret using a standard automatic turret frame for basic suppression.</description>
    <uiIconPath>Things/Building/Security/DNX_LightMachineGunTurret_MenuIcon</uiIconPath>
    <uiIconScale>0.90</uiIconScale>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Flammability>0.7</Flammability>
      <WorkToBuild>1600</WorkToBuild>
      <Mass>8</Mass>
      <Beauty>-12</Beauty>
      <ShootingAccuracyTurret>0.92</ShootingAccuracyTurret>
    </statBases>
    <costList>
      <Steel>85</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <building>
      <turretGunDef>DNX_Gun_LightMachineGunTurret</turretGunDef>
      <turretBurstCooldownTime>3.8</turretBurstCooldownTime>
      <turretTopDrawSize>1.7</turretTopDrawSize>
    </building>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>95</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Refuelable">
        <fuelLabel>LMG ammunition</fuelLabel>
        <fuelGizmoLabel>LMG ammunition</fuelGizmoLabel>
        <outOfFuelMessage>LMG ammunition depleted</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>120</fuelCapacity>
        <fuelMultiplier>1.2</fuelMultiplier>
        <initialFuelPercent>1</initialFuelPercent>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>10</minimumFueledThreshold>
        <factorByDifficulty>false</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
      </li>
      <li Class="CompProperties_Stunnable">
        <affectedDamageDefs>
          <li>Stun</li>
          <li>EMP</li>
        </affectedDamageDefs>
      </li>
    </comps>
  </ThingDef>

