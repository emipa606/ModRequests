<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>DNX_GiantCapacitorArray</defName>
    <label>giant capacitor array</label>
    <description>A massive capacitor array for high-energy defensive weapons. It stores a huge amount of power like a battery and can discharge into linked DNX heavy energy weapons anywhere on the same map. &lt;color=yellow&gt;&lt;b&gt;Your energy weapons must rely on this large, stable energy-storage device to provide the power they need to operate.&lt;/b&gt;&lt;/color&gt;</description>
    <thingClass>Building_Battery</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>70</pathCost>
    <fillPercent>0.45</fillPercent>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <selectable>true</selectable>
    <size>(3,5)</size>
    <tickerType>Normal</tickerType>
    <rotatable>true</rotatable>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsPower</li>
    </thingCategories>
    <designationCategory>Power</designationCategory>
    <uiIconPath>Things/Building/Misc/DNX_GiantCapacitorArray_south</uiIconPath>
    <graphicData>
      <texPath>Things/Building/Misc/DNX_GiantCapacitorArray</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,5)</drawSize>
      <damageData>
        <rect>(0.12,0.12,0.76,0.76)</rect>
      </damageData>
      <shadowData>
        <volume>(2.4,0.45,4.0)</volume>
        <offset>(0,0,-0.1)</offset>
      </shadowData>
    </graphicData>
    <statBases>
      <MaxHitPoints>720</MaxHitPoints>
      <WorkToBuild>9000</WorkToBuild>
      <Mass>160</Mass>
      <Flammability>0.55</Flammability>
      <Beauty>-16</Beauty>
    </statBases>
    <building>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
    </building>
    <costList>
      <Steel>420</Steel>
      <ComponentIndustrial>12</ComponentIndustrial>
      <ComponentSpacer>3</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CompProperties_Battery">
        <storedEnergyMax>10000</storedEnergyMax>
        <efficiency>0.85</efficiency>
        <shortCircuitInRain>true</shortCircuitInRain>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Stunnable">
        <useLargeEMPEffecter>true</useLargeEMPEffecter>
        <affectedDamageDefs>
          <li>EMP</li>
        </affectedDamageDefs>
      </li>
      <li Class="CompProperties_Facility">
        <maxDistance>999</maxDistance>
      </li>
      <li Class="DNX.CompProperties_DNXCapacitorArray"/>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>DNX_HighEnergyCapacitorArrays</li>
    </researchPrerequisites>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <constructEffect>ConstructMetal</constructEffect>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <canOverlapZones>false</canOverlapZones>
  </ThingDef>

</Defs>


