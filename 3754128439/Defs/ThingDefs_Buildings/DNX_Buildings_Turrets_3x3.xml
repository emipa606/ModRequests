<Defs>

<ThingDef ParentName="DNX_BaseTurret3x3Heavy">
    <defName>DNX_TriEyeTargetingArray</defName>
    <label>Tri-Eye targeting array</label>
    <description>A larger fire-control marking array that locks up to three hostile targets at once, reveals invisible enemies, exposes weakpoints, and increases their chance to be hit. It is especially useful when building layered defensive positions.</description>
    <thingClass>DNX.Building_TacticalMarkerTower</thingClass>
    <uiIconPath>Things/Building/Security/DNX_TriEyeTargetingArray_MenuIcon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/Security/DNX_SentinelHMG4Turret_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <rect>(0.15,0.15,0.7,0.7)</rect>
      </damageData>
    </graphicData>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
      <WorkToBuild>6800</WorkToBuild>
      <Mass>68</Mass>
      <Flammability>0.55</Flammability>
      <Beauty>-18</Beauty>
    </statBases>
    <costList>
      <Steel>360</Steel>
      <ComponentIndustrial>12</ComponentIndustrial>
      <Plasteel>40</Plasteel>
    </costList>
    <building>
      <ai_combatDangerous>true</ai_combatDangerous>
    </building>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>680</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Flickable"/>
    </comps>
    <placeWorkers Inherit="False">
      <li>DNX.PlaceWorker_ShowDNXTurretRadius</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>DNX_MultiSourceTargetAnalysis</li>
    </researchPrerequisites>
    <modExtensions>
      <li Class="DNX.TacticalMarkerTowerExtension">
        <range>34.9</range>
        <scanIntervalTicks>45</scanIntervalTicks>
        <visualIntervalTicks>72</visualIntervalTicks>
        <hediffRefreshTicks>120</hediffRefreshTicks>
        <requiresLineOfSight>true</requiresLineOfSight>
        <topTexPath>Things/Building/Security/DNX_TriEyeTargetingArray_Top</topTexPath>
        <topDrawSize>4.6</topDrawSize>
        <hediffDef>DNX_WeakpointExposed</hediffDef>
        <maxTargets>3</maxTargets>
        <preferUnmarkedTargets>true</preferUnmarkedTargets>
        <markedMote>DNX_Mote_TacticalMarked</markedMote>
        <towerMoteOffset>0.15</towerMoteOffset>
        <visualScale>1</visualScale>
      </li>
    </modExtensions>
  </ThingDef>

<ThingDef ParentName="DNX_BaseTurret3x3Heavy">
    <defName>DNX_Turret_Boxer35mmAA</defName>
    <label>Boxer 35mm twin anti-aircraft turret</label>
    <description>A heavy twin 35mm anti-aircraft turret that fires high-velocity armor-piercing shells and can intercept incoming explosive projectiles. &lt;color=yellow&gt;The 35mm AA turret can fire programmed ammunition at very long range to shoot down hostile drones and projectiles, but interception is not guaranteed. Build multiple turrets if you want a higher success rate.&lt;/color&gt;</description>
    <uiIconPath>Things/Building/Security/DNX_Boxer35mmTurret_MenuIcon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/Security/DNX_SentinelHMG4Turret_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <rect>(0.15,0.15,0.7,0.7)</rect>
      </damageData>
    </graphicData>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
      <WorkToBuild>8200</WorkToBuild>
      <Mass>86</Mass>
      <Flammability>0.5</Flammability>
      <Beauty>-24</Beauty>
    </statBases>
    <costList>
      <Steel>480</Steel>
      <ComponentIndustrial>14</ComponentIndustrial>
      <Plasteel>40</Plasteel>
    </costList>
    <researchPrerequisites>
      <li>DNX_HighSpeedBeltFeedSystems</li>
    </researchPrerequisites>
    <building>
      <turretGunDef>DNX_Gun_Boxer35mmAA</turretGunDef>
      <turretBurstWarmupTime>0.1</turretBurstWarmupTime>
      <turretBurstCooldownTime>3.7</turretBurstCooldownTime>
      <turretTopDrawSize>7.1</turretTopDrawSize>
