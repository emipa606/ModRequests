        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>780</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="DNX.CompProperties_FireControlReceiver">
        <accuracyOffset>0.04</accuracyOffset>
      </li>
      <li Class="DNX.CompProperties_AimingExtensionReceiver"/>
      <li Class="CompProperties_Refuelable">
        <fuelLabel>35mm ammunition</fuelLabel>
        <fuelGizmoLabel>35mm ammunition</fuelGizmoLabel>
        <outOfFuelMessage>35mm ammunition depleted</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>240</fuelCapacity>
        <fuelMultiplier>2.4</fuelMultiplier>
        <initialFuelPercent>1</initialFuelPercent>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>12</minimumFueledThreshold>
        <factorByDifficulty>false</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
      </li>
      <li Class="DNX.CompProperties_PointDefenseInterceptor">
        <range>55</range>
        <scanIntervalTicks>15</scanIntervalTicks>
        <cooldownTicks>60</cooldownTicks>
        <interceptChance>0.45</interceptChance>
        <ammoCost>3</ammoCost>
        <refuelableFuelLabel>35mm ammunition</refuelableFuelLabel>
        <interceptorProjectileDef>DNX_Bullet_Boxer35mmInterceptorDummy</interceptorProjectileDef>
        <interceptorShotCount>4</interceptorShotCount>
