<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="DNX_BaseTurret3x3Heavy">
    <defName>DNX_VerticalMissileSilo</defName>
    <label>vertical missile silo (WIP)</label>
    <description>An experimental compact vertical missile silo for testing cold-launched top-attack missiles. This system is currently in testing.</description>
    <thingClass>DNX.Building_VerticalMissileSilo</thingClass>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsSecurity</li>
    </thingCategories>
    <uiIconPath>Things/Building/Security/DNX_TacticalNuclearMissileSilo</uiIconPath>
    <graphicData>
      <texPath>Things/Building/Security/DNX_TacticalNuclearMissileSilo</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <statBases>
      <MaxHitPoints>850</MaxHitPoints>
      <WorkToBuild>12000</WorkToBuild>
      <Mass>450</Mass>
      <Flammability>0.18</Flammability>
      <Beauty>-14</Beauty>
    </statBases>
    <building>
      <ai_combatDangerous>true</ai_combatDangerous>
      <combatPower>95</combatPower>
    </building>
    <costList>
      <Steel>420</Steel>
      <Plasteel>90</Plasteel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>800</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Refuelable">
        <fuelLabel>vertical missile readiness</fuelLabel>
        <fuelGizmoLabel>vertical missile readiness</fuelGizmoLabel>
        <outOfFuelMessage>vertical missile readiness depleted</outOfFuelMessage>
        <fuelFilter>
          <thingDefs>
            <li>Shell_HighExplosive</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>10</fuelCapacity>
        <fuelMultiplier>1</fuelMultiplier>
        <initialFuelPercent>0</initialFuelPercent>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>1</minimumFueledThreshold>
        <factorByDifficulty>false</factorByDifficulty>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
      </li>
      <li Class="DNX.CompProperties_ManualMissileLauncher">
        <projectileDef>DNX_Projectile_VerticalTopAttackMissile</projectileDef>
        <range>90</range>
        <minRange>10</minRange>
        <commandLabel>Launch vertical missile</commandLabel>
        <commandDesc>Manually select a target and launch a cold-launched top-attack missile. Consumes one vertical missile readiness charge.</commandDesc>
        <iconPath>UI/DNX/Commands/Launch</iconPath>
        <refuelableFuelLabel>vertical missile readiness</refuelableFuelLabel>
        <autoScanIntervalTicks>60</autoScanIntervalTicks>
        <cooldownTicks>1200</cooldownTicks>
        <drawCustomRangeRing>true</drawCustomRangeRing>
        <customRangeRingAlpha>0.5</customRangeRingAlpha>
      </li>
    </comps>
    <placeWorkers Inherit="False">
      <li>PlaceWorker_NotUnderRoof</li>
    </placeWorkers>
    <researchPrerequisites Inherit="False">
      <li>DNX_TacticalMissileSystems</li>
    </researchPrerequisites>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <constructEffect>ConstructMetal</constructEffect>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
  </ThingDef>

</Defs>
