<?xml version="1.0" encoding="utf-8" ?>

<Defs>
		<!-- Boomium -->
	<ThingDef ParentName="MakeableDrugPillBase">
		<defName>Boomium</defName>
		<label>boomium</label>
		<description>Used to inject chemfuel mechanites into an antelope. The boomalope produces chemfuel naturally.</description>
		<graphicData>
			<texPath>Boomalope/Drug</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<rotatable>false</rotatable>
		<statBases>
			<MarketValue>700</MarketValue>
			<Mass>0.01</Mass>
		</statBases>
		<techLevel>Ultra</techLevel>
		<tradeability>Sellable</tradeability>
		<ingestible>
			<drugCategory>Medical</drugCategory>
			<ingestSound>Ingest_Inject</ingestSound>
			<outcomeDoers>
			<li Class="IngestionOutcomeDoer_GiveHediff">
				<hediffDef>InjectBoomium</hediffDef>
				<severity>1.2</severity>
			</li>
			</outcomeDoers>
		</ingestible>
		<comps>
			<li Class="CompProperties_Drug">
			<listOrder>1000</listOrder>
			</li>
		</comps>
			<costList> 
			<MedicineUltratech>1</MedicineUltratech>
			<ComponentSpacer>2</ComponentSpacer>
			<Chemfuel>20</Chemfuel>
		</costList>
	</ThingDef>
  
    <HediffDef>
		<defName>InjectBoomium</defName>
		<label>Injected with chemfuel mechanites</label>
		<description>The mechanites are being absorbed by the glands.</description>
		<hediffClass>Evolopes.Hediff_InjectBoomium</hediffClass>
		<defaultLabelColor>(1,0,0.5)</defaultLabelColor>
		<scenarioCanAdd>true</scenarioCanAdd>
		<maxSeverity>1.2</maxSeverity>
		<isBad>false</isBad>	
		<comps>
            <li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>-1.00</severityPerDay>
            </li>
        </comps>
	</HediffDef>
 
		<!-- Recipe -->	
	<RecipeDef>
		<defName>CraftBoomium</defName>
		<label>Craft 1 boomium</label>
		<description>The boomium is used to inject chemfuel mechanites into an antelope's body to produce it.</description>
		<jobString>crafting 1 boomium</jobString>
		<effectWorking>Smith</effectWorking>
		<soundWorking>Recipe_Machining</soundWorking>
		<workAmount>1200</workAmount>
		<targetCountAdjustment>1</targetCountAdjustment>
		<workSkill>Intellectual</workSkill>
		<skillRequirements>
			<Intellectual>7</Intellectual>
		</skillRequirements>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>MedicineUltratech</li>
					</thingDefs>                    
				</filter>
				<count>1</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentSpacer</li>
					</thingDefs>                    
				</filter>
				<count>3</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Chemfuel</li>
					</thingDefs>                    
				</filter>
				<count>20</count>
			</li>
		</ingredients>
		<products>
			<Boomium>1</Boomium>
		</products>
		<recipeUsers>
			<li>DrugLab</li>
		</recipeUsers>
    </RecipeDef>

