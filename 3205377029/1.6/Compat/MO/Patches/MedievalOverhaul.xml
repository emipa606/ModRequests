<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  
           
           <Operation Class="PatchOperationSequence">
                <operations>
            
         
			
			<li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "DankPyon_GreatOak"]/plant/harvestedThingDef</xpath>
				<value>
					<harvestedThingDef>WoodLog_Oak</harvestedThingDef>
				</value>
			</li>
             <li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "DankPyon_GreatFir"]/plant</xpath>
				<value>
					<harvestedThingDef>DankPyon_RawDarkWood</harvestedThingDef>
				</value>
			</li>
            <li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "DankPyon_GreatWillow"]/plant</xpath>
				<value>
					<harvestedThingDef>WoodLog_Willow</harvestedThingDef>
				</value>
			</li>
			 <li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName = "DankPyon_TreeScara"]/plant</xpath>
				<value>
					<harvestedThingDef>DankPyon_RawWood</harvestedThingDef>
				</value>
			</li>
			
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName = "DankPyon_RawDarkWood"]/stuffProps/statFactors/Flammability</xpath>
					<value>			
						<Flammability>0.8</Flammability>
					</value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName = "DankPyon_RawDarkWood"]/stuffProps/statFactors/DoorOpenSpeed</xpath>
					<value>			
						<DoorOpenSpeed>1.25</DoorOpenSpeed>
					</value>
				</li>
			
			 <li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "DankPyon_RawDarkWood"]/stuffProps/categories/li</xpath>
				<value>
					<li>RawWoody</li>
				</value>
			</li>
			 <li Class="PatchOperationReplace">
				<xpath>Defs/ThingDef[defName = "DankPyon_RawDarkWood"]/thingCategories/li</xpath>
				<value>
					<li>WoodTypes</li>
				</value>
			</li>
			
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef/comps/li[@Class="CompProperties_Refuelable" and fuelFilter/thingDefs/li[.="DankPyon_Coal"]]/fuelFilter/thingDefs</xpath>
				<value>
					<li>DankPyon_RawDarkWood</li>					
				</value>
			</li>			

                </operations>
		  
    </Operation>
</Patch>