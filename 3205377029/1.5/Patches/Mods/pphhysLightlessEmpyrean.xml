<?xml version="1.0" encoding="utf-8"?>
<Patch>

	
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>pphhyy's Lightless Empyrean</li>
		</mods>
		<match Class="PatchOperationSequence">
			
		<operations>
			<!-- one new type of wood: Lightless Oak-->
			<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "pphhyy_LightlessEmpyrean_LightlessTree" or defName="pphhyy_LightlessEmpyrean_DeadTree"]/plant</xpath>
					<value>
						<harvestedThingDef>WoodLog_Lightless_Oak</harvestedThingDef>
					</value>
			</li>
			
			<li Class="PatchOperationInsert">
					<xpath>Defs/ThingDef[defName = "WoodLog_Oak"]</xpath>
					<value>
						<ThingDef ParentName="WoodLogBase">
							<defName>WoodLog_Lightless_Oak</defName> 
							<label>lightless oak logs</label>
							<description>Raw lightless oak wood. When processed it becomes useful for building structures, weapons, and even simple prosthetics.</description>
							<graphicData>
								<color>(70,67,67)</color>
							</graphicData>
							<statBases>
								<Mass>0.5</Mass> 
								<MarketValue>1.6</MarketValue>
								<DeteriorationRate>4</DeteriorationRate>
							</statBases>
							<stuffProps>
								<stuffAdjective>lightless oak</stuffAdjective>
								<commonality>0.3</commonality>
								<color>(70,67,67)</color>
								<statFactors>
									<MaxHitPoints>0.75</MaxHitPoints>
									<Beauty>2</Beauty>
									<WorkToMake>1</WorkToMake>
									<WorkToBuild>1</WorkToBuild>
								</statFactors>
							</stuffProps>
							<butcherProducts>
								<LumberLightlessOak>30</LumberLightlessOak>
							</butcherProducts>	
						</ThingDef>
					</value>
			</li>
			<li Class="PatchOperationInsert">
					<xpath>Defs/ThingDef[defName = "LumberOak"]</xpath>
					<value>
						<ThingDef ParentName="WoodLumberBase">
							<defName>LumberLightlessOak</defName>
							<label>lightless oak lumber</label>
							<description>Processed lightless oak lumber. Mostly useful for building simple structures and furniture. Lightless Oak is a durable hardwood.</description>
							<graphicData>
								<color>(70,67,67)</color>
							</graphicData>
							<statBases>
								<Mass>0.5</Mass>
								<MarketValue>3.2</MarketValue>
								<DeteriorationRate>0.75</DeteriorationRate>
							</statBases>
							<stuffProps>
								<stuffAdjective>sunless</stuffAdjective>
								<commonality>0.3</commonality>
								<color>(70,67,67)</color>
								<statFactors>
									<MaxHitPoints>0.4</MaxHitPoints>
									<Beauty>2</Beauty>
									<WorkToMake>1</WorkToMake>
									<WorkToBuild>1</WorkToBuild>
								</statFactors>
							</stuffProps>
						</ThingDef>
					</value>
			</li>
			<li Class="PatchOperationInsert">
				<xpath>Defs/RecipeDef[defName = "MakeWoodLumberOak"]</xpath>
				<value>
					<RecipeDef ParentName="MakeWoodLumberBase">
						<defName>MakeWoodLumberLightlessOak</defName>
						<label>make lightless oak lumber</label>
						<description>Process raw sunless logs into lumber for construction.</description>
						<allowMixingIngredients>false</allowMixingIngredients>
						<ingredients>
							<li>
								<filter>
									<thingDefs>
										<li>WoodLog_Lightless_Oak</li>
									</thingDefs>
								</filter>
								<count>15</count>
							</li>
						</ingredients>
						<fixedIngredientFilter>
							<thingDefs>
								<li>WoodLog_Lightless_Oak</li>
							</thingDefs>
						</fixedIngredientFilter>
						<products>
							<LumberLightlessOak>30</LumberLightlessOak>
						</products>
					</RecipeDef>
				</value>
			</li>			
			
		</operations>
		</match>
			
	</Operation>
	
	
</Patch>