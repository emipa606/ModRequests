<?xml version="1.0" encoding="utf-8"?>
<Patch>

	
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Gulden Biome</li>
		</mods>
		<match Class="PatchOperationSequence">
			
		<operations>
			<!-- one new type of wood: gulden-->
			<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName = "Plant_SmallGuldenTree" or defName="Plant_GuldenShrub" or defName="Plant_GuldenConifer"]/plant/harvestedThingDef</xpath>
					<value>
						<harvestedThingDef>WoodLog_Gulden</harvestedThingDef>
					</value>
			</li>
			
			<li Class="PatchOperationInsert">
					<xpath>Defs/ThingDef[defName = "WoodLog_Poplar"]</xpath>
					<value>
						<ThingDef ParentName="WoodLogBase">
							<defName>WoodLog_Gulden</defName> 
							<label>gulden logs</label>
							<description>Raw gulden wood. When processed it becomes useful for building structures, weapons, and even simple prosthetics.</description>
							<graphicData>
								<color>(165,152,136)</color>
							</graphicData>
							<statBases>
								<Mass>0.5</Mass> 
								<MarketValue>1.6</MarketValue>
								<DeteriorationRate>4</DeteriorationRate>
							</statBases>
							<stuffProps>
								<stuffAdjective>gulden</stuffAdjective>
								<commonality>0.3</commonality>
								<color>(165,152,136)</color>
								<statFactors>
									<MaxHitPoints>0.4</MaxHitPoints>
									<Beauty>3.25</Beauty>
									<WorkToMake>1</WorkToMake>
									<WorkToBuild>1</WorkToBuild>
								</statFactors>
							</stuffProps>
							<butcherProducts>
								<LumberGulden>30</LumberGulden>
							</butcherProducts>	
						</ThingDef>
					</value>
			</li>
			<li Class="PatchOperationInsert">
					<xpath>Defs/ThingDef[defName = "LumberPoplar"]</xpath>
					<value>
						<ThingDef ParentName="WoodLumberBase">
							<defName>LumberGulden</defName>
							<label>gulden lumber</label>
							<description>Processed gulden lumber. Mostly useful for building simple structures and furniture. Gulden is a durable softwood.</description>
							<graphicData>
								<color>(165,152,136)</color>
							</graphicData>
							<statBases>
								<Mass>0.5</Mass>
								<MarketValue>3.2</MarketValue>
								<DeteriorationRate>0.75</DeteriorationRate>
							</statBases>
							<stuffProps>
								<stuffAdjective>prehistoric</stuffAdjective>
								<commonality>0.3</commonality>
								<color>(165,152,136)</color>
								<statFactors>
									<MaxHitPoints>0.4</MaxHitPoints>
									<Beauty>3.25</Beauty>
									<WorkToMake>1</WorkToMake>
									<WorkToBuild>1</WorkToBuild>
								</statFactors>
							</stuffProps>
						</ThingDef>
					</value>
			</li>
			<li Class="PatchOperationInsert">
				<xpath>Defs/RecipeDef[defName = "MakeWoodLumberPoplar"]</xpath>
				<value>
					<RecipeDef ParentName="MakeWoodLumberBase">
						<defName>MakeWoodLumberGulden</defName>
						<label>make gulden lumber</label>
						<description>Process raw prehistoric logs into lumber for construction.</description>
						<allowMixingIngredients>false</allowMixingIngredients>
						<ingredients>
							<li>
								<filter>
									<thingDefs>
										<li>WoodLog_Gulden</li>
									</thingDefs>
								</filter>
								<count>15</count>
							</li>
						</ingredients>
						<fixedIngredientFilter>
							<thingDefs>
								<li>WoodLog_Gulden</li>
							</thingDefs>
						</fixedIngredientFilter>
						<products>
							<LumberGulden>30</LumberGulden>
						</products>
					</RecipeDef>
				</value>
			</li>			
			
		</operations>
		</match>
			
	</Operation>
	
	
</Patch>