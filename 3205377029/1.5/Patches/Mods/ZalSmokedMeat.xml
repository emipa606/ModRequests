<?xml version="1.0" encoding="utf-8"?>
<Patch>

	
<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Zal's Smoked Meat</li>
			<li>Zal's Smoked Meat PF Edition</li>
		</mods>
		<match Class="PatchOperationSequence">
			
			<operations>
				
		<li Class="PatchOperationRemove">
					<xpath>Defs/ThingDef[defName = "Zal_Smokepit"]/costList</xpath>					
				</li>

<li Class="PatchOperationInsert">
					<xpath>Defs/ThingDef[defName = "Zal_Smokepit"]/statBases</xpath>
					<value>
					<stuffCategories>
							<li>RawWoody</li>
						</stuffCategories>
						<costStuffCount>10</costStuffCount>
					</value>
				</li>

<li Class="PatchOperationRemove">
					<xpath>Defs/ThingDef[defName = "Zal_Smokepit"]/constructEffect</xpath>			
				</li>

<li Class="PatchOperationReplace">
					<xpath>Defs/ThingDef[defName = "Zal_Smokepit"]/graphicData/texPath</xpath>	
				<value>
					<texPath>Things/Building/Smokepit/Smokepit</texPath>
				</value>		
				</li>

<!--<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName = "Zal_Smokepit"]/</xpath>
					<value>
					<uiIconPath>Things/Building/Misc/Campfire</uiIconPath>
					</value>
				</li>-->

			</operations>
		</match>
	</Operation>
	
	
</Patch>