<?xml version="1.0" encoding="utf-8" ?>
<Patch>

<!-- Alpha bloat patches -->
<!--                     -->

<!-- Ocularkin -->
	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>Defs/GeneDef[defName="AG_OcularAffinity"]/biostatMet</xpath>
		<match Class="PatchOperationReplace">
			<xpath>/Defs/GeneDef[defName = "AG_OcularAffinity"]/biostatMet</xpath>
			<value>
				<biostatMet>-1</biostatMet>
			</value>
		</match>
	</Operation>
	
<!-- Malachai -->
	<Operation Class="PatchOperationReplace">
		<xpath>/Defs/GeneDef[defName="AG_Painless"]/biostatMet</xpath>
		<value>
			<biostatMet>-6</biostatMet>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationReplace"> <!-- Also affects Mind Devourers -->
