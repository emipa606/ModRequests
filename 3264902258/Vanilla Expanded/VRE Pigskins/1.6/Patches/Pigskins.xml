<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!-- Boarskins -->
	<Operation Class="PatchOperationRemove">
	<xpath>Defs/XenotypeDef[defName="VRE_Boarskin"]/genes/li[text()="StrongStomach"]</xpath>
	</Operation>
			
	<Operation Class="PatchOperationReplace">
	<xpath>/Defs/GeneDef[defName="VRE_Brave"]/biostatMet</xpath>
	<value>
		<biostatMet>-2</biostatMet>
	</value>
	</Operation>
		
	<Operation Class="PatchOperationSequence">
	<operations>
		<li Class="PatchOperationRemove">
			<xpath>Defs/XenotypeDef[defName="VRE_Boarskin"]/genes/li[text()="Immunity_Strong"]</xpath>
		</li>
	</operations>
	</Operation>

	<Operation Class="PatchOperationAdd">
    <xpath>Defs/XenotypeDef[defName="VRE_Boarskin"]/genes</xpath>
    <value>
		<li>Immunity_SuperStrong</li>
    </value>
	</Operation>
	
	<Operation Class="PatchOperationAddModExtension">
		<xpath>/Defs/GeneDef[defName = "GM_SlowAging"]</xpath>
		<value>
            <li Class="VEF.Genes.GeneExtension">
				<hideGene>true</hideGene>
			</li>
		</value>
	</Operation>
	
	<!-- Category Sorting -->
	<Operation Class="PatchOperationReplace">
		<xpath>/Defs/GeneDef[defName="VRE_RapidAging"]/displayCategory</xpath>
		<value>
			<displayCategory>GM_CellStability</displayCategory>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationReplace">
		<xpath>/Defs/GeneDef[defName="VRE_FastAging"]/displayCategory</xpath>
		<value>
			<displayCategory>GM_CellStability</displayCategory>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationReplace">
		<xpath>/Defs/GeneDef[defName="VRE_SlowAging"]/displayCategory</xpath>
		<value>
			<displayCategory>GM_CellStability</displayCategory>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationReplace">
		<xpath>/Defs/GeneDef[defName="VRE_MouthTusks"]/displayOrderInCategory</xpath>
		<value>
			<displayOrderInCategory>2100</displayOrderInCategory>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationReplace">
		<xpath>/Defs/GeneDef[defName="VRE_PigSkin"]/displayOrderInCategory</xpath>
		<value>
			<displayOrderInCategory>2001</displayOrderInCategory>
		</value>
	</Operation>
	
</Patch>