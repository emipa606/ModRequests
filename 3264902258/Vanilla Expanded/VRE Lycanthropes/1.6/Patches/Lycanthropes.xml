<?xml version="1.0" encoding="utf-8" ?>
<Patch>
		<!-- Lycans -->
		<Operation Class="PatchOperationAdd">
			<xpath>/Defs/XenotypeDef[defName="VRE_Lycan"]/genes</xpath>
			<value>
				<li>ArchiteMetabolism</li>
			</value>
		</Operation>
		
	<!-- Category Sorting -->
	<Operation Class="PatchOperationReplace">
		<xpath>/Defs/GeneDef[defName="VRE_SpeechInability"]/displayCategory</xpath>
		<value>
			<displayCategory>GM_Capacities</displayCategory>
		</value>
	</Operation>
		
	<Operation Class="PatchOperationReplace">
		<xpath>/Defs/GeneDef[defName="VRE_SpeechInability"]/displayOrderInCategory</xpath>
		<value>
			<displayOrderInCategory>47</displayOrderInCategory>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/GeneDef[defName="VRE_SpeechInability"]/exclusionTags</xpath>
		<value>
			<li>GM_DeafMute</li>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/GeneDef[defName="VRE_CanineNose"]/displayCategory</xpath>
		<value>
			<displayCategory>Cosmetic</displayCategory>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationReplace">
		<xpath>/Defs/GeneDef[defName="VRE_CanineNose"]/displayOrderInCategory</xpath>
			<value>
				<displayOrderInCategory>82.5</displayOrderInCategory>
			</value>
	</Operation>	
	
	<Operation Class="PatchOperationAddModExtension">
		<xpath>/Defs/GeneDef[defName = "GM_Mute"]</xpath>
		<value>
            <li Class="VEF.Genes.GeneExtension">
				<hideGene>true</hideGene>
			</li>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/GeneDef[defName="VRE_ChestFur"]</xpath>
		<value>
			<displayCategory>GM_BodyParts</displayCategory>
		</value>
	</Operation>
				
	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/GeneDef[defName="VRE_ChestFur"]</xpath>
		<value>
			<displayOrderInCategory>404.5</displayOrderInCategory>
		</value>
	</Operation>
	
</Patch>