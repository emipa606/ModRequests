<?xml version="1.0" encoding="utf-8" ?>
<Patch>
		<!-- Gene Categories	-->
		<Operation Class="PatchOperationReplace">
			<xpath>/Defs/GeneDef[defName="VRE_Maniac"]/displayCategory</xpath>
			<value>
				<displayCategory>Violence</displayCategory>
			</value>
		</Operation>
		
		<Operation Class="PatchOperationReplace">
			<xpath>/Defs/GeneDef[defName="VRE_Maniac"]/displayOrderInCategory</xpath>
			<value>
				<displayOrderInCategory>21.2</displayOrderInCategory>
			</value>
		</Operation>
		
		<Operation Class="PatchOperationAdd">
			<xpath>/Defs/GeneDef[defName="VRE_DreadHair"]</xpath>
			<value>
				<displayOrderInCategory>59</displayOrderInCategory>
			</value>
		</Operation>
		
		<Operation Class="PatchOperationAdd">
			<xpath>/Defs/GeneDef[defName="VRE_FacialSpots"]</xpath>
			<value>
				<displayOrderInCategory>2102</displayOrderInCategory>
			</value>
		</Operation>
		
		<Operation Class="PatchOperationAdd">
			<xpath>/Defs/GeneDef[defName="VRE_FacialSpots"]</xpath>
			<value>
				<displayCategory>Cosmetic</displayCategory>
			</value>
		</Operation>
		
		<Operation Class="PatchOperationReplace">
			<xpath>/Defs/GeneDef[defName="VRE_Leatherskin"]/displayCategory</xpath>
			<value>
				<displayCategory>GM_BodyParts</displayCategory>
			</value>
		</Operation>
		
				
		<Operation Class="PatchOperationReplace">
			<xpath>/Defs/GeneDef[defName="VRE_Leatherskin"]/displayOrderInCategory</xpath>
			<value>
				<displayOrderInCategory>402</displayOrderInCategory>
			</value>
