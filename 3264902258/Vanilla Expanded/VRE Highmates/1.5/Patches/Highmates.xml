<?xml version="1.0" encoding="utf-8" ?>
<Patch>
		
		<Operation Class="PatchOperationReplace">
			<xpath>/Defs/GeneDef[defName="VRE_Distressed"]/biostatMet</xpath>
			<value>
				<biostatMet>4</biostatMet>
			</value>
		</Operation>
		
		<Operation Class="PatchOperationReplace">
			<xpath>/Defs/GeneDef[defName="VRE_PerfectBody"]/biostatMet</xpath>
			<value>
				<biostatMet>0</biostatMet>
			</value>
		</Operation>
		
		<Operation Class="PatchOperationAddModExtension">
		<xpath>/Defs/GeneDef[defName = "GM_LovinDependency"]</xpath>
		<value>
            <li Class="VanillaGenesExpanded.GeneExtension">
				<hideGene>true</hideGene>
			</li>
		</value>
		</Operation>
		
</Patch>