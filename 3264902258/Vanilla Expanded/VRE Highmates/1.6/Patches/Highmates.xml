<?xml version="1.0" encoding="utf-8" ?>
<Patch>
		
		<Operation Class="PatchOperationReplace">
			<xpath>/Defs/GeneDef[defName="VRE_Distressed"]/biostatMet</xpath>
			<value>
				<biostatMet>1</biostatMet>
			</value>
		</Operation>
		
		<Operation Class="PatchOperationReplace">
			<xpath>/Defs/GeneDef[defName="VRE_PerfectBody"]/biostatMet</xpath>
			<value>
				<biostatMet>0</biostatMet>
			</value>
		</Operation>
		
		<Operation Class="PatchOperationAddModExtension">
		<xpath>/Defs/GeneDef[defName = "GM_LovinDependency"]</xpath>
		<value>
            <li Class="VEF.Genes.GeneExtension">
				<hideGene>true</hideGene>
			</li>
		</value>
		</Operation>
		
		<!--Category Patches-->
		
		<Operation Class="PatchOperationAdd">
			<xpath>/Defs/GeneDef[defName="VRE_FelineTail"]</xpath>
			<value>
				<displayOrderInCategory>2002</displayOrderInCategory>
			</value>
		</Operation>
		
		<Operation Class="PatchOperationAdd">
			<xpath>/Defs/GeneDef[defName="VRE_HighmateHair"]</xpath>
			<value>
				<displayOrderInCategory>59.2</displayOrderInCategory>
			</value>
		</Operation>
		
		<Operation Class="PatchOperationAdd">
			<xpath>/Defs/GeneDef[defName="VRE_PerfectBody"]</xpath>
			<value>
				<displayCategory>GM_BodyParts</displayCategory>
			</value>
		</Operation>
		
				
		<Operation Class="PatchOperationReplace">
			<xpath>/Defs/GeneDef[defName="VRE_PerfectBody"]/displayOrderInCategory</xpath>
			<value>
				<displayOrderInCategory>409</displayOrderInCategory>
			</value>
		</Operation>
		
		<Operation Class="PatchOperationReplace">
			<xpath>/Defs/GeneDef[defName="VRE_Distressed"]/displayOrderInCategory</xpath>
			<value>
				<displayOrderInCategory>-1</displayOrderInCategory>
			</value>
		</Operation>
		
</Patch>