			<xpath>/Defs/FactionDef[defName = "TribeCivilCustomVaried"]</xpath>
			<value>
				<xenotypeSet>
					<xenotypeChances>
						<VRE_Animakin>0.005</VRE_Animakin>
					</xenotypeChances>
				</xenotypeSet>
			</value>
		</nomatch>
		<match Class="PatchOperationAdd">
		<xpath>/Defs/FactionDef[defName = "TribeCivilCustomVaried"]/xenotypeSet/xenotypeChances</xpath>
			<value>
				<VRE_Animakin>0.005</VRE_Animakin>
			</value>
		</match>
	</Operation>
</Patch>