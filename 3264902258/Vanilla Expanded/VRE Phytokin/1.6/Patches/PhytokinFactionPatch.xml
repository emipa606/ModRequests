<?xml version="1.0" encoding="utf-8" ?>
<Patch>
		<!-- Gauranlenkin  -->
		
	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>/Defs/FactionDef[defName = "OutlanderMulticultural"]/xenotypeSet/xenotypeChances</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>/Defs/FactionDef[defName = "OutlanderMulticultural"]</xpath>
			<value>
				<xenotypeSet>
					<xenotypeChances>
						<VRE_Gauranlenkin>0.005</VRE_Gauranlenkin>
					</xenotypeChances>
				</xenotypeSet>
			</value>
		</nomatch>
		<match Class="PatchOperationAdd">
		<xpath>/Defs/FactionDef[defName = "OutlanderMulticultural"]/xenotypeSet/xenotypeChances</xpath>
			<value>
				<VRE_Gauranlenkin>0.005</VRE_Gauranlenkin>
			</value>
		</match>
	</Operation>
		
		<!-- Animakin  -->
	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>/Defs/FactionDef[defName = "TribeCivilCustomVaried"]/xenotypeSet/xenotypeChances</xpath>
