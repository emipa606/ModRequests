<?xml version="1.0" encoding="utf-8" ?>

<Patch>
		<!-- Wasters -->
		<Operation Class="PatchOperationReplace">
			<xpath>/Defs/GeneDef[defName="VRE_ToxAbsorption"]/biostatMet</xpath>
			<value>
				<biostatMet>-2</biostatMet>
			</value>
		</Operation>
		
		<!--Category Patches-->
		
		<Operation Class="PatchOperationReplace">
			<xpath>/Defs/GeneDef[defName="VRE_Instability_Nominal"]/displayOrderInCategory</xpath>
			<value>
				<displayOrderInCategory>129.5</displayOrderInCategory>
			</value>
		</Operation>
		
		<Operation Class="PatchOperationAdd">
			<xpath>/Defs/GeneDef[defName="VRE_Instability_Nominal"]</xpath>
			<value>
				<displayCategory>GM_CellStability</displayCategory>
			</value>
		</Operation>
		
		<Operation Class="PatchOperationReplace">
			<xpath>/Defs/GeneDef[defName="VRE_Instability_Extreme"]/displayOrderInCategory</xpath>
			<value>
				<displayOrderInCategory>136</displayOrderInCategory>
			</value>
		</Operation>
		
		<Operation Class="PatchOperationAdd">
			<xpath>/Defs/GeneDef[defName="VRE_Instability_Extreme"]</xpath>
			<value>
				<displayCategory>GM_CellStability</displayCategory>
			</value>
		</Operation>
		
		<Operation Class="PatchOperationReplace">
			<xpath>/Defs/GeneDef[defName="VRE_Instability_Progressive"]/displayOrderInCategory</xpath>
			<value>
				<displayOrderInCategory>137</displayOrderInCategory>
			</value>
		</Operation>
		
		<Operation Class="PatchOperationAdd">
			<xpath>/Defs/GeneDef[defName="VRE_Instability_Progressive"]</xpath>
			<value>
				<displayCategory>GM_CellStability</displayCategory>
			</value>
		</Operation>
		
		<Operation Class="PatchOperationConditional">
			<xpath>Defs/XenotypeDef[defName="Waster"]/genes/li[text()="VRE_GauntBody"]</xpath>
			<match Class="PatchOperationSequence">
				<operations>
					<li Class="PatchOperationReplace">
						<xpath>/Defs/GeneDef[defName="VRE_GauntBody"]/displayCategory</xpath>
						<value>
							<displayCategory>GM_BodyParts</displayCategory>
						</value>
					</li>
					<li Class="PatchOperationReplace">
						<xpath>/Defs/GeneDef[defName="VRE_GauntBody"]/displayOrderInCategory</xpath>
						<value>
							<displayOrderInCategory>405</displayOrderInCategory>
						</value>
					</li>
				</operations>
			</match>
		</Operation>
			
</Patch>