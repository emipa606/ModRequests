<?xml version="1.0" encoding="utf-8" ?>
<Defs>



<!-- Minor beneficial effects -->
  
    <GeneDef ParentName="GeneHandsBase">
    <defName>GM_Claws</defName> 
    <label>clawed hands</label>
    <iconPath>UI/Icons/Genes/GM_Claws</iconPath>
    <description>Carriers of this gene grow sharp, retractable claws. While not particularly useful otherwise, they provide some benefit in melee combat.</description>
    <displayOrderInCategory>330</displayOrderInCategory>
    <biostatMet>-1</biostatMet>
    <biostatCpx>1</biostatCpx>
    <statFactors>
      <MeleeDamageFactor>1.1</MeleeDamageFactor>
    </statFactors>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>claw</symbol></li>
        <li><symbol>sharp</symbol></li>
        <li><symbol>rip</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>mangle</symbol></li>
        <li><symbol>dactyl</symbol></li>
        <li><symbol>talon</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>
  
 <!-- Tail -->

  <GeneDef ParentName="GeneTailBase">
    <defName>GM_TailImp</defName>
    <label>imp tail</label>
    <description>Carriers of this gene grow a leathery, whip-like tail. While not particularly strong or agile, the tail is porous and helps regulate and mitigate heat.</description>
    <iconPath>UI/Icons/Genes/GM_ImpTail</iconPath>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
    <displayOrderInCategory>1150</displayOrderInCategory>
    <statOffsets>
      <ComfyTemperatureMax>10</ComfyTemperatureMax>
    </statOffsets>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <renderNodeProperties>
      <li>
        <workerClass>PawnRenderNodeWorker_AttachmentBody</workerClass>
        <texPath>Things/Pawn/Humanlike/BodyAttachments/ImpTail/ImpTail</texPath>
        <colorType>Skin</colorType>
        <overrideMeshSize>(1, 1)</overrideMeshSize>
        <parentTagDef>Body</parentTagDef>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <drawData>
          <scaleOffsetByBodySize>true</scaleOffsetByBodySize>
          <defaultData>
            <layer>-2</layer>
          </defaultData>
          <dataNorth>
            <offset>(-.1, 0, -0.55)</offset>
            <layer>90</layer>
          </dataNorth>
          <dataEast>
            <offset>(-.55, 0, -0.5)</offset>
          </dataEast>
          <dataSouth>
            <offset>(0.25, 0, -0.25)</offset>
          </dataSouth>
          <dataWest>
            <offset>(0.5, 0, -0.5)</offset>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>whip</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>imp</symbol></li>
        <li><symbol>snare</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef> 
  
</Defs>