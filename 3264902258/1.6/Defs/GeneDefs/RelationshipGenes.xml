<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- Lovin Dependency -->

 <GeneDef>
    <defName>GM_LovinDependency</defName>
    <label>Insatiable</label>
    <iconPath>UI/Icons/Genes/GM_LovinDependency</iconPath>
    <description>Carriers of this gene have an unusually intense psychological need for lovin'. After 15 days without lovin', carriers will suffer negative effects to their mood. This effect will increase over time.</description>
    <displayCategory>Reproduction</displayCategory>
    <displayOrderInCategory>400</displayOrderInCategory>
    <biostatMet>3</biostatMet>
    <biostatCpx>1</biostatCpx>
    <minAgeActive>16</minAgeActive>
    <enablesNeeds>
      <li>GM_Lovin</li>
    </enablesNeeds>
	<exclusionTags>
      <li>GM_Asexual</li>
    </exclusionTags>
	<geneClass>VanillaXenotypesImproved.Gene_AddedHediff</geneClass>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>love</symbol></li>
        <li><symbol>passion</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>max</symbol></li>
        <li><symbol>doll</symbol></li>
      </suffixSymbols>
    </symbolPack>
	<modExtensions>
      <li Class="VanillaXenotypesImproved.ModExtension_AddsHediff">
        <hediffDef>GM_InsatiableHediff</hediffDef>
	  </li>
    </modExtensions>
  </GeneDef>

  <HediffDef>
    <defName>GM_InsatiableHediff</defName>
    <label>Lovin' Need</label>
    <description>This person has a genetically-induced psychological dependency on lovin'. Without regular lovin', their psychological state will begin to unravel.\n\nTakes effect after age: 16.</description>
  </HediffDef>
  
<!-- Appealing gene -->  
<GeneDef>
  <defName>GM_Appealing</defName>
  <label>Appealing</label>
  <iconPath>UI/Icons/Genes/GM_Appealing</iconPath>
  <description>Carriers of this gene subconsciously make others invested in them. They are more likely to be the target of romance attempts and dislike being single. Breakups and affairs are more difficult for their partners to handle.</description>
  <displayCategory>Beauty</displayCategory>
  <displayOrderInCategory>100</displayOrderInCategory>
  <biostatMet>3</biostatMet>
  <biostatCpx>1</biostatCpx>
  <minAgeActive>16</minAgeActive>    
  <exclusionTags>
      <li>GM_Appealing</li>
    </exclusionTags>
</GeneDef>

<ThoughtDef>
  <defName>GM_AppealingLonely</defName>
  <label>lonely</label>
  <durationDays>-1</durationDays>
  <stages>
    <li>
      <label>lonely</label>
      <description>I really don't like being single.</description>
      <baseMoodEffect>-12</baseMoodEffect>
    </li>
  </stages>
  <workerClass>GM_ThoughtWorker_NeedsRelationship</workerClass>
</ThoughtDef>

<ThoughtDef>
  <defName>GM_AppealingCheatedOnMeMood</defName>
  <durationDays>30</durationDays>
  <nullifyingHediffs>
      <li MayRequire="Ludeon.RimWorld.Anomaly">Inhumanized</li>
  </nullifyingHediffs>
  <developmentalStageFilter>Adult</developmentalStageFilter>
  <stackLimit>2</stackLimit>
  <stages>
    <li>
      <label>cheated on by {0}</label>
      <description>It hurts more because of who it was.</description>
      <baseMoodEffect>-30</baseMoodEffect>
    </li>
  </stages>
</ThoughtDef>

<ThoughtDef>
    <defName>GM_AppealingBrokeUpWithMeMood</defName>
    <durationDays>30</durationDays>
    <stackLimit>2</stackLimit>
    <developmentalStageFilter>Adult</developmentalStageFilter>
    <nullifyingHediffs>
      <li MayRequire="Ludeon.RimWorld.Anomaly">Inhumanized</li>
    </nullifyingHediffs>
    <stages>
      <li>
        <label>broken up with by {0}</label>
        <description>I was just dumped by someone special.</description>
        <baseMoodEffect>-20</baseMoodEffect>
      </li>
    </stages>
</ThoughtDef>

<ThoughtDef>
  <defName>GM_AppealingDivorcedMeMood</defName>
  <durationDays>40</durationDays>
  <nullifyingHediffs>
      <li MayRequire="Ludeon.RimWorld.Anomaly">Inhumanized</li>
  </nullifyingHediffs>
  <developmentalStageFilter>Adult</developmentalStageFilter>
  <stackLimit>2</stackLimit>
  <stages>
    <li>
      <label>cheated on by {0}</label>
      <description>I was going to stay with them forever...</description>
      <baseMoodEffect>-40</baseMoodEffect>
    </li>
  </stages>
</ThoughtDef>

<!-- Minor beneficial effects -->

  <GeneDef>
    <defName>GM_Charming</defName>
    <label>charming</label>
    <iconPath>UI/Icons/Genes/GM_Charming</iconPath>
    <description>Carriers of this gene are unusually charming and persuasive.</description>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>402</displayOrderInCategory>
	<customEffectDescriptions>
		<li>Those without this gene will have a +20 opinion of the carrier.</li>
	</customEffectDescriptions>
    <biostatMet>-1</biostatMet>
    <biostatCpx>2</biostatCpx>
    <missingGeneRomanceChanceFactor>1.5</missingGeneRomanceChanceFactor>
	<statOffsets>
      <NegotiationAbility>.1</NegotiationAbility>
    </statOffsets>
    <exclusionTags>
      <li>GM_Charming</li>
    </exclusionTags>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>charm</symbol></li>
        <li><symbol>pull</symbol></li>
        <li><symbol>passion</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>caller</symbol></li>
        <li><symbol>bringer</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

