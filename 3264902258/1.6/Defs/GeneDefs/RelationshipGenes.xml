<!-- Minor detrimental effect -->

  <GeneDef>
    <defName>GM_Unsettling</defName>
    <label>unsettling</label>
    <description>Carriers of this gene are subconsciously offputting to others.</description>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>401</displayOrderInCategory>
	<customEffectDescriptions>
		<li>Those without this gene will have a -20 opinion of the carrier.</li>
	</customEffectDescriptions>
    <iconPath>UI/Icons/Genes/GM_Unsettling</iconPath>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
    <missingGeneRomanceChanceFactor>0.5</missingGeneRomanceChanceFactor>
	<statOffsets>
      <NegotiationAbility>-.25</NegotiationAbility>
    </statOffsets>
    <exclusionTags>
      <li>GM_Charming</li>
      <li>GM_Appealing</li>
    </exclusionTags>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>creep</symbol></li>
        <li><symbol>strange</symbol></li>
        <li><symbol>weird</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>death</symbol></li>
        <li><symbol>rend</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>
  
<!-- Sexuality genes -->
      
    <GeneDef Name="GM_RelationshipGeneBase" Abstract="True">
    <biostatCpx>0</biostatCpx>
    <biostatMet>0</biostatMet>
    <displayCategory>Reproduction</displayCategory>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
    <exclusionTags>
      <li>Sexuality</li>
    </exclusionTags>
    </GeneDef>
	
    <GeneDef ParentName="GM_RelationshipGeneBase">
    <defName>GM_Heterosexual</defName>
    <label>heterosexual</label>
    <description>Carriers of this gene are genetically heterosexual.</description>
    <displayOrderInCategory>200</displayOrderInCategory>
    <iconPath>UI/Icons/Genes/GM_Heterosexual</iconPath>
	<suppressedTraits>
      <li>
        <def>Gay</def>
      </li>
	  <li>
        <def>Asexual</def>
      </li>      
	  <li>
        <def>Bisexual</def>
      </li>
    </suppressedTraits>
    </GeneDef>

    <GeneDef ParentName="GM_RelationshipGeneBase">
    <defName>GM_Homosexual</defName>
    <label>homosexual</label>
    <description>Carriers of this gene are genetically homosexual.</description>
    <displayOrderInCategory>201</displayOrderInCategory>
    <iconPath>UI/Icons/Genes/GM_Homosexual</iconPath>
	<forcedTraits>
      <li>
        <def>Gay</def>
      </li>
    </forcedTraits>
    </GeneDef>
  
    <GeneDef ParentName="GM_RelationshipGeneBase">
    <defName>GM_Bisexual</defName>
    <label>bisexual</label>
    <description>Carriers of this gene are genetically bisexual.</description>
    <displayOrderInCategory>202</displayOrderInCategory>
    <iconPath>UI/Icons/Genes/GM_Bisexual</iconPath>
	<forcedTraits>
      <li>
        <def>Bisexual</def>
      </li>
    </forcedTraits>
    </GeneDef>
  
    <GeneDef ParentName="GM_RelationshipGeneBase">
    <defName>GM_Asexual</defName>
    <label>Asexual</label>
    <description>Carriers of this gene are genetically asexual.</description>
    <displayOrderInCategory>203</displayOrderInCategory>
    <iconPath>UI/Icons/Genes/GM_Asexual</iconPath>
	<forcedTraits>
      <li>
        <def>Asexual</def>
      </li>
    </forcedTraits>
	<exclusionTags>
      <li>GM_Asexual</li>
    </exclusionTags>
    </GeneDef>
</Defs>