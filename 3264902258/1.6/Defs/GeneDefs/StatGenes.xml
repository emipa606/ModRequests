<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- Minor beneficial effects -->

  <GeneDef>
    <defName>GM_Sharpsighted</defName>
    <label>sharpsighted</label>
    <iconPath>UI/Icons/Genes/GM_Gene_Sharpsighted</iconPath>
    <description>Carriers of this gene have sharp vision. Their shooting accuracy at long ranges is slightly increased.</description>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>51</displayOrderInCategory>
    <statFactors>
      <ShootingAccuracyFactor_Long>1.2</ShootingAccuracyFactor_Long>
      <ShootingAccuracyFactor_Medium>1.5</ShootingAccuracyFactor_Medium>
    </statFactors>
    <biostatMet>-2</biostatMet>
    <biostatCpx>1</biostatCpx>
    <exclusionTags>
      <li>GM_BlindSharpSighted</li>
      <li>ShootingAccuracy</li>
    </exclusionTags>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>sharp</symbol></li>
        <li><symbol>hawk</symbol></li>
        <li><symbol>crow</symbol></li>
        <li><symbol>fleet</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>sighter</symbol></li>
        <li><symbol>seer</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>
  
  <GeneDef>
    <defName>GM_KeenReflexes</defName>
    <label>keen reflexes</label>
    <iconPath>UI/Icons/Genes/GM_KeenReflexes</iconPath>
    <description>Carriers of this gene have keen reflexes. They are more difficult to hit in melee combat and fire guns more quickly.</description>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>63</displayOrderInCategory>
    <biostatMet>-2</biostatMet>
    <biostatCpx>2</biostatCpx>
	<statOffsets>
      <MeleeDodgeChance>10</MeleeDodgeChance>
      <AimingDelayFactor>-0.1</AimingDelayFactor>
    </statOffsets>
    <statFactors>
      <PawnTrapSpringChance>0.5</PawnTrapSpringChance>
    </statFactors>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>sharp</symbol></li>
        <li><symbol>fleet</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>dodger</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>
  
  <GeneDef>
    <defName>GM_MentallyResilient</defName>
    <label>mentally resilient</label>
    <iconPath>UI/Icons/Genes/GM_MentallyResilient</iconPath>
    <description>Carriers of this gene are mentally resilient. They are better able to adjust to harsh circumstances.</description>
    <displayCategory>Mood</displayCategory>
    <displayOrderInCategory>100</displayOrderInCategory>
    <biostatMet>-2</biostatMet>
    <biostatCpx>1</biostatCpx>
    <statFactors>
        <MentalBreakThreshold>.8</MentalBreakThreshold>
    </statFactors>
    <exclusionTags>
      <li>GM_MentalBreak</li>
    </exclusionTags>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>tough</symbol></li>
        <li><symbol>hold</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>earth</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>
  
    <GeneDef ParentName="CellInstabilityBase">
    <defName>GM_Gene_Stability</defName>
    <label>cell stability</label>
    <description>Carriers of this gene need more metabolic energy to stay alive due to telomeric safeguards that promote stability in their cell-replication machinery.</description>
    <displayCategory>GM_CellStability</displayCategory>
    <iconPath>UI/Icons/Genes/GM_Gene_Stability</iconPath>
    <displayOrderInCategory>129</displayOrderInCategory>
    <biostatMet>-2</biostatMet>
    <statFactors>
      <LifespanFactor>1.5</LifespanFactor>
      <CancerRate>.5</CancerRate>
      <ImmunityGainSpeed>1.1</ImmunityGainSpeed>
    </statFactors>
  </GeneDef>
  
  <GeneDef>
    <defName>GM_ImprovedMining</defName>
    <label>stone sense</label>
    <description>Carriers of this gene are genetically predisposed towards stone. This sense of comfort and familiarity increases their mining efficiency.</description>
    <iconPath>UI/Icons/Genes/GM_ImprovedMining</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>2000</displayOrderInCategory>
    <biostatMet>-1</biostatMet>
    <statFactors>
      <MiningYield>1.1</MiningYield>
    </statFactors>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>stone</symbol></li>
        <li><symbol>mine</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>earth</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>
  
   <GeneDef>
    <defName>GM_GreenThumb</defName> <!-- Needs C# to add a hediff that gives an attack. Doesn't feel worth it -->
    <label>natural touch</label>
    <iconPath>UI/Icons/Genes/GM_GreenThumb</iconPath>
    <description>Carriers of this gene possess special glands in their skin that release pheromones many animals find pleasant.</description>
    <displayCategory>Miscellaneous</displayCategory>
    <displayOrderInCategory>2100</displayOrderInCategory>
    <biostatMet>-1</biostatMet>
    <biostatCpx>1</biostatCpx>
	<statFactors>
      <TameAnimalChance>1.5</TameAnimalChance>
    </statFactors>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>nature</symbol></li>
        <li><symbol>green</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>caller</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

<!-- Minor detrimental effects -->

  <GeneDef ParentName="FertilityBase">
    <defName>GM_LessFertile</defName>
    <label>less fertile</label>
    <description>Carriers of this gene have a lower chance of becoming pregnant or impregnating others.</description>
    <iconPath>UI/Icons/Genes/GM_LessFertile</iconPath>
    <displayOrderInCategory>101</displayOrderInCategory>
    <statFactors>
      <Fertility>.25</Fertility>
    </statFactors>
  </GeneDef>
  
  <GeneDef>
    <defName>GM_MentallyFragile</defName>
    <label>neurotic</label>
    <iconPath>UI/Icons/Genes/GM_MentallyFragile</iconPath>
    <description>Carriers of this gene are less mentally resilient. They are less able to adjust to harsh circumstances.</description>
    <displayCategory>Mood</displayCategory>
    <displayOrderInCategory>101</displayOrderInCategory>
    <biostatMet>2</biostatMet>
    <biostatCpx>1</biostatCpx>
    <statFactors>
        <MentalBreakThreshold>1.2</MentalBreakThreshold>
    </statFactors>
    <exclusionTags>
      <li>GM_MentalBreak</li>
    </exclusionTags>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>weak</symbol></li>
        <li><symbol>delicate</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>mien</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

<!-- Major beneficial effects -->

  <GeneDef ParentName="UVSensitivityBase">
    <defName>GM_SolarEnthusiasm</defName>
    <label>solar enthusiasm</label>
    <description>Carriers of this gene have biological compounds in their skin that aggressively metabolize UV radiation. They are rejuvenated by sunlight.</description>
    <iconPath>UI/Icons/Genes/GM_SolarEnthusiasm</iconPath>
    <displayOrderInCategory>59.5</displayOrderInCategory>
    <conditionalStatAffecters>
      <li Class="ConditionalStatAffecter_InSunlight">
        <statOffsets>
          <MoveSpeed>.2</MoveSpeed>
          <WorkSpeedGlobal>.1</WorkSpeedGlobal>
        </statOffsets>
      </li>
    </conditionalStatAffecters>
    <biostatCpx>3</biostatCpx>
    <biostatMet>-2</biostatMet>
    <dislikesSunlight>false</dislikesSunlight>
    <exclusionTags>
      <li>GM_LightEnthusiasm</li>
    </exclusionTags>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>hot</symbol></li>
        <li><symbol>heat</symbol></li>
        <li><symbol>sun</symbol></li>
        <li><symbol>sweat</symbol></li>
        <li><symbol>bake</symbol></li>
        <li><symbol>solar</symbol></li>
      </prefixSymbols>
    </symbolPack>
  </GeneDef>
  
    <ThoughtDef>
    <defName>GM_SunlightEnthusiasm</defName>
    <workerClass>ThoughtWorker_InSunlight</workerClass>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <requiredGenes>
      <li>GM_SolarEnthusiasm</li>
    </requiredGenes>
    <stages>
      <li>
        <label>sunlight enthusiasm</label>
        <description>The light of the sun feels so good on my skin. This is where I'm meant to be.</description>
        <baseMoodEffect>15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  
  <GeneDef ParentName="UVSensitivityBase">
    <defName>GM_LunarEnthusiasm</defName>
    <label>lunar enthusiasm</label>
    <description>Carriers of this gene have metabolic reserves that are triggered by dark, open spaces. They are rejuvenated by the open sky at night.</description>
    <iconPath>UI/Icons/Genes/GM_LunarEnthusiasm</iconPath>
    <displayOrderInCategory>59.6</displayOrderInCategory>
    <conditionalStatAffecters>
      <li Class="VanillaXenotypesImproved.ConditionalStatAffecter_OutsideInDark">
        <statOffsets>
          <MoveSpeed>.2</MoveSpeed>
          <WorkSpeedGlobal>.1</WorkSpeedGlobal>
        </statOffsets>
      </li>
    </conditionalStatAffecters>
    <biostatCpx>3</biostatCpx>
    <biostatMet>-2</biostatMet>
    <dislikesSunlight>false</dislikesSunlight>
    <exclusionTags Inherit="false">
      <li>GM_LightEnthusiasm</li>
    </exclusionTags>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>cold</symbol></li>
        <li><symbol>cool</symbol></li>
        <li><symbol>moon</symbol></li>
        <li><symbol>lunar</symbol></li>
      </prefixSymbols>
    </symbolPack>
  </GeneDef>
    
  <ThoughtDef>
    <defName>GM_LunarEnthusiasm</defName>
    <workerClass>VanillaXenotypesImproved.ThoughtWorker_OutsideInDark</workerClass>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <requiredGenes>
      <li>GM_LunarEnthusiasm</li>
    </requiredGenes>
    <stages>
      <li>
        <label>lunar enthusiasm</label>
        <description>The wide open darkness covers me like a blanket.</description>
        <baseMoodEffect>15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  
    <GeneDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>GM_StellarEnthusiasm</defName>
    <label>stellar enthusiasm</label>
    <displayCategory>ResistanceAndWeakness</displayCategory>
    <description>Carriers of this gene have metabolic reserves that are triggered in space. They are rejuvenated while in unroofed space.</description>
    <iconPath>UI/Icons/Genes/GM_StellarEnthusiasm</iconPath>
    <displayOrderInCategory>59.7</displayOrderInCategory>
    <conditionalStatAffecters>
      <li Class="VanillaXenotypesImproved.GM_ConditionalStatAffecter_PawnInSpace">
        <statOffsets>
          <MoveSpeed>.2</MoveSpeed>
          <WorkSpeedGlobal>.1</WorkSpeedGlobal>
        </statOffsets>
      </li>
    </conditionalStatAffecters>
    <biostatCpx>3</biostatCpx>
    <biostatMet>-2</biostatMet>
    <exclusionTags>
      <li>GM_LightEnthusiasm</li>
    </exclusionTags>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>stellar</symbol></li>
        <li><symbol>space</symbol></li>
        <li><symbol>nubula</symbol></li>
        <li><symbol>star</symbol></li>
      </prefixSymbols>
    </symbolPack>
  </GeneDef>
  
  <ThoughtDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>GM_StellarEnthusiasm</defName>
    <workerClass>VanillaXenotypesImproved.ThoughtWorker_PawnInSpace</workerClass>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <requiredGenes>
      <li>GM_StellarEnthusiasm</li>
    </requiredGenes>
    <stages>
      <li>
        <label>stellar enthusiasm</label>
        <description>The vastness of space is all around me. I belong here.</description>
        <baseMoodEffect>15</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

 <GeneDef>
    <defName>GM_SlowAging</defName>
    <label>slow aging</label>
    <description>Carriers of this gene possess a complex assortment of metabolic safeguards against aging. Starting at the age of 18, carriers begin to age more slowly.</description>
    <iconPath>UI/Icons/Genes/GM_SlowAging</iconPath>
    <displayCategory>GM_CellStability</displayCategory>
    <displayOrderInCategory>128</displayOrderInCategory>
    <biologicalAgeTickFactorFromAgeCurve>
      <points>
        <li>(18, 1)</li>
        <li>(19, .8)</li>
      </points>
    </biologicalAgeTickFactorFromAgeCurve>
    <biostatMet>-2</biostatMet>
    <biostatCpx>3</biostatCpx>
    <exclusionTags>
      <li>Pawn_Aging</li>
    </exclusionTags>
  </GeneDef>

  <GeneDef>
    <defName>GM_GoodFineMotor</defName>
    <label>fine motor precision</label>
    <description>Carriers of this gene have distinct control over their fine motor skills. They are good with their hands, which benefits them in many areas.</description>
    <iconPath>UI/Icons/Genes/GM_GoodFineMotor</iconPath>
    <displayOrderInCategory>64</displayOrderInCategory>
    <biostatMet>-2</biostatMet>
    <statFactors>
      <SurgerySuccessChanceFactor>1.1</SurgerySuccessChanceFactor>
      <GeneralLaborSpeed>1.05</GeneralLaborSpeed>
    </statFactors>
    <exclusionTags>
      <li>GM_FineMotor</li>
    </exclusionTags>
  </GeneDef>

<!-- Major detrimental effects -->

  <GeneDef>
    <defName>GM_PoorFineMotor</defName>
    <label>fine motor malus</label>
    <description>Carriers of this gene have difficulty with fine motor control. It will take them longer to do many kinds of tasks and they are somewhat unskilled with their hands.</description>
    <iconPath>UI/Icons/Genes/GM_PoorFineMotor</iconPath>
    <displayOrderInCategory>64</displayOrderInCategory>
    <biostatMet>3</biostatMet>
    <statFactors>
      <SurgerySuccessChanceFactor>0.8</SurgerySuccessChanceFactor>
      <GeneralLaborSpeed>0.9</GeneralLaborSpeed>
    </statFactors>
    <exclusionTags>
      <li>GM_FineMotor</li>
    </exclusionTags>
  </GeneDef>
  
  <GeneDef>
    <defName>GM_NerveStapled</defName>
    <label>nerve-stapled</label>
    <description>Carriers of this gene have extremely elevated moods, at the cost of their higher mental functions.</description>
    <iconPath>UI/Icons/Genes/GM_NerveStapled</iconPath>
    <displayOrderInCategory>64</displayOrderInCategory>
    <displayCategory>Mood</displayCategory>
    <biostatMet>2</biostatMet>
    <capMods>
      <li>
        <capacity>Consciousness</capacity>
        <postFactor>0.8</postFactor>
      </li>
    </capMods>
    <missingGeneRomanceChanceFactor>0</missingGeneRomanceChanceFactor>
    <disabledWorkTags>
      <li>Caring</li>
      <li>Cooking</li>
      <li>Constructing</li>
      <li>Crafting</li>
      <li>Intellectual</li>
    </disabledWorkTags>
    <exclusionTags>
      <li>Mood</li>
    </exclusionTags>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>deaf</symbol></li>
        <li><symbol>blank</symbol></li>
        <li><symbol>null</symbol></li>
        <li><symbol>vac</symbol></li>
        <li><symbol>void</symbol></li>
        <li><symbol>drone</symbol></li>
        <li><symbol>labor</symbol></li>
      </prefixSymbols>
    </symbolPack>
  </GeneDef>

 <GeneDef>
    <defName>GM_Blind</defName>
    <label>blind</label>
    <description>Carriers of this gene are genetically blind due to the suppression of visual processing in the brain.</description>
    <iconPath>UI/Icons/Genes/GM_Blind</iconPath>
    <displayCategory>GM_Capacities</displayCategory>
    <biostatMet>6</biostatMet>
    <biostatCpx>2</biostatCpx>
    <capMods>
      <li>
        <capacity>Sight</capacity>
        <postFactor>0</postFactor>
      </li>
    </capMods>
    <exclusionTags>
      <li>GM_BlindSharpSighted</li>
	  <li>GM_BlindDarkvision</li>
	  <li>GM_BlindNearsighted</li>
    </exclusionTags>
    <displayOrderInCategory>49</displayOrderInCategory>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>blind</symbol></li>
        <li><symbol>blur</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>ract</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>
  
     <GeneDef>
    <defName>GM_Deaf</defName>
    <label>deaf</label>
    <description>Carriers of this gene are genetically deaf due to the suppression of audio processing in the brain.</description>
    <iconPath>UI/Icons/Genes/GM_Deaf</iconPath>
    <displayCategory>GM_Capacities</displayCategory>
    <biostatMet>4</biostatMet>
    <biostatCpx>1</biostatCpx>
    <capMods>
      <li>
        <capacity>Hearing</capacity>
        <postFactor>0</postFactor>
      </li>
    </capMods>
    <exclusionTags>
      <li>GM_DeafMute</li>
    </exclusionTags>
    <displayOrderInCategory>48</displayOrderInCategory>
  </GeneDef>
  
   <GeneDef>
    <defName>GM_Mute</defName>
    <label>mute</label>
    <description>Carriers of this gene are genetically mute due to the suppression of muscular control of the larynx.</description>
    <iconPath>UI/Icons/Genes/GM_Mute</iconPath>
    <displayCategory>GM_Capacities</displayCategory>
    <biostatMet>3</biostatMet>
    <biostatCpx>1</biostatCpx>
    <capMods>
      <li>
        <capacity>Talking</capacity>
        <postFactor>0</postFactor>
      </li>
    </capMods>
    <exclusionTags>
      <li>GM_DeafMute</li>
    </exclusionTags>
    <displayOrderInCategory>47</displayOrderInCategory>
  </GeneDef>
  
   <GeneDef>
    <defName>GM_Prole</defName>
    <label>worker drone</label>
    <description>Carriers of this gene are physiologically inhibited from using neural pathways necessary for higher intellectualism and artistry. They are slow to solve problems and are incapable of understanding art.</description>
    <iconPath>UI/Icons/Genes/GM_Prole</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatMet>3</biostatMet>
    <biostatCpx>3</biostatCpx>
    <disabledWorkTags>
	  <li>Artistic</li>
    </disabledWorkTags>
	<statFactors>
      <ReadingSpeed>0.5</ReadingSpeed>
      <HackingSpeed>0.8</HackingSpeed>
      <HackingStealth>0.8</HackingStealth>
      <ResearchSpeed>0.2</ResearchSpeed>
      <EntityStudyRate MayRequire="Ludeon.RimWorld.Anomaly">0.5</EntityStudyRate>
    </statFactors>
    <displayOrderInCategory>406</displayOrderInCategory>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>drone</symbol></li>
        <li><symbol>worker</symbol></li>
      </prefixSymbols>
    </symbolPack>
  </GeneDef>
  
   <GeneDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>GM_Nonterrestrial</defName>
    <label>nonterrestrial</label>
    <description>Carriers of this gene have lower muscle mass and reduced physical strength due to a lack of tolerance to gravity. Gravity is uncomfortable for them and they will be in pain while on the surface of a planet.</description>
    <iconPath>UI/Icons/Genes/GM_Nonterrestrial</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <geneClass>VanillaXenotypesImproved.GM_AddGravitySicknessOnSurface</geneClass>
    <biostatMet>4</biostatMet>
    <biostatCpx>1</biostatCpx>
    <displayOrderInCategory>900</displayOrderInCategory>
	<customEffectDescriptions>
		<li>Pain +15% (planetside)</li>
		<li>Comfort capped at 25% (planetside)</li>
	</customEffectDescriptions>
  </GeneDef>
</Defs>