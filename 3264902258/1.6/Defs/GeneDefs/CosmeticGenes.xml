<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- New Eye Colors -->

  <GeneDef ParentName="GeneEyeColor">
    <defName>GM_Eyes_Standard</defName>
    <label>Standard eyes</label>
    <description>Carriers of these genes have the standard range of human eye colors.</description>
    <iconPath>UI/Icons/Genes/GM_Gene_StandardEyes</iconPath>
    <displayOrderInCategory>-1</displayOrderInCategory>
  </GeneDef>

  <GeneDef ParentName="GeneEyeColor">
    <defName>GM_Eyes_Purple</defName>
    <label>Purple eyes</label>
    <labelShortAdj>Purple-eyed</labelShortAdj>
    <description>Carriers of this gene have deeply purple-pigmented eyes.</description>
    <iconPath>UI/Icons/Genes/GM_Gene_PurpleEyes</iconPath>
    <displayOrderInCategory>2</displayOrderInCategory>
    <renderNodeProperties>
      <li Class="PawnRenderNodeProperties_Eye">
        <texPath>Things/Pawn/Humanlike/HeadAttachments/PurpleEyes/Male/GM_PurpleEyes_Male</texPath>
        <texPathFemale>Things/Pawn/Humanlike/HeadAttachments/PurpleEyes/Female/GM_PurpleEyes_Female</texPathFemale>
        <anchorTag>RightEye</anchorTag>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <parentTagDef>Head</parentTagDef>
        <drawSize>0.2</drawSize>
        <side>Right</side>
        <drawData>
          <defaultData>
            <layer>54</layer>
            <offset>(0, 0, -0.25)</offset>
          </defaultData>
        </drawData>
      </li>
      <li Class="PawnRenderNodeProperties_Eye">
        <texPath>Things/Pawn/Humanlike/HeadAttachments/PurpleEyes/Male/GM_PurpleEyes_Male</texPath>
        <texPathFemale>Things/Pawn/Humanlike/HeadAttachments/PurpleEyes/Female/GM_PurpleEyes_Female</texPathFemale>
        <anchorTag>LeftEye</anchorTag>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <parentTagDef>Head</parentTagDef>
        <drawSize>0.2</drawSize>
        <side>Left</side>
        <drawData>
          <defaultData>
            <layer>54</layer>
            <offset>(0, 0, -0.25)</offset>
            <flip>true</flip>
          </defaultData>
          <dataWest>
            <flip>false</flip>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
  </GeneDef>

  <GeneDef ParentName="GeneEyeColor">
    <defName>GM_Eyes_Yellow</defName>
    <label>yellow eyes</label>
    <labelShortAdj>yellow-eyed</labelShortAdj>
    <description>Carriers of this gene have deeply yellow-pigmented eyes.</description>
    <iconPath>UI/Icons/Genes/GM_Gene_YellowEyes</iconPath>
    <displayOrderInCategory>3</displayOrderInCategory>
    <renderNodeProperties>
      <li Class="PawnRenderNodeProperties_Eye">
        <texPath>Things/Pawn/Humanlike/HeadAttachments/YellowEyes/Male/GM_YellowEyes_Male</texPath>
        <texPathFemale>Things/Pawn/Humanlike/HeadAttachments/YellowEyes/Female/GM_YellowEyes_Female</texPathFemale>
        <anchorTag>RightEye</anchorTag>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <parentTagDef>Head</parentTagDef>
        <drawSize>0.2</drawSize>
        <side>Right</side>
        <drawData>
          <defaultData>
            <layer>54</layer>
            <offset>(0, 0, -0.25)</offset>
          </defaultData>
        </drawData>
      </li>
      <li Class="PawnRenderNodeProperties_Eye">
        <texPath>Things/Pawn/Humanlike/HeadAttachments/YellowEyes/Male/GM_YellowEyes_Male</texPath>
        <texPathFemale>Things/Pawn/Humanlike/HeadAttachments/YellowEyes/Female/GM_YellowEyes_Female</texPathFemale>
        <anchorTag>LeftEye</anchorTag>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <parentTagDef>Head</parentTagDef>
        <drawSize>0.2</drawSize>
        <side>Left</side>
        <drawData>
          <defaultData>
            <layer>54</layer>
            <offset>(0, 0, -0.25)</offset>
            <flip>true</flip>
          </defaultData>
          <dataWest>
            <flip>false</flip>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
  </GeneDef>

<!-- New Ears -->

  <GeneDef ParentName="GeneEarsBase">
    <defName>GM_Ears_Cat</defName>
    <label>hairless high ears</label>
    <description>Carriers of this gene have hairless, elongated ears at the tops of their heads.</description>
    <iconPath>UI/Icons/Genes/Gene_EarCat</iconPath>
    <renderNodeProperties>
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPath>Things/Pawn/Humanlike/HeadAttachments/CatEars/CatEars</texPath>
        <colorType>Skin</colorType>
        <parentTagDef>Head</parentTagDef>
        <useSkinShader>true</useSkinShader>
        <useRottenColor>true</useRottenColor>
        <rotDrawMode>Fresh, Rotting</rotDrawMode>
        <drawData>
          <defaultData>
            <layer>70</layer>
          </defaultData>
        </drawData>
      </li>
    </renderNodeProperties>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>cat</symbol></li>
        <li><symbol>kitty</symbol></li>
        <li><symbol>kit</symbol></li>
        <li><symbol>tabby</symbol></li>
        <li><symbol>tom</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>cat</symbol></li>
        <li><symbol>kitten</symbol></li>
        <li><symbol>tabby</symbol></li>
        <li><symbol>tom</symbol></li>
        <li><symbol>ear</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>
  
	<GeneDef ParentName="GeneEarsBase">
		<defName>GM_side_elf_ears</defName>   <!-- The small elf ears were obtained from Horns & Ears & Things mod by chiomaus -->
		<label>horizontal pointed ears</label>
		<description>Carriers of this gene have pointed ears that extend out to the side of the head.</description>
		<iconPath>UI/Icons/Genes/GM_small_elf_ears</iconPath>
		<renderNodeProperties>
			<li>
				<nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
				<workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
				<texPath>Things/Pawn/Humanlike/HeadAttachments/GM_small_elf_ears/GM_small_elf_ears</texPath>
				<colorType>Skin</colorType>
				<parentTagDef>Head</parentTagDef>
				<useSkinShader>true</useSkinShader>
				<useRottenColor>true</useRottenColor>
				<rotDrawMode>Fresh, Rotting</rotDrawMode>
				<drawData>
					<defaultData>
						<layer>70</layer>
					</defaultData>
				</drawData>
			</li>
		</renderNodeProperties>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>point</symbol></li>
        <li><symbol>sharp</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>ear</symbol></li>
        <li><symbol>point</symbol></li>
      </suffixSymbols>
    </symbolPack>
	</GeneDef>

<!-- New Skin Tones and Hair Colors -->

  <GeneDef ParentName="GeneSkinColorOverride">
    <defName>GM_Skin_Pink</defName>
    <label>soft pink skin</label>
    <description>Carriers of this gene produce a pigment that turns their skin a pale pink color.</description>
    <randomBrightnessFactor>0</randomBrightnessFactor>
    <skinColorOverride>(255,184,191)</skinColorOverride>
    <displayOrderInCategory>79</displayOrderInCategory>
    <symbolPack>
	<prefixSymbols>
        <li><symbol>pink</symbol></li>
        <li><symbol>blush</symbol></li>
    </prefixSymbols>
    </symbolPack>
  </GeneDef>
  
    <GeneDef ParentName="GeneSkinColorOverride">
    <defName>GM_Skin_Teal</defName>
    <label>teal skin</label>
    <description>Carriers of this gene produce a pigment that turns their skin an oceanic teal color.</description>
    <randomBrightnessFactor>0</randomBrightnessFactor>
    <skinColorOverride>(13,148,148)</skinColorOverride>
    <displayOrderInCategory>86</displayOrderInCategory>
    <symbolPack>
	<prefixSymbols>
        <li><symbol>teal</symbol></li>
        <li><symbol>ocean</symbol></li>
    </prefixSymbols>
    </symbolPack>
  </GeneDef>
  
  <GeneDef ParentName="GeneHairColorBase">
    <defName>GM_Hair_DeepRed</defName>
    <label>deep red hair</label>
    <hairColorOverride>(165, 42, 42)</hairColorOverride>
    <displayOrderInCategory>200</displayOrderInCategory>
    <selectionWeight>0.05</selectionWeight>
  </GeneDef>
  
  
