<?xml version="1.0" encoding="utf-8" ?>

<Defs>

 <!-- Unsettling -->
   <ThoughtDef>
    <defName>GM_Unsettling</defName>
	<thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>VanillaXenotypesImproved.ThoughtWorker_UnsettlingGene</workerClass>
	<nullifyingTraits>
		<li>Psychopath</li>
	</nullifyingTraits>		
	<nullifyingHediffs>
		<li MayRequire="Ludeon.RimWorld.Anomaly">Inhumanized</li>
	</nullifyingHediffs>
	<stages>
		<li>
			<label>offputting</label>
			<baseOpinionOffset>-20</baseOpinionOffset>
		</li>
	</stages>
  </ThoughtDef>
  
   <!-- Charming -->
   <ThoughtDef>
    <defName>GM_Charming</defName>
	<thoughtClass>Thought_SituationalSocial</thoughtClass>
    <workerClass>VanillaXenotypesImproved.ThoughtWorker_CharmingGene</workerClass>
	<nullifyingTraits>
		<li>Psychopath</li>
	</nullifyingTraits>		
	<nullifyingHediffs>
		<li MayRequire="Ludeon.RimWorld.Anomaly">Inhumanized</li>
	</nullifyingHediffs>
	<stages>
		<li>
			<label>charming</label>
			<baseOpinionOffset>20</baseOpinionOffset>
		</li>
	</stages>
  </ThoughtDef>
  
  <!-- Nerve stapled -->
  <ThoughtDef>
    <defName>GM_NerveStapledMood</defName>
    <workerClass>ThoughtWorker_AlwaysActive</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <requiredGenes>
      <li>GM_NerveStapled</li>
    </requiredGenes>
    <stages>
      <li>
        <label>nerve stapled</label>
        <description>No worry. No fear. Happy... Happy...</description>
        <baseMoodEffect>50</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

 <!-- Lovin Dependency -->
  <ThoughtDef>
    <defName>GM_LovinDependency_Mild</defName>
    <workerClass>VanillaXenotypesImproved.ThoughtWorker_LovinDependency</workerClass>
    <developmentalStageFilter>Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>lovin' desire</label>
        <description>It's been too long. I need to find someone.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
	  <li>
        <label>lovin' desperation</label>
        <description>I can't take this anymore! I don't even care who it is.</description>
        <baseMoodEffect>-20</baseMoodEffect>
      </li>
    </stages>
	<nullifyingTraits>
      <li>Asexual</li>
    </nullifyingTraits>
  </ThoughtDef>
 
 
