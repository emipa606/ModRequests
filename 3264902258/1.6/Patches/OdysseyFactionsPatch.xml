<?xml version="1.0" encoding="utf-8" ?>
<Patch>

<!--Adds custom xenotypes from other mod to new factions-->

<Operation Class="PatchOperationSequence">
<operations>

 <li MayRequire="Ludeon.RimWorld.Odyssey" Class="PatchOperationAdd">
	<xpath>Defs/FactionDef[defName="TradersGuild"]/xenotypeSet/xenotypeChances</xpath>
	  <value>
	    <Kitul>.05</Kitul>
	    <Prole>.05</Prole>
	    <Nizhar>.05</Nizhar>
	  </value>
</li>

 <li MayRequire="Ludeon.RimWorld.Odyssey" Class="PatchOperationAdd">
	<xpath>Defs/FactionDef[defName="Salvagers"]/xenotypeSet/xenotypeChances</xpath>
	  <value>
	    <Kitul>.1</Kitul>
	    <Nizhar>.1</Nizhar>
	  </value>
</li>

</operations>
</Operation>

</Patch>