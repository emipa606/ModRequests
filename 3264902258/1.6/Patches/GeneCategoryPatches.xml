<?xml version="1.0" encoding="utf-8" ?>
<Patch>

<Operation Class="PatchOperationSequence">
  <operations>
  
<!-- Cell stability -->
  
	<li Class="PatchOperationReplace">
	<xpath>Defs/GeneDef[defName="Inbred"]/displayCategory</xpath>
	  <value>
        <displayCategory>GM_CellStability</displayCategory>
	  </value>
    </li>
	
	<li Class="PatchOperationAdd">
	<xpath>Defs/GeneDef[defName="Instability_Mild"]</xpath>
	  <value>
        <displayCategory>GM_CellStability</displayCategory>
	  </value>
    </li>
	
	<li Class="PatchOperationAdd">
	<xpath>Defs/GeneDef[defName="Instability_Major"]</xpath>
	  <value>
        <displayCategory>GM_CellStability</displayCategory>
	  </value>
    </li>
	
<!-- Body Parts -->

	<li Class="PatchOperationReplace">
	<xpath>Defs/GeneDef[@Name="GeneHandsBase"]/displayCategory</xpath>
	  <value>
        <displayCategory>GM_BodyParts</displayCategory>
	  </value>
    </li>
	
	<li Class="PatchOperationReplace">
	<xpath>Defs/GeneDef[@Name="GeneTailBase"]/displayCategory</xpath>
	  <value>
        <displayCategory>GM_BodyParts</displayCategory>
	  </value>
    </li>
	
	<li Class="PatchOperationReplace">
	<xpath>Defs/GeneDef[defName="Furskin"]/displayCategory</xpath>
	  <value>
        <displayCategory>GM_BodyParts</displayCategory>
	  </value>
    </li>
	
	<li Class="PatchOperationReplace">
	<xpath>Defs/GeneDef[defName="Hair_Grayless"]/displayCategory</xpath>
	  <value>
        <displayCategory>GM_BodyParts</displayCategory>
	  </value>
    </li>

<!-- Move Pig Nose to Cosmetic Category -->

    <li Class="PatchOperationReplace">
	<xpath>Defs/GeneDef[defName="Nose_Pig"]/displayCategory</xpath>
	  <value>
        <displayCategory>Cosmetic</displayCategory>
	  </value>
    </li>
	
	<li Class="PatchOperationReplace">
	<xpath>Defs/GeneDef[defName="Nose_Pig"]/displayOrderInCategory</xpath>
	  <value>
        <displayOrderInCategory>81</displayOrderInCategory>
	  </value>
    </li>

  </operations>
</Operation>



</Patch>