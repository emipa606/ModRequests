<?xml version="1.0" encoding="utf-8" ?>
<Patch>

<!-- Ability cooldown patches -->
<!--                          -->

<Operation Class="PatchOperationSequence">
  <operations>
  <li Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="FireSpew"]/cooldownTicksRange</xpath>
    <value>
      <cooldownTicksRange>150000</cooldownTicksRange> <!-- 60000 ticks per day, so 2.5 days -->
    </value>
  </li>
  
  <li Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="FoamSpray"]/cooldownTicksRange</xpath>
    <value>
      <cooldownTicksRange>5000</cooldownTicksRange> <!-- 2 hours -->
    </value>
  </li>
  
  <li Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="AcidSpray"]/cooldownTicksRange</xpath>
    <value>
      <cooldownTicksRange>2500</cooldownTicksRange> <!-- 1 hour -->
    </value>
  </li>
  
  <li Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="AnimalWarcall"]/cooldownTicksRange</xpath>
    <value>
      <cooldownTicksRange>150000</cooldownTicksRange> <!-- 2.5 days -->
    </value>
  </li>
  </operations>
</Operation>

