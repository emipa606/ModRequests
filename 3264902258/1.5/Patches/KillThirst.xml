<?xml version="1.0" encoding="utf-8" ?>
<Patch>

<Operation Class="PatchOperationAdd">
    <xpath>Defs/GeneDef[defName="KillThirst"]</xpath>
    <value>
		<geneClass>VanillaXenotypesImproved.Gene_AddedHediff</geneClass>
    </value>
</Operation>

  <Operation Class="PatchOperationAddModExtension">
      <xpath>Defs/GeneDef[defName="KillThirst"]</xpath>
    <value>
	  <li Class="VanillaXenotypesImproved.ModExtension_AddsHediff">
        <hediffDef>GM_KillThirst</hediffDef>
	  </li>
    </value>
  </Operation>

