<?xml version="1.0" encoding="utf-8" ?>
<Patch>

<Operation Class="PatchOperationSequence">
  <operations>

<!-- Anti-furskin gene. Currently bugged due to how gene overlapping works -->

	<li Class="PatchOperationAdd">
	<xpath>Defs/GeneDef[defName="Furskin"]/exclusionTags</xpath>
	  <value>
           <li>GM_Fur</li>
	  </value>
    </li>
	
	<li Class="PatchOperationReplace">
	<xpath>Defs/GeneDef[defName="Furskin"]/description</xpath>
	  <value>
		<description>Carriers of this gene grow thick fur all over their body, which protects them from cold temperatures. If butchered, this fur can be acquired.</description>
	  </value>
    </li>
	
	<li Class="PatchOperationAdd">
	<xpath>Defs/GeneDef[defName="Furskin"]/beardTagFilter/tags</xpath>
	<value>
		<li>NoBeard</li>
	</value>
	</li>

<!-- Cat ear patch -->
    <li Class="PatchOperationReplace">
	<xpath>Defs/GeneDef[defName="Ears_Cat"]/iconPath</xpath>
	  <value>
        <iconPath>UI/Icons/Genes/GM_Ears_Cat</iconPath>
	  </value>
    </li>

    <li Class="PatchOperationReplace">
	<xpath>Defs/GeneDef[defName="Ears_Cat"]/renderNodeProperties/li/colorType</xpath>
	  <value>    
	    <colorType>Hair</colorType>
	  </value>
    </li>
	
	<li Class="PatchOperationReplace">
	<xpath>Defs/GeneDef[defName="Ears_Cat"]/renderNodeProperties/li/useSkinShader</xpath>
	  <value>    
	      <useSkinShader>false</useSkinShader>
	  </value>
    </li>
	
<!-- Nonsenescent exclusion patch -->
	
	<li Class="PatchOperationAdd">
	<xpath>Defs/GeneDef[defName="Ageless"]</xpath>
	  <value>
		<exclusionTags>
			<li>Pawn_Aging</li>
		</exclusionTags>
	  </value>
	</li>

<!-- Strong stomach incompatible with robust digestion -->

	<li Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>/Defs/GeneDef[defName = "StrongStomach"]/exclusionTags</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>/Defs/GeneDef[defName = "StrongStomach"]</xpath>
			<value>
				<exclusionTags>
					<li>GM_Stomach</li>
				</exclusionTags>
			</value>
		</nomatch>
		<match Class="PatchOperationAdd">
			<xpath>/Defs/GeneDef[defName = "StrongStomach"]/exclusionTags</xpath>
			<value>
				<li>GM_Stomach</li>
			</value>
		</match>
	</li>
	
	<li Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>/Defs/GeneDef[defName = "RobustDigestion"]/exclusionTags</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>/Defs/GeneDef[defName = "RobustDigestion"]</xpath>
			<value>
				<exclusionTags>
					<li>GM_Stomach</li>
				</exclusionTags>
			</value>
		</nomatch>
		<match Class="PatchOperationAdd">
			<xpath>/Defs/GeneDef[defName = "RobustDigestion"]/exclusionTags</xpath>
			<value>
				<li>GM_Stomach</li>
			</value>
		</match>
	</li>

<!-- Blind exclusions -->
	
	<li Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>/Defs/GeneDef[defName = "DarkVision"]/exclusionTags</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>/Defs/GeneDef[defName = "DarkVision"]</xpath>
			<value>
				<exclusionTags>
					<li>GM_BlindDarkvision</li>
				</exclusionTags>
			</value>
		</nomatch>
		<match Class="PatchOperationAdd">
			<xpath>/Defs/GeneDef[defName = "DarkVision"]/exclusionTags</xpath>
			<value>
				<li>GM_BlindDarkvision</li>
			</value>
		</match>
	</li>
	
	<li Class="PatchOperationAdd">
	<xpath>Defs/GeneDef[defName="Nearsighted"]/exclusionTags</xpath>
	  <value>
          <li>GM_BlindNearsighted</li>
	  </value>
    </li>

</operations>
</Operation>

<!-- Nullifying genes thought disabler -->

<Operation Class="PatchOperationSequence">
  <operations>

	<li Class="PatchOperationAdd"> <!-- Blind people don't mind darkness -->
	<xpath>Defs/ThoughtDef[defName="EnvironmentDark"]/nullifyingGenes</xpath>
	  <value>
        <li>GM_Blind</li>
	  </value>
    </li>

