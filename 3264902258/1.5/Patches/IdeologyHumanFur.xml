<?xml version="1.0" encoding="utf-8" ?>
<Patch>

<!-- Cannibalism with human fur -->
<!--                            -->

<Operation Class="PatchOperationSequence">
  <operations>
  
<!-- Abhorrent -->

  <li MayRequire="Ludeon.Rimworld.Ideology" Class="PatchOperationAdd">
    <xpath>Defs/PreceptDef[defName="Cannibalism_Abhorrent"]/comps</xpath>
    <value>
      <li Class="PreceptComp_SituationalThought">
        <thought>GM_HumanFurApparel_Abhorrent</thought>
        <description>Humanfur apparel</description>
        <tooltipShowMoodRange>true</tooltipShowMoodRange>
      </li>
    </value>
  </li>
  
<!-- Horrible -->

  <li MayRequire="Ludeon.Rimworld.Ideology" Class="PatchOperationAdd">
    <xpath>Defs/PreceptDef[defName="Cannibalism_Horrible"]/comps</xpath>
    <value>
      <li Class="PreceptComp_SituationalThought">
        <thought>GM_HumanFurApparel_Horrible</thought>
        <description>Humanfur apparel</description>
        <tooltipShowMoodRange>true</tooltipShowMoodRange>
      </li>
    </value>
  </li>

<!-- Disapproved -->

  <li MayRequire="Ludeon.Rimworld.Ideology" Class="PatchOperationAdd">
    <xpath>Defs/PreceptDef[defName="Cannibalism_Disapproved"]/comps</xpath>
    <value>
      <li Class="PreceptComp_SituationalThought">
        <thought>GM_HumanFurApparel_Disapproved</thought>
        <description>Humanfur apparel</description>
        <tooltipShowMoodRange>true</tooltipShowMoodRange>
      </li>
    </value>
  </li>

<!-- Preferred -->

  <li MayRequire="Ludeon.Rimworld.Ideology" Class="PatchOperationAdd">
    <xpath>Defs/PreceptDef[defName="Cannibalism_Preferred"]/comps</xpath>
    <value>
      <li Class="PreceptComp_SituationalThought">
        <thought>GM_HumanFurApparel_Preferred</thought>
        <description>Humanfur apparel</description>
        <tooltipShowMoodRange>true</tooltipShowMoodRange>
      </li>
    </value>
  </li>

<!-- Strictly required -->

  <li MayRequire="Ludeon.Rimworld.Ideology" Class="PatchOperationAdd">
    <xpath>Defs/PreceptDef[defName="Cannibalism_RequiredStrong"]/comps</xpath>
    <value>
      <li Class="PreceptComp_SituationalThought">
        <thought>GM_HumanFurApparel_RequiredStrong</thought>
        <description>Humanfur apparel</description>
        <tooltipShowMoodRange>true</tooltipShowMoodRange>
      </li>
    </value>
  </li>

<!-- Absolutely required -->

  <li MayRequire="Ludeon.Rimworld.Ideology" Class="PatchOperationAdd">
    <xpath>Defs/PreceptDef[defName="Cannibalism_RequiredRavenous"]/comps</xpath>
    <value>
      <li Class="PreceptComp_SituationalThought">
        <thought>GM_HumanFurApparel_RequiredRavenous</thought>
        <description>Humanfur apparel</description>
        <tooltipShowMoodRange>true</tooltipShowMoodRange>
      </li>
    </value>
  </li>
  
  </operations>
</Operation>

</Patch>