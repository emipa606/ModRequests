<Operation Class="PatchOperationSequence">
	<operations>
		<li Class="PatchOperationRemove">
			<xpath>Defs/XenotypeDef[defName="Dirtmole"]/genes/li[text()="WoundHealing_Fast"]</xpath>
		</li>		
		<li Class="PatchOperationRemove">
			<xpath>Defs/XenotypeDef[defName="Dirtmole"]/genes/li[text()="UVSensitivity_Intense"]</xpath>
		</li>
	</operations>
</Operation>

<Operation Class="PatchOperationAdd">
    <xpath>Defs/XenotypeDef[defName="Dirtmole"]/genes</xpath>
    <value>
		<li>UVSensitivity_Mild</li>
