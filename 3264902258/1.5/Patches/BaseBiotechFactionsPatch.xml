<?xml version="1.0" encoding="utf-8" ?>
<Patch>

<!--Adds custom xenotypes to my new factions-->


<!-- Wasters -->
 <Operation Class="PatchOperationAdd">
	<xpath>Defs/FactionDef[defName="PirateWaster"]/xenotypeSet/xenotypeChances</xpath>
	  <value>
        <Nizhar>.05</Nizhar>
        <Kitul>.05</Kitul>
        <Gwennin>.025</Gwennin>
        <Prole>.025</Prole>
	  </value>
</Operation>

<!-- Furskinned -->
<Operation Class="PatchOperationAdd">
	<xpath>Defs/FactionDef[defName="PirateYttakin"]/xenotypeSet/xenotypeChances</xpath>
	  <value>
	    <Gwennin>0.25</Gwennin>
	  </value>
</Operation>

<Operation Class="PatchOperationReplace">
	<xpath>Defs/FactionDef[defName="PirateYttakin"]/label</xpath>
	  <value>
		<label>furskinned pirates</label>
	  </value>
</Operation>

<Operation Class="PatchOperationReplace">
	<xpath>Defs/FactionDef[defName="PirateYttakin"]/description</xpath>
	  <value>
		<description>A close-knit band of fur-bodied pirates. They refuse to deal with outsiders and are quick to call their animal warriors against those who disrespect them - or whose wealth they intend to take.\n\nThis faction is dominated by yttakin, a race originally engineered to populate the icy planet Yttak. Yttakin now pursue their traditional lifestyle on many worlds.\n\nThis particular group has a significant minority of gwennin who have been conquered by the ytakkin.</description>
	  </value>
</Operation>

<!-- Adoptive Pirate Gang -->

<Operation Class="PatchOperationAdd">
	<xpath>Defs/FactionDef[defName="MulticulturalPirates"]</xpath>
	  <value>
		<xenotypeSet>
		  <xenotypeChances>
			<Dirtmole>0.05</Dirtmole>
			<Hussar>0.05</Hussar>
			<Waster>0.025</Waster>
			<Pigskin>0.025</Pigskin>
			<Neanderthal>0.025</Neanderthal>
			<Impid>0.025</Impid>
			<Genie>0.025</Genie>
			<Yttakin>0.025</Yttakin>
			<Kitul>.3</Kitul>
			<Artemid>.025</Artemid>
			<Nizhar>.05</Nizhar>
			<Prole>.075</Prole>
			<Gwennin>.075</Gwennin>
		  </xenotypeChances>
		</xenotypeSet>
	  </value>
</Operation>

<!-- Multicultural Civil Union -->

	<Operation Class="PatchOperationConditional">
		<success>Always</success>
		<xpath>/Defs/FactionDef[defName = "OutlanderMulticultural"]/xenotypeSet/xenotypeChances</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>/Defs/FactionDef[defName = "OutlanderMulticultural"]</xpath>
			<value>
				<xenotypeSet>
					<xenotypeChances>
						<Dirtmole>.05</Dirtmole>
						<Genie>.025</Genie>
						<Hussar>.025</Hussar>
						<Impid>.05</Impid>
						<Kitul>.05</Kitul>
						<Artemid>.025</Artemid>
						<Prole>.05</Prole>
						<Gwennin>.05</Gwennin>
					</xenotypeChances>
				</xenotypeSet>
			</value>
		</nomatch>
		<match Class="PatchOperationAdd">
		<xpath>/Defs/FactionDef[defName = "OutlanderMulticultural"]/xenotypeSet/xenotypeChances</xpath>
			<value>
						<Dirtmole>.05</Dirtmole>
						<Genie>.025</Genie>
						<Hussar>.025</Hussar>
						<Impid>.05</Impid>
						<Kitul>.05</Kitul>
						<Artemid>.025</Artemid>
						<Prole>.05</Prole>
						<Gwennin>.05</Gwennin>
			</value>
		</match>
	</Operation>

