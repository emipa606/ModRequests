<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  
<!-- Old Soldier -->

  <CreepJoinerFormKindDef ParentName="BaseCreepJoinerKind">
    <defName>OldSoldier</defName>
    <label>old soldier</label>
    <weight>0.5</weight>
    <letterLabel>An old soldier is approaching the colony.</letterLabel>
    <letterPrompt>A man with a bionic eye towers over you. He is full of rage and demands you take him in. His lone biological eye burns red as he stares you down.\n\nYou can tell he'll react poorly if you refuse him.</letterPrompt>
    <minGenerationAge>49</minGenerationAge>
    <maxGenerationAge>69</maxGenerationAge>
	<techHediffsRequired>
      <li>BionicEye</li>
      <li MayRequire="Ludeon.Rimworld.Royalty">KneeSpike</li>
    </techHediffsRequired>
	<xenotypeSet>
		<xenotypeChances>
			<Hussar MayRequire="Ludeon.RimWorld.Biotech">1</Hussar>
		</xenotypeChances>
	</xenotypeSet>
    <inventoryOptions>
      <skipChance>0</skipChance>
      <subOptionsChooseOne>
        <li>
          <thingDef>GoJuice</thingDef>
          <countRange>2</countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
	<fixedInventory>
      <Gun_PumpShotgun />
      <Apparel_FlakJacket>
        <quality>Normal</quality>
      </Apparel_FlakJacket>
      <Apparel_BasicShirt>
        <stuff>Cloth</stuff>
        <quality>Normal</quality>
      </Apparel_BasicShirt>
      <Apparel_FlakPants>
        <quality>Normal</quality>
      </Apparel_FlakPants>
      <Apparel_AdvancedHelmet>
        <stuff>Steel</stuff>
        <quality>Normal</quality>
      </Apparel_AdvancedHelmet>
    </fixedInventory>
    <requires>
      <li MayRequire="Ludeon.RimWorld.Ideology">OldSoldierBenefit</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ManOfBladesBenefit</li>
      <li>BioferriteBodyBenefit</li>
	  <li>AggressiveRejection</li>
    </requires>
    <excludes>
      <li>Leaves</li>
      <li>EntityJailbreaker</li>
	  <li>CraftsmanBenefit</li>
	  <li>GourmandBenefit</li>
    </excludes>
	<fixedGender>Male</fixedGender>
	<skills>
      <li>
        <skill>Melee</skill>
        <range>8~12</range>
      </li>
      <li>
        <skill>Shooting</skill>
        <range>8~12</range>
      </li>
    </skills>
    <forcedTraits>
      <Tough/>
    </forcedTraits>
    <modExtensions>
        <li MayRequire="brrainz.harmony" Class="IntegratedCreepJoiners.CreepJoinerFormKindDefModExtension">
          <bodyTypesMale>Hulk, Male, Thin, Fat</bodyTypesMale>
          <bodyTypesFemale>Hulk, Female, Thin, Fat</bodyTypesFemale>
        </li>
    </modExtensions>
  </CreepJoinerFormKindDef>

<!-- Master Craftsman -->

  <CreepJoinerFormKindDef ParentName="BaseCreepJoinerKind">
    <defName>MasterCraftsman</defName>
    <label>master craftsman</label>
    <weight>0.5</weight>
    <letterLabel>A limping figure is approaching the colony.</letterLabel>
    <letterPrompt>The figure slouches as {PAWN_pronoun} moves, {PAWN_possessive} gait not quite correct. Upon closer inspection, it appears {PAWN_possessive} arms and legs are prosthetic.\n\nWhen {PAWN_pronoun} speaks, {PAWN_possessive} voice is made of quiet rasps and lisps. {PAWN_pronoun} seeks to join the colony.</letterPrompt>
    <minGenerationAge>33</minGenerationAge>
    <maxGenerationAge>55</maxGenerationAge>
	<xenotypeSet>
		<xenotypeChances>
			<Genie MayRequire="Ludeon.RimWorld.Biotech">.125</Genie>
			<Dirtmole MayRequire="Ludeon.RimWorld.Biotech">.125</Dirtmole>
			<Neanderthal MayRequire="Ludeon.RimWorld.Biotech">.125</Neanderthal>
			<Impid MayRequire="Ludeon.RimWorld.Biotech">.125</Impid>
			<Waster MayRequire="Ludeon.RimWorld.Biotech">.125</Waster>
			<Prole MayRequireAnyOf="GrillMaster.moreracesfactions,GrillMaster.vanillaxenotypesimproved">.125</Prole>
			<Gwennin MayRequireAnyOf="GrillMaster.moreracesfactions,GrillMaster.vanillaxenotypesimproved">.125</Gwennin>
			<Kitul MayRequireAnyOf="GrillMaster.moreracesfactions,GrillMaster.vanillaxenotypesimproved">.125</Kitul>
		</xenotypeChances>
	</xenotypeSet>
	<fixedInventory>
      <Apparel_Shadecone MayRequire="Ludeon.RimWorld.Ideology">
        <stuff>Leather_Thrumbo</stuff>
        <quality>Excellent</quality>
      </Apparel_Shadecone>
    </fixedInventory>
    <apparelTags>
      <li>IndustrialBasic</li>
    </apparelTags>
    <apparelMoney>500~500</apparelMoney>
    <requires>
      <li>CraftsmanBenefit</li>
    </requires>
	<techHediffsRequired>
      <li>SimpleProstheticLeg</li>
      <li>SimpleProstheticLeg</li>
      <li>SimpleProstheticArm</li>
      <li>SimpleProstheticArm</li>
    </techHediffsRequired>
	<skills>
      <li>
        <skill>Crafting</skill>
        <range>14~20</range>
      </li>
    </skills>
    <modExtensions>
        <li MayRequire="brrainz.harmony" Class="IntegratedCreepJoiners.CreepJoinerFormKindDefModExtension">
          <bodyTypesMale>Hulk, Male, Thin, Fat</bodyTypesMale>
          <bodyTypesFemale>Hulk, Female, Thin, Fat</bodyTypesFemale>
        </li> 
    </modExtensions>
  </CreepJoinerFormKindDef>

<!-- Summer Child -->

  <CreepJoinerFormKindDef ParentName="BaseCreepJoinerKind">
    <defName>SummerChild</defName>
    <label>summer child</label>
    <weight>0.5</weight>
    <letterLabel>A smiling girl is approaching the colony.</letterLabel>
    <letterPrompt>A grinning girl approaches you. Despite being strangers, she speaks almost as if you're old friends. She does not appear to be dangerous in any way, but looks can be deceiving.</letterPrompt>
    <minGenerationAge>13</minGenerationAge>
    <maxGenerationAge>19</maxGenerationAge>
	<techHediffsRequired>
      <li MayRequire="Ludeon.RimWorld.Royalty">PsychicReader</li>
    </techHediffsRequired>
	<xenotypeSet>
		<xenotypeChances>
			<Dirtmole MayRequire="Ludeon.RimWorld.Biotech">.1</Dirtmole>
			<Impid MayRequire="Ludeon.RimWorld.Biotech">.1</Impid>
			<Sanguophage MayRequire="Ludeon.RimWorld.Biotech">.05</Sanguophage>
			<Highmate MayRequire="Ludeon.RimWorld.Biotech">.05</Highmate>
			<Kitul MayRequireAnyOf="GrillMaster.moreracesfactions,GrillMaster.vanillaxenotypesimproved">.1</Kitul>
		</xenotypeChances>
	</xenotypeSet>
    <apparelTags>
      <li>IndustrialBasic</li>
    </apparelTags>
    <apparelMoney>200~500</apparelMoney>
    <requires>
      <li>Joybringer</li>
    </requires>
	<fixedInventory>
      <Apparel_PsyfocusShirt MayRequire="Ludeon.RimWorld.Royalty">
        <quality>Normal</quality>
      </Apparel_PsyfocusShirt>
      <Apparel_Cape MayRequire="Ludeon.RimWorld.Royalty">
        <stuff>Cloth</stuff>
        <quality>Normal</quality>
      </Apparel_Cape>
    </fixedInventory>
    <excludes>
      <li>Leaves</li>
      <li>AggressiveRejection</li>
      <li>Aggressive</li>
      <li>CrumblingMind</li>
      <li>Disturbing</li>
	  <li>ConsistentViolentBreaks</li>
	  <li>CraftsmanBenefit</li>
	  <li>GourmandBenefit</li>
    </excludes>
	<fixedGender>Female</fixedGender>
    <forcedTraits>
      <Kind/>
      <Beauty>1</Beauty>
    </forcedTraits>
	<skills>
      <li>
        <skill>Social</skill>
        <range>12~14</range>
      </li>
    </skills>
    <modExtensions>
        <li MayRequire="brrainz.harmony" Class="IntegratedCreepJoiners.CreepJoinerFormKindDefModExtension">
          <allowIncapableOfViolence>true</allowIncapableOfViolence>
          <bodyTypesMale>Male, Thin</bodyTypesMale>
          <bodyTypesFemale>Female, Thin</bodyTypesFemale>
        </li> 
    </modExtensions>
  </CreepJoinerFormKindDef>

<!-- Exiled Noble-->

  <CreepJoinerFormKindDef MayRequire="Ludeon.RimWorld.Royalty" ParentName="BaseCreepJoinerKind">
    <defName>ExiledNoble</defName>
    <label>exiled noble</label>
    <weight>0.5</weight>
    <letterLabel>A swaggering figure is approaching the colony.</letterLabel>
    <letterPrompt>A swaggering figure in fancy clothes sidles up to you. While charming, {PAWN_pronoun} exudes an aura of overconfidence that borders on arrogance.\n\n{PAWN_nameDef} is capable of psycasting, a rare ability, and {PAWN_pronoun} is adamant that {PAWN_pronoun} will leave soon.</letterPrompt>
    <minGenerationAge>21</minGenerationAge>
    <maxGenerationAge>35</maxGenerationAge>
	<xenotypeSet>
		<xenotypeChances>
			<Sanguophage MayRequire="Ludeon.RimWorld.Biotech">.1</Sanguophage>
			<Highmate MayRequire="Ludeon.RimWorld.Biotech">.05</Highmate>
			<Starjack MayRequire="Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Odyssey">.05</Starjack>
			<Kitul MayRequireAnyOf="GrillMaster.moreracesfactions,GrillMaster.vanillaxenotypesimproved">.1</Kitul>
		</xenotypeChances>
	</xenotypeSet>
	<fixedInventory>
      <Apparel_ShirtRuffle>
        <stuff>Synthread</stuff>
        <quality>Normal</quality>
        <color>(120, 81, 169)</color>
      </Apparel_ShirtRuffle>
      <Apparel_EltexSkullcap>
        <quality>Normal</quality>
        <color>(120, 81, 169)</color>
      </Apparel_EltexSkullcap>
      <Apparel_Pants>
        <stuff>Synthread</stuff>
        <quality>Normal</quality>
        <color>(120, 81, 169)</color>
      </Apparel_Pants>
      <Apparel_PsyfocusRobe>
        <quality>Normal</quality>
        <color>(120, 81, 169)</color>
      </Apparel_PsyfocusRobe>
    </fixedInventory>
	<skills>
      <li>
        <skill>Social</skill>
        <range>10~12</range>
      </li>
    </skills>
	<techHediffsRequired>
      <li>PsychicAmplifier</li>
    </techHediffsRequired>
    <forcedTraits>
      <AnnoyingVoice/>
    </forcedTraits>
    <requires>
      <li>Leaves</li>
      <li>Occultist</li>
      <li>Alchemist</li>
      <li>DeathRefusal</li>
      <li>PsychicButcher</li>
      <li>BioferriteBodyBenefit</li>
    </requires>
    <excludes>
      <li>CreepIsCancerous</li>
	  <li>CraftsmanBenefit</li>
	  <li>GourmandBenefit</li>
    </excludes>
    <modExtensions>
        <li MayRequire="brrainz.harmony" Class="IntegratedCreepJoiners.CreepJoinerFormKindDefModExtension">
          <allowIncapableOfViolence>true</allowIncapableOfViolence>
          <bodyTypesMale>Male, Thin</bodyTypesMale>
          <bodyTypesFemale>Female, Thin</bodyTypesFemale>
        </li> 
    </modExtensions>
  </CreepJoinerFormKindDef>

<!-- Man of Blades -->

 <CreepJoinerFormKindDef MayRequire="Ludeon.RimWorld.Royalty" ParentName="BaseCreepJoinerKind">
    <defName>ManOfBlades</defName>
    <label>man of blades</label>
    <weight>0.5</weight>
    <letterLabel>A man with a pained expression approaches.</letterLabel>
    <letterPrompt>A man stands before you, clutching his head as if in pain. He explains that he escaped from an unethical laboratory that was trying to turn him into a human weapon.\n\nHe begs for a place to stay. He claims that he's no threat to anyone, despite his modifications.</letterPrompt>
    <missingParts>
      <li>
        <bodyPart>Eye</bodyPart>
      </li>
    </missingParts>
    <minGenerationAge>25</minGenerationAge>
    <maxGenerationAge>40</maxGenerationAge>
	<bodyTypeGraphicPaths>
      <Male>Things/Pawn/Humanlike/Bodies/ManOfBladesMale</Male>
      <Female>Things/Pawn/Humanlike/Bodies/ManOfBladesFemale</Female>
      <Hulk>Things/Pawn/Humanlike/Bodies/ManOfBladesHulk</Hulk>
      <Fat>Things/Pawn/Humanlike/Bodies/ManOfBladesFat</Fat>
      <Thin>Things/Pawn/Humanlike/Bodies/ManOfBladesThin</Thin>
    </bodyTypeGraphicPaths>
	<forcedHeadTypes>
      <li>ManOfBlades</li>
    </forcedHeadTypes>
	<forcedTraits>
      <Tough/>
    </forcedTraits>
    <requires>
      <li MayRequire="Ludeon.RimWorld.Ideology">ManOfBladesBenefit</li>
      <li>UnnaturalHealing</li>
      <li>BodyMastery</li>
      <li>PsychicButcher</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">OldSoldierBenefit</li>
    </requires>
    <excludes>
      <li>AggressiveRejection</li>
      <li>Aggressive</li>
      <li>EntityJailbreaker</li>
	  <li>CraftsmanBenefit</li>
	  <li>GourmandBenefit</li>
    </excludes>
	<skills>
      <li>
        <skill>Melee</skill>
        <range>10~12</range>
      </li>
    </skills>
	<xenotypeSet>
		<xenotypeChances>
			<Dirtmole MayRequire="Ludeon.RimWorld.Biotech">.20</Dirtmole>
			<Yttakin MayRequire="Ludeon.RimWorld.Biotech">.20</Yttakin>
			<Neanderthal MayRequire="Ludeon.RimWorld.Biotech">.20</Neanderthal>
			<Nizai MayRequire="GrillMaster.moreracesfactions">.40</Nizai>
			<Nizhar MayRequire="GrillMaster.vanillaxenotypesimproved">.40</Nizhar>
		</xenotypeChances>
	</xenotypeSet>
    <itemQuality>Poor</itemQuality>
    <apparelMoney>90~280</apparelMoney>
	<fixedInventory>
      <Apparel_Sash MayRequire="Ludeon.RimWorld.Biotech">
        <stuff>Leather_Patch</stuff>
        <quality>Normal</quality>
      </Apparel_Sash>
    </fixedInventory>
	<techHediffsRequired>
      <li>HealingEnhancer</li>
      <li>Mindscrew</li>
      <li>PowerClaw</li>
      <li>ElbowBlade</li>
      <li>VenomFangs</li>
      <li>ToughskinGland</li>
    </techHediffsRequired>
    <existingDamage>
      <li>
        <damage>SurgicalCut</damage>
        <groups>
          <li>Legs</li>
          <li>Arms</li>
          <li>Torso</li>
        </groups>
      </li>
    </existingDamage>
	<fixedGender>Male</fixedGender>
    <modExtensions>
        <li MayRequire="brrainz.harmony" Class="IntegratedCreepJoiners.CreepJoinerFormKindDefModExtension">
          <bodyTypesMale>Hulk, Male, Thin, Fat</bodyTypesMale>
          <bodyTypesFemale>Hulk, Female, Thin, Fat</bodyTypesFemale>
        </li> 
    </modExtensions>
  </CreepJoinerFormKindDef>
  
    <HeadTypeDef ParentName="AverageBase">
    <defName>ManOfBlades</defName>
    <graphicPath>Things/Pawn/Humanlike/Heads/ManOfBlades_Head_Male</graphicPath>
    <gender>Male</gender>
    <randomChosen>false</randomChosen>
    <eyeOffsetEastWest>(0.16, 0, 0.17)</eyeOffsetEastWest>
  </HeadTypeDef>
  
  <!-- Vampire -->
  
  <CreepJoinerFormKindDef MayRequire="Ludeon.RimWorld.Biotech" ParentName="BaseCreepJoinerKind">
    <defName>vampirecreep</defName>
    <label>the fanged one</label>
    <weight>.5</weight>
    <letterLabel>A stranger with fangs is approaching the colony.</letterLabel>
    <letterPrompt>The fanged one is quiet, but {PAWN_possessive} voice is filled with the weight of age and time. {PAWN_nameDef} has suffered at the hands of a dark archotech and wants a place to call home.\n\n{PAWN_possessive} needs are specific, but {PAWN_pronoun} offers the full extent of {PAWN_possessive} knowledge and abilities in exchange for protection.</letterPrompt>
    <minGenerationAge>21</minGenerationAge>
    <maxGenerationAge>25</maxGenerationAge>
    <chronologicalAgeRange>500~1000</chronologicalAgeRange>
	<xenotypeSet>
		<xenotypeChances>
			<Sanguophage MayRequire="Ludeon.RimWorld.Biotech">1</Sanguophage>
		</xenotypeChances>
	</xenotypeSet>
    <existingDamage>
      <li>
        <damage>SurgicalCut</damage>
        <groups>
          <li>Legs</li>
          <li>Arms</li>
        </groups>
      </li>
    </existingDamage>
    <apparelTags>
      <li>IndustrialAdvanced</li>
    </apparelTags>
    <apparelRequired>
      <li>Apparel_Duster</li>
      <li>Apparel_CollarShirt</li>
      <li>Apparel_Pants</li>
    </apparelRequired>
    <itemQuality>Good</itemQuality>
    <minApparelQuality>Good</minApparelQuality>
    <maxApparelQuality>Good</maxApparelQuality>
    <forceNormalGearQuality>false</forceNormalGearQuality>
    <apparelColor>(29,29,29)</apparelColor>
    <ignoreIdeoApparelColors>true</ignoreIdeoApparelColors>
    <favoriteColor MayRequire="Ludeon.RimWorld.Ideology">Black</favoriteColor>
    <requires>
      <li>Occultist</li>
      <li>UnnaturalHealing</li>
      <li>PerfectHuman</li>
      <li>PsychicButcher</li>
      <li>Departure</li>
    </requires>
    <excludes>
      <li>CreepIsCancerous</li>
	  <li>CraftsmanBenefit</li>
	  <li>GourmandBenefit</li>
    </excludes>
    <modExtensions>
        <li MayRequire="brrainz.harmony" Class="IntegratedCreepJoiners.CreepJoinerFormKindDefModExtension">
          <bodyTypesMale>Male, Thin</bodyTypesMale>
          <bodyTypesFemale>Female, Thin</bodyTypesFemale>
        </li> 
    </modExtensions>
  </CreepJoinerFormKindDef>

  <!-- Cannibal Gourmand -->
  
  <CreepJoinerFormKindDef ParentName="BaseCreepJoinerKind">
    <defName>CannibalGourmand</defName>
    <label>the chef</label>
    <weight>.5</weight>
    <letterLabel>A figure in white approaches.</letterLabel>
    <letterPrompt>{PAWN_nameDef} is all smiles. Fragrant scents seem to emanate from {PAWN_possessive} person. {PAWN_pronoun} explains {PAWN_pronoun} is a highly experienced chef and is more than willing to cook for your colony.</letterPrompt>
    <minGenerationAge>21</minGenerationAge>
    <maxGenerationAge>60</maxGenerationAge>
	<xenotypeSet>
		<xenotypeChances>
			<Dirtmole MayRequire="Ludeon.RimWorld.Biotech">.1</Dirtmole>
			<Genie MayRequire="Ludeon.RimWorld.Biotech">.1</Genie>
			<Hussar MayRequire="Ludeon.RimWorld.Biotech">.1</Hussar>
			<Impid MayRequire="Ludeon.RimWorld.Biotech">.1</Impid>
			<Yttakin MayRequire="Ludeon.RimWorld.Biotech">.1</Yttakin>
			<Neanderthal MayRequire="Ludeon.RimWorld.Biotech">.1</Neanderthal>
			<Kitul MayRequireAnyOf="GrillMaster.moreracesfactions,GrillMaster.vanillaxenotypesimproved">.1</Kitul>
			<Artemid MayRequireAnyOf="GrillMaster.moreracesfactions,GrillMaster.vanillaxenotypesimproved">.1</Artemid>
			<Nizai MayRequire="GrillMaster.moreracesfactions">.1</Nizai>
			<Nizhar MayRequire="GrillMaster.vanillaxenotypesimproved">.1</Nizhar>
			<Prole MayRequireAnyOf="GrillMaster.moreracesfactions,GrillMaster.vanillaxenotypesimproved">.1</Prole>
		</xenotypeChances>
	</xenotypeSet>
    <forcedTraits>
      <Cannibal/>
    </forcedTraits>
	<techHediffsRequired>
      <li MayRequire="Ludeon.RimWorld.Royalty">GastroAnalyzer</li>
    </techHediffsRequired>
    <apparelTags>
      <li>IndustrialAdvanced</li>
    </apparelTags>
    <apparelRequired>
      <li MayRequire="Ludeon.RimWorld.Royalty">Apparel_Beret</li>
      <li>Apparel_CollarShirt</li>
      <li>Apparel_Jacket</li>
      <li>Apparel_Pants</li>
    </apparelRequired>
	<fixedInventory>
      <MeleeWeapon_Knife>
        <stuff>Silver</stuff>
        <quality>Normal</quality>
      </MeleeWeapon_Knife>
    </fixedInventory>
    <apparelColor>(200,200,200)</apparelColor>
    <itemQuality>Good</itemQuality>
    <minApparelQuality>Good</minApparelQuality>
    <maxApparelQuality>Good</maxApparelQuality>
    <forceNormalGearQuality>false</forceNormalGearQuality>
    <ignoreIdeoApparelColors>true</ignoreIdeoApparelColors>
    <favoriteColor MayRequire="Ludeon.RimWorld.Ideology">Red</favoriteColor>
    <requires>
      <li>GourmandBenefit</li>
    </requires>
	<excludes>
		<li>CraftsmanBenefit</li>
	</excludes>
	<skills>
      <li>
        <skill>Cooking</skill>
        <range>14~20</range>
      </li>
    </skills>
    <modExtensions>
        <li MayRequire="brrainz.harmony" Class="IntegratedCreepJoiners.CreepJoinerFormKindDefModExtension">
          <bodyTypesMale>Hulk, Male, Thin, Fat</bodyTypesMale>
          <bodyTypesFemale>Hulk, Female, Thin, Fat</bodyTypesFemale>
        </li> 
    </modExtensions>
  </CreepJoinerFormKindDef>

</Defs>