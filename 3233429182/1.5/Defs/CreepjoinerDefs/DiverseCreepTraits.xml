<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- Master Craftsman -->

  <TraitDef>
    <defName>MasterCraftsmanTrait</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label>craftsmaster</label>
        <description>{PAWN_nameDef} has extensive experience in construction and crafting. {PAWN_pronoun} will work faster than others and nearly always succeed at construction and repairs.</description>
        <statOffsets>
          <ConstructionSpeed>0.25</ConstructionSpeed>
          <ConstructSuccessChance>0.25</ConstructSuccessChance>
          <FixBrokenDownBuildingSuccessChance>0.25</FixBrokenDownBuildingSuccessChance>
          <SmoothingSpeed>0.25</SmoothingSpeed>
          <SmeltingSpeed>0.25</SmeltingSpeed>
          <GeneralLaborSpeed>0.25</GeneralLaborSpeed>
        </statOffsets>
      </li>
    </degreeDatas>
  </TraitDef>

  <!-- Cannibal Gourmand -->

  <TraitDef>
    <defName>MasterCookTrait</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label>master chef</label>
        <description>{PAWN_nameDef} has extensive experience in cooking. {PAWN_pronoun} will cook faster than others and never cause food poisoning.</description>
        <statOffsets>
          <CookSpeed>5</CookSpeed>
          <FoodPoisonChance>-1</FoodPoisonChance>
        </statOffsets>
      </li>
    </degreeDatas>
  </TraitDef>

<!-- Violent Mind Downside-->

  <TraitDef>
    <defName>ViolentMind</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label>violent mind</label>
        <description>{PAWN_nameDef} is predisposed towards violence and will frequently try to harm others.</description>
        <randomMentalState>BerserkShort</randomMentalState>
        <randomMentalStateMtbDaysMoodCurve>
          <points>
            <li>(0, 60)</li>
          </points>
        </randomMentalStateMtbDaysMoodCurve>
	    <socialFightChanceFactor>2</socialFightChanceFactor>
		<allowedMeditationFocusTypes><li>Morbid</li></allowedMeditationFocusTypes>
      </li>
    </degreeDatas>
	<requiredWorkTags>
      <li>Violent</li>
    </requiredWorkTags>
  </TraitDef>

