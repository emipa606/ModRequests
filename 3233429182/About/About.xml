<?xml version="1.0" encoding="utf-8" ?>
<ModMetaData>
    <name>Integrated Creep Joiners</name>
    <author>GrillMaster</author>
    <packageId>GrillMaster.integratedcreepjoiners</packageId>
    <supportedVersions>
        <li>1.5</li>
        <li>1.6</li>
    </supportedVersions>

    <description>A simple mod to add more integration between creep joiners and Rimworld's Royalty, Ideology, and Biotech content.
    </description>
	<modDependencies>
        <li>
			<packageId>Ludeon.RimWorld.Anomaly</packageId>
			<displayName>Anomaly</displayName>
		</li>
		<li>
			<packageId>brrainz.harmony</packageId>
			<displayName>Harmony</displayName>
			<downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
			<steamWorkshopUrl>https://steamcommunity.com/workshop/filedetails/?id=2009463077</steamWorkshopUrl>
		</li>
    </modDependencies>
    <loadAfter>
		<li>GrillMaster.moreracesfactions</li>
    </loadAfter>
	<incompatibleWith>
      <li>GrillMaster.anomalyjoinerxenotypes</li>
	  <li>microus.creepjoinersromance</li>
    </incompatibleWith>
</ModMetaData>