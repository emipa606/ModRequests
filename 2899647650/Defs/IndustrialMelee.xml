	 <costList>
      <WoodLog>60</WoodLog>
	  <Steel>50</Steel>
    </costList>
    <weaponTags>
      <li>IndustiralMeleeDecent</li>
    </weaponTags>
    <weaponClasses>
      <li>Melee</li>
    </weaponClasses>
    <tools>
      <li>
        <label>handle</label>
