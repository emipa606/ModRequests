   <!-- ====================== Trench Shovel ===================== -->
   
  <ThingDef ParentName="BaseMeleeWeapon_Blunt_Quality">
    <defName>MeleeWeapon_TrenchShovel</defName>
    <label>Trench Shovel</label>
    <description>Trench Shovels are used by the Astra Militarum to dig trenches with. The Death Korps of Krieg have put such Shovels to legendary use in their service to the Imperium.</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Weapons/Trench Shovel</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconScale>1.2</uiIconScale>
    <techLevel>Industrial</techLevel>
    <statBases>
      <WorkToMake>8000</WorkToMake>
      <Mass>1.5</Mass>
    </statBases>
	<equippedAngleOffset>-65</equippedAngleOffset>
    <recipeMaker>
      <researchPrerequisite>Machining</researchPrerequisite>
