	<ThingDef ParentName="BaseWeapon">
		<defName>Artemiish_SNKnife</defName>
		<label>blade of the killer</label>
		<description>This weapons is nothing more than a Shard with a handle. It seems to appear whenever the holder of the curse needs it.</description>
		<descriptionHyperlinks>
			<HediffDef>Artemiish_SNKnifeHediff</HediffDef>
			<ThingDef>Shard</ThingDef>
		</descriptionHyperlinks>
		<possessionCount>1</possessionCount>
		<graphicData>
			<texPath>ArtemiishThings/Weapons/CursedKnife</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<uiIconScale>1.2</uiIconScale>
		<techLevel>Archotech</techLevel>
		<statBases Inherit="False">
			<Mass>0.85</Mass>
		</statBases>
		<equippedAngleOffset>-65</equippedAngleOffset>
		<smeltable>false</smeltable>
		<burnableByRecipe>false</burnableByRecipe>
		<destroyOnDrop>true</destroyOnDrop>
		<tradeability>None</tradeability>
		<useHitPoints>false</useHitPoints>
		<tools>
			<li>
				<label>handle</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>10</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>point</label>
				<capacities>
					<li>Stab</li>
				</capacities>
				<power>18</power>
				<armorPenetration>0.6</armorPenetration>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>edge</label>
				<capacities>
					<li>Cut</li>
				</capacities>
				<power>18</power>
				<armorPenetration>0.6</armorPenetration>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<comps>
			<li Class="SupernaturalWeapons.CompProperties_DestroyOnUnequip"/>
		</comps>
	</ThingDef>
	
	<AbilityDef>
		<defName>Artemiish_MarkSkip</defName>
		<label>skip</label>
		<description>Use the power of the mark to skip some distance away.</description>
		<iconPath>ArtemiishThings/UI/MarkBlinkAbility</iconPath>
		<cooldownTicksRange>90</cooldownTicksRange>
		<hostile>false</hostile>
		<aiCanUse>true</aiCanUse>
		<verbProperties>
			<verbClass>SupernaturalWeapons.Verb_CastAbilityTeleport</verbClass>
			<label>skip</label>
			<violent>false</violent>
			<forceNormalTimeSpeed>false</forceNormalTimeSpeed>
			<warmupTime>0.5</warmupTime>
			<range>19.9</range>
			<requireLineOfSight>true</requireLineOfSight>
			<soundCast>Longjump_Jump</soundCast>
			<soundLanding>Longjump_Land</soundLanding>
			<targetParams>
				<canTargetLocations>true</canTargetLocations>
				<canTargetPawns>false</canTargetPawns>
				<canTargetBuildings>false</canTargetBuildings>
			</targetParams>
		</verbProperties>
		<jobDef>CastJump</jobDef>
		<comps>
			<li Class="SupernaturalWeapons.CompProperties_AbilityNeedCost">
				<needDef>Artemiish_BloodThirst</needDef>
				<needCost>0.05</needCost>
			</li>
		</comps>
	</AbilityDef>
</Defs>
