<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
	<NeedDef>
		<defName>Artemiish_BloodThirst</defName>
		<needClass>EBSGFramework.Need_Murderous</needClass>
		<label>bloodthirst</label>
		<description>This pawn needs to kill to mantain the power of the mark and their sanity.</description>
		<baseLevel>0</baseLevel>
		<minIntelligence>ToolUser</minIntelligence>
		<colonistAndPrisonersOnly>true</colonistAndPrisonersOnly>
		<onlyIfCausedByHediff>true</onlyIfCausedByHediff>
		<fallPerDay>0.01</fallPerDay>
		<modExtensions>
			<li Class="EBSGFramework.EBSGExtension">
				<increasePerKill>0.2</increasePerKill>
				<thresholdPercentages>
					<li>0.25</li>
					<li>0.5</li>
					<li>0.75</li>
				</thresholdPercentages>
			</li>
		</modExtensions>
	</NeedDef>

	<ThoughtDef>
		<defName>Artemiish_BloodthirstThought</defName>
		<thoughtClass>EBSGFramework.Thought_Situational_BasicCurveNeedMood</thoughtClass>
		<workerClass>EBSGFramework.ThoughtWorker_BasicCurveNeedMood</workerClass>
		<developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
		<stages>
			<li>
				<label>bloodthirst</label>
				<baseMoodEffect>0</baseMoodEffect>
			</li>
		</stages>
		<modExtensions>
			<li Class="EBSGFramework.EBSGExtension">
				<need>Artemiish_BloodThirst</need>
				<moodOffsetCurve>
					<points>
						<li>0, -50</li>
						<li>0.25, -25</li>
						<li>0.5, 0</li>
						<li>0.75, 10</li>
						<li>0.9, 20</li>
					</points>
				</moodOffsetCurve>
			</li>
		</modExtensions>
	</ThoughtDef>

	<HediffDef ParentName="ImplantHediffBase">
		<defName>Artemiish_SNKnifeHediff</defName>
		<label>mark of the killer</label>
		<labelNoun>the mark of a curse</labelNoun>
		<description>A mark that shows this pawn is bound by a curse. This curse gives the pawn superhuman strength, regeneration and resurrection after a few days, but they need to kill to mantain the power.</description>
		<descriptionHyperlinks>
			<ThingDef>Artemiish_SNKnife</ThingDef>
		</descriptionHyperlinks>
		<hediffClass>HediffWithComps</hediffClass>
		<causesNeed>Artemiish_BloodThirst</causesNeed>
		<comps>
			<li Class="SupernaturalWeapons.HediffCompProperties_AttachedNeed">
				<needDef>Artemiish_BloodThirst</needDef>
			</li>
			<li Class="SupernaturalWeapons.HediffCompProperties_EquipWeapon">
				<weapon>Artemiish_SNKnife</weapon>
			</li>
			<li Class="SupernaturalWeapons.HediffCompProperties_GiveAbilityToSeverity">
				<abilityParams>
					<li>
						<abilityDef>Artemiish_MarkSkip</abilityDef>
						<severity>0.75</severity>
					</li>
				</abilityParams>
			</li>
			<li Class="HediffCompProperties_HealPermanentWounds"/>
		</comps>
