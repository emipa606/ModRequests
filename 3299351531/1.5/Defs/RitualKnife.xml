<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<SupernaturalWeapons.PsychicRitualDef_TransferMark>
		<defName>Artemiish_MarkRitual</defName>
		<label>transfer mark</label>
		<description>Perform a ritual to transfer the mark of the killer from the target to the invoker.</description>
		<researchPrerequisite>Artemiish_KnifeResearch</researchPrerequisite>
		<outcomeDescription>The target will suffer brain damage and fall into a coma. A shoddy ritual might result in the target's death.</outcomeDescription>
		<targetRole>MarkTransferTarget</targetRole>
		<hoursUntilOutcome>2</hoursUntilOutcome>
		<cooldownHours>300</cooldownHours>
		<iconPath>ArtemiishThings/UI/KillerMarkRitual</iconPath>
		<brainDamageFromQualityCurve>
			<points>
				<li>(0, 8)</li>
				<li>(25, 5)</li>
				<li>(50, 2)</li>
				<li>(75, 0.3)</li>
				<li>(100, 0)</li>
			</points>
		</brainDamageFromQualityCurve>
	</SupernaturalWeapons.PsychicRitualDef_TransferMark>

	<PsychicRitualRoleDef>
		<defName>MarkTransferTarget</defName>
		<label>target</label>
		<allowedCount>1</allowedCount>
		<allowedConditions>Default, Downed, Prisoner, Sleeping, IdeoUnwilling</allowedConditions>
		<applyPowerOffset>false</applyPowerOffset>
	</PsychicRitualRoleDef>

</Defs>