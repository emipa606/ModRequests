<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <TraderKindDef>
        <defName>Artemiish_RevolverTrader</defName>
        <label>strange trader</label>
		<commonality>0.1</commonality>
		<requestable>False</requestable>
		<tradeCurrency>Silver</tradeCurrency>
		<faction>OutlanderCivil</faction>
		<category>StrangeTrader</category>
		<hideThingsNotWillingToTrade>True</hideThingsNotWillingToTrade>
        <stockGenerators>
			<li Class="StockGenerator_Tag">
				<tradeTag>Artemiish_Revolver</tradeTag>
				<thingDefCountRange>1</thingDefCountRange>
