        </stockGenerators>
    </TraderKindDef>

	<IncidentDef>
		<defName>Artemiish_StrangeTraderArrival</defName>
		<label>strange trader arrival</label>
		<category>Misc</category>
		<baseChance>1</baseChance>
		<minAnomalyThreatLevel>2</minAnomalyThreatLevel>
		<minRefireDays>60</minRefireDays>
		<targetTags>
			<li>Map_PlayerHome</li>
		</targetTags>
		<workerClass>SupernaturalWeapons.IncidentWorker_StrangeTraderArrival</workerClass>
		<requireColonistsPresent>True</requireColonistsPresent>
	</IncidentDef>

