<?xml version="1.0" encoding="utf-8"?>

<Patch>

    <!-- Add the meds to traders. -->

    <Operation Class="PatchOperationAdd">

        <xpath>Defs/TraderKindDef/stockGenerators[li/thingDef="MedicineHerbal"]</xpath>

        <value>

            <li Class="StockGenerator_SingleDef">
                <thingDef>CapAcetamol</thingDef>
                <countRange>-12~5</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>CapImmunitol</thingDef>
                <countRange>-12~5</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>CapOpimol</thingDef>
                <countRange>-12~5</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>CapOxymol</thingDef>
                <countRange>-12~5</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>CapVicomol</thingDef>
                <countRange>-12~5</countRange>
            </li>

        </value>

    </Operation>


</Patch>